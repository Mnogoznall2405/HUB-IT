# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_API_FALLBACK_IP=149.154.167.220
TELEGRAM_BOT_API_PREFER_FALLBACK_IP=1
ALLOWED_GROUP_ID=your_group_id_here
ALLOWED_USERS=user_id1,user_id2,user_id3

# RouterAI API Configuration (единый LLM gateway: shared/llm)
ROUTERAI_API_KEY=your_routerai_api_key_here
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=google/gemini-3.6-flash
# Узкий fallback только для routerai.ru, если DNS виртуального адаптера даёт SERVFAIL.
ROUTERAI_DNS_FALLBACK=1
ROUTERAI_DNS_PREFER_DOH=1
ROUTERAI_DOH_URL=https://1.1.1.1/dns-query
# Не задавайте на обычных установках. Нужен только при перехвате трафика TUN-адаптером.
ROUTERAI_LOCAL_ADDRESS=

# Необязательные переопределения модели по назначению:
ROUTERAI_MODEL_MAIL=
ROUTERAI_MODEL_CHAT=
ROUTERAI_MODEL_MARKDOWN=
ROUTERAI_MODEL_ACT=
ROUTERAI_MODEL_OCR=
ROUTERAI_MODEL_DOC_CONVERT=

# Старые переменные поддерживаются как fallback на время миграции.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL_MAIL=
OPENROUTER_MODEL_CHAT=
OPENROUTER_MODEL_MARKDOWN=
ACT_PARSE_MODEL=
OCR_MODEL=qwen/qwen3-vl-8b-instruct
DOC_CONVERT_MODEL=google/gemini-3.5-flash
# Vision-in-the-loop: region refine + side-by-side verify + rebuild on low fidelity
DOC_CONVERT_VERIFY=1
DOC_CONVERT_VERIFY_ROUNDS=3
DOC_CONVERT_VERIFY_MIN_FIDELITY=0.9
DOC_CONVERT_REGION_REFINE=1
DOC_CONVERT_REGION_REFINE_MAX_BLOCKS=12
DOC_CONVERT_REBUILD_ON_LOW_FIDELITY=1
DOC_CONVERT_MAX_PAGE_CHARS=25000

# OpenRouter gateway retry / reliability (shared/llm)
AI_OPENROUTER_MAX_RETRIES=3
AI_OPENROUTER_RETRY_BASE_DELAY=0.8
AI_OPENROUTER_RETRY_MAX_DELAY=8.0
# Default request timeout is 45s; markdown transform uses per-call timeout=20s

# Unused (зарезервировано, код не читает): CARTRIDGE_ANALYSIS_MODEL
# CARTRIDGE_ANALYSIS_MODEL=anthropic/claude-3.5-sonnet

# Database Configuration
SQL_SERVER_HOST=your_sql_server_host
SQL_SERVER_DATABASE=ITINVENT
SQL_SERVER_USERNAME=your_sql_username
SQL_SERVER_PASSWORD=your_sql_password
AVAILABLE_DATABASES=ITINVENT,MSK-ITINVENT,OBJ-ITINVENT,SPB-ITINVENT
# ITINVENT VARCHAR/CHAR are usually Windows-1251; NVARCHAR/NCHAR need UTF-16-LE (not UTF-8).
SQL_CHAR_ENCODING=cp1251
SQL_WCHAR_ENCODING=utf-16-le

# Unified internal PostgreSQL for app-owned runtime data
# Required when APP_ENV=production. JSON runtime storage does not fall back
# to legacy SQLite in production; migrate it with scripts/migrate_json_store_sqlite_to_postgres.py.
# Example: postgresql+psycopg://postgres:postgres@localhost:5432/itinvent
APP_DATABASE_URL=
APP_DB_POOL_SIZE=40
APP_DB_MAX_OVERFLOW=40
# Dedicated threads for mail bootstrap/list (isolated from hub/chat to_thread stampede)
MAIL_WORKER_THREADS=16
APP_DB_APPLICATION_NAME=itinvent-backend
# Dual chat DB pools (same URL). Overflow is burst-only, not steady capacity.
CHAT_DB_WRITE_POOL_SIZE=8
CHAT_DB_WRITE_MAX_OVERFLOW=2
CHAT_DB_READ_POOL_SIZE=12
CHAT_DB_READ_MAX_OVERFLOW=4
CHAT_DB_CONNECTION_BUDGET=40
CHAT_DB_CONNECTION_BUDGET_FAIL_START=0
CHAT_PROCESS_COUNT=1
CHAT_SEND_DB_RESERVED=4
CHAT_MARK_READ_DB_SLOTS=2
CHAT_MARK_READ_PUBLISH_CONCURRENCY=2
CHAT_AUX_WRITE_DB_SLOTS=2
CHAT_READ_CONCURRENCY=16
CHAT_READ_ACQUIRE_TIMEOUT_MS=200
CHAT_READ_STATEMENT_TIMEOUT_MS=5000
# Legacy aliases (map to write pool if dual vars unset)
CHAT_DB_POOL_SIZE=8
CHAT_DB_MAX_OVERFLOW=2
CHAT_DB_APPLICATION_NAME=itinvent-backend-chat-write
CHAT_DB_READ_APPLICATION_NAME=itinvent-backend-chat-read
APP_DB_ECHO=0
REQUEST_METRICS_ENABLED=1
# Allow unauthenticated GET/POST /api/v1/system/request-metrics/local from 127.0.0.1 only
REQUEST_METRICS_LOCALHOST_OPEN=1
REQUEST_METRICS_SLOW_MS=1000
REQUEST_METRICS_MAX_ROUTES=300
REQUEST_METRICS_SAMPLE_SIZE=512
SQL_SLOW_LOG_MS=250
# Set to 1 to skip auto-update of documentation/technical/POSTGRES_APP_SCHEMA*.md after Alembic / dev PG init
SKIP_PG_SCHEMA_DOCS=0

# Public share links for "My files" (/api/v1/my-files/public/*) — per-token and per-IP buckets
MY_FILES_PUBLIC_META_LIMIT_PER_TOKEN=60
MY_FILES_PUBLIC_META_WINDOW_TOKEN_SEC=600
MY_FILES_PUBLIC_META_LIMIT_PER_IP=120
MY_FILES_PUBLIC_META_WINDOW_IP_SEC=60
MY_FILES_PUBLIC_DOWNLOAD_LIMIT_PER_TOKEN=15
MY_FILES_PUBLIC_DOWNLOAD_WINDOW_TOKEN_SEC=600
MY_FILES_PUBLIC_DOWNLOAD_LIMIT_PER_IP=80
MY_FILES_PUBLIC_DOWNLOAD_WINDOW_IP_SEC=3600
MY_FILES_PUBLIC_MISS_LIMIT_PER_IP=60
MY_FILES_PUBLIC_MISS_WINDOW_IP_SEC=60
# One-time owner download grants (native browser download, 2 min TTL by default)
MY_FILES_DOWNLOAD_GRANT_TTL_SEC=120
MY_FILES_DOWNLOAD_GRANT_MINT_LIMIT_PER_USER=40
MY_FILES_DOWNLOAD_GRANT_MINT_WINDOW_USER_SEC=60
MY_FILES_DOWNLOAD_GRANT_MINT_LIMIT_PER_IP=80
MY_FILES_DOWNLOAD_GRANT_MINT_WINDOW_IP_SEC=60
MY_FILES_DOWNLOAD_GRANT_CONSUME_LIMIT_PER_IP=120
MY_FILES_DOWNLOAD_GRANT_CONSUME_WINDOW_IP_SEC=60
MY_FILES_DOWNLOAD_GRANT_MISS_LIMIT_PER_IP=60
MY_FILES_DOWNLOAD_GRANT_MISS_WINDOW_IP_SEC=60
# Authenticated upload throttling and queue reservations. Internal requests are not exempt.
MY_FILES_UPLOAD_LIMIT_PER_USER=30
MY_FILES_UPLOAD_WINDOW_USER_SEC=600
MY_FILES_UPLOAD_LIMIT_PER_IP=100
MY_FILES_UPLOAD_WINDOW_IP_SEC=600
MY_FILES_MAX_UPLOADING_PER_USER=2
MY_FILES_MAX_UPLOADING_GLOBAL=8
MY_FILES_MAX_ACTIVE_JOBS_PER_USER=5
MY_FILES_MAX_ACTIVE_JOBS_GLOBAL=100
MY_FILES_MAX_PROCESSING_GLOBAL=1
MY_FILES_UPLOAD_RESERVATION_TTL_SEC=7200
MY_FILES_PROCESSING_TIMEOUT_SEC=21600
# Production runs this worker separately under PM2.
MY_FILES_INLINE_WORKER_ENABLED=0
MY_FILES_ZSTD_THREADS=2
# Microsoft Defender custom scan. Production defaults to enabled and fail-closed.
MY_FILES_ANTIVIRUS_ENABLED=1
MY_FILES_ANTIVIRUS_FAIL_CLOSED=1
MY_FILES_ANTIVIRUS_TIMEOUT_SEC=300
MY_FILES_DEFENDER_PATH=
# Separate encryption key for stable public share links. Do not reuse other keys.
MY_FILES_SHARE_TOKEN_KEY=change_me_to_secure_random_value

# Enable corporate chat HTTP API, websocket and runtime
CHAT_MODULE_ENABLED=0
VITE_CHAT_ENABLED=0
VITE_CHAT_WS_ENABLED=0
# Task comments -> corporate chat (requires CHAT_MODULE_ENABLED=1)
TASK_DISCUSSION_CHAT_ENABLED=0
VITE_TASK_DISCUSSION_CHAT_ENABLED=0
# Optional chat-specific override; if empty, chat can fall back to APP_DATABASE_URL
CHAT_DATABASE_URL=
# Ordinary chat → hub_notifications (Variant A hybrid). Split write vs read for safe rollback:
#   deploy:        WRITE=true  READ=true   (full legacy)
#   prod stage 1:  WRITE=true  READ=false  (hide ~695k legacy unread, keep writer)
#   prod stage 2:  WRITE=false READ=false  (cutover; ordinary_hub_rows_created=0)
#   rollback write: WRITE=true READ=false  (writer back without badge flood)
# Mentions always go to bell. Prefer env + controlled restart of all backend workers in prod.
CHAT_HUB_ORDINARY_WRITE_ENABLED=true
CHAT_HUB_ORDINARY_READ_VISIBLE=true
# Legacy combined flag (fallback if split flags unset). Prefer the two flags above.
# CHAT_HUB_ORDINARY_NOTIFICATIONS_ENABLED=true

# Additional Databases (опционально)
ITINVENT2_HOST=secondary_server_host
ITINVENT2_DATABASE=ITINVENT2

# Mail Office attachment preview (LibreOffice headless -> PDF)
MAIL_OFFICE_PREVIEW_ENABLED=1
MAIL_OFFICE_PREVIEW_MAX_BYTES=26214400
MAIL_OFFICE_PREVIEW_TIMEOUT_SEC=120
MAIL_OFFICE_PREVIEW_MAX_CONCURRENCY=2
# Shared durable preview worker: Chat, Hub tasks, mail, document flow and My Files.
PREVIEW_WORKER_CONCURRENCY=4
PREVIEW_MAX_ATTEMPTS=3
PREVIEW_LEASE_SEC=240
PREVIEW_POLL_INTERVAL_MS=500
# Empty = auto-detect (Windows: C:\Program Files\LibreOffice\program\soffice.exe)
LIBREOFFICE_SOFFICE_PATH=

# SMTP Configuration (legacy fallback; primary transport is Exchange EWS via hub-it@)
SMTP_SERVER=your_smtp_server
# Unified HUB-IT service mailbox for acts, task notifications and security alerts.
EMAIL_ADDRESS=hub-it@yourdomain.com
EMAIL_PASSWORD=
# Hub task email notifications and shared outgoing transport for web backend.
TASK_EMAIL_NOTIFICATIONS_ENABLED=0
TASK_EMAIL_FROM_EMAIL=hub-it@yourdomain.com
TASK_EMAIL_FROM_NAME=HUB-IT
TASK_EMAIL_APP_URL=https://hub-it.yourdomain.com
TASK_EMAIL_DEADLINE_SOON_HOURS=24
TASK_EMAIL_TRANSPORT=exchange
TASK_EMAIL_EWS_LOGIN=hub-it@yourdomain.com
TASK_EMAIL_EWS_PASSWORD=
TASK_EMAIL_DESCRIPTION_MAX_CHARS=300
TASK_EMAIL_SMTP_TIMEOUT_SECONDS=5
# Hub notifications retention worker (off + dry-run by default; unread never deleted unless ALLOW_UNREAD=1)
# PR3c defaults favour write-path safety: small batches, pause, daily interval. Do not enable in prod without safety gate.
HUB_NOTIFICATIONS_CLEANUP_ENABLED=false
HUB_NOTIFICATIONS_CLEANUP_DRY_RUN=true
HUB_NOTIFICATIONS_CLEANUP_BATCH_SIZE=50
HUB_NOTIFICATIONS_CLEANUP_MAX_BATCHES=40
HUB_NOTIFICATIONS_CLEANUP_MAX_RUNTIME_SECONDS=60
HUB_NOTIFICATIONS_CLEANUP_INTERVAL_SECONDS=86400
HUB_NOTIFICATIONS_CLEANUP_BATCH_PAUSE_MS=750
HUB_NOTIFICATIONS_CLEANUP_STARTUP_DELAY_SECONDS=120
HUB_NOTIFICATIONS_CLEANUP_HTTP_MAX_BATCH_SIZE=25
HUB_NOTIFICATIONS_CLEANUP_ALLOW_UNREAD=false
HUB_NOTIFICATIONS_RETENTION_CHAT_READ_DAYS=90
HUB_NOTIFICATIONS_RETENTION_TASK_READ_DAYS=180
HUB_NOTIFICATIONS_RETENTION_ANNOUNCEMENT_READ_DAYS=180
# Chat push outbox retention worker (off + dry-run by default). Never deletes queued/processing/pending.
# Enable execute only after Stage 0.5 restore gate + explicit ops approval.
CHAT_PUSH_OUTBOX_CLEANUP_ENABLED=false
CHAT_PUSH_OUTBOX_CLEANUP_DRY_RUN=true
CHAT_PUSH_OUTBOX_NO_SUBSCRIPTIONS_DAYS=7
CHAT_PUSH_OUTBOX_SUPPRESSED_DAYS=14
CHAT_PUSH_OUTBOX_SENT_DAYS=30
CHAT_PUSH_OUTBOX_FAILED_DAYS=30
# Failed retention attempts MUST match delivery worker CHAT_PUSH_OUTBOX_MAX_ATTEMPTS.
# Prefer leaving FAILED_MIN_ATTEMPTS unset (inherits MAX_ATTEMPTS). If set, must equal MAX_ATTEMPTS or config fail-closes.
CHAT_PUSH_OUTBOX_MAX_ATTEMPTS=8
# CHAT_PUSH_OUTBOX_FAILED_MIN_ATTEMPTS=8
CHAT_PUSH_OUTBOX_CLEANUP_BATCH_SIZE=200
CHAT_PUSH_OUTBOX_CLEANUP_BATCH_PAUSE_MS=500
CHAT_PUSH_OUTBOX_CLEANUP_MAX_BATCHES=100
CHAT_PUSH_OUTBOX_CLEANUP_MAX_RUNTIME_SECONDS=120
CHAT_PUSH_OUTBOX_CLEANUP_INTERVAL_SECONDS=3600
CHAT_PUSH_OUTBOX_CLEANUP_LOCK_TIMEOUT_MS=2000
CHAT_PUSH_OUTBOX_CLEANUP_STATEMENT_TIMEOUT_MS=15000
CHAT_PUSH_OUTBOX_CLEANUP_ERROR_BUDGET=3
CHAT_PUSH_OUTBOX_CLEANUP_STARTUP_DELAY_SECONDS=30
# Фоновый цикл напоминаний о сроках задач (in-app + email outbox), не в poll/unread-counts
TASK_DUE_NOTIFICATION_BACKGROUND_ENABLED=1
TASK_DUE_NOTIFICATION_INTERVAL_SECONDS=600
TASK_DUE_NOTIFICATION_STARTUP_DELAY_SECONDS=60
# Security email about new account login. Disabled by default.
AUTH_NEW_LOGIN_EMAIL_ENABLED=0

# Other Configuration
TRANSFER_TEMPLATE_PATH=templates/docx_transfer_act.docx
TRANSFER_ACTS_DIR=transfer_acts
MAX_TRANSFER_PHOTOS=10

# Scan Server / Scan Agent
SCAN_SERVER_HOST=127.0.0.1
SCAN_SERVER_PORT=8011
# PostgreSQL for Scan Center runtime (schema ``scan``). Empty = SQLite data/scan_server/scan_server.db
# Do not reuse APP_DATABASE_URL symbolically in code; same instance/DB is OK with a dedicated URL.
# SCAN_DATABASE_URL=postgresql+psycopg://hubit_scan:CHANGE_ME@127.0.0.1:5432/hubit_chat
# Backfill: python scripts/migrate_scan_sqlite_to_postgres.py --source-db-path data/scan_server/scan_server.db --truncate
# MSI for Scan Center "Обновить агент" (self_update). Prefer local path so agents download via API.
# SCAN_AGENT_PACKAGE_PATH=C:\Project\Image_scan\dist\HUB-IT Agent-1.4.11-win64.msi
# Optional: UNC/HTTPS instead of (or with) local path. SHA256 required if there is no local file.
# SCAN_AGENT_PACKAGE_URL=\\fileserver\itinvent\HUB-IT Agent-1.4.9-win64.msi
# SCAN_AGENT_PACKAGE_SHA256=
# Rare software inventory report from inventory agent (hours; 0 = disable):
# ITINV_SOFTWARE_INVENTORY_INTERVAL_HOURS=168
SCAN_SERVER_WATCHDOG_ENABLED=1
SCAN_SERVER_WATCHDOG_INTERVAL_SEC=30
SCAN_SERVER_WATCHDOG_TIMEOUT_SEC=3
SCAN_SERVER_WATCHDOG_FAILURES=3
SCAN_SERVER_WATCHDOG_STARTUP_GRACE_SEC=20
SCAN_SERVER_API_KEYS=
# Fail-closed: expose X-Scan-* timing response headers only when true/1/yes/on (invalid → false).
SCAN_PERF_TIMING_HEADERS_ENABLED=false
# Store lock mode: rlock (default, production) | null (experimental stub, fail-closed off).
# Do not set null in production without S1/S2 metrics and race-safety work.
# SCAN_STORE_LOCK_MODE=rlock
# SCAN_JOB_COUNTS_CACHE_TTL_SEC=3
# SCAN_RECONCILE_DEBOUNCE_SEC=1.5
# SCAN_RECONCILE_EVERY_N_JOBS=25
# SCAN_TOUCH_THROTTLE_SEC=30
SCAN_WEB_AUTH_ME_URL=http://127.0.0.1:8001/api/v1/auth/me
SCAN_WEB_AUTH_TIMEOUT_SEC=5
SCAN_WEB_AUTH_CACHE_TTL_SEC=5
# Legacy single-key fallback (transition only):
SCAN_SERVER_API_KEY=
SCAN_RETENTION_DAYS=90
# Sample interval for scan_task_system_metrics writer (seconds; accepted 10-300, else 30).
SCAN_SYSTEM_METRICS_SAMPLE_INTERVAL_SECONDS=30
# Dedicated Scan system-metrics retention 24h (table scan.scan_task_system_metrics only).
# If both HOURS and DAYS set, HOURS wins.
# Independent of SCAN_RETENTION_DAYS (incidents/jobs/tasks). Defaults fail-closed.
SCAN_SYSTEM_METRICS_RETENTION_ENABLED=false
SCAN_SYSTEM_METRICS_RETENTION_DRY_RUN=true
SCAN_SYSTEM_METRICS_RETENTION_HOURS=24
SCAN_SYSTEM_METRICS_RETENTION_DAYS=3
SCAN_SYSTEM_METRICS_RETENTION_BATCH_SIZE=5000
SCAN_SYSTEM_METRICS_RETENTION_PAUSE_MS=500
SCAN_SYSTEM_METRICS_RETENTION_INTERVAL_SECONDS=3600
SCAN_SYSTEM_METRICS_RETENTION_MAX_RUNTIME_SECONDS=300
SCAN_TASK_TTL_DAYS=7
SCAN_TASK_ACK_TIMEOUT_SEC=300
SCAN_OCR_LANG=rus
SCAN_OCR_DPI=250
SCAN_OCR_FOCUSED_DPI=300
# A3 stays at 300 DPI; larger drawings get bounded full-page OCR plus direct high-detail header/footer regions.
SCAN_OCR_FULL_PAGE_MAX_PIXELS=20000000
SCAN_OCR_FOCUSED_REGION_MAX_PIXELS=12000000
SCAN_PDF_MAX_BYTES=52428800
SCAN_LIBREOFFICE_CMD=C:\Program Files\LibreOffice\program\soffice.exe
SCAN_OFFICE_CONVERT_TIMEOUT_SEC=180
SCAN_INGEST_MAX_PENDING_PDF_JOBS=4000
SCAN_INGEST_MAX_PENDING_JOBS=4000
SCAN_JOB_MAX_WORKERS=6
SCAN_OCR_MAX_PROCESSES=6

