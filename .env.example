MAIL_QUOTA_SNAPSHOT_RETENTION_DAYS=90
MAIL_QUOTA_MAX_UPLOAD_MB=25
# When Exchange reports unlimited mailbox quota, treat as this limit (GB) for % and alerts
MAIL_QUOTA_DEFAULT_GB=5
# Keep TLS verification enabled. Use MAIL_TLS_CA_BUNDLE for an internal Exchange CA.
MAIL_VERIFY_TLS=1
MAIL_TLS_CA_BUNDLE=
MAIL_CACHE_TTL_SEC=90
# Full message bodies stay process-local and bounded; attachments are not included.
MAIL_DETAIL_CACHE_TTL_SEC=600
MAIL_BOOTSTRAP_DEFAULT_LIMIT=20
MAIL_IT_RECIPIENTS=it@zsgp.ru
MAIL_LOG_RETENTION_DAYS=90
MAIL_SEARCH_WINDOW_LIMIT=1000
MAIL_MAX_FILES=10
MAIL_MAX_FILE_SIZE_MB=15
MAIL_MAX_TOTAL_SIZE_MB=25
# Either a Fernet key or any passphrase (will be derived with SHA-256)
MAIL_CREDENTIALS_KEY=change_me_to_secure_random_value
# Separate key for the password vault. Do not reuse MAIL_CREDENTIALS_KEY.
PASSWORD_VAULT_KEY=change_me_to_secure_random_value
# Optional previous vault key after PASSWORD_VAULT_KEY rotation (scripts/password_vault_decrypt_audit.py).
PASSWORD_VAULT_KEY_LEGACY=

# Frontend build flag (rebuild frontend after change)
VITE_MAIL_MODULE_ENABLED=0
VITE_API_URL=/api
# Canonical public browser host. This value is embedded during the frontend build.
VITE_CANONICAL_HOST=hubit.zsgp.ru
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8001
VITE_BASE_PATH=/

# WEB backend
APP_ENV=development
# Disable development create_all/maintenance DDL on a long-lived server that
# cannot yet switch APP_ENV to production. Alembic migrations remain enabled.
APP_SCHEMA_DEV_AUTO_CREATE=1
BACKEND_PORT=8001
DEBUG=false
# Temporary mobile UX debug relay: POST /api/v1/debug/client-log -> WEB-itinvent/debug-{SESSION}.log
DEBUG_CLIENT_LOG_ENABLED=0
DEBUG_CLIENT_LOG_SESSION=891634
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_EXPIRE_MINUTES=480
# Generate strong random values for production, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_SECRET_KEYS=
AUTH_COOKIE_NAME=itinvent_access_token
AUTH_REFRESH_COOKIE_NAME=itinvent_refresh_token
# Keep true in production. For local HTTP-only development you may explicitly set false.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Strict
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# Auth runtime state uses APP_DATABASE_URL on Windows Server. Leave Redis empty unless chat realtime explicitly needs it.
REDIS_URL=
REDIS_PASSWORD=
CHAT_REDIS_CHANNEL=itinvent:chat:events
CHAT_REALTIME_NODE_ID=
# Keep 0 for a single node. Dual-node mode must set this to 1 and pass readiness only with Redis Pub/Sub.
CHAT_REDIS_REQUIRED=0
CHAT_REDIS_RECONNECT_BASE_SEC=0.5
CHAT_REDIS_RECONNECT_MAX_SEC=30
CHAT_REDIS_RECONNECT_JITTER_RATIO=0.5
CHAT_PRESENCE_PREFIX=itinvent:chat:presence:user
CHAT_PRESENCE_TTL_SEC=75
CHAT_PRESENCE_WATCH_LIMIT=50
CHAT_WS_OUTBOUND_QUEUE_SIZE=256
CHAT_WS_SEND_TIMEOUT_SEC=5
# Coalesce presence / conversation.updated / unread.summary (not chat messages/ACK).
CHAT_WS_EVENT_COALESCE=1
# Defer+debounce presence publish off WS connect hot path (ms).
CHAT_PRESENCE_DEFER_CONNECT=1
CHAT_PRESENCE_DEBOUNCE_MS=300
CHAT_PRESENCE_PUBLISH_CONCURRENCY=4
# Chat process logging: QueueHandler (non-blocking). Set 0 to disable uvicorn access log for lag A/B.
CHAT_LOG_QUEUE_SIZE=5000
CHAT_ROUTE_LOG_SLOW_MS=200
CHAT_SLOW_LOG_RATE_LIMIT_SEC=5
CHAT_UVICORN_ACCESS_LOG=1
CHAT_TYPING_STARTED_THROTTLE_SEC=2
CHAT_TYPING_STATE_TTL_SEC=5
AUTH_2FA_ENFORCED=1
AUTH_2FA_POLICY=external_only
AUTH_2FA_INTERNAL_CIDRS=10.0.0.0/8
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Best-effort GeoIP for login VPN hint when client is outside Russia (headers preferred).
AUTH_GEOIP_LOOKUP_ENABLED=1
TOTP_ISSUER=HUB-IT
# Display name in otpauth path (authenticator apps). Apple Passwords issuer domain comes from WEBAUTHN_RP_ID.
AUTH_2FA_CHALLENGE_TTL_SEC=300
AUTH_BACKUP_CODES_COUNT=10
WEBAUTHN_RP_ID=hubit.zsgp.ru
WEBAUTHN_RP_NAME=HUB-IT
WEBAUTHN_ORIGIN=https://hubit.zsgp.ru
# Passkey only for external network by default. Set 1 only if passkey must work on corp 10.x Wi-Fi.
AUTH_PASSKEY_ALLOW_INTERNAL=0
AUTH_TRUSTED_DEVICE_TTL_DAYS=90
# Email alert on each successful login. Keep 0 unless security team explicitly needs it.
AUTH_NEW_LOGIN_EMAIL_ENABLED=0
RATE_LIMIT_STORAGE_URL=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_IDLE_TIMEOUT_TRUSTED_DAYS=7
# Idle for sessions created from internal network (AUTH_2FA_INTERNAL_CIDRS), without passkey.
# Clamped to minimum 7 days in config loader. Must never fall back to 30 minutes for internal.
SESSION_IDLE_TIMEOUT_INTERNAL_DAYS=7
# Parallel /auth/refresh race: reuse newly issued pair for this many seconds.
REFRESH_ROTATION_GRACE_SECONDS=15
SESSION_HISTORY_RETENTION_DAYS=14
SESSION_CLEANUP_MIN_INTERVAL_SECONDS=300
LDAP_SYNC_USER=your_user@domain.local
LDAP_SYNC_PASSWORD=your_password
LDAP_SYNC_INTERVAL_SECONDS=86400
LDAP_APP_USER_SYNC_ENABLED=1
LDAP_APP_USER_SYNC_INTERVAL_SECONDS=86400
LDAP_APP_USER_IMPORT_PERSON_ONLY=1

# Address book — sync employee contacts from 1C ZUP (V83.COMConnector, Windows only)
# Used by /address-book page and POST /api/v1/address-book/sync
ADDRESS_BOOK_SYNC_ENABLED=0
# Comma-separated 1C cluster servers (default matches corporate ZUP cluster)
ADDRESS_BOOK_1C_SERVER=tmn-srv-1c-01.zsgp.corp,tmn-srv-1c-02.zsgp.corp
# 1C infobase name (publication ref)
ADDRESS_BOOK_1C_REF=zar31
ADDRESS_BOOK_1C_USER=your_1c_username
ADDRESS_BOOK_1C_PASSWORD=your_1c_password
# Background sync interval in seconds (min 300, default 14400 = 4h)
ADDRESS_BOOK_SYNC_INTERVAL_SECONDS=14400

# Warehouse 1C — live Остатки/Ведомость с деньгами from 1C Бухгалтерия 2.0 (buh20)
# via V83.COMConnector (Windows only). Used by /warehouse-1c page.
# Comma-separated 1C cluster servers (default matches corporate buh20 cluster)
BUH20_1C_SERVER=tmn-srv-1c-01.zsgp.corp,tmn-srv-1c-02.zsgp.corp
# 1C infobase name (publication ref)
BUH20_1C_REF=buh20
BUH20_1C_USER=your_1c_username
BUH20_1C_PASSWORD=your_1c_password
# Background sync of Номенклатура/Склады directories into a local cache, so
# autocomplete filters in memory instead of hitting 1C on every keystroke.
# Live Остатки/Ведомость queries are never cached and always hit 1C directly.
WAREHOUSE_1C_CATALOG_SYNC_ENABLED=1
# Background sync interval in seconds (min 300, default 3600 = 1h)
WAREHOUSE_1C_CATALOG_SYNC_INTERVAL_SECONDS=3600
# Mark the catalogue stale after this many seconds; stale/error data must not
# be interpreted as a zero 1C balance.
WAREHOUSE_1C_CATALOG_STALE_SECONDS=7200
# Where the read-only 1C directory snapshot is served from: auto uses the
# indexed app database when APP_DATABASE_URL is configured; set 0 only for a
# controlled rollback to the legacy JSON cache.
WAREHOUSE_1C_CATALOG_APP_STORAGE=auto
# --- 1C compact (D-lite) search — ALL fail-closed / production-safe defaults ---
# Engine: tokens (current) | compact (derived documents). Invalid values → tokens.
# Do NOT set compact on production without an approved canary cutover.
WAREHOUSE_1C_CATALOG_SEARCH_ENGINE=tokens
# Deterministic canary % (0–100). Default 0 = disabled. Requires opaque routing_user_key.
# Rollback: set back to 0. Compact still requires index_state=ready.
WAREHOUSE_1C_CATALOG_SEARCH_CANARY_PERCENT=0
# Optional comma-separated opaque routing keys always selected for compact (admin allowlist).
WAREHOUSE_1C_CATALOG_SEARCH_CANARY_ALLOWLIST=
# Shadow-read compact in parallel; user still gets tokens. Keep 0 in production.
WAREHOUSE_1C_CATALOG_SEARCH_SHADOW=0
WAREHOUSE_1C_CATALOG_SHADOW_SAMPLE_RATE=0
WAREHOUSE_1C_CATALOG_SHADOW_TIMEOUT_MS=150
# Dual-write compact documents/token_stats while still writing old token rows.
WAREHOUSE_1C_CATALOG_WRITE_COMPACT=0
# Incremental compact dual-write thresholds (fail-closed → stale + versioned recovery).
# Ordinary hourly patches stay incremental; mass changes escalate. Keep defaults.
WAREHOUSE_1C_CATALOG_COMPACT_INCREMENTAL_MAX_CHANGED_ROWS=50000
WAREHOUSE_1C_CATALOG_COMPACT_INCREMENTAL_MAX_CHANGED_PERCENT=5
# Percent threshold ignored when incoming_count < this (small catalogs / fixtures).
WAREHOUSE_1C_CATALOG_COMPACT_INCREMENTAL_PERCENT_MIN_BASE=10000
# token_stats after incremental patch: delta (prefer) | scope (full stats rebuild).
WAREHOUSE_1C_CATALOG_COMPACT_TOKEN_STATS_MODE=delta
# Deferred previous index_version cleanup (fail-closed). Incremental patches only
# schedule cleanup; this service batch-deletes after grace. Keep ENABLED=0 and
# DRY_RUN=1 until a separately approved ops window. PG DELETE does not shrink GIN
# files — REINDEX INDEX CONCURRENTLY is a separate approved step.
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_ENABLED=0
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_DRY_RUN=1
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_BATCH=2000
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_MAX_BATCHES=50
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_MAX_RUNTIME_SECONDS=60
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_PAUSE_MS=50
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_STATEMENT_TIMEOUT_MS=30000
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_ERROR_BUDGET=5
WAREHOUSE_1C_CATALOG_COMPACT_PREVIOUS_CLEANUP_GRACE_SECONDS=3600
# Non-prod only: allow SQLAlchemy create_all to create compact tables for fixtures.
# Production never uses create_all (Alembic 0080/0081/0082 adoption). Keep 0 to
# refuse surprise compact DDL via startup create_all.
WAREHOUSE_1C_CATALOG_COMPACT_ALLOW_CREATE_ALL=1
# One-shot backfill CLI only (not a permanent PM2 worker). Keep 0 in production.
WAREHOUSE_1C_CATALOG_COMPACT_BACKFILL_ENABLED=0
WAREHOUSE_1C_CATALOG_COMPACT_BACKFILL_BATCH=2000
WAREHOUSE_1C_CATALOG_COMPACT_BACKFILL_MAX_RUNTIME_SECONDS=0
WAREHOUSE_1C_CATALOG_COMPACT_BACKFILL_PAUSE_MS=0
WAREHOUSE_1C_CATALOG_COMPACT_BACKFILL_STATEMENT_TIMEOUT_MS=30000
WAREHOUSE_1C_CATALOG_COMPACT_BACKFILL_ERROR_BUDGET=20
WAREHOUSE_1C_CATALOG_COMPACT_MIN_FREE_DISK_BYTES=16106127360
# Typo fallback via token_stats candidates only (never full-entry fuzzy scan).
WAREHOUSE_1C_CATALOG_TYPO_FALLBACK_ENABLED=0
WAREHOUSE_1C_CATALOG_TYPO_TIMEOUT_MS=120
WAREHOUSE_1C_CATALOG_TYPO_MAX_CANDIDATES=5
WAREHOUSE_1C_CATALOG_TYPO_SIMILARITY_THRESHOLD=0.35
# Mid-token substring stage requires all query tokens >= this length (product: 3).
WAREHOUSE_1C_CATALOG_MIDTOKEN_MIN_LENGTH=3
WAREHOUSE_1C_CATALOG_MIDTOKEN_TIMEOUT_MS=80
# Enable only after the read-only child-process bridge is validated in the
# target Windows environment. When enabled, a timeout restarts the child and
# is returned as unknown/error; it never falls back to in-process COM.
WAREHOUSE_1C_PROCESS_BRIDGE_ENABLED=0
WAREHOUSE_1C_BRIDGE_QUEUE_LIMIT=16
WAREHOUSE_1C_BRIDGE_FAILURE_THRESHOLD=4
WAREHOUSE_1C_BRIDGE_COOLDOWN_SECONDS=60
WAREHOUSE_1C_BRIDGE_MAX_MESSAGE_BYTES=8388608
# Bounded download limit for 1C document attachments (bytes).
WAREHOUSE_1C_MAX_ATTACHED_FILE_BYTES=26214400
# Keep 0 during audit-only rollout.  Setting 1 enables a separately
# permission-checked, confirmed HUB-side reconcile write (registry links,
# owner mappings and legacy PART_NO projection). It never writes a document
# or balance to 1C.
WAREHOUSE_1C_RECONCILE_REGISTRY_WRITE_ENABLED=1
# Cross-DB 1C reconciliation is admin-only and fails closed unless every HUB
# database visible in scope=all is explicitly named here (comma-separated).
# Leave blank to disable scope=all entirely.
WAREHOUSE_1C_RECONCILE_ALLOWED_DB_IDS=

# 1C Document Management — personal user sessions for /docflow.
# Recommended for multi-host deployments: generate a dedicated Fernet key
# outside the repository; never reuse MAIL_CREDENTIALS_KEY. On Windows, an
# empty value safely falls back to DPAPI bound to the backend service account.
DOCFLOW_CREDENTIALS_KEY=
# Optional previous key during controlled rotation.
DOCFLOW_CREDENTIALS_KEY_LEGACY=
DOCFLOW_1C_REF=docflow
DOCFLOW_TRANSPORT=dmservice
# Use the FQDN covered by the corporate certificate. TLS verification is mandatory.
DOCFLOW_DM_SERVICE_URL=https://tmn-srv-1c-04.zsgp.corp/docflow/ws/DMService
DOCFLOW_DM_SERVICE_TLS_VERIFY=1
# Temporary read-only exception for an internal HTTP publication. Never enable
# insecure writes; remove this flag immediately after HTTPS is available.
DOCFLOW_DM_ALLOW_INSECURE_HTTP=0
DOCFLOW_DM_ALLOW_INSECURE_WRITES=0
# Optional path to a PEM bundle with the corporate issuing/root CA.
DOCFLOW_DM_SERVICE_CA_BUNDLE=
# On Windows, include the corporate ROOT/CA stores in the verified TLS context.
DOCFLOW_DM_USE_WINDOWS_CERT_STORE=1
DOCFLOW_DM_CONNECT_TIMEOUT_SECONDS=5
DOCFLOW_DM_READ_TIMEOUT_SECONDS=25
DOCFLOW_DM_WRITE_TIMEOUT_SECONDS=45
DOCFLOW_DM_FILE_TIMEOUT_SECONDS=90
DOCFLOW_DM_QUEUE_TIMEOUT_SECONDS=5
# Soft timeout for related documents/files when enriching a task card (fail-soft).
DOCFLOW_DM_RELATED_TIMEOUT_SECONDS=8
DOCFLOW_DM_MAX_CONCURRENCY=16
DOCFLOW_DM_QUEUE_LIMIT=64
DOCFLOW_DM_MAX_RESPONSE_BYTES=26214400
# File SOAP payloads are base64(~4/3) + XML; default is derived from DOCFLOW_MAX_FILE_BYTES.
# DOCFLOW_DM_MAX_FILE_RESPONSE_BYTES=72089600
DOCFLOW_MAX_FILE_BYTES=52428800
DOCFLOW_WEB_URL=https://tmn-srv-1c-04.zsgp.corp/docflow
# Temporary one-week rollback is explicit only: DOCFLOW_TRANSPORT=com. There is
# never an automatic fallback from DMService to COM.
# Mutating commands remain fail-closed unless the exact versioned rules match.
DOCFLOW_WRITE_ENABLED=0
DOCFLOW_WRITE_PILOT_USER_IDS=
DOCFLOW_WRITE_ALL_USERS=0
DOCFLOW_WRITE_TEST_ONLY=1
DOCFLOW_WRITE_TEST_TITLE_PREFIX=HUB-IT TEST
# Optional incident barrier. Set this to the next credential version after a
# password exposure; write commands remain blocked until the user re-saves it.
DOCFLOW_WRITE_CREDENTIAL_MIN_VERSION=0
DOCFLOW_ACTION_STATE_KEY=
# An explicit command-status check may classify a timed-out write as not
# applied only after this delay and only when the full 1C task state is unchanged.
DOCFLOW_ACTION_NOT_APPLIED_VERIFY_DELAY_SECONDS=5
# Empty JSON uses the reviewed, versioned resource shipped with the backend.
# Set DOCFLOW_ACTION_RULES_FILE only for an explicitly reviewed external file.
DOCFLOW_ACTION_RULES_FILE=
# Example shape: {"rules":[{"configuration":"docflow","task_type":"ЗадачаИсполнителя","process_type":"...","configuration_fingerprint":"...","actions":{"approve":{"label":"Согласовать","result_value":"Согласовано","comment_mode":"optional"}}}]}
DOCFLOW_ACTION_RULES_JSON=
# Create unlock (ops): HTTPS URL + TLS verify, then WRITE_ENABLED=1, CREATE_ENABLED=1,
# pilot IDs or CREATE_ALL_USERS=1, RBAC docflow.create, restart-backend.ps1, smoke script.
DOCFLOW_CREATE_ENABLED=0
DOCFLOW_CREATE_PILOT_USER_IDS=
DOCFLOW_CREATE_ALL_USERS=0
DOCFLOW_CREATE_TEST_ONLY=1
DOCFLOW_CREATE_TEST_TITLE_PREFIX=HUB-IT TEST

# Optional explicit DB config alias for ITINVENT
DB_ITINVENT_HOST=your_sql_server_host
DB_ITINVENT_DATABASE=ITINVENT
DB_ITINVENT_USERNAME=your_sql_username
DB_ITINVENT_PASSWORD=your_sql_password

# Branch databases (each needs all four DB_<ID>_* variables)
DB_MSK-ITINVENT_HOST=your_sql_server_host
DB_MSK-ITINVENT_DATABASE=MSK-ITINVENT
DB_MSK-ITINVENT_USERNAME=your_sql_username
DB_MSK-ITINVENT_PASSWORD=your_sql_password

DB_OBJ-ITINVENT_HOST=your_sql_server_host
DB_OBJ-ITINVENT_DATABASE=OBJ-ITINVENT
DB_OBJ-ITINVENT_USERNAME=your_sql_username
DB_OBJ-ITINVENT_PASSWORD=your_sql_password

DB_SPB-ITINVENT_HOST=your_sql_server_host
DB_SPB-ITINVENT_DATABASE=SPB-ITINVENT
DB_SPB-ITINVENT_USERNAME=your_sql_username
DB_SPB-ITINVENT_PASSWORD=your_sql_password

# Chat Web Push
# Generate: python scripts/generate_web_push_vapid_keys.py
WEB_PUSH_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_SUBJECT=mailto:it@zsgp.ru

# Native Android push through Firebase Cloud Messaging HTTP v1.
# Put either inline JSON or a path to a service-account JSON file.
FCM_PROJECT_ID=your_firebase_project_id
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
BACKEND_HOST=127.0.0.1
