<WixLocalization Culture="ru-ru" Language="1049" Codepage="1251" SummaryInformationCodepage="1251" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Установка [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Проверка обновлений" />
  <String Id="UpdateButton" Value="&amp;Обновить до версии [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Добро пожаловать" />
  <String Id="InstallMessage" Value="Программа установит [WixBundleName] на ваш компьютер. Нажмите «Установить», чтобы продолжить, или «Отмена», чтобы выйти." />
  <String Id="InstallMessageOptions" Value="Программа установит [WixBundleName] на ваш компьютер. Нажмите «Установить», чтобы продолжить, «Параметры» для настройки, или «Отмена», чтобы выйти." />
  <String Id="InstallVersion" Value="Версия [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Вы уверены, что хотите отменить установку?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Предыдущая версия" />
  <String Id="HelpHeader" Value="Справка по установке" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [каталог] — установка, восстановление, удаление или создание полной локальной копии пакета в каталоге. По умолчанию выполняется установка.&#xA;&#xA;/passive | /quiet — отображается минимальный интерфейс без запросов или нет интерфейса вовсе. По умолчанию отображается полный интерфейс.&#xA;&#xA;/norestart   — отменить любые попытки перезагрузки. По умолчанию будет запрос на перезагрузку.&#xA;/log log.txt — записывать журнал в указанный файл. По умолчанию журнал создается в %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Закрыть" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName] &lt;a href=&quot;#&quot;&gt;условия лицензии&lt;/a&gt;." />
