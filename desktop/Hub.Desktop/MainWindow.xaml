<Window x:Class="Hub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUB Desktop"
        Width="1360"
        Height="860"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Background="#F5F7FA">
        <Grid x:Name="BrowserHost" />

        <ProgressBar x:Name="LoadingIndicator"
                     Height="3"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="Collapsed" />

        <Border x:Name="ErrorOverlay"
                Background="#F5F7FA"
                Visibility="Collapsed">
            <StackPanel Width="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ErrorTitle"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="Не удалось открыть HUB"
                           TextAlignment="Center" />
                <TextBlock x:Name="ErrorDetails"
                           Margin="0,12,0,24"
                           FontSize="14"
                           Foreground="#52606D"
                           Text="Проверьте подключение к сети и повторите попытку."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Width="160"
                        Height="40"
                        HorizontalAlignment="Center"
                        Click="RetryButton_Click"
                        Content="Повторить" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
