<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Hub.Desktop.Native.Views">

    <!-- Стили нативного шелла в духе Windows 11 / Fluent (WinUI 3).
         Палитра (кисти Hub*Brush/цвета Hub*Color) вынесена в
         HubColorsDark.xaml / HubColorsLight.xaml: NativeThemeManager
         подменяет словарь палитры в Application.Resources, поэтому все
         ссылки на кисти здесь — DynamicResource. Без Application
         (STA-тесты, скриншоты) палитру дозаливает
         NativeThemeManager.EnsureFallbackPalette. -->

    <!-- Видимый фокус для клавиатурной навигации (2px периметр). -->
    <Style x:Key="HubFocusStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderBrush="{DynamicResource HubFocusBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопки заголовка окна (chrome). -->
    <Style x:Key="HubTitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubTitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource HubTitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E81123" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#A4262C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Основная кнопка действия. -->
    <Style x:Key="HubPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HubPrimaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Иконка-кнопка без рамки (обновить, выйти). -->
    <Style x:Key="HubGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource HubSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поля ввода: Win11-паттерн — заливка, тонкая граница, акцентная нижняя линия при фокусе. -->
    <Style x:Key="HubTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <Border x:Name="FocusLine"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource HubAccentBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <Border x:Name="FocusLine"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource HubAccentBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Фильтр-чип (ToggleButton): Все / Новые / В работе / ... -->
    <Style x:Key="HubChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource HubSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка задачи в списке. -->
    <Style x:Key="HubTaskCardStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface"
                            Background="{DynamicResource HubSurfaceBrush}"
                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HubTaskCardStyle}" />
    </Style>

    <!-- Пункт левой навигации шелла (Win11 NavigationView): акцент-пилл у левого
         края + подсветка (состояние читается не только цветом). -->
    <Style x:Key="HubNavItemStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Indicator"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-10,0,0,0"
                                    CornerRadius="1.5"
                                    Background="Transparent" />
                            <ContentPresenter Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource HubAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкий скроллбар. -->
    <Style x:Key="HubScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar"
                            Margin="1,1,2,1"
                            Background="{DynamicResource HubScrollThumbBrush}"
                            CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource HubScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource HubScrollThumbPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HubScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecBtn" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncBtn" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecBtn" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="IncBtn" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкий тёмный скроллбар для всех списков/панелей (в т.ч. внутри шаблонов ListBox). -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource HubScrollBarStyle}" />

    <Style x:Key="HubScrollViewerStyle" TargetType="ScrollViewer">
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource HubScrollBarStyle}" />
        </Style.Resources>
    </Style>

    <!-- Плашка статуса: текст + цвет (статус читается не только по цвету).
         Тон задаётся attached-свойством local:HubTone.Value (info|warning|
         review|success|danger|muted, константы HubStatusTone) на самой рамке —
         триггеры красят BorderBrush палитровой кистью; текст внутри берёт
         HubToneTextStyle и подхватывает тон по наследованию. -->
    <Style x:Key="HubStatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Тонированный текст: Foreground по local:HubTone.Value (ставится на сам
         TextBlock или наследуется от рамки-пилюли). Неизвестный/пустой тон —
         приглушённый, как раньше у молчаливых статусов. -->
    <Style x:Key="HubToneTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Тонированная акцентная полоса/плашка (Border.Background по тону). -->
    <Style x:Key="HubToneStripeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Background" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Background" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Background" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Background" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Тонированная точка состояния (Ellipse.Fill по тону). -->
    <Style x:Key="HubToneDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Fill" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Fill" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Fill" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Fill" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Fill" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Типографика. -->
    <Style x:Key="HubSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
    </Style>

    <Style x:Key="HubMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
