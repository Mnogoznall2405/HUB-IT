        <Setter Property="ItemContainerStyle" Value="{StaticResource HubTaskCardStyle}" />
    </Style>

    <!-- ═══ Строки почтового шелла (страница «Почта»): плоская строка дерева папок
         и карточка письма. Живут в теме, а не в разметке страницы: это состояние
         контейнеров (hover/selected/unread/collapse), общее для всего дизайна. ═══ -->

    <!-- Строка папки — как в дереве папок Thunderbird (tree-listbox.css /
         about3Pane.css): плоская полновысокая строка без скруглений, hover — серая
         заливка (gray-20/gray-60), выбранная — нейтральный gray-30/gray-70, а не
         акцентный тинт; свёрнутая ветка дерева не занимает место в списке. -->
    <Style x:Key="MailFolderItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,3,8,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubRowSelectedNeutralBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Свёрнутая ветка дерева не занимает место в рейке. -->
            <DataTrigger Binding="{Binding IsTreeVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Карточка письма — анатомия thread-card Thunderbird: радиус 3px
         (listbox-border-radius), тонкая рамка, непрочитанное — заливка
         surface-raised и полужирный текст, выбранное — акцентный тинт
         с акцентной рамкой (selected-item 15-20% + border 30%). -->
    <Style x:Key="MailMessageItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface"
                            Background="{DynamicResource HubSurfaceBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Порядок = приоритет, hover ≠ выбрано: наведение — нейтральная
                             рамка и мягкий тон (не акцент!), выбранное — акцент. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт левой навигации шелла (Win11 NavigationView): акцент-пилл у левого
         края + акцентный тинт выбранного + hover-слой (состояние читается
         не только цветом: пилюля и вес шрифта). -->
    <Style x:Key="HubNavItemStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Indicator"
                                    Width="3"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-12,0,0,0"
                                    CornerRadius="1.5"
                                    Background="Transparent" />
                            <ContentPresenter Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource HubAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт компактной рейки (свернутое меню): центрированная иконка 48×40,
         выбранный — акцентный тинт + пилюля; подпись живёт в ToolTip. -->
    <Style x:Key="HubNavRailItemStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Indicator"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-2,0,0,0"
                                    CornerRadius="1.5"
                                    Background="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource HubAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкий скроллбар. -->
    <Style x:Key="HubScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar"
                            Background="{DynamicResource HubScrollThumbBrush}"
                            CornerRadius="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource HubScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource HubScrollThumbPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HubScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecBtn" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncBtn" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecBtn" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="IncBtn" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкий тёмный скроллбар для всех списков/панелей (в т.ч. внутри шаблонов ListBox). -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource HubScrollBarStyle}" />

    <Style x:Key="HubScrollViewerStyle" TargetType="ScrollViewer">
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource HubScrollBarStyle}" />
        </Style.Resources>
    </Style>

    <!-- Overlay-скроллбар как в Telegram Desktop: тонкий слой поверх контента,
         не съедает ширину раскладки и виден всегда, когда контент прокручивается. -->
    <Style x:Key="HubOverlayScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Panel.ZIndex="2"
                                   Height="2"
                                   Opacity="0"
                                   Orientation="Horizontal"
                                   AutomationProperties.Name="Горизонтальная прокрутка"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Panel.ZIndex="2"
                                   Width="2"
                                   Opacity="0"
                                   AutomationProperties.Name="Вертикальная прокрутка"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Дефолт для всех ScrollViewer приложения — Telegram-подобный оверлей:
         постоянных полос прокрутки нет нигде, ползунок проявляется при наведении. -->
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource HubOverlayScrollViewerStyle}" />

    <!-- Плашка статуса: текст + цвет (статус читается не только по цвету).
         Тон задаётся attached-свойством local:HubTone.Value (info|warning|
         review|success|danger|muted, константы HubStatusTone) на самой рамке —
         триггеры красят BorderBrush палитровой кистью; текст внутри берёт
         HubToneTextStyle и подхватывает тон по наследованию. -->
    <Style x:Key="HubStatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource HubStatusMutedSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Background" Value="{DynamicResource HubStatusNewSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{DynamicResource HubStatusInProgressSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Background" Value="{DynamicResource HubStatusReviewSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Background" Value="{DynamicResource HubStatusDoneSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Background" Value="{DynamicResource HubStatusOverdueSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Тонированный текст: Foreground по local:HubTone.Value (ставится на сам
         TextBlock или наследуется от рамки-пилюли). Неизвестный/пустой тон —
         приглушённый, как раньше у молчаливых статусов. -->
    <Style x:Key="HubToneTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Foreground" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Тонированная акцентная полоса/плашка (Border.Background по тону). -->
    <Style x:Key="HubToneStripeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Background" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Background" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Background" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Background" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Тонированная точка состояния (Ellipse.Fill по тону). -->
    <Style x:Key="HubToneDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Fill" Value="{DynamicResource HubStatusNewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Fill" Value="{DynamicResource HubStatusInProgressBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Fill" Value="{DynamicResource HubStatusReviewBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Fill" Value="{DynamicResource HubStatusDoneBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Fill" Value="{DynamicResource HubStatusOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Мягкая тонированная заливка по HubTone.Value — фон чипов/бейджей
         и KPI-индикаторов (пара обычным HubStatus*Brush для текста/глифов). -->
    <Style x:Key="HubToneSoftFillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HubStatusMutedSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="info">
                <Setter Property="Background" Value="{DynamicResource HubStatusNewSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="warning">
                <Setter Property="Background" Value="{DynamicResource HubStatusInProgressSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="review">
                <Setter Property="Background" Value="{DynamicResource HubStatusReviewSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="success">
                <Setter Property="Background" Value="{DynamicResource HubStatusDoneSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(local:HubTone.Value), RelativeSource={RelativeSource Self}}" Value="danger">
                <Setter Property="Background" Value="{DynamicResource HubStatusOverdueSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Fluent-флайауты: контекстные меню, пункты, разделители, тултипы.
         Раньше они рендерились дефолтным светлым Aero-хромом и в тёмной
         теме выглядели чужеродно. Popup'ы с AllowsTransparency получают
         HubFlyoutShadow; ContextMenu дополнительно просит системную тень. ═══ -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource HubFlyoutSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource HubFlyoutShadow}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckGlyph"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="✓"
                                       Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="9"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="&#xE76C;"
                                       Visibility="Collapsed" />
                            <Popup x:Name="SubmenuPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   HorizontalOffset="-2"
                                   VerticalOffset="-4"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource HubFlyoutSurfaceBrush}"
                                        BorderBrush="{DynamicResource HubBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        Effect="{StaticResource HubFlyoutShadow}"
                                        SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                            <Setter TargetName="Surface" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="6,4"
                            Background="{DynamicResource HubBorderDimBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource HubFlyoutSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Прогресс-бар: тонкий Fluent-трек + акцентная заливка с закруглёнными
         концами; indeterminate — бегущая 30%-я полоса через анимацию
         смещений градиентной маски (Offset-анимации не требуют биндингов,
         поэтому Storyboard свободно замораживается в шаблоне; цвет берёт
         Foreground — кастомные цвета полос у вью продолжают работать). -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="99"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border CornerRadius="99"
                                        Background="{TemplateBinding Foreground}"
                                        SnapsToDevicePixels="True" />
                            </Decorator>
                            <Border x:Name="Runner"
                                    Background="{TemplateBinding Foreground}"
                                    Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="MarqueeLead" Color="Transparent" Offset="-0.30" />
                                        <GradientStop x:Name="MarqueeMid" Color="#FF000000" Offset="-0.15" />
                                        <GradientStop x:Name="MarqueeTail" Color="Transparent" Offset="0.00" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MarqueeLead"
                                                         Storyboard.TargetProperty="Offset"
                                                         From="-0.30" To="1.00" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="MarqueeMid"
                                                         Storyboard.TargetProperty="Offset"
                                                         From="-0.15" To="1.15" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="MarqueeTail"
                                                         Storyboard.TargetProperty="Offset"
                                                         From="0.00" To="1.30" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Типографика. -->
    <Style x:Key="HubSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
    </Style>

    <Style x:Key="HubMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
