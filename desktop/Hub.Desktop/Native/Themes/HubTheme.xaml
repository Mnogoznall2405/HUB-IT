<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Hub.Desktop.Native.Views">

    <!-- Стили нативного шелла в духе Windows 11 / Fluent (WinUI 3).
         Палитра (кисти Hub*Brush/цвета Hub*Color) вынесена в
         HubColorsDark.xaml / HubColorsLight.xaml: NativeThemeManager
         подменяет словарь палитры в Application.Resources, поэтому все
         ссылки на кисти здесь — DynamicResource. Без Application
         (STA-тесты, скриншоты) палитру дозаливает
         NativeThemeManager.EnsureFallbackPalette. -->

    <!-- Видимый фокус для клавиатурной навигации (2px периметр). -->
    <Style x:Key="HubFocusStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderBrush="{DynamicResource HubFocusBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Мягкая тень флайаутов (меню, попапы, диалоги, панели-оверлеи) —
         одна на приложение: замороженный Effect безопасно делить между
         несколькими поверхностями. НЕ вешать на элементы списков —
         только разовые overlay-слои. -->
    <DropShadowEffect x:Key="HubFlyoutShadow"
                      BlurRadius="24"
                      ShadowDepth="1"
                      Opacity="0.3"
                      Color="#000000" />

    <!-- Кнопки заголовка окна (chrome). -->
    <Style x:Key="HubTitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubTitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource HubTitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E81123" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#A4262C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Основная кнопка действия. -->
    <Style x:Key="HubPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Тонкая светлая кромка по периметру акцентной заливки —
                         Fluent-«rim», кнопка перестаёт быть плоским прямоугольником. -->
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource HubAccentHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubAccentPressedBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HubPrimaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Иконка-кнопка без рамки (обновить, выйти). -->
    <Style x:Key="HubGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource HubSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Чекбокс с явным шаблоном: Aero-дефолт на тёмной теме почти не виден
         (рамка тоне в фоне, галочка теряется). Тонкая рамка secondary, при
         checked — акцентная заливка с контрастной галочкой; hover подсвечивает
         рамку. ContentPresenter сохраняет подписи полей форм. -->
    <Style x:Key="HubCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="{DynamicResource HubTextSecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Path x:Name="Check"
                                  Data="M 3.4,8.0 L 6.6,11.2 L 12.4,4.4"
                                  Stroke="{DynamicResource HubOnAccentBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource HubAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HubTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поля ввода: Win11-паттерн — заливка, тонкая граница, акцентная нижняя линия при фокусе. -->
    <Style x:Key="HubTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <Border x:Name="FocusLine"
                                Height="2"
                                Margin="2,0"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource HubAccentBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <Border x:Name="FocusLine"
                                Height="2"
                                Margin="2,0"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource HubAccentBrush}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Поля выбора и даты: неявные стили ComboBox / DatePicker / Calendar.
         Без них контролы рендерятся дефолтным Aero и остаются белыми в тёмной
         теме. Внешний вид повторяет HubTextBoxStyle: заливка HubSurfaceAlt,
         1px HubBorder, радиус 4, акцентная нижняя линия при фокусе/попапе. ═══ -->

    <!-- Прозрачная кликабельная плоскость ComboBox (ToggleButton). -->
    <Style x:Key="HubComboBoxToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Шеврон выпадающего списка (Segoe MDL2 — как глифы хрома окна). -->
    <Style x:Key="HubChevronDownStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Text" Value="&#xE70D;" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <!-- Редактируемое поле внутри ComboBox IsEditable: прозрачный chrome,
         рамку рисует сам шаблон комбобокса. -->
    <Style x:Key="HubComboBoxTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource HubAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="HubComboBoxTemplate" TargetType="ComboBox">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Surface"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" />
            <Border x:Name="FocusLine"
                    Grid.ColumnSpan="2"
                    Height="2"
                    Margin="4,0"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource HubAccentBrush}"
                    CornerRadius="1"
                    Visibility="Collapsed" />
            <ContentPresenter x:Name="ContentSite"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              Margin="{TemplateBinding Padding}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsHitTestVisible="False" />
            <ToggleButton x:Name="ToggleButton"
                          Grid.ColumnSpan="2"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource HubComboBoxToggleStyle}" />
            <TextBlock x:Name="Chevron"
                       Grid.Column="1"
                       Style="{StaticResource HubChevronDownStyle}" />
            <Popup x:Name="PART_Popup"
                   MinWidth="{TemplateBinding ActualWidth}"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Slide"
                   VerticalOffset="1">
                <Border x:Name="DropDownBorder"
                        Padding="4"
                        Background="{DynamicResource HubFlyoutSurfaceBrush}"
                        BorderBrush="{DynamicResource HubBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource HubFlyoutShadow}"
                        SnapsToDevicePixels="True">
                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  SnapsToDevicePixels="True"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="HubEditableComboBoxTemplate" TargetType="ComboBox">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Surface"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" />
            <Border x:Name="FocusLine"
                    Grid.ColumnSpan="2"
                    Height="2"
                    Margin="4,0"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource HubAccentBrush}"
                    CornerRadius="1"
                    Visibility="Collapsed" />
            <TextBox x:Name="PART_EditableTextBox"
                     Margin="{TemplateBinding Padding}"
                     Foreground="{TemplateBinding Foreground}"
                     FontSize="{TemplateBinding FontSize}"
                     IsReadOnly="{TemplateBinding IsReadOnly}"
                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                     AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                     Style="{StaticResource HubComboBoxTextBoxStyle}" />
            <Border x:Name="DropDownOverlay"
                    Grid.Column="1"
                    Width="24"
                    Margin="4"
                    Background="Transparent"
                    CornerRadius="6" />
            <ToggleButton x:Name="ToggleButton"
                          Grid.Column="1"
                          Margin="3"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource HubComboBoxToggleStyle}" />
            <TextBlock x:Name="Chevron"
                       Grid.Column="1"
                       Style="{StaticResource HubChevronDownStyle}" />
            <Popup x:Name="PART_Popup"
                   MinWidth="{TemplateBinding ActualWidth}"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Slide"
                   VerticalOffset="1">
                <Border x:Name="DropDownBorder"
                        Padding="4"
                        Background="{DynamicResource HubFlyoutSurfaceBrush}"
                        BorderBrush="{DynamicResource HubBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource HubFlyoutShadow}"
                        SnapsToDevicePixels="True">
                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  SnapsToDevicePixels="True"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                <Setter TargetName="DropDownOverlay" Property="Background" Value="{DynamicResource HubHoverBrush}" />
            </Trigger>
            <Trigger SourceName="ToggleButton" Property="IsPressed" Value="True">
                <Setter TargetName="DropDownOverlay" Property="Background" Value="{DynamicResource HubPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                <Setter TargetName="Chevron" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Элемент списка: подсветка наведения и мягкий акцент выбранного
         (как пункт навигации HubNavItemStyle, но без отступа слева). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Indicator"
                                    Width="3"
                                    Height="14"
                                    HorizontalAlignment="Left"
