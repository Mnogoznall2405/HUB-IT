<UserControl x:Class="Hub.Desktop.Native.Views.AddressBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Меню-фильтры: пункт = опция, команда — из Tag кнопки-хозяина. -->
            <Style x:Key="FilterMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}" />
                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, фильтры, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Width="300"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск по адресной книге" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="ФИО, должность, подразделение, город, телефон или e-mail…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Margin="10,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectDepartmentFilterCommand}"
                            Click="DepartmentFilterMenuButton_Click"
                            AutomationProperties.Name="Фильтр по подразделению">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource FilterMenuItemStyle}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Подразделение: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedDepartmentFilterText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectCityFilterCommand}"
                            Click="CityFilterMenuButton_Click"
                            AutomationProperties.Name="Фильтр по городу">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource FilterMenuItemStyle}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Город: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedCityFilterText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Сбросить"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Сбросить фильтры адресной книги" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить адресную книгу" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка адресной книги">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку адресной книги" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Список + карточка контакта -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,6"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource HubAccentBrush}"
                             Background="{DynamicResource HubSurfaceRaisedBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Индикатор загрузки адресной книги" />
                <Grid Grid.Row="1">
                    <ListBox Style="{StaticResource HubListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             AutomationProperties.Name="Список контактов адресной книги">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40"
                                            Height="40"
                                            VerticalAlignment="Top"
                                            CornerRadius="20"
                                            Background="{DynamicResource HubSelectionBrush}">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubAccentBrush}"
                                                       Text="{Binding Initials}"
                                                       AutomationProperties.Name="Инициалы контакта" />
                                            <!-- Фото поверх инициалов — пришло через AuthImageLoader. -->
                                            <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding PhotoImage}"
                                                                Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding FullName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding Subtitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Subtitle, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding PrimaryPhoneText}"
                                                       Visibility="{Binding PrimaryPhoneText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <TextBlock Margin="10,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding PrimaryEmailText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding PrimaryEmailText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding EmptyTitleText}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="{Binding EmptyHintText}" />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="2"
                        Margin="0,8,0,0"
                        Style="{StaticResource HubSecondaryButtonStyle}"
                        Command="{Binding LoadMoreCommand}"
                        Content="{Binding MoreButtonText}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Показать ещё контакты" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель списка и карточки контакта"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей" />

            <!-- Карточка контакта -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Контакт не выбран" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Выберите сотрудника в списке слева." />
                    </StackPanel>

                    <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer Padding="22,18"
                                      VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedItem}"
                                      AutomationProperties.Name="Карточка контакта">
                            <StackPanel>
                                <!-- Шапка: инициалы + ФИО + должность -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72"
                                            Height="72"
                                            VerticalAlignment="Top"
                                            CornerRadius="36"
                                            Background="{DynamicResource HubSelectionBrush}">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubAccentBrush}"
                                                       Text="{Binding Initials}"
                                                       AutomationProperties.Name="Фото или инициалы контакта" />
                                            <!-- Фото поверх инициалов — пришло через AuthImageLoader. -->
                                            <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding PhotoImage}"
                                                                Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding FullName}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="ФИО контакта" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding MetaText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <!-- Действия -->
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                            Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanCall}"
                                            Content="Позвонить"
                                            AutomationProperties.Name="Позвонить контакту" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource HubSecondaryButtonStyle}"
                                            Command="{Binding DataContext.EmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanEmail}"
                                            Content="Написать"
                                            AutomationProperties.Name="Написать письмо контакту" />
                                </StackPanel>

                                <!-- Контакты -->
                                <TextBlock Margin="0,20,0,0"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           Text="Контакты"
                                           Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="Телефоны" />
                                        <ItemsControl ItemsSource="{Binding Phones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,6"
                                                               Style="{StaticResource MetaValueStyle}"
                                                               Text="{Binding DisplayText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Margin="0,0,0,4"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="E-mail" />
                                        <ItemsControl ItemsSource="{Binding Emails}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,6"
                                                               Style="{StaticResource MetaValueStyle}"
                                                               Text="{Binding DisplayText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- Работа -->
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           Text="Работа"
                                           Visibility="{Binding HasWorkMeta, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding HasWorkMeta, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Подразделение"
                                                   Visibility="{Binding DepartmentText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding DepartmentText}"
                                                   Visibility="{Binding DepartmentText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Код подразделения"
                                                   Visibility="{Binding DepartmentCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding DepartmentCodeText}"
                                                   Visibility="{Binding DepartmentCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Город"
                                                   Visibility="{Binding CityText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding CityText}"
                                                   Visibility="{Binding CityText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Рабочее место"
                                                   Visibility="{Binding WorkplaceText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding WorkplaceText}"
                                                   Visibility="{Binding WorkplaceText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Табельный номер"
                                                   Visibility="{Binding EmployeeCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding EmployeeCodeText}"
                                                   Visibility="{Binding EmployeeCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Дата приёма"
                                                   Visibility="{Binding HireDateText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding HireDateText}"
                                                   Visibility="{Binding HireDateText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Личное -->
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           Text="Личное"
                                           Visibility="{Binding HasPersonalMeta, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding HasPersonalMeta, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Отчество"
                                                   Visibility="{Binding MiddleNameText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding MiddleNameText}"
                                                   Visibility="{Binding MiddleNameText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Возраст"
                                                   Visibility="{Binding AgeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding AgeText}"
                                                   Visibility="{Binding AgeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="ИНН"
                                                   Visibility="{Binding InnText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="0,2,0,10" Style="{StaticResource MetaValueStyle}"
                                                   Text="{Binding InnText}"
                                                   Visibility="{Binding InnText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статусная строка -->
        <Border Grid.Row="3" Padding="20,0,20,12">
            <Grid>
                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding TotalText}"
                           AutomationProperties.Name="Счётчик найденных контактов" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding LastUpdatedText}"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
