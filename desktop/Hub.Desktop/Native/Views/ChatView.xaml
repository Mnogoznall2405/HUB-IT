<UserControl x:Class="Hub.Desktop.Native.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
            <local:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:RatioConverter x:Key="Ratio" />
            <!-- Строка-эмодзи → цветной Twemoji PNG (Assets/Emoji); null → текст-фоллбэк. -->
            <local:EmojiToImageConverter x:Key="EmojiToImage" />
            <!-- Строка-эмодзи иконки хрома → монохромная VectorIcons-геометрия. -->
            <local:EmojiToVectorConverter x:Key="EmojiToVector" />
            <local:ChatPeerBrushConverter x:Key="ChatPeerBrush" />
            <local:ChatPeerInitialsConverter x:Key="ChatPeerInitials" />
            <local:ChatShortTimeConverter x:Key="ChatShortTime" />
            <!-- Вкладки галереи — тот же чип-переключатель, что в «Отсутствиях». -->
            <Style x:Key="MediaTabRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}" />

            <!-- «Плоский» ListBox без внутреннего ScrollViewer — для списков внутри
                 общего ScrollViewer колонки: внутренний скроллер отключён, но всё равно
                 перехватывал бы MouseWheel и не давал колесу всплыть наружу. -->
            <Style x:Key="ChatFlatListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource HubListBoxStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListBox с оверлей-скроллом как в Telegram (тонкий слой поверх контента,
                 проявляется при наведении): шаблон для ленты сообщений и списка диалогов. -->
            <Style x:Key="ChatOverlayListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="HistoryScrollViewer"
                                              Style="{StaticResource HubOverlayScrollViewerStyle}"
                                              Focusable="False"
                                              Padding="{TemplateBinding Padding}">
                                    <!-- ItemsPresenter напрямую передаёт ScrollViewer
                                         виртуализирующую панель как IScrollInfo. -->
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Пузырь сообщения без выделения/карточки; интервалы — внутри шаблона
                 (компактные в серии одного автора, шире между сериями — как в Telegram). -->
            <Style x:Key="ChatMessageItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <!-- Слой строки вполширины ленты: hover-тинт ~5% как в
                                 tdesktop — пузырь остаётся без выделения; оверлей
                                 даёт плавный fade ~120 мс вместо мгновенной смены. -->
                            <Grid>
                                <Border x:Name="RowSurface"
                                        Background="Transparent" />
                                <Border x:Name="RowHoverOverlay"
                                        Background="{DynamicResource HubChatRowHoverBrush}"
                                        Opacity="0" />
                                <Border>
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RowHoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RowHoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <!-- «Вспышка» строки ~1 с после перехода к якорю
                                     (reply/pinned/search) — tg msgSelectOverlay. -->
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HubChatRowFlashBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка диалога как в Telegram Desktop: без карточки, hover —
                 #202B36, выбранная — синяя заливка #2B5278 с закруглением. -->
            <Style x:Key="ChatConversationItemStyle" TargetType="ListBoxItem">
                <!-- Аватар 46 + padding 8×2 = 62 DIP строки — эталон tdesktop (UI-021). -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="6,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <!-- Подложка выбора мгновенная (как в tdesktop), hover —
                                 плавный fade оверлея ~120/160 мс. -->
                            <Grid>
                                <Border x:Name="Surface"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True" />
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource HubChatHoverBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                <Border Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatRowSelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Вторичный текст строки: обычный — #708499, на выбранной строке —
                 светло-стальной; title на выбранной — белый. -->
            <Style x:Key="ChatRowSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource HubChatRowSelectedTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ChatRowTitleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource HubChatOnAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Ghost-кнопки чата — иконки приглушённым #708499, как в Telegram. -->
            <Style x:Key="ChatGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                <!-- Плоская кнопка хрома чата: без заливки в покое — шапка и
                     композер читаются как единые панели (UI-009/UI-016);
                     hover/pressed дают фон через триггеры шаблона. -->
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Приглушённый текст внутри чата — Telegram-вторичный тон
                 вместо шеллового (локальный ключ перекрывает HubTheme). -->
            <Style x:Key="HubMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Вкладка вертикальной полосы папок слева — иконка + короткая
                 подпись + бейдж, активная — акцентная подложка (Telegram Desktop). -->
            <Style x:Key="ChatRailTabStyle" TargetType="Button">
                <Setter Property="Width" Value="56" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Padding" Value="2,4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Surface"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True" />
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource HubChatHoverBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                <Border Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatRailActiveBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource HubChatAccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Корневой пункт Menu как ghost-кнопка: подменю открывается вниз
                 (⋯-overflow в шапке списка диалогов). -->
            <Style x:Key="ChatMenuRootDownStyle" TargetType="MenuItem">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <local:EmojiGlyph Glyph="{TemplateBinding Header}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    <Popup x:Name="SubmenuPopup"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           Placement="Bottom"
                                           HorizontalOffset="-152"
                                           VerticalOffset="4"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource HubFlyoutSurfaceBrush}"
                                                BorderBrush="{DynamicResource HubBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="4"
                                                Effect="{StaticResource HubFlyoutShadow}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- То же, но меню открывается вверх — «скрепка» composer'а (tg-attach).
                 Цель 44×46 DIP по эталону tdesktop (UI-021). -->
            <Style x:Key="ChatMenuRootUpStyle" TargetType="MenuItem" BasedOn="{StaticResource ChatMenuRootDownStyle}">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <local:EmojiGlyph Glyph="{TemplateBinding Header}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    <Popup x:Name="SubmenuPopup"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           Placement="Top"
                                           HorizontalOffset="-4"
                                           VerticalOffset="0"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource HubFlyoutSurfaceBrush}"
                                                BorderBrush="{DynamicResource HubBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="4"
                                                Effect="{StaticResource HubFlyoutShadow}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Пункт меню с иконкой в левой колонке — как у пунктов tg-context/tg-attach.
                 Копия шаблона темы: колонка 0 рендерит MenuItem.Icon (эмодзи/глиф),
                 галочка IsChecked сохранена под иконкой. -->
            <Style x:Key="ChatIconMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                    </Grid.ColumnDefinitions>
                                    <local:VectorIcon x:Name="CheckGlyph"
                                                      Size="11"
                                                      VerticalAlignment="Center"
                                                      Data="{x:Static local:VectorIcons.Check}"
                                                      Visibility="Collapsed" />
                                    <!-- Иконка пункта: строковый эмодзи → цветной Twemoji,
                                         иначе — исходный глиф/элемент как есть. -->
                                    <local:EmojiGlyph x:Name="IconHost"
                                                      Glyph="{TemplateBinding Icon}"
                                                      VerticalAlignment="Center"
                                                      FontSize="13"
                                                      Foreground="{DynamicResource HubChatSecondaryBrush}" />
                                    <local:EmojiGlyph Grid.Column="1"
                                                      Glyph="{TemplateBinding Header}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />
                                    <local:VectorIcon x:Name="Arrow"
                                                      Grid.Column="2"
                                                      Size="9"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                      Data="{x:Static local:VectorIcons.ChevronRight}"
                                                      Visibility="Collapsed" />
                                    <Popup x:Name="SubmenuPopup"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           Placement="Right"
                                           HorizontalOffset="-2"
                                           VerticalOffset="-4"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource HubFlyoutSurfaceBrush}"
                                                BorderBrush="{DynamicResource HubBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                Effect="{StaticResource HubFlyoutShadow}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChatMessageContextMenuStyle" TargetType="ContextMenu"
                   BasedOn="{StaticResource {x:Type ContextMenu}}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Grid>
                                <Border x:Name="ActionSurface"
                                        Margin="0,44,0,0"
                                        Background="{DynamicResource HubChatPanelBrush}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Effect="{StaticResource HubFlyoutShadow}"
                                        IsHitTestVisible="False"
                                        SnapsToDevicePixels="True" />
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                    <Setter TargetName="ActionSurface" Property="Margin" Value="0" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Эмодзи быстрой реакции в шапке контекстного меню сообщения —
                 компактная кнопка без колонок меню (tg-context). -->
            <Style x:Key="ChatQuickReactionItemStyle" TargetType="MenuItem">
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    SnapsToDevicePixels="True">
                                <local:EmojiGlyph Glyph="{TemplateBinding Header}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Шеврон «⌄» в конце ряда быстрых реакций — открывает полный
                 список эмодзи подменю справа, при этом остаётся компактным. -->
            <Style x:Key="ChatQuickReactionExpandStyle" TargetType="MenuItem">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border Width="24"
                                            Height="24"
                                            Background="{DynamicResource HubChatHoverBrush}"
                                            CornerRadius="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <local:VectorIcon Size="14"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="{x:Static local:VectorIcons.ChevronDown}" />
                                    </Border>
                                    <Popup x:Name="PART_Popup"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           Placement="Right"
                                           HorizontalOffset="-2"
                                           VerticalOffset="-2"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource HubFlyoutSurfaceBrush}"
                                                BorderBrush="{DynamicResource HubBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                Effect="{StaticResource HubFlyoutShadow}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Вкладка «Эмодзи/Стикеры» в шапке панели — текстовая кнопка,
                 активная подчёркнута акцентом (tg-stickers). -->
            <Style x:Key="ChatStickerTabStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    <Border Height="2"
                                            Margin="0,0,0,-5"
                                            VerticalAlignment="Bottom"
                                            Background="{TemplateBinding BorderBrush}"
                                            CornerRadius="1" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка-действие в карточке собеседника — иконка слева, текст,
                 hover заливка как у пунктов меню (tg-profile). -->
            <Style x:Key="ChatCardItemStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Поле ввода сообщения — «таблетка» (поиск диалога и composer);
                 заливка #242F3D на панели #17212B, как в Telegram Desktop. -->
            <Style x:Key="ChatPillTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Background" Value="{DynamicResource HubChatInputBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource HubChatAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="19"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChatComposerTextBoxStyle" TargetType="TextBox"
                   BasedOn="{StaticResource ChatPillTextBoxStyle}">
                <Setter Property="Padding" Value="6,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кнопка отправки — плоская иконка как в tdesktop: акцентный ➤
                 при тексте, ✓ при правке. -->
            <Style x:Key="ChatSendFabStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource HubChatAccentBrush}" />
                <Setter Property="ToolTip" Value="{Binding SendButtonText}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    SnapsToDevicePixels="True">
                                <local:VectorIcon x:Name="Glyph"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Size="21"
                                                  Data="{x:Static local:VectorIcons.Send}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                </Trigger>
                                <!-- Пустой composer оставляет неактивную отправку; правка — ✓. -->
                                <DataTrigger Binding="{Binding SendButtonText}" Value="Сохранить">
                                    <Setter TargetName="Glyph" Property="Data" Value="{x:Static local:VectorIcons.Check}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Пилюля действия режима выделения («ПЕРЕСЛАТЬ 1» / «УДАЛИТЬ 1»)
                 — акцентная заливка, белый текст, как в tg-multiselect. -->
            <Style x:Key="ChatAccentPillButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource HubChatOnAccentBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource HubChatAccentBrush}"
                                    CornerRadius="15"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatAccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatAccentPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка диалога: аватар 50 + онлайн-точка | 📌+title+🔕 · ✓✓+time |
                 «Вы:»+preview · бейдж непрочитанных | kind. Отступ слева — волосная
                 линия-разделитель под строкой, как в Telegram Desktop. -->
            <DataTemplate x:Key="ConversationRowTemplate">
                <Grid>
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}" />
                            </ContextMenu.Resources>
                            <MenuItem Command="{Binding TogglePinCommand}"
                                      Header="{Binding PinMenuText}">
                                <MenuItem.Icon>
                                    <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Pin}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding ToggleMuteCommand}"
                                      Header="{Binding MuteMenuText}">
                                <MenuItem.Icon>
                                    <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.BellOff}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding ToggleArchiveCommand}"
                                      Header="{Binding ArchiveMenuText}">
                                <MenuItem.Icon>
                                    <local:VectorIcon Size="16" Data="{Binding ArchiveMenuIcon, Converter={StaticResource EmojiToVector}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Visibility="{Binding HasFolderMenuItems, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="Добавить в папку"
                                      ItemsSource="{Binding FolderMenuItems}"
                                      Visibility="{Binding HasFolderMenuItems, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Добавить диалог в папку">
                                <MenuItem.Icon>
                                    <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Folder}" />
                                </MenuItem.Icon>
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Command" Value="{Binding ToggleCommand}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsIncluded}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                                <MenuItem.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </MenuItem.ItemTemplate>
                            </MenuItem>
                            <MenuItem Command="{Binding ExportHistoryCommand}"
                                      Header="Экспорт"
                                      AutomationProperties.Name="Экспорт истории диалога"
                                      Visibility="{Binding CanExportHistory, Converter={StaticResource BoolToVisibility}}">
                                <MenuItem.Icon>
                                    <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Unarchive}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Visibility="{Binding CanLeaveGroup, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Command="{Binding LeaveGroupCommand}"
                                      Header="Покинуть группу"
                                      Foreground="{DynamicResource HubErrorTextBrush}"
                                      AutomationProperties.Name="Покинуть группу"
                                      Visibility="{Binding CanLeaveGroup, Converter={StaticResource BoolToVisibility}}">
                                <MenuItem.Icon>
                                    <local:VectorIcon Size="16"
                                                      Foreground="{DynamicResource HubErrorTextBrush}"
                                                      Data="{x:Static local:VectorIcons.Exit}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Волосная линия под строкой, начиная после аватара — как в Telegram. -->
                    <Border Grid.ColumnSpan="2"
                            Height="1"
                            Margin="56,0,-6,-8"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource HubBorderDimBrush}"
                            Opacity="0.6" />
                    <Grid VerticalAlignment="Center">
                        <!-- Круглый градиентный аватар пира + белые инициалы; поверх — фото, когда загружено. -->
                        <Border Width="46"
                                Height="46"
                                CornerRadius="23"
                                Background="{Binding AvatarBrush}">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding AvatarInitials}" />
                                <Border CornerRadius="23"
                                        Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarImage}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <Ellipse Width="11"
                                 Height="11"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Fill="{DynamicResource HubChatAccentBrush}"
                                 AutomationProperties.Name="В сети"
                                 Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <!-- Колокол мьюта у правого края колонки имени — рядом со статусом,
                                     как в tg-main; DockPanel (в отличие от StackPanel) меряет текст
                                     конечной шириной, и CharacterEllipsis работает. -->
                                <local:VectorIcon DockPanel.Dock="Right"
                                                  Margin="4,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Size="13"
                                                  Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                  Data="{x:Static local:VectorIcons.BellOff}"
                                                  Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource ChatRowTitleTextStyle}"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Своя последняя реплика — галочки прочтения до времени (tg-main). -->
                                <local:VectorIcon Margin="0,0,4,0"
                                                  Size="12"
                                                  Foreground="{DynamicResource HubChatAccentBrush}"
                                                  Data="{Binding LastMessageStatusText, Converter={StaticResource EmojiToVector}}"
                                                  Visibility="{Binding LastMessageStatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                <TextBlock FontSize="12"
                                           Style="{StaticResource ChatRowSecondaryTextStyle}"
                                           Text="{Binding TimeText}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- «Вы:» — акцентный префикс своего последнего сообщения
                                     (прячется под «печатает…» и под черновиком). -->
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource HubChatLinkBrush}"
                                           Text="Вы: ">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding LastMessageIsOwn}" Value="True" />
                                                        <Condition Binding="{Binding IsTyping}" Value="False" />
                                                        <Condition Binding="{Binding HasDraft}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           FontSize="13"
                                           Text="{Binding Preview}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="36">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChatRowSecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTyping}" Value="False" />
                                                        <Condition Binding="{Binding HasDraft}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- «Черновик: текст» — красный префикс + приглушённый текст
                                     вместо превью; «печатает…» важнее (Telegram). -->
                                <TextBlock Grid.Column="1"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="36">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChatRowSecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTyping}" Value="False" />
                                                        <Condition Binding="{Binding HasDraft}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Foreground="{DynamicResource HubChatDraftBrush}"
                                         Text="Черновик: " /><Run Text="{Binding DraftText, Mode=OneWay}" />
                                </TextBlock>
                                <!-- «печатает…» заменяет превью акцентным текстом (Telegram). -->
                                <TextBlock Grid.Column="1"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource HubChatLinkBrush}"
                                           Text="{Binding TypingText}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsTyping, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <StackPanel Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <!-- 📌 справа внизу — как у закреплённых диалогов в tg-main. -->
                                <local:VectorIcon Margin="0,0,4,0"
                                                  Size="13"
                                                  Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                  Data="{x:Static local:VectorIcons.Pin}"
                                                  Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Красная «@»-пилюля упоминаний — перед счётчиком (tg-main). -->
                                <Border MinWidth="18"
                                        Height="18"
                                        Padding="5,0"
                                        Margin="0,0,4,0"
                                        CornerRadius="9"
                                        Background="{DynamicResource HubErrorTextBrush}"
                                        Visibility="{Binding HasUnreadMention, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HubChatOnAccentBrush}"
                                               Text="{Binding UnreadMentionBadgeText}" />
                                </Border>
                                <!-- Пилюля непрочитанных #5188C1; у отключённых уведомлений — серая. -->
                                <Border MinWidth="18"
                                        Height="18"
                                        Padding="5,0"
                                        CornerRadius="9"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource HubChatAccentBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource HubChatOnAccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HubChatMutedBadgeBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding UnreadBadgeText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Style="{StaticResource ChatRowSecondaryTextStyle}"
                                   Text="{Binding KindText}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding KindText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid PreviewKeyDown="ChatView_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Баннер ошибки -->
        <Border Grid.Row="0"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource ChatGhostButtonStyle}"
                        Command="{Binding RetryCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку диалогов" />
                <Button Grid.Column="2"
                        Style="{StaticResource ChatGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                        ToolTip="Скрыть ошибку"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <Grid x:Name="ChatAreaGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Сайдбар 420px — дефолт веб-чата (chatSidebarSizing.js); границу
                     можно тянуть (MinWidth/MaxWidth колонки — пределы сплиттера). -->
                <ColumnDefinition Width="420" MinWidth="280" MaxWidth="560" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: поиск + папки + диалоги — панель #17212B весь рост,
                 как сайдбар Telegram Desktop; справа — волосная граница. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource HubChatPanelBrush}" />
            <Grid Grid.Column="1">
                <Border HorizontalAlignment="Center"
                        Width="1"
                        Background="{DynamicResource HubBorderDimBrush}" />
                <!-- Прозрачная ручка 5px поверх волосной линии — resize сайдбара
                     перетаскиванием, как в tdesktop. -->
                <GridSplitter Width="5"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Изменить ширину списка диалогов" />
            </Grid>
            <Grid x:Name="SidebarHost" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <!-- Вертикальная полоса папок ~58px — фирменный признак Telegram Desktop. -->
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,6,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FolderTabs}"
                                      AutomationProperties.Name="Вкладки папок диалогов">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="2,1"
                                            Style="{StaticResource ChatRailTabStyle}"
                                            Command="{Binding SelectCommand}"
                                            ToolTip="{Binding Title}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Border Width="28"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        CornerRadius="9"
                                                        Background="{DynamicResource HubChatRailIconBrush}">
                                                    <local:VectorIcon HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Size="16"
                                                                      Foreground="{DynamicResource HubChatOnAccentBrush}"
                                                                      Data="{Binding IconText, Converter={StaticResource EmojiToVector}}" />
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-4,-4,0"
                                                        MinWidth="15"
                                                        Height="15"
                                                        Padding="3,0"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource HubChatAccentBrush}"
                                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HubChatOnAccentBrush}"
                                                               Text="{Binding UnreadBadgeText}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="52"
                                                       FontSize="9.5"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Низ полосы: ИИ, «Ред.» (менеджер папок) и «Архив» — как в tg-main. -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Button Margin="2,1"
                                Style="{StaticResource ChatRailTabStyle}"
                                Command="{Binding ToggleAiPanelCommand}"
                                ToolTip="ИИ-ассистент"
                                AutomationProperties.Name="Открыть панель ИИ-ассистента">
                            <StackPanel>
                                <local:VectorIcon HorizontalAlignment="Center"
                                                  Size="17"
                                                  Data="{x:Static local:VectorIcons.Robot}" />
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="9.5"
                                           Text="ИИ" />
                            </StackPanel>
                        </Button>
                        <Button Margin="2,1"
                                Style="{StaticResource ChatRailTabStyle}"
                                Command="{Binding ToggleFolderManagerCommand}"
                                ToolTip="Управление папками"
                                AutomationProperties.Name="Управление папками">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="15"
                                           Text="≡" />
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="9.5"
                                           Text="Ред." />
                            </StackPanel>
                        </Button>
                        <Button Margin="2,1"
                                Command="{Binding ToggleArchivedViewCommand}"
                                ToolTip="{Binding ArchiveToggleText}"
                                AutomationProperties.Name="Показать архивные диалоги">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChatRailTabStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArchiveView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HubChatRailActiveBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HubChatAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <local:VectorIcon HorizontalAlignment="Center"
                                                  Size="17"
                                                  Data="{x:Static local:VectorIcons.Archive}" />
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="9.5"
                                           Text="Архив" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="0"
                        HorizontalAlignment="Right"
                        Width="1"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource HubBorderDimBrush}" />

                <!-- Колонка списка: один ряд — поисковая «таблетка» на всю ширину
                     + «＋» новый диалог + «⋯» второстепенные действия (tg-main). -->
                <Grid Grid.Column="1" Margin="8,10,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- ☰ — фирменное меню Telegram: шапка профиля + пункты действий
                             (tg-menu). Открывается вниз, тёмный flyout общего стиля. -->
                        <Menu Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Background="Transparent">
                            <MenuItem Style="{StaticResource ChatMenuRootDownStyle}"
                                      ToolTip="Меню"
                                      AutomationProperties.Name="Главное меню">
                                <MenuItem.Header>
                                    <local:VectorIcon Size="20"
                                                      Data="{x:Static local:VectorIcons.Menu}" />
                                </MenuItem.Header>
                                <MenuItem.Resources>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}" />
                                </MenuItem.Resources>
                                <!-- Шапка: градиент-аватар текущего пользователя + имя и @username. -->
                                <MenuItem StaysOpenOnClick="True"
                                          Focusable="False"
                                          AutomationProperties.Name="Профиль текущего пользователя">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border Padding="10,9"
                                                    Background="Transparent">
                                                <ContentPresenter ContentSource="Header" />
                                            </Border>
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="38"
                                                    Height="38"
                                                    CornerRadius="19"
                                                    Background="{Binding MenuProfileName, Converter={StaticResource ChatPeerBrush}}">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               Text="{Binding MenuProfileInitials}" />
                                                    <Border CornerRadius="19"
                                                            Visibility="{Binding HasMenuProfileAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding MenuProfileAvatarImage}"
                                                                        Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="13"
                                                           MaxWidth="240"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding MenuProfileName, TargetNullValue='Профиль'}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,1,0,0"
                                                           MaxWidth="240"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                           Text="{Binding MenuProfileUsername}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding MenuProfileUsername, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding BeginNewDirectCommand}"
                                          Header="Новый диалог"
                                          AutomationProperties.Name="Новый диалог">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Edit}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding BeginNewGroupCommand}"
                                          Header="Новая группа"
                                          AutomationProperties.Name="Новая группа">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Group}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenNotesCommand}"
                                          Header="Заметки себе"
                                          AutomationProperties.Name="Заметки себе">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Document}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding ToggleGlobalSearchCommand}"
                                          Header="Поиск по всем сообщениям"
                                          AutomationProperties.Name="Поиск по всем сообщениям">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Search}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenSupportCommand}"
                                          Header="Написать в поддержку"
                                          AutomationProperties.Name="Написать в поддержку">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Help}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding RefreshConversationsCommand}"
                                          Header="Обновить список"
                                          AutomationProperties.Name="Обновить список диалогов">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Refresh}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <!-- «Ночной режим» — переключатель темы, галочка = тёмная. -->
                                <MenuItem Command="{Binding ToggleNightThemeCommand}"
                                          Header="Ночной режим"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsNightTheme, Mode=OneWay}"
                                          StaysOpenOnClick="True"
                                          AutomationProperties.Name="Ночной режим">
                                    <MenuItem.Icon>
                                        <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Moon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem IsEnabled="False"
                                          StaysOpenOnClick="True"
                                          Header="HUB Desktop" />
                            </MenuItem>
                        </Menu>
                        <TextBox x:Name="ConversationSearchInput"
                                 Grid.Column="1"
                                 Style="{StaticResource ChatPillTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск диалога" />
                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Orientation="Horizontal"
                                    TextElement.Foreground="{DynamicResource HubChatSecondaryBrush}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <local:VectorIcon VerticalAlignment="Center"
                                              Size="14"
                                              Data="{x:Static local:VectorIcons.Search}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Поиск диалога…" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource ChatGhostButtonStyle}"
                                Command="{Binding ToggleNewConversationCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                ToolTip="Новый диалог"
                                AutomationProperties.Name="Новый диалог" />
                    </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid IsEnabled="{Binding IsConversationListActive}">
                        <!-- Режим поиска (tg-search): список превращается в выдачу —
                             скоуп-чип, секция «Чаты» (тот же шаблон строки) и секция
                             «Сообщения» из глобального поиска. Общий ScrollViewer
                             снаружи: внутренние списки растут по контенту. -->
                        <ScrollViewer Style="{StaticResource HubOverlayScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Шапка режима «Архив»: 📁 + «Архив · N диалогов»,
                                     как заголовок Archived Chats в Telegram. -->
                                <Border Margin="0,2,0,6"
                                        Padding="10,6"
                                        Background="{DynamicResource HubChatHoverBrush}"
                                        CornerRadius="8"
                                        Visibility="{Binding IsArchiveView, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:VectorIcon VerticalAlignment="Center"
                                                          Size="15"
                                                          Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                          Data="{x:Static local:VectorIcons.Archive}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HubTextBrush}"
                                                   Text="{Binding ArchiveHeaderText}" />
                                    </StackPanel>
                                </Border>
                                <Grid Visibility="{Binding IsConversationSearchActive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Margin="4,2,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource ChatRowSecondaryTextStyle}"
                                               Text="Область поиска" />
                                    <Button HorizontalAlignment="Right"
                                            Padding="10,3"
                                            Command="{Binding ToggleMessageSearchCommand}"
                                            Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Искать только в открытом чате">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chip"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{DynamicResource HubChatHoverBrush}"
                                                        CornerRadius="11">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HubTextBrush}"
                                                               Text="Этот чат ⌄" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="Opacity" Value="0.85" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <TextBlock Margin="4,8,0,4"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource ChatRowSecondaryTextStyle}"
                                           Text="Чаты"
                                           Visibility="{Binding IsConversationSearchActive, Converter={StaticResource BoolToVisibility}}" />
                                <ListBox Style="{StaticResource ChatFlatListBoxStyle}"
                                         ItemContainerStyle="{StaticResource ChatConversationItemStyle}"
                                         ItemTemplate="{StaticResource ConversationRowTemplate}"
                                         ItemsSource="{Binding Conversations}"
                                         SelectedItem="{Binding SelectedConversation}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Список диалогов" />
                                <TextBlock Margin="4,10,0,4"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="Сообщения">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChatRowSecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConversationSearchActive}" Value="True" />
                                                        <Condition Binding="{Binding HasGlobalSearchResults}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding GlobalSearchResults}"
                                              AutomationProperties.Name="Результаты поиска по сообщениям">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Preview}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.PickGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Preview}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Surface"
                                                                Padding="8,6"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                CornerRadius="8">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40"
                                                            Height="40"
                                                            VerticalAlignment="Top"
                                                            CornerRadius="20"
                                                            Background="{Binding ConversationTitle, Converter={StaticResource ChatPeerBrush}}">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="{Binding ConversationTitle, Converter={StaticResource ChatPeerInitials}}" />
                                                    </Border>
                                                    <Grid Grid.Column="1" Margin="10,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding ConversationTitle, TargetNullValue='Диалог'}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock HorizontalAlignment="Right"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding CreatedAt, Converter={StaticResource ChatShortTime}}" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding SenderName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="2"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="12"
                                                                   Text="{Binding Preview}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="{Binding EmptyHint}" />
                    </StackPanel>

                    <!-- Пустая выдача поиска — лупа + «Ничего не найдено» (tg-search). -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsConversationSearchEmpty, Converter={StaticResource BoolToVisibility}}">
                        <local:VectorIcon HorizontalAlignment="Center"
                                          Size="44"
                                          Foreground="{DynamicResource HubChatSecondaryBrush}"
                                          Data="{x:Static local:VectorIcons.Search}" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Ничего не найдено" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,16,0,0"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="Загрузка…"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Button Grid.Row="1"
                            Margin="0,8,0,0"
                            Style="{StaticResource HubSecondaryButtonStyle}"
                            Command="{Binding LoadMoreConversationsCommand}"
                            Content="{Binding ConversationsMoreText}"
                            IsEnabled="{Binding IsConversationListActive}"
                            Visibility="{Binding HasMoreConversations, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Показать следующую порцию диалогов" />

                    <!-- Панель «Новый диалог» поверх списка -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="1"
                            Padding="14"
                            Background="{DynamicResource HubChatPanelBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsNewConversationOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding NewConversationTitleText}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding ToggleNewGroupModeCommand}"
                                        Content="{Binding NewConversationModeToggleText}"
                                        AutomationProperties.Name="Переключить режим: личный диалог или группа" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding ToggleNewConversationCommand}"
                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                        ToolTip="Закрыть создание диалога"
                                        AutomationProperties.Name="Закрыть создание диалога" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <TextBox x:Name="NewConversationSearchInput"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         Text="{Binding NewConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Поиск пользователя" />
                                <TextBlock Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                           Text="Имя или логин…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewConversationSearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Поля режима «Новая группа»: название + чипы выбранных -->
                            <StackPanel Grid.Row="2"
                                        Visibility="{Binding IsNewGroupMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,10,0,0">
                                    <TextBox x:Name="NewGroupTitleInput"
                                             Style="{StaticResource HubTextBoxStyle}"
                                             Text="{Binding NewGroupTitle, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Название группы" />
                                    <TextBlock Margin="13,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                               Text="Название группы…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NewGroupTitleInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ItemsControl Margin="0,8,0,0"
                                              ItemsSource="{Binding SelectedGroupMembers}"
                                              AutomationProperties.Name="Выбранные участники группы">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6"
                                                    Command="{Binding DataContext.PickUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Убрать {0} из группы'}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chip"
                                                                Padding="8,3"
                                                                Background="{DynamicResource HubChatHoverBrush}"
                                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           Text="{Binding DisplayName}" />
                                                                <local:VectorIcon Margin="6,0,0,0"
                                                                                  VerticalAlignment="Center"
                                                                                  Size="10"
                                                                                  Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                  Data="{x:Static local:VectorIcons.Close}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ListBox Grid.Row="3"
                                     Margin="0,10,0,0"
                                     Style="{StaticResource HubListBoxStyle}"
                                     ItemsSource="{Binding FoundUsers}"
                                     AutomationProperties.Name="Найденные пользователи">
                                <!-- Действие на внутренней кнопке — контейнер
                                     нефокусируем, иначе мёртвая остановка Tab. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource HubTaskCardStyle}">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.PickUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding DisplayName}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Surface"
                                                            Padding="8,6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubBorderDimBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="18"
                                                        Background="{Binding AvatarBrush}">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   Text="{Binding AvatarInitials}" />
                                                        <Border CornerRadius="18"
                                                                Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding AvatarImage}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <local:VectorIcon Grid.Column="2"
                                                                  Size="14"
                                                                  Margin="8,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource HubChatAccentBrush}"
                                                                  Data="{x:Static local:VectorIcons.Check}"
                                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Поиск людей…"
                                           Visibility="{Binding IsSearchingUsers, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Никого не найдено"
                                           Visibility="{Binding IsUserSearchEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Создание диалога…"
                                           Visibility="{Binding IsCreatingConversation, Converter={StaticResource BoolToVisibility}}" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource HubSecondaryButtonStyle}"
                                        Command="{Binding CreateGroupCommand}"
                                        Content="Создать группу"
                                        AutomationProperties.Name="Создать группу"
                                        Visibility="{Binding IsNewGroupMode, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Панель глобального поиска по сообщениям поверх списка -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="1"
                            Padding="14"
                            Background="{DynamicResource HubChatPanelBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsGlobalSearchOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Поиск по сообщениям" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding ToggleGlobalSearchCommand}"
                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                        ToolTip="Закрыть поиск по всем сообщениям"
                                        AutomationProperties.Name="Закрыть поиск по всем сообщениям" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <TextBox x:Name="GlobalSearchInput"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Поиск по всем сообщениям" />
                                <TextBlock Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                           Text="Текст сообщения…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Margin="0,8"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="{Binding GlobalSearchHint}"
                                       Visibility="{Binding GlobalSearchHint, Converter={StaticResource NonEmptyStringToVisibility}}" />

                            <ListBox Grid.Row="3"
                                     Style="{StaticResource HubListBoxStyle}"
                                     ItemsSource="{Binding GlobalSearchResults}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Результаты поиска по всем сообщениям">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource HubTaskCardStyle}">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.PickGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Preview}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Surface"
                                                            Padding="8,6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ConversationTitle, TargetNullValue='Диалог'}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding SenderName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding CreatedAt, StringFormat='dd.MM HH:mm'}" />
                                                </Grid>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="13"
                                                           Text="{Binding Preview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="34" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- «Управление папками»: создание/переименование/удаление/состав -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="1"
                            Padding="14"
                            Background="{DynamicResource HubChatPanelBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsFolderManagerOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Управление папками" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding CloseFolderManagerCommand}"
                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                        ToolTip="Закрыть управление папками"
                                        AutomationProperties.Name="Закрыть управление папками" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource HubTextBoxStyle}"
                                         Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Имя новой папки" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource HubSecondaryButtonStyle}"
                                        Command="{Binding CreateFolderCommand}"
                                        Content="Создать"
                                        AutomationProperties.Name="Создать папку" />
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                       Text="{Binding FolderErrorText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFolderError, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <ListBox Style="{StaticResource HubListBoxStyle}"
                                         ItemsSource="{Binding CustomFolderTabs}"
                                         AutomationProperties.Name="Пользовательские папки">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Обычный режим строки -->
                                                <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding ConversationCountText}" />
                                                </StackPanel>
                                                <!-- Режим переименования -->
                                                <Grid Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource HubTextBoxStyle}"
                                                             Text="{Binding DataContext.RenamingFolderName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Новое имя папки" />
                                                    <Button Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.SaveFolderRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.Check}"
                                                            ToolTip="Сохранить"
                                                            AutomationProperties.Name="Сохранить имя папки" />
                                                    <Button Grid.Column="2"
                                                            Margin="4,0,0,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.CancelFolderRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                            ToolTip="Отмена"
                                                            AutomationProperties.Name="Отменить переименование" />
                                                </Grid>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <Button Margin="0,0,4,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.OpenFolderMembershipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Состав папки"
                                                            AutomationProperties.Name="Состав папки">
                                                        <local:VectorIcon Size="18" Data="{x:Static local:VectorIcons.Group}" />
                                                    </Button>
                                                    <Button Margin="0,0,4,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.BeginFolderRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Переименовать"
                                                            AutomationProperties.Name="Переименовать папку">
                                                        <local:VectorIcon Size="18" Data="{x:Static local:VectorIcons.Edit}" />
                                                    </Button>
                                                    <Button Margin="0,0,4,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.MoveFolderUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.ArrowUp}"
                                                            ToolTip="Выше"
                                                            AutomationProperties.Name="Переместить папку выше" />
                                                    <Button Margin="0,0,4,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.MoveFolderDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.ArrowDown}"
                                                            ToolTip="Ниже"
                                                            AutomationProperties.Name="Переместить папку ниже" />
                                                    <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Удалить папку"
                                                            AutomationProperties.Name="Удалить папку">
                                                        <local:VectorIcon Size="18" Data="{x:Static local:VectorIcons.Trash}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding CustomFolderTabs.Count, Converter={StaticResource ZeroToVisibility}}">
                                    <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                               TextAlignment="Center"
                                               Text="Папок пока нет. Создайте первую выше." />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- «Состав папки»: чек-лист диалогов поверх менеджера -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="2"
                            Padding="14"
                            Background="{DynamicResource HubChatPanelBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsFolderMembershipOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding MembershipFolderTitle, StringFormat='Состав папки «{0}»'}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding CloseFolderMembershipCommand}"
                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                        ToolTip="Закрыть состав папки"
                                        AutomationProperties.Name="Закрыть состав папки" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                       Text="{Binding FolderErrorText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFolderError, Converter={StaticResource BoolToVisibility}}" />
                            <ListBox Grid.Row="2"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource HubListBoxStyle}"
                                     ItemsSource="{Binding FolderMembershipItems}"
                                     AutomationProperties.Name="Диалоги в папке">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,4"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsIncluded}"
                                                  AutomationProperties.Name="{Binding Title, StringFormat='Диалог {0} в папке'}">
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock FontSize="13"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                           Text="{Binding Subtitle}"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding CloseFolderMembershipCommand}"
                                        Content="Отмена"
                                        AutomationProperties.Name="Отменить изменение состава папки" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource HubPrimaryButtonStyle}"
                                        Command="{Binding SaveFolderMembershipCommand}"
                                        Content="Сохранить"
                                        AutomationProperties.Name="Сохранить состав папки" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Панель «ИИ-ассистент»: диалоги с ассистентами + помощники -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="1"
                            Padding="14"
                            Background="{DynamicResource HubChatPanelBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsAiPanelOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="ИИ-ассистент" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding CloseAiPanelCommand}"
                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                        ToolTip="Закрыть панель ИИ-ассистента"
                                        AutomationProperties.Name="Закрыть панель ИИ-ассистента" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                       Text="{Binding AiErrorText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasAiError, Converter={StaticResource BoolToVisibility}}" />
                            <ScrollViewer Grid.Row="2"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                               Text="Диалоги с ассистентом" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  ItemsSource="{Binding AiConversations}"
                                                  AutomationProperties.Name="Диалоги с ассистентом">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat='Диалог с ассистентом: {0}'}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding Preview}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.SelectAiConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Открыть"
                                                            AutomationProperties.Name="Открыть диалог с ассистентом" />
                                                    <Button Grid.Column="2"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding DataContext.DeleteAiConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Удалить диалог"
                                                            AutomationProperties.Name="Удалить диалог с ассистентом">
                                                        <local:VectorIcon Size="18" Data="{x:Static local:VectorIcons.Trash}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ChatGhostButtonStyle}"
                                            Command="{Binding CreateGeneralAiConversationCommand}"
                                            Content="Новый диалог с ассистентом"
                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                            ToolTip="Новый диалог с ассистентом"
                                            AutomationProperties.Name="Новый диалог с ассистентом" />
                                    <Border Margin="0,12,0,8"
                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                            BorderThickness="0,1,0,0" />
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                               Text="Помощники" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingAiBots, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  ItemsSource="{Binding AiBots}"
                                                  AutomationProperties.Name="Помощники">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat='Помощник: {0}'}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding Description}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="30" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding OpenCommand}"
                                                            Content="{Binding OpenText}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='Открыть помощника {0}'}" />
                                                    <Button Grid.Column="2"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding NewConversationCommand}"
                                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                                            ToolTip="Новый диалог с помощником"
                                                            Visibility="{Binding HasExistingConversation, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="Новый диалог с помощником" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="7"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель диалогов и сообщений"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей" />

            <!-- Правая колонка: лента сообщений на #0E1621 весь рост — Telegram Desktop.
                 AllowDrop на всю колонку: файлы принимает и лента, и composer;
                 дочерние DragEnter/DragLeave сводятся счётчиком в code-behind. -->
            <Border x:Name="ChatDropArea"
                    Grid.Column="2"
                    Background="{DynamicResource HubChatAreaBrush}"
                    AllowDrop="True"
                    DragEnter="OnChatAreaDragEnter"
                    DragOver="OnChatAreaDragOver"
                    DragLeave="OnChatAreaDragLeave"
                    Drop="OnChatAreaDrop">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasConversation, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Выберите диалог" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Сообщения появятся здесь." />
                    </StackPanel>

                    <Grid Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Шапка диалога на панельном #17212B + статус подключения.
                             В режиме выделения (tg-multiselect) меняется на панель
                             действий: «ПЕРЕСЛАТЬ N»/«УДАЛИТЬ N» слева, «ОТМЕНА» справа. -->
                        <Border Grid.Row="0"
                                Padding="18,3.5"
                                Background="{DynamicResource HubChatPanelBrush}"
                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <!-- Панель действий выделения — заменяет обычную шапку. -->
                                <Grid Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button VerticalAlignment="Center"
                                            Style="{StaticResource ChatAccentPillButtonStyle}"
                                            Command="{Binding ForwardSelectedCommand}"
                                            Content="{Binding ForwardSelectedText}"
                                            AutomationProperties.Name="Переслать выделенные сообщения" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ChatAccentPillButtonStyle}"
                                            Command="{Binding DeleteSelectedCommand}"
                                            Content="{Binding DeleteSelectedText}"
                                            AutomationProperties.Name="Удалить выделенные сообщения" />
                                    <Button Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ChatGhostButtonStyle}"
                                            Command="{Binding ExitSelectionCommand}"
                                            Content="ОТМЕНА"
                                            Foreground="{DynamicResource HubChatLinkBrush}"
                                            FontWeight="SemiBold"
                                            AutomationProperties.Name="Выйти из режима выделения" />
                                </Grid>
                                <Grid Visibility="{Binding IsSelectionMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Заголовок кликабельный: карточка собеседника (tg-profile). -->
                                <Button Margin="-6,0,0,0"
                                        Padding="6,4"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding TogglePeerCardCommand}"
                                        AutomationProperties.Name="Открыть карточку собеседника">
                                    <StackPanel>
                                        <!-- DockPanel по контенту: эмодзи-статус обнимает имя;
                                             при дефиците ширины текст троеточится (в отличие от
                                             горизонтального StackPanel с бесконечной мерой). -->
                                        <DockPanel HorizontalAlignment="Left">
                                            <!-- Статус-эмодзи (🛟/✨/🔖) справа от имени —
                                                 как emoji-status в Telegram. -->
                                            <local:EmojiGlyph DockPanel.Dock="Right"
                                                              Margin="4,0,0,0"
                                                              VerticalAlignment="Center"
                                                              FontSize="13"
                                                              Glyph="{Binding SelectedConversation.StatusEmoji}"
                                                              Visibility="{Binding SelectedConversation.HasStatusEmoji, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock FontSize="15"
                                                       MaxWidth="520"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedConversation.Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <!-- «печатает…» заменяет статус акцентным — как в Telegram. -->
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HubChatLinkBrush}"
                                                   Text="{Binding TypingText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.Name="Индикатор набора текста"
                                                   Visibility="{Binding HasTypingText, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Подзаголовок (статус/вид диалога) целиком
                                             заменяется строкой «печатает…» — как в
                                             Telegram Desktop (две строки шапки). -->
                                        <StackPanel Visibility="{Binding HasTypingText, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Text="{Binding SelectedConversation.PresenceText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.Name="Статус собеседника"
                                                   Visibility="{Binding SelectedConversation.PresenceText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedConversation.IsOnline}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource HubChatLinkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                   Text="{Binding SelectedConversation.KindText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SelectedConversation.KindText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <!-- Telegram: справа — 🔍 поиск, ℹ информация,
                                     ⋮ второстепенное, статус-пилюля. -->
                                <Button x:Name="HeaderMessageSearchButton"
                                        Grid.Column="1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding ToggleMessageSearchCommand}"
                                        AutomationProperties.Name="Поиск по сообщениям">
                                    <local:VectorIcon Size="20"
                                                      Data="{x:Static local:VectorIcons.Search}" />
                                </Button>
                                <!-- Явный вход в карточку собеседника — дублирует
                                     клик по заголовку, но видим и фокусируем (UI-009). -->
                                <Button Grid.Column="2"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding TogglePeerCardCommand}"
                                        AutomationProperties.Name="Информация о собеседнике">
                                    <local:VectorIcon Size="20"
                                                      Data="{x:Static local:VectorIcons.Info}" />
                                </Button>
                                <Menu Grid.Column="3"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Background="Transparent">
                                    <MenuItem Style="{StaticResource ChatMenuRootDownStyle}"
                                              ToolTip="Действия диалога"
                                              AutomationProperties.Name="Действия диалога">
                                        <MenuItem.Header>
                                            <local:VectorIcon Size="20"
                                                              Data="{x:Static local:VectorIcons.MoreVertical}" />
                                        </MenuItem.Header>
                                        <MenuItem.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}" />
                                        </MenuItem.Resources>
                                        <MenuItem Command="{Binding ToggleMediaPanelCommand}"
                                                  Header="Медиа"
                                                  AutomationProperties.Name="Медиагалерея диалога">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Photo}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding ToggleMembersPanelCommand}"
                                                  Header="Участники"
                                                  AutomationProperties.Name="Участники группы"
                                                  Visibility="{Binding SelectedConversation.IsGroupLike, Converter={StaticResource BoolToVisibility}}">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Group}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding ToggleGroupSettingsCommand}"
                                                  Header="Настройки группы"
                                                  AutomationProperties.Name="Настройки группы">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Settings}" />
                                            </MenuItem.Icon>
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedConversation.Kind}" Value="group">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </MenuItem>
                                </Menu>
                                <Border Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HubStatusPillStyle}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource HubToneDotStyle}"
                                                 local:HubTone.Value="{Binding ConnectionTone}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                   Text="{Binding ConnectionStatusText}"
                                                   AutomationProperties.Name="Статус подключения чата" />
                                    </StackPanel>
                                </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Плашка ассистента: статус запуска + стоп/повтор/сброс контекста -->
                        <Border Grid.Row="1"
                                Margin="14,6,14,0"
                                Padding="10,8"
                                Background="{DynamicResource HubChatPanelBrush}"
                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsAiConversation, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Статус ассистента">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding AiStatusText}"
                                               Visibility="{Binding HasAiStatus, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.Name="Статус запуска ассистента" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                               Text="{Binding AiStatusHint}"
                                               Visibility="{Binding AiStatusHint, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding AiReadOnlyText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsAiReadOnly, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding AiErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasAiError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding StopAiRunCommand}"
                                        Content="Остановить"
                                        Visibility="{Binding CanStopAiRun, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Остановить ассистента" />
                                <Button Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding RetryAiRunCommand}"
                                        Content="Повторить"
                                        Visibility="{Binding CanRetryAiRun, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Повторить запуск ассистента" />
                                <Button Grid.Column="3"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding ResetAiContextCommand}"
                                        Content="Сбросить контекст"
                                        AutomationProperties.Name="Сбросить контекст ассистента" />
                            </Grid>
                        </Border>

                        <!-- Плашка закреплённого сообщения (клик → переход к якорю):
                             акцентная полоса слева + «Закреплённое сообщение» акцентом
                             и превью — двухстрочная, как в Telegram Desktop. В adaptive-
                             раскладке выравнивается по центрированной колонке ленты. -->
                        <Grid Grid.Row="2"
                              MaxWidth="740"
                              Visibility="{Binding HasPinnedMessages, Converter={StaticResource BoolToVisibility}}">
                        <Button Margin="16,6,14,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource ChatGhostButtonStyle}"
                                Command="{Binding JumpToPinnedCommand}"
                                AutomationProperties.Name="Перейти к закреплённому сообщению">
                            <Grid>
                                <Border Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="2"
                                        Background="{DynamicResource HubChatAccentBrush}" />
                                <StackPanel Margin="11,0,0,0">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HubChatAccentBrush}"
                                               Text="{Binding PinnedBarTitleText}" />
                                    <TextBlock Margin="0,1,0,0"
                                               MaxWidth="560"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                               Text="{Binding PinnedBarPreviewText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        </Grid>

                        <!-- Подгрузка старых сообщений -->
                        <TextBlock Grid.Row="4"
                                   Panel.ZIndex="2"
                                   Margin="0,8,0,0"
                                   Padding="8,3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Background="{DynamicResource HubChatPanelBrush}"
                                   Foreground="{DynamicResource HubTextBrush}"
                                   Text="Загрузка истории…"
                                   Visibility="{Binding IsLoadingOlder, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="RetryOlderHistoryButton"
                                Grid.Row="4"
                                Panel.ZIndex="2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Style="{StaticResource HubSecondaryButtonStyle}"
                                Content="Повторить загрузку истории"
                                Command="{Binding LoadOlderCommand}"
                                Visibility="{Binding HasOlderHistoryError, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Фон ленты: почти невидимый повторяющийся паттерн
                             (default wallpaper tdesktop) — область сообщений +
                             композер: в tdesktop wallpaper продолжается под
                             панелью ввода, поле ввода плавает на нём. -->
                        <Border Grid.Row="4"
                                Grid.RowSpan="4"
                                Background="{DynamicResource HubChatAreaPatternBrush}" />

                        <!-- Лента сообщений: колонка ограниченной ширины по центру —
                             как в Telegram Desktop. ChatScrollAssist: следит за
                             прокруткой (FAB «вниз») и слушает ScrollToEndSignal. -->
                        <Grid Grid.Row="4" MaxWidth="740">
                            <ListBox x:Name="MessagesList"
                                     Style="{StaticResource ChatOverlayListBoxStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="16,4,14,4"
                                     ItemsSource="{Binding Messages}"
                                     SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ChatMessageItemStyle}"
                                     IsTabStop="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PreviewMouseWheel="MessagesList_PreviewMouseWheel"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                     local:ChatScrollAssist.Track="True"
                                     local:ChatScrollAssist.EndSignal="{Binding ScrollToEndSignal}"
                                     AutomationProperties.Name="Сообщения диалога">
                                <!-- UI-022: короткая история у нижнего края —
                                     свободное место остаётся над сообщениями. -->
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="RowRoot" Margin="0,1,0,1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Разделитель дня: центрированная пилюля («Сегодня»/«Вчера»/дата). -->
                                            <Border Grid.Row="0"
                                                    Margin="0,6,0,8"
                                                    Padding="12,3"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource HubChatPillBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{Binding ShowDaySeparator, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubChatPillTextBrush}"
                                                           Text="{Binding DaySeparatorText}" />
                                            </Border>

                                            <!-- «Непрочитанные сообщения»: полоса во всю ширину ленты
                                                 с подписью по центру — unread bar Telegram Desktop.
                                                 Отрицательные поля выводят её за ListBox.Padding. -->
                                            <Border Grid.Row="1"
                                                    Margin="-16,3,-14,5"
                                                    Padding="0,4"
                                                    Background="{DynamicResource HubChatPillBrush}"
                                                    Visibility="{Binding ShowUnreadDivider, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubChatPillTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Text="Непрочитанные сообщения" />
                                            </Border>

                                            <!-- Системное событие (kind="system"): центрированная
                                                 приглушённая пилюля вместо пузыря (parity web). -->
                                            <Border Grid.Row="2"
                                                    Margin="0,2"
                                                    Padding="12,3"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource HubChatPillBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubChatPillTextBrush}"
                                                           Text="{Binding BodyText}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <!-- Обычное сообщение: аватар (входящие в группе) + пузырь. -->
                                            <Grid x:Name="MsgRow"
                                                  Grid.Row="2"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Visibility="{Binding IsSystem, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ChatMessageContextMenuStyle}">
                                                        <!-- Все пункты — с иконкой слева (tg-context). -->
                                                        <ContextMenu.Resources>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}" />
                                                        </ContextMenu.Resources>
                                                        <!-- Быстрые реакции — горизонтальный ряд эмодзи сверху
                                                             меню, как в Telegram Desktop (tg-context). Вложенные
                                                             MenuItem рисуются инлайн через ItemsPresenter — клик
                                                             исполняет команду и закрывает меню как обычный пункт. -->
                                                        <MenuItem Height="44"
                                                                  AutomationProperties.Name="Быстрые реакции"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Template>
                                                                <ControlTemplate TargetType="MenuItem">
                                                                    <Border Margin="0,0,0,6"
                                                                            Padding="5,3"
                                                                            HorizontalAlignment="Left"
                                                                            Background="{DynamicResource HubChatPanelBrush}"
                                                                            CornerRadius="19"
                                                                            Effect="{StaticResource HubFlyoutShadow}">
                                                                        <ItemsPresenter />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </MenuItem.Template>
                                                            <MenuItem.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                                                </ItemsPanelTemplate>
                                                            </MenuItem.ItemsPanel>
                                                            <MenuItem Header="❤️"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="❤️" />
                                                            <MenuItem Header="👍"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="👍" />
                                                            <MenuItem Header="😁"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="😁" />
                                                            <MenuItem Header="🤝"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="🤝" />
                                                            <MenuItem Header="🥰"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="🥰" />
                                                            <MenuItem Header="🔥"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="🔥" />
                                                            <MenuItem Header="😢"
                                                                      Style="{StaticResource ChatQuickReactionItemStyle}"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="😢" />
                                                            <MenuItem Header="Ещё реакции"
                                                                      Style="{StaticResource ChatQuickReactionExpandStyle}"
                                                                      AutomationProperties.Name="Ещё реакции"
                                                                      ToolTip="Ещё реакции">
                                                                <MenuItem Header="👍"
                                                                          Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="👍" />
                                                                <MenuItem Header="❤️"
                                                                          Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="❤️" />
                                                                <MenuItem Header="😂"
                                                                          Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="😂" />
                                                                <MenuItem Header="🎉"
                                                                          Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="🎉" />
                                                                <MenuItem Header="😮"
                                                                          Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="😮" />
                                                                <MenuItem Header="👎"
                                                                          Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="👎" />
                                                            </MenuItem>
                                                        </MenuItem>
                                                        <MenuItem Header="Ответить"
                                                                  Command="{Binding PlacementTarget.Tag.BeginReplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Reply}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Изменить"
                                                                  Command="{Binding PlacementTarget.Tag.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Edit}" />
                                                            </MenuItem.Icon>
                                                            <!-- Править можно только kind="text" — опросы скрываем. -->
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding PlacementTarget.DataContext.CanEditOrDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                                <Condition Binding="{Binding PlacementTarget.DataContext.HasPoll, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Pin}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Копировать текст"
                                                                  Command="{Binding PlacementTarget.Tag.CopyMessageTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Copy}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Переслать"
                                                                  Command="{Binding PlacementTarget.Tag.BeginForwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Forward}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Завершить опрос"
                                                                  Command="{Binding PlacementTarget.DataContext.ClosePollCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanClosePoll, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Poll}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Кто прочитал"
                                                                  Command="{Binding PlacementTarget.Tag.ShowMessageReadersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.DoneAll}" />
                                                            </MenuItem.Icon>
                                                            <!-- Только свои и прочитанные: StatusText = «✓✓». -->
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.StatusText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                     Value="✓✓">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <!-- «Выделить» — вход в мультивыбор (порядок пунктов
                                                             как в tdesktop: после «Кто прочитал»). -->
                                                        <MenuItem Header="Выделить"
                                                                  Command="{Binding PlacementTarget.Tag.BeginSelectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.SelectAll}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Пожаловаться"
                                                                  Command="{Binding PlacementTarget.Tag.BeginReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReport, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Flag}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Visibility="{Binding PlacementTarget.DataContext.CanEditOrDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Удалить"
                                                                  Foreground="{DynamicResource HubErrorTextBrush}"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanEditOrDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem.Icon>
                                                                <local:VectorIcon Size="16"
                                                                                  Foreground="{DynamicResource HubErrorTextBrush}"
                                                                                  Data="{x:Static local:VectorIcons.Trash}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <!-- Аватарка входящего в группе: колонка зарезервирована
                                                     всегда (ShowSender), кружок — на крайнем сообщении серии.
                                                     Градиент пира + белые инициалы, как в Telegram Desktop. -->
                                                <Grid Width="34"
                                                      Visibility="{Binding ShowSender, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Width="30"
                                                            Height="30"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="15"
                                                            Background="{Binding SenderAvatarBrush}"
                                                            Visibility="{Binding ShowSenderAvatar, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"
                                                                       Text="{Binding SenderAvatarInitials}" />
                                                            <Border CornerRadius="15"
                                                                    Visibility="{Binding HasSenderAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding SenderAvatarImage}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <Border x:Name="Bubble"
                                                        Grid.Column="1"
                                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Ratio}, ConverterParameter=0.68}"
                                                        Margin="6,0,0,0"
                                                        Padding="12,7"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource HubChatBubbleInBrush}"
                                                        CornerRadius="16"
                                                        SnapsToDevicePixels="True">
                                                    <!-- Мягкая тень — едва заметная, как в Telegram. -->
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6"
                                                                          Direction="270"
                                                                          ShadowDepth="1"
                                                                          Opacity="0.18"
                                                                          RenderingBias="Quality" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                    <!-- Имя отправителя — персональный цвет пира, как в Telegram. -->
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding SenderNameBrush}"
                                                               Text="{Binding SenderName}"
                                                               Visibility="{Binding ShowSender, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="12"
                                                               FontStyle="Italic"
                                                               Text="{Binding ForwardText}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding ForwardText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubChatLinkBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubChatOutTextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Цитата-ответ: левая акцентная полоса отличает её от тела
                                                         сообщения; клик — переход к оригиналу (tg «go to replied»). -->
                                                    <Button Margin="0,4,0,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding OpenReplyTargetCommand}"
                                                            Visibility="{Binding ReplyText, Converter={StaticResource NonEmptyStringToVisibility}}"
                                                            AutomationProperties.Name="Перейти к цитируемому сообщению">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Quote"
                                                                        Padding="8,0,0,0"
                                                                        BorderThickness="3,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource HubChatLinkBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource HubChatOutTextBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="12"
                                                                               FontStyle="Italic"
                                                                               Text="{Binding ReplyText}"
                                                                               TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource HubChatOutTextMutedBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <local:LinkifiedTextBlock Margin="0,2,0,0"
                                                                              FontSize="14"
                                                                              LinkText="{Binding BodyText}"
                                                                              LinkCommand="{Binding OpenBodyLinkCommand}"
                                                                              TextWrapping="Wrap">
                                                        <local:LinkifiedTextBlock.Style>
                                                            <Style TargetType="local:LinkifiedTextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubChatOutTextBrush}" />
                                                                        <Setter Property="local:LinkifiedTextBlock.LinkResourceKey" Value="HubChatOutLinkBrush" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:LinkifiedTextBlock.Style>
                                                        <!-- UI-023: метаданные инлайн в конце последней строки
                                                             текста, как в Telegram. Без тела/с вложениями —
                                                             отдельной строкой ниже (MetaInlineInText). -->
                                                        <local:LinkifiedTextBlock.TrailingContent>
                                                            <StackPanel Margin="7,0,0,0"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding MetaInlineInText, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource HubChatOutTextMutedBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Margin="0,0,4,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Text="{Binding EditedText}"
                                                                           Visibility="{Binding EditedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Text="{Binding TimeText}" />
                                                                <local:VectorIcon Margin="4,0,0,0"
                                                                                  Size="11"
                                                                                  VerticalAlignment="Center"
                                                                                  Data="{Binding StatusText, Converter={StaticResource EmojiToVector}}"
                                                                                  Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                                    <local:VectorIcon.ToolTip>
                                                                        <ToolTip Content="Статус доставки: ✓ отправлено, ✓✓ прочитано" />
                                                                    </local:VectorIcon.ToolTip>
                                                                </local:VectorIcon>
                                                            </StackPanel>
                                                        </local:LinkifiedTextBlock.TrailingContent>
                                                    </local:LinkifiedTextBlock>
                                                    <!-- Превью первой ссылки в тексте (parity web ChatLinkPreview) -->
                                                    <ItemsControl Margin="0,6,0,0"
                                                                  ItemsSource="{Binding LinkPreviewItems}"
                                                                  Visibility="{Binding HasLinkPreviews, Converter={StaticResource BoolToVisibility}}"
                                                                  AutomationProperties.Name="Превью ссылки">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="AutomationProperties.Name" Value="{Binding HeaderText, StringFormat='Превью ссылки: {0}'}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Command="{Binding OpenCommand}"
                                                                        AutomationProperties.Name="{Binding HeaderText, StringFormat='Открыть ссылку {0}'}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Card"
                                                                                    Padding="10,7"
                                                                                    Background="{DynamicResource HubSurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource HubChatLinkBrush}"
                                                                                    BorderThickness="3,0,0,0"
                                                                                    CornerRadius="0,8,8,0">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Border Width="44"
                                                                                            Height="44"
                                                                                            Margin="0,0,10,0"
                                                                                            VerticalAlignment="Top"
                                                                                            CornerRadius="6"
                                                                                            ClipToBounds="True"
                                                                                            Background="{DynamicResource HubChatHoverBrush}">
                                                                                        <Grid>
                                                                                            <local:VectorIcon HorizontalAlignment="Center"
                                                                                                              VerticalAlignment="Center"
                                                                                                              Size="18"
                                                                                                              Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                                              Data="{x:Static local:VectorIcons.Link}" />
                                                                                            <Image Stretch="UniformToFill"
                                                                                                   Source="{Binding ImageUrl}"
                                                                                                   Visibility="{Binding ImageUrl, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <StackPanel Grid.Column="1"
                                                                                                VerticalAlignment="Center">
                                                                                        <TextBlock FontSize="11"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource HubChatLinkBrush}"
                                                                                                   Text="{Binding HeaderText}"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="13"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource HubTextBrush}"
                                                                                                   Text="{Binding Title}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   TextWrapping="Wrap"
                                                                                                   MaxHeight="36"
                                                                                                   Visibility="{Binding Title, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                                   Text="{Binding Description}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   TextWrapping="Wrap"
                                                                                                   MaxHeight="32"
                                                                                                   Visibility="{Binding Description, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                                   Text="Загрузка превью…"
                                                                                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                                    <Setter TargetName="Card" Property="BorderThickness" Value="3,0,0,2" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Карточка задачи (kind="task_share" + task_preview) -->
                                                    <Border Margin="0,6,0,0"
                                                            Padding="10,7"
                                                            Background="{DynamicResource HubSurfaceBrush}"
                                                            BorderBrush="{DynamicResource HubChatLinkBrush}"
                                                            BorderThickness="3,0,0,0"
                                                            CornerRadius="0,8,8,0"
                                                            AutomationProperties.Name="Карточка задачи"
                                                            Visibility="{Binding HasTaskCard, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <local:VectorIcon Margin="0,0,10,0"
                                                                              VerticalAlignment="Top"
                                                                              Size="18"
                                                                              Foreground="{DynamicResource HubChatLinkBrush}"
                                                                              Data="{x:Static local:VectorIcons.Task}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource HubTextBrush}"
                                                                           Text="{Binding TaskCardTitle}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                           Text="{Binding TaskCardMeta}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding TaskCardMeta, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TaskCardIsOverdue}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl Margin="0,4,0,0"
                                                                  ItemsSource="{Binding PollOptions}"
                                                                  Visibility="{Binding HasPoll, Converter={StaticResource BoolToVisibility}}"
                                                                  AutomationProperties.Name="Варианты опроса">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="AutomationProperties.Name" Value="{Binding Text, StringFormat='Вариант опроса: {0}'}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Margin="0,2,0,0"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Command="{Binding VoteCommand}"
                                                                        AutomationProperties.Name="{Binding Text, StringFormat='Вариант опроса {0}'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Grid MinHeight="32">
                                                                                <ProgressBar Minimum="0"
                                                                                             Maximum="100"
                                                                                             Value="{Binding Percent, Mode=OneWay}"
                                                                                             Foreground="{DynamicResource HubChatLinkBrush}"
                                                                                             Background="{DynamicResource HubSurfaceBrush}" />
                                                                                <Border x:Name="Surface"
                                                                                        Padding="8,0"
                                                                                        Background="Transparent"
                                                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="6">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock VerticalAlignment="Center"
                                                                                                   FontSize="13"
                                                                                                   Foreground="{DynamicResource HubTextBrush}"
                                                                                                   Text="{Binding Text}"
                                                                                                   TextTrimming="CharacterEllipsis">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Margin="8,0,0,0"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Orientation="Horizontal">
                                                                                            <local:VectorIcon Size="12"
                                                                                                              VerticalAlignment="Center"
                                                                                                              Foreground="{DynamicResource HubChatLinkBrush}"
                                                                                                              Data="{x:Static local:VectorIcons.Check}"
                                                                                                              Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}" />
                                                                                            <TextBlock Margin="4,0,0,0"
                                                                                                       FontSize="11"
                                                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                                       Text="{Binding VotesText}"
                                                                                                       Visibility="{Binding VotesText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.8" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding PollSummaryText}"
                                                               Visibility="{Binding PollSummaryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <ItemsControl Margin="0,4,0,0"
                                                                  ItemsSource="{Binding AttachmentItems}"
                                                                  Visibility="{Binding HasAttachmentItems, Converter={StaticResource BoolToVisibility}}"
                                                                  AutomationProperties.Name="Вложения сообщения">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="AutomationProperties.Name" Value="{Binding FileName, StringFormat='Вложение: {0}'}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid HorizontalAlignment="Left">
                                                                <!-- Image-вложение — кликабельная плитка-картинка
                                                                     (Telegram), открывает просмотрщик. -->
                                                                <Button Margin="0,2,0,0"
                                                                        Command="{Binding OpenCommand}"
                                                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                                                        FocusVisualStyle="{StaticResource HubFocusStyle}"
                                                                        AutomationProperties.Name="{Binding FileName, StringFormat='Открыть изображение {0}'}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Tile"
                                                                                    Width="{Binding PhotoWidth}"
                                                                                    Height="{Binding PhotoHeight}"
                                                                                    CornerRadius="10"
                                                                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                                                    SnapsToDevicePixels="True">
                                                                                <Grid>
                                                                                    <StackPanel Margin="8"
                                                                                                VerticalAlignment="Center"
                                                                                                Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                                                                                        <local:VectorIcon Size="22"
                                                                                                          HorizontalAlignment="Center"
                                                                                                          Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                          Data="{x:Static local:VectorIcons.Photo}" />
                                                                                        <TextBlock Margin="0,4,0,0"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                   Text="{Binding FileName}"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <Border CornerRadius="10"
                                                                                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                                                                                        <Border.Background>
                                                                                            <ImageBrush ImageSource="{Binding Preview}" Stretch="Uniform" />
                                                                                        </Border.Background>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Tile" Property="Opacity" Value="0.9" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                <!-- Прочие виды — обычный чип. -->
                                                                <Button Margin="0,2,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Command="{Binding OpenCommand}"
                                                                        Visibility="{Binding IsImage, Converter={StaticResource InverseBoolToVisibility}}"
                                                                        AutomationProperties.Name="{Binding FileName, StringFormat='Открыть вложение {0}'}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="ChipBg"
                                                                                    Padding="8,4"
                                                                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <local:VectorIcon VerticalAlignment="Center"
                                                                                                      Size="14"
                                                                                                      Foreground="{DynamicResource HubChatAccentBrush}"
                                                                                                      Data="{Binding IconData}" />
                                                                                    <TextBlock Margin="6,0,0,0"
                                                                                               MaxWidth="220"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="12"
                                                                                               Foreground="{DynamicResource HubTextBrush}"
                                                                                               Text="{Binding FileName}"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Margin="8,0,0,0"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                               Text="{Binding SizeText}"
                                                                                               Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                                    <Setter TargetName="ChipBg" Property="BorderThickness" Value="2" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Карточка действия ассистента: превью операции, выбор,
                                                         подтвердить/отмена, терминальный статус и ссылка на результат -->
                                                    <Border Margin="0,8,0,0"
                                                            Padding="10,8"
                                                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                            BorderBrush="{DynamicResource HubChatLinkBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Visibility="{Binding HasActionCard, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="Карточка действия ассистента">
                                                        <!-- Visibility биндится к HasActionCard сообщения, а
                                                             DataContext карточки переключаем внутри — иначе
                                                             при ActionCard=null рамка остаётся видимой. -->
                                                        <StackPanel DataContext="{Binding ActionCard}">
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource HubTextBrush}"
                                                                       Text="{Binding Title}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding Summary}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                                                            <ItemsControl Margin="0,4,0,0"
                                                                          ItemsSource="{Binding Items}"
                                                                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                                                                          AutomationProperties.Name="Состав сообщения">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Margin="0,1,0,0"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource HubTextBrush}"
                                                                                   Text="{Binding}"
                                                                                   TextWrapping="Wrap" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl Margin="0,4,0,0"
                                                                          ItemsSource="{Binding Warnings}"
                                                                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}"
                                                                          AutomationProperties.Name="Предупреждения">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Margin="0,1,0,0"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource HubErrorTextBrush}"
                                                                                   Text="{Binding}"
                                                                                   TextWrapping="Wrap" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ComboBox Margin="0,6,0,0"
                                                                      ItemsSource="{Binding Choices}"
                                                                      SelectedItem="{Binding SelectedChoice}"
                                                                      DisplayMemberPath="Label"
                                                                      IsEnabled="{Binding IsActionable}"
                                                                      Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}"
                                                                      AutomationProperties.Name="Вариант действия ассистента" />
                                                            <ComboBox Margin="0,6,0,0"
                                                                      ItemsSource="{Binding Formats}"
                                                                      SelectedItem="{Binding SelectedFormat}"
                                                                      DisplayMemberPath="Label"
                                                                      IsEnabled="{Binding IsActionable}"
                                                                      Visibility="{Binding HasFormats, Converter={StaticResource BoolToVisibility}}"
                                                                      AutomationProperties.Name="Формат результата" />
                                                            <StackPanel Margin="0,8,0,0"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding IsActionable, Converter={StaticResource BoolToVisibility}}">
                                                                <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                                                        Command="{Binding ConfirmCommand}"
                                                                        Content="Подтвердить"
                                                                        AutomationProperties.Name="Подтвердить действие ассистента" />
                                                                <Button Margin="8,0,0,0"
                                                                        Style="{StaticResource ChatGhostButtonStyle}"
                                                                        Command="{Binding CancelCommand}"
                                                                        Content="Отмена"
                                                                        AutomationProperties.Name="Отменить действие ассистента" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,6,0,0"
                                                                        Orientation="Horizontal">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                           Text="{Binding StatusText}"
                                                                           Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                <Button Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Style="{StaticResource ChatGhostButtonStyle}"
                                                                        Command="{Binding OpenResultCommand}"
                                                                        Content="Открыть результат"
                                                                        Visibility="{Binding HasResultUrl, Converter={StaticResource BoolToVisibility}}"
                                                                        AutomationProperties.Name="Открыть результат действия" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                                                       Text="{Binding ErrorText}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Чипы реакций (tg-reactions): цветной
                                                         эмодзи + счётчик на подложке. -->
                                                    <ItemsControl Margin="0,6,0,0"
                                                                  ItemsSource="{Binding ReactionItems}"
                                                                  Visibility="{Binding HasReactionItems, Converter={StaticResource BoolToVisibility}}"
                                                                  AutomationProperties.Name="Реакции на сообщение">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="AutomationProperties.Name" Value="{Binding Emoji, StringFormat='Реакция {0}'}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,4,0"
                                                                        Padding="7,1"
                                                                        CornerRadius="11"
                                                                        Background="{DynamicResource HubChatHoverBrush}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <local:EmojiGlyph VerticalAlignment="Center"
                                                                                          FontSize="13"
                                                                                          Glyph="{Binding Emoji}" />
                                                                        <TextBlock Margin="4,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                   Text="{Binding CountText}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Отдельная строка метаданных — только когда инлайн
                                                         недоступен: нет тела или под текстом есть вложения/
                                                         карточка (UI-023). -->
                                                    <StackPanel Margin="0,4,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding MetaInlineInText, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource HubChatSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource HubChatOutTextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Margin="0,0,4,0"
                                                                   FontSize="11"
                                                                   Text="{Binding EditedText}"
                                                                   Visibility="{Binding EditedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        <TextBlock FontSize="11"
                                                                   Text="{Binding TimeText}" />
                                                        <!-- Галочки доставки справа от времени — как в Telegram. -->
                                                        <local:VectorIcon Margin="4,0,0,0"
                                                                          Size="11"
                                                                          Data="{Binding StatusText, Converter={StaticResource EmojiToVector}}"
                                                                          Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                            <local:VectorIcon.ToolTip>
                                                                <ToolTip Content="Статус доставки: ✓ отправлено, ✓✓ прочитано" />
                                                            </local:VectorIcon.ToolTip>
                                                        </local:VectorIcon>
                                                    </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Хвостик пузыря — выступ со стороны отправителя у крайнего
                                                     сообщения серии (UI-024): изгиб у нижнего угла, зеркально
                                                     для своих. Цвет совпадает с заливкой пузыря. -->
                                                <Path x:Name="BubbleTail"
                                                      Grid.Column="1"
                                                      Width="22"
                                                      Height="12"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Bottom"
                                                      Data="M6,0 C6,5 5,9 0,12 H22 V0 Z"
                                                      Fill="{DynamicResource HubChatBubbleInBrush}"
                                                      IsHitTestVisible="False"
                                                      Visibility="Collapsed" />
                                                <!-- Круг выделения у правого края строки — в режиме
                                                     мультивыбора (tg-multiselect): пустой круг,
                                                     выбранное — акцент с белой галочкой. -->
                                                <Border Grid.Column="2"
                                                        Width="22"
                                                        Height="22"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource HubChatSecondaryBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="11"
                                                        Visibility="{Binding Tag.IsSelectionMode, ElementName=MsgRow, Converter={StaticResource BoolToVisibility}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HubChatAccentBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <local:VectorIcon Size="12"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="White"
                                                                      Data="{x:Static local:VectorIcons.Check}"
                                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                </Border>
                                                <!-- Клик по строке в режиме выделения — toggle галочки;
                                                     перекрывает контент пузыря только в режиме. -->
                                                <Button Grid.Column="0"
                                                        Grid.ColumnSpan="3"
                                                        Command="{Binding Tag.ToggleMessageSelectionCommand, ElementName=MsgRow}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Visibility="{Binding Tag.IsSelectionMode, ElementName=MsgRow, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="Переключить выделение сообщения">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- Серия одного отправителя — компактный интервал (2px),
                                                 новая серия/день — 10px, как в Telegram. -->
                                            <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                                                <Setter TargetName="RowRoot" Property="Margin" Value="0,9,0,1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="Bubble" Property="Margin" Value="0,0,6,0" />
                                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource HubChatBubbleOutBrush}" />
                                                <Setter TargetName="Bubble" Property="TextElement.Foreground" Value="{DynamicResource HubChatOutTextBrush}" />
                                            </DataTrigger>
                                            <!-- Форма серии (UI-024, зеркально для своих): смежные
                                                 углы соседних пузырей согласованы малым радиусом,
                                                 у крайнего — выступ-хвостик со стороны отправителя.
                                                 Одиночное сообщение: все углы 16 + хвостик. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupStart}" Value="True" />
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="False" />
                                                    <Condition Binding="{Binding IsOwn}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,16,4" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupStart}" Value="False" />
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="False" />
                                                    <Condition Binding="{Binding IsOwn}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="4,16,16,4" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupStart}" Value="False" />
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="True" />
                                                    <Condition Binding="{Binding IsOwn}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="4,16,16,16" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupStart}" Value="True" />
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="False" />
                                                    <Condition Binding="{Binding IsOwn}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,4,16" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupStart}" Value="False" />
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="False" />
                                                    <Condition Binding="{Binding IsOwn}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="16,4,4,16" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupStart}" Value="False" />
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="True" />
                                                    <Condition Binding="{Binding IsOwn}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bubble" Property="CornerRadius" Value="16,4,16,16" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGroupEnd}" Value="True" />
                                                    <Condition Binding="{Binding IsOwn}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="BubbleTail" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="BubbleTail" Property="Data" Value="M16,0 C16,5 17,9 22,12 H0 V0 Z" />
                                                <Setter TargetName="BubbleTail" Property="Fill" Value="{DynamicResource HubChatBubbleOutBrush}" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsGroupEnd}" Value="True">
                                                <Setter TargetName="BubbleTail" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsMessagesEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Сообщений пока нет. Напишите первым." />
                            </StackPanel>
                            <!-- Ошибка загрузки истории — отдельно от честной пустой
                                 ленты: причина + повтор именно для этого диалога. -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasHistoryError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock HorizontalAlignment="Center"
                                           MaxWidth="360"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Не удалось загрузить сообщения." />
                                <TextBlock Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           MaxWidth="360"
                                           Foreground="{DynamicResource HubErrorTextBrush}"
                                           Text="{Binding HistoryErrorText}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding RetryHistoryCommand}"
                                        Content="Повторить"
                                        AutomationProperties.Name="Повторить загрузку сообщений" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Загрузка сообщений…"
                                       Visibility="{Binding IsLoadingMessages, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Поиск по сообщениям поверх ленты -->
                            <Border x:Name="MessageSearchPanel"
                                    Panel.ZIndex="1"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsMessageSearchOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageSearchInput"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding MessageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Поиск по сообщениям диалога" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                   Text="Текст сообщения…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=MessageSearchInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding ToggleMessageSearchCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть поиск по сообщениям"
                                                AutomationProperties.Name="Закрыть поиск по сообщениям" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="{Binding MessageSearchHint}"
                                               Visibility="{Binding MessageSearchHint, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <ListBox Grid.Row="2"
                                             MaxHeight="320"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding SearchResults}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Результаты поиска по сообщениям">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.PickSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Surface"
                                                                    Padding="8,6"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding SenderName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="13"
                                                                   Text="{Binding BodyText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Пересылка: модал выбора диалога поверх ленты (tg-forward):
                                 дим, заголовок, свой поиск «Переслать в…», строки диалогов
                                 с фото-аватарами, клик — сразу отправка. -->
                            <Grid Panel.ZIndex="1"
                                  Visibility="{Binding IsForwardPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Border Background="#33000000" />
                                <Border MaxWidth="430"
                                        MaxHeight="500"
                                        MinWidth="360"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource HubChatPanelBrush}"
                                        BorderBrush="{DynamicResource HubBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        AutomationProperties.Name="Выбор диалога для пересылки">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="18,14,12,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Text="Переслать сообщение" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                           Text="{Binding ForwardingMessage.ReplySummaryText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding ForwardingMessage.ReplySummaryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding CloseForwardPanelCommand}"
                                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                    ToolTip="Закрыть выбор диалога для пересылки"
                                                    AutomationProperties.Name="Закрыть выбор диалога для пересылки" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="14,0,14,4">
                                            <TextBox x:Name="ForwardFilterInput"
                                                     Style="{StaticResource HubTextBoxStyle}"
                                                     Text="{Binding ForwardSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Фильтр диалогов для пересылки" />
                                            <TextBlock Margin="13,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                       Text="Переслать в…">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ForwardFilterInput}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Пересылаем…"
                                                   Visibility="{Binding IsForwarding, Converter={StaticResource BoolToVisibility}}" />
                                        <Grid Grid.Row="3" Margin="0,6,0,6">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="20"
                                                       Style="{StaticResource HubMutedTextStyle}"
                                                       Text="Диалоги не найдены"
                                                       Visibility="{Binding HasForwardTargets, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ListBox Style="{StaticResource HubListBoxStyle}"
                                                     ItemsSource="{Binding ForwardTargets}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="Диалоги для пересылки">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button HorizontalContentAlignment="Stretch"
                                                                Command="{Binding DataContext.PickForwardTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding Title}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Surface"
                                                                            Padding="14,7"
                                                                            Background="Transparent">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsFocused" Value="True">
                                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Opacity" Value="0.6" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="40"
                                                                        Height="40"
                                                                        CornerRadius="20"
                                                                        Background="{Binding AvatarBrush}">
                                                                    <Grid>
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#FFFFFF"
                                                                                   Text="{Binding AvatarInitials}" />
                                                                        <Border CornerRadius="20"
                                                                                Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding AvatarImage}"
                                                                                            Stretch="UniformToFill" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="12,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource HubTextBrush}"
                                                                               Text="{Binding Title}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="11.5"
                                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                               Text="{Binding Preview}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- «Удалить сообщение?»: подтверждающая модал tg-delete
                                 (текстовые кнопки «Отмена»/красная «Удалить»). -->
                            <Grid Panel.ZIndex="3"
                                  Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">
                                <!-- Клик по затемнению = «Отмена» (как в tdesktop). -->
                                <Border Background="#33000000"
                                        MouseLeftButtonDown="OnDeleteConfirmBackdropClick" />
                                <!-- TabNavigation=Cycle: Tab/Shift+Tab циркулируют внутри
                                     модала и не уводят фокус в фон (UI-004). -->
                                <Border MaxWidth="360"
                                        MinWidth="300"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="20,18"
                                        Background="{DynamicResource HubChatPanelBrush}"
                                        BorderBrush="{DynamicResource HubBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        KeyboardNavigation.TabNavigation="Cycle"
                                        AutomationProperties.Name="Подтверждение удаления">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DeleteConfirmTitle}" />
                                        <TextBlock Margin="0,10,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                   Text="{Binding DeleteConfirmText}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,18,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                            <Button x:Name="DeleteCancelButton"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding CancelDeleteCommand}"
                                                    Content="Отмена"
                                                    IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                                    AutomationProperties.Name="Отменить удаление" />
                                            <Button Margin="8,0,0,0"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding ConfirmDeleteCommand}"
                                                    Content="Удалить"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource HubDangerBrush}"
                                                    IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                                    AutomationProperties.Name="Подтвердить удаление" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- «Отправить файлы»: модал подтверждения вложений
                                 (UI-027, tg-send-files) — список файлов с крестом
                                 удаления, подпись отдельно от черновика, Отправить/
                                 Отмена. Upload-сессия стартует только по «Отправить». -->
                            <Grid Panel.ZIndex="4"
                                  Visibility="{Binding IsAttachmentConfirmOpen, Converter={StaticResource BoolToVisibility}}">
                                <!-- Клик по затемнению = «Отмена» (как в tdesktop). -->
                                <Border Background="#33000000"
                                        MouseLeftButtonDown="OnAttachmentConfirmBackdropClick" />
                                <Border MaxWidth="430"
                                        MaxHeight="480"
                                        MinWidth="360"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource HubChatPanelBrush}"
                                        BorderBrush="{DynamicResource HubBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        KeyboardNavigation.TabNavigation="Cycle"
                                        AutomationProperties.Name="Подтверждение отправки файлов">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="18,14,12,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding PendingAttachmentTitleText}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                           Text="{Binding PendingAttachmentTargetTitle, StringFormat='Получатель: {0}'}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding PendingAttachmentTargetTitle, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding CancelAttachmentsCommand}"
                                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                    ToolTip="Отменить отправку файлов"
                                                    AutomationProperties.Name="Отменить отправку файлов" />
                                        </Grid>
                                        <ListBox Grid.Row="1"
                                                 Margin="6,4,6,0"
                                                 Style="{StaticResource HubListBoxStyle}"
                                                 ItemsSource="{Binding PendingAttachments}"
                                                 MaxHeight="250"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="Файлы к отправке">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44"
                                                                Height="44"
                                                                CornerRadius="8"
                                                                ClipToBounds="True"
                                                                Background="{DynamicResource HubChatHoverBrush}">
                                                            <Grid>
                                                                <Image Stretch="UniformToFill"
                                                                       Source="{Binding Preview}"
                                                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                                                <local:VectorIcon HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Size="18"
                                                                                  Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                  Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}"
                                                                                  Data="{Binding IconData}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding FileName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding SizeText}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                                Command="{Binding DataContext.RemovePendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                                ToolTip="Убрать файл из отправки"
                                                                AutomationProperties.Name="{Binding FileName, StringFormat='Убрать файл {0}'}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBox Grid.Row="2"
                                                 Margin="14,6,14,0"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding AttachmentCaption, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Подпись к файлам" />
                                        <Grid Grid.Row="3" Margin="14,10,14,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                       Text="{Binding UploadStatusText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasUploadStatus, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                        Command="{Binding CancelAttachmentsCommand}"
                                                        Content="Отмена"
                                                        AutomationProperties.Name="Отменить отправку" />
                                                <Button Margin="8,0,0,0"
                                                        Style="{StaticResource ChatAccentPillButtonStyle}"
                                                        Command="{Binding ConfirmAttachmentsCommand}"
                                                        Content="Отправить"
                                                        AutomationProperties.Name="Отправить файлы" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- «Кто прочитал»: мини-панель справа поверх ленты -->
                            <Border Panel.ZIndex="2"
                                    MaxWidth="320"
                                    MaxHeight="360"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsReadersPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ReadersTitleText}" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseReadersPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть список прочитавших"
                                                AutomationProperties.Name="Закрыть список прочитавших" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingReaders, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Grid.Row="2"
                                                  Margin="0,8,0,0"
                                                  ItemsSource="{Binding MessageReaders}"
                                                  AutomationProperties.Name="Прочитавшие сообщение">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="13"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding ReadAtText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- «Участники»: список и управление участниками поверх ленты -->
                            <Border Panel.ZIndex="1"
                                    MaxWidth="420"
                                    MaxHeight="460"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsMembersPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding MembersTitleText}" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseMembersPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть список участников"
                                                AutomationProperties.Name="Закрыть список участников" />
                                    </Grid>
                                    <Grid Grid.Row="1"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding CanManageGroupMembers, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox x:Name="MemberSearchInput"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Поиск участника для добавления" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                   Text="Добавить участника…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=MemberSearchInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="{Binding MemberSearchHint}"
                                               Visibility="{Binding MemberSearchHint, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <ListBox Grid.Row="3"
                                             Margin="0,6,0,0"
                                             MaxHeight="140"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding MemberCandidateResults}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Visibility="{Binding HasMemberCandidates, Converter={StaticResource BoolToVisibility}}"
                                             AutomationProperties.Name="Кандидаты в группу">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem"
                                                   BasedOn="{StaticResource HubTaskCardStyle}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.PickMemberCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Добавить {0} в группу'}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Surface"
                                                                    Padding="8,6"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Background="{Binding AvatarBrush}">
                                                            <Grid>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FFFFFF"
                                                                           Text="{Binding AvatarInitials}" />
                                                                <Border CornerRadius="16"
                                                                        Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{Binding AvatarImage}"
                                                                                    Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding Subtitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="4" Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Загрузка…"
                                                   Visibility="{Binding IsLoadingMembers, Converter={StaticResource BoolToVisibility}}" />
                                        <ListBox Grid.Row="1"
                                                 Margin="0,4,0,0"
                                                 Style="{StaticResource HubListBoxStyle}"
                                                 ItemsSource="{Binding GroupMembers}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="Участники группы">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ContextMenu>
                                                            <!-- Модерация строки — гейты web ChatContextPanel. -->
                                                            <ContextMenu>
                                                                <MenuItem Header="Назначить модератором"
                                                                          Command="{Binding PromoteCommand}"
                                                                          Visibility="{Binding CanPromote, Converter={StaticResource BoolToVisibility}}" />
                                                                <MenuItem Header="Снять модератора"
                                                                          Command="{Binding DemoteCommand}"
                                                                          Visibility="{Binding CanDemote, Converter={StaticResource BoolToVisibility}}" />
                                                                <MenuItem Header="Сделать владельцем"
                                                                          Command="{Binding TransferOwnershipCommand}"
                                                                          Visibility="{Binding CanTransferOwnership, Converter={StaticResource BoolToVisibility}}" />
                                                                <MenuItem Header="Ограничить отправку"
                                                                          Visibility="{Binding CanRestrict, Converter={StaticResource BoolToVisibility}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding CanRestrict}" Value="True" />
                                                                                        <Condition Binding="{Binding IsRestricted}" Value="False" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                    <MenuItem Header="На 1 час"
                                                                              Command="{Binding RestrictCommand}"
                                                                              CommandParameter="3600" />
                                                                    <MenuItem Header="На 1 день"
                                                                              Command="{Binding RestrictCommand}"
                                                                              CommandParameter="86400" />
                                                                    <MenuItem Header="На 1 неделю"
                                                                              Command="{Binding RestrictCommand}"
                                                                              CommandParameter="604800" />
                                                                    <MenuItem Header="Бессрочно"
                                                                              Command="{Binding RestrictCommand}" />
                                                                </MenuItem>
                                                                <MenuItem Header="Снять ограничение"
                                                                          Command="{Binding LiftRestrictionCommand}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding CanRestrict}" Value="True" />
                                                                                        <Condition Binding="{Binding IsRestricted}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Header="Исключить из группы"
                                                                          Command="{Binding RemoveCommand}"
                                                                          Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                                            </ContextMenu>
                                                        </Grid.ContextMenu>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid VerticalAlignment="Top">
                                                            <Border Width="32"
                                                                    Height="32"
                                                                    CornerRadius="16"
                                                                    Background="{Binding AvatarBrush}">
                                                                <Grid>
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#FFFFFF"
                                                                               Text="{Binding AvatarInitials}" />
                                                                    <Border CornerRadius="16"
                                                                            Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding AvatarImage}"
                                                                                        Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <Ellipse Width="9"
                                                                     Height="9"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Fill="{DynamicResource HubSuccessBrush}"
                                                                     AutomationProperties.Name="В сети"
                                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="13"
                                                                           MaxWidth="260"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Margin="6,0,0,0"
                                                                        Padding="5,1"
                                                                        CornerRadius="8"
                                                                        Background="{DynamicResource HubChatHoverBrush}"
                                                                        Visibility="{Binding RoleText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                                    <TextBlock FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource HubChatLinkBrush}"
                                                                               Text="{Binding RoleText}" />
                                                                </Border>
                                                                <TextBlock Margin="6,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource HubErrorTextBrush}"
                                                                           Text="{Binding RestrictedText}"
                                                                           Visibility="{Binding RestrictedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding Subtitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <!-- Модерация — через контекстное меню строки
                                                             (как в Telegram Desktop): inline-кнопки
                                                             обрезали бейджи ролей. -->
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- «Настройки группы»: профиль, аватар, ссылка-приглашение, модерация (web ChatContextPanel) -->
                            <Border x:Name="GroupSettingsPanel"
                                    Panel.ZIndex="2"
                                    MaxWidth="440"
                                    MaxHeight="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Настройки группы"
                                    Visibility="{Binding IsGroupSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="Настройки группы" />
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding CloseGroupSettingsCommand}"
                                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                    ToolTip="Закрыть настройки группы"
                                                    AutomationProperties.Name="Закрыть настройки группы" />
                                        </Grid>
                                        <TextBlock Margin="0,10,0,4"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Название" />
                                        <TextBox Style="{StaticResource HubTextBoxStyle}"
                                                 IsEnabled="{Binding CanManageGroupOwners}"
                                                 Text="{Binding GroupTitleDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Название группы" />
                                        <TextBlock Margin="0,10,0,4"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Описание" />
                                        <TextBox MinHeight="54"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding GroupDescriptionDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Описание группы" />
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource HubPrimaryButtonStyle}"
                                                Command="{Binding SaveGroupProfileCommand}"
                                                Content="Сохранить"
                                                AutomationProperties.Name="Сохранить настройки группы" />
                                        <StackPanel Margin="0,14,0,0"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding CanManageGroupOwners, Converter={StaticResource BoolToVisibility}}">
                                            <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding UploadGroupAvatarCommand}"
                                                    Content="Сменить фото"
                                                    AutomationProperties.Name="Сменить фото группы" />
                                            <Button Margin="8,0,0,0"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding RemoveGroupAvatarCommand}"
                                                    Content="Удалить фото"
                                                    AutomationProperties.Name="Удалить фото группы"
                                                    Visibility="{Binding HasGroupAvatar, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <Border Margin="0,14,0,0"
                                                Padding="10,8"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding CanManageGroupMembers, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="Ссылка-приглашение" />
                                                <StackPanel Margin="0,6,0,0"
                                                            Orientation="Horizontal">
                                                    <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding CreateInviteLinkCommand}"
                                                            Content="Создать ссылку"
                                                            AutomationProperties.Name="Создать ссылку-приглашение" />
                                                    <Button Margin="8,0,0,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding CopyInviteLinkCommand}"
                                                            Content="Копировать"
                                                            AutomationProperties.Name="Копировать ссылку-приглашение"
                                                            Visibility="{Binding HasGroupInviteLink, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Margin="8,0,0,0"
                                                            Style="{StaticResource ChatGhostButtonStyle}"
                                                            Command="{Binding RevokeInviteLinkCommand}"
                                                            Content="{Binding InviteRevokeText}"
                                                            AutomationProperties.Name="Отозвать ссылку-приглашение" />
                                                </StackPanel>
                                                <TextBox Margin="0,6,0,0"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource HubTextBoxStyle}"
                                                         Text="{Binding GroupInviteLink, Mode=OneWay}"
                                                         AutomationProperties.Name="Ссылка-приглашение"
                                                         Visibility="{Binding HasGroupInviteLink, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="0,14,0,0"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding CanManageGroupMembers, Converter={StaticResource BoolToVisibility}}">
                                            <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding ToggleJoinRequestsPanelCommand}"
                                                    AutomationProperties.Name="Заявки на вступление">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Заявки" />
                                                    <Border Margin="4,0,0,0"
                                                            Padding="4,0"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource HubChatAccentBrush}"
                                                            Visibility="{Binding JoinRequestsBadgeText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource HubChatOnAccentBrush}"
                                                                   Text="{Binding JoinRequestsBadgeText}" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="8,0,0,0"
                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                    Command="{Binding ToggleReportsPanelCommand}"
                                                    AutomationProperties.Name="Жалобы на сообщения">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Жалобы" />
                                                    <Border Margin="4,0,0,0"
                                                            Padding="4,0"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource HubChatAccentBrush}"
                                                            Visibility="{Binding ReportsBadgeText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource HubChatOnAccentBrush}"
                                                                   Text="{Binding ReportsBadgeText}" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Button Margin="0,14,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding DeleteGroupCommand}"
                                                Content="{Binding DeleteGroupText}"
                                                Foreground="{DynamicResource HubErrorTextBrush}"
                                                AutomationProperties.Name="Удалить группу"
                                                Visibility="{Binding CanManageGroupOwners, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- «Заявки на вступление»: список + переключатель «по заявкам» (web ChatGroupJoinRequestsDialog) -->
                            <Border Panel.ZIndex="2"
                                    MaxWidth="420"
                                    MaxHeight="460"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Заявки на вступление"
                                    Visibility="{Binding IsJoinRequestsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Заявки на вступление" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseJoinRequestsPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть заявки"
                                                AutomationProperties.Name="Закрыть заявки" />
                                    </Grid>
                                    <CheckBox Grid.Row="1"
                                              Margin="0,8,0,0"
                                              IsChecked="{Binding IsJoinApprovalRequired}"
                                              AutomationProperties.Name="Вступление по заявкам">
                                        <CheckBox.Style>
                                            <!-- BasedOn HubCheckBoxStyle: семантические кисти подписи
                                                 и disabled-состояние темы (UI-019). -->
                                            <Style BasedOn="{StaticResource HubCheckBoxStyle}" TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsJoinApprovalBusy}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <CheckBox.Content>
                                            <TextBlock FontSize="13"
                                                       Text="Вступление по заявкам" />
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingJoinRequests, Converter={StaticResource BoolToVisibility}}" />
                                    <ListBox Grid.Row="3"
                                             Margin="0,6,0,0"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding JoinRequests}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Список заявок на вступление">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32"
                                                            Height="32"
                                                            CornerRadius="16"
                                                            Background="{Binding AvatarBrush}">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   Text="{Binding AvatarInitials}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource HubTextBrush}"
                                                                   Text="{Binding UserName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding CreatedAtText, StringFormat='Подана {0}'}"
                                                                   Visibility="{Binding CreatedAtText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                        <Button Margin="0,0,6,0"
                                                                Style="{StaticResource HubPrimaryButtonStyle}"
                                                                Command="{Binding ApproveCommand}"
                                                                Content="Принять"
                                                                AutomationProperties.Name="{Binding UserName, StringFormat='Принять заявку {0}'}" />
                                                        <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                                Command="{Binding RejectCommand}"
                                                                Content="Отклонить"
                                                                AutomationProperties.Name="{Binding UserName, StringFormat='Отклонить заявку {0}'}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- «Жалобы»: список жалоб на сообщения диалога (owner/moderator) -->
                            <Border Panel.ZIndex="2"
                                    MaxWidth="440"
                                    MaxHeight="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Жалобы на сообщения"
                                    Visibility="{Binding IsReportsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Жалобы на сообщения" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseReportsPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть жалобы"
                                                AutomationProperties.Name="Закрыть жалобы" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingReports, Converter={StaticResource BoolToVisibility}}" />
                                    <ListBox Grid.Row="2"
                                             Margin="0,6,0,0"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding MessageReports}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Список жалоб">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,3"
                                                        Padding="8,6"
                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Padding="5,1"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="8"
                                                                    Background="{DynamicResource HubChatHoverBrush}">
                                                                <TextBlock FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource HubChatLinkBrush}"
                                                                           Text="{Binding ReasonText}" />
                                                            </Border>
                                                            <TextBlock Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding ReporterText}" />
                                                            <TextBlock Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding CreatedAtText}"
                                                                       Visibility="{Binding CreatedAtText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="12"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding MessagePreview}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="48"
                                                                   Visibility="{Binding MessagePreview, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="12"
                                                                   Text="{Binding Comment}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Comment, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        <StackPanel Margin="0,6,0,0"
                                                                    Orientation="Horizontal">
                                                            <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                                                    Command="{Binding ResolveCommand}"
                                                                    Content="Решено"
                                                                    AutomationProperties.Name="{Binding Id, StringFormat='Закрыть жалобу {0}'}" />
                                                            <Button Margin="8,0,0,0"
                                                                    Style="{StaticResource ChatGhostButtonStyle}"
                                                                    Command="{Binding DismissCommand}"
                                                                    Content="Отклонить"
                                                                    AutomationProperties.Name="{Binding Id, StringFormat='Отклонить жалобу {0}'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- «Пожаловаться на сообщение»: причина + комментарий -->
                            <Border Panel.ZIndex="3"
                                    MaxWidth="380"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="14"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Жалоба на сообщение"
                                    Visibility="{Binding IsReportDialogOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="Пожаловаться на сообщение" />
                                    <TextBlock Margin="0,10,0,4"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Причина" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ReportReason"
                                                     IsChecked="{Binding IsReportReasonSpam}"
                                                     Content="Спам"
                                                     AutomationProperties.Name="Причина: спам" />
                                        <RadioButton Margin="10,0,0,0"
                                                     GroupName="ReportReason"
                                                     IsChecked="{Binding IsReportReasonAbuse}"
                                                     Content="Оскорбления"
                                                     AutomationProperties.Name="Причина: оскорбления" />
                                        <RadioButton Margin="10,0,0,0"
                                                     GroupName="ReportReason"
                                                     IsChecked="{Binding IsReportReasonIllegal}"
                                                     Content="Незаконное"
                                                     AutomationProperties.Name="Причина: незаконное" />
                                        <RadioButton Margin="10,0,0,0"
                                                     GroupName="ReportReason"
                                                     IsChecked="{Binding IsReportReasonOther}"
                                                     Content="Другое"
                                                     AutomationProperties.Name="Причина: другое" />
                                    </StackPanel>
                                    <TextBox Margin="0,10,0,0"
                                             MinHeight="60"
                                             MaxLength="500"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Style="{StaticResource HubTextBoxStyle}"
                                             Text="{Binding ReportComment, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Комментарий жалобы" />
                                    <StackPanel Margin="0,12,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CancelReportCommand}"
                                                Content="Отмена"
                                                AutomationProperties.Name="Отменить жалобу" />
                                        <Button Margin="8,0,0,0"
                                                Style="{StaticResource HubPrimaryButtonStyle}"
                                                Command="{Binding SubmitReportCommand}"
                                                Content="Отправить"
                                                AutomationProperties.Name="Отправить жалобу" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- «Поделиться задачей»: выбор задачи → сообщение task_share -->
                            <Border Panel.ZIndex="1"
                                    MaxWidth="420"
                                    MaxHeight="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Поделиться задачей"
                                    Visibility="{Binding IsTaskShareOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Поделиться задачей" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseTaskShareCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть панель задач"
                                                AutomationProperties.Name="Закрыть панель задач" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <TextBox x:Name="TaskShareSearchInput"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding TaskShareSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Поиск задачи" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                   Text="Название или номер задачи…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TaskShareSearchInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsTaskShareLoading, Converter={StaticResource BoolToVisibility}}" />
                                    <ListBox Grid.Row="3"
                                             Margin="0,6,0,0"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding ShareableTasks}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Задачи для отправки">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                   Text="{Binding MetaText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource HubPrimaryButtonStyle}"
                                                            Command="{Binding ShareCommand}"
                                                            Content="Отправить"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='Поделиться задачей {0}'}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- «Запланированные»: отложенные сообщения диалога поверх ленты -->
                            <Border Panel.ZIndex="2"
                                    MaxWidth="420"
                                    MaxHeight="440"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,10,0"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Запланированные сообщения"
                                    Visibility="{Binding IsScheduledPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Запланированные" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseScheduledPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть запланированные сообщения"
                                                AutomationProperties.Name="Закрыть запланированные сообщения" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingScheduled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding ScheduledErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasScheduledError, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ScheduledMessages}"
                                                          AutomationProperties.Name="Список запланированных сообщений">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Body, StringFormat='Запланированное сообщение: {0}'}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,3"
                                                                Padding="8,6"
                                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock FontSize="13"
                                                                               Text="{Binding Body}"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxHeight="40" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                               Text="{Binding StatusText}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Orientation="Horizontal">
                                                                    <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                                            Command="{Binding EditCommand}"
                                                                            local:NavGlyph.Icon="{x:Static local:VectorIcons.Edit}"
                                                                            ToolTip="Изменить время или текст"
                                                                            IsEnabled="{Binding AreActionsEnabled}"
                                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"
                                                                            AutomationProperties.Name="{Binding Body, StringFormat='Изменить запланированное: {0}'}" />
                                                                    <Button Margin="4,0,0,0"
                                                                            Command="{Binding CancelCommand}"
                                                                            Content="{Binding CancelText}"
                                                                            ToolTip="Отменить запланированное"
                                                                            IsEnabled="{Binding AreActionsEnabled}"
                                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"
                                                                            AutomationProperties.Name="{Binding Body, StringFormat='Отменить запланированное: {0}'}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button"
                                                                                   BasedOn="{StaticResource ChatGhostButtonStyle}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CancelArmed}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource HubDangerBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Запланированных сообщений нет"
                                                   Visibility="{Binding IsScheduledListEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- «Отправить позже»: текст + дата/время отправки -->
                            <Border Panel.ZIndex="3"
                                    MaxWidth="380"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="14"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    AutomationProperties.Name="Отложенная отправка сообщения"
                                    Visibility="{Binding IsScheduleEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding ScheduleEditorTitle}" />
                                    <TextBox Margin="0,10,0,0"
                                             MinHeight="60"
                                             MaxHeight="140"
                                             MaxLength="12000"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource HubTextBoxStyle}"
                                             Text="{Binding ScheduleDraftBody, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Текст запланированного сообщения" />
                                    <StackPanel Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding ApplySchedulePresetCommand}"
                                                CommandParameter="hour"
                                                Content="Через час"
                                                AutomationProperties.Name="Отправить через час" />
                                        <Button Margin="6,0,0,0"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding ApplySchedulePresetCommand}"
                                                CommandParameter="tomorrow"
                                                Content="Завтра в 9:00"
                                                AutomationProperties.Name="Отправить завтра в 9:00" />
                                        <Button Margin="6,0,0,0"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding ApplySchedulePresetCommand}"
                                                CommandParameter="monday"
                                                Content="В понедельник в 9:00"
                                                AutomationProperties.Name="Отправить в понедельник в 9:00" />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <DatePicker SelectedDate="{Binding ScheduleDraftDate, Mode=TwoWay}"
                                                    AutomationProperties.Name="Дата отправки" />
                                        <TextBox Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 Width="72"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding ScheduleDraftTime, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Время отправки, ЧЧ:ММ"
                                                 AutomationProperties.Name="Время отправки, ЧЧ:ММ" />
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding ScheduleDraftErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasScheduleDraftError, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                               Text="{Binding ScheduleDraftHint}"
                                               Visibility="{Binding ScheduleDraftHint, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding ScheduledErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasScheduledError, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="0,12,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseScheduleEditorCommand}"
                                                Content="Отмена"
                                                AutomationProperties.Name="Отменить планирование" />
                                        <Button Margin="8,0,0,0"
                                                Style="{StaticResource HubPrimaryButtonStyle}"
                                                Command="{Binding ConfirmScheduleCommand}"
                                                Content="{Binding ScheduleEditorConfirmText}"
                                                AutomationProperties.Name="Подтвердить запланированное сообщение" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- «Медиа»: галерея вложений диалога поверх ленты -->
                            <Border Panel.ZIndex="1"
                                    MaxWidth="460"
                                    MaxHeight="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsMediaPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Медиа" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseMediaPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть медиагалерею"
                                                AutomationProperties.Name="Закрыть медиагалерею" />
                                    </Grid>
                                    <StackPanel Grid.Row="1"
                                                Margin="0,6,0,0"
                                                Orientation="Horizontal">
                                        <RadioButton GroupName="MediaGalleryTab"
                                                     Style="{StaticResource MediaTabRadioStyle}"
                                                     IsChecked="{Binding IsMediaTabSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMediaTabCommand}"
                                                     CommandParameter="media"
                                                     Content="Медиа"
                                                     AutomationProperties.Name="Вкладка галереи: медиа" />
                                        <RadioButton GroupName="MediaGalleryTab"
                                                     Style="{StaticResource MediaTabRadioStyle}"
                                                     IsChecked="{Binding IsFilesTabSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMediaTabCommand}"
                                                     CommandParameter="file"
                                                     Content="Файлы"
                                                     AutomationProperties.Name="Вкладка галереи: файлы" />
                                        <RadioButton GroupName="MediaGalleryTab"
                                                     Style="{StaticResource MediaTabRadioStyle}"
                                                     IsChecked="{Binding IsAudioTabSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMediaTabCommand}"
                                                     CommandParameter="audio"
                                                     Content="Аудио"
                                                     AutomationProperties.Name="Вкладка галереи: аудио" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,6"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingMedia, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Grid.Row="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding MediaItems}"
                                                          AutomationProperties.Name="Медиафайлы диалога">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding FileName, StringFormat='Медиафайл: {0}'}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,6,6"
                                                                Command="{Binding OpenCommand}"
                                                                ToolTip="{Binding FileName}"
                                                                AutomationProperties.Name="{Binding FileName, StringFormat='Открыть {0}'}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Tile"
                                                                            Width="132"
                                                                            Padding="8"
                                                                            Background="{DynamicResource HubSurfaceBrush}"
                                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Grid>
                                                                                <local:VectorIcon HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Size="26"
                                                                                                  Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                                  Data="{Binding IconData}" />
                                                                                <!-- Превью image-вложения поверх иконки. -->
                                                                                <Image Height="72"
                                                                                       Stretch="UniformToFill"
                                                                                       Source="{Binding Thumbnail}"
                                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                                            </Grid>
                                                                            <TextBlock Grid.Row="1"
                                                                                       Margin="0,6,0,0"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource HubTextBrush}"
                                                                                       Text="{Binding FileName}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       TextWrapping="Wrap"
                                                                                       MaxHeight="30" />
                                                                            <StackPanel Grid.Row="2"
                                                                                        Margin="0,2,0,0"
                                                                                        Orientation="Horizontal">
                                                                                <TextBlock FontSize="10"
                                                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                           Text="{Binding SizeText}"
                                                                                           Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                <TextBlock Margin="4,0,0,0"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                                           Text="{Binding DurationText}"
                                                                                           Visibility="{Binding DurationText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                            <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="{Binding MediaEmptyText}"
                                                   Visibility="{Binding MediaEmptyText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </Grid>
                                    <Button Grid.Row="4"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ChatGhostButtonStyle}"
                                            Command="{Binding LoadMoreMediaCommand}"
                                            Content="Показать ещё"
                                            Visibility="{Binding HasMoreMedia, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Показать ещё медиафайлы" />
                                </Grid>
                            </Border>

                            <!-- @mention-автокомплит над composer (web .mentionList):
                                 аватар + имя + @handle по строке ~36px; ↑↓ по списку,
                                 Enter/Tab вставка, Esc — закрыть (см. PreviewKeyDown). -->
                            <Border Panel.ZIndex="2"
                                    MaxHeight="300"
                                    Margin="0,0,0,58"
                                    Padding="4"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Effect="{StaticResource HubFlyoutShadow}"
                                    Visibility="{Binding IsMentionPopupOpen, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Подсказки упоминаний">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,10"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка участников…"
                                               Visibility="{Binding IsLoadingMentions, Converter={StaticResource BoolToVisibility}}" />
                                    <ListBox x:Name="MentionList"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding MentionSuggestions}"
                                             SelectedItem="{Binding SelectedMentionSuggestion}"
                                             Visibility="{Binding IsLoadingMentions, Converter={StaticResource InverseBoolToVisibility}}"
                                             MouseLeftButtonUp="MentionList_MouseLeftButtonUp"
                                             AutomationProperties.Name="Кандидаты упоминания">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Surface"
                                                                    Padding="8,3"
                                                                    Background="Transparent"
                                                                    CornerRadius="6">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatRowSelectedBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="30"
                                                      AutomationProperties.Name="{Binding DisplayName}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Background="{Binding AvatarBrush}">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF"
                                                                       Text="{Binding AvatarInitials}" />
                                                            <Border CornerRadius="15"
                                                                    Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding AvatarImage}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="13"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding HandleText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Панель стикеров: вкладки паков, сетка с авторизованными превью, импорт -->
                            <Border x:Name="StickerPanel"
                                    Panel.ZIndex="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="346"
                                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                    MaxHeight="620"
                                    Margin="0,0,0,4"
                                    Padding="10"
                                    Background="{DynamicResource HubChatPanelBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    MouseEnter="StickerPanel_MouseEnter"
                                    MouseLeave="StickerPanel_MouseLeave"
                                    Visibility="{Binding IsStickerPanelOpen, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Панель стикеров">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Вкладки «Эмодзи/Стикеры» — полоса как в tg-stickers. -->
                                        <StackPanel VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button x:Name="StickerEmojiTab"
                                                    Command="{Binding SelectStickerTabCommand}"
                                                    CommandParameter="emoji"
                                                    Content="Эмодзи"
                                                    AutomationProperties.Name="Вкладка эмодзи">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChatStickerTabStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmojiTab}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubChatAccentBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="StickerPacksTab"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding SelectStickerTabCommand}"
                                                    CommandParameter="stickers"
                                                    Content="Стикеры"
                                                    AutomationProperties.Name="Вкладка стикеров">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChatStickerTabStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmojiTab}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubChatAccentBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource HubChatAccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CloseStickerPanelCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Закрыть панель стикеров"
                                                AutomationProperties.Name="Закрыть панель стикеров" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding StickerErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasStickerError, Converter={StaticResource BoolToVisibility}}" />
                                    <ListBox Grid.Row="2"
                                             Margin="0,6,0,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding StickerPacks}"
                                             SelectedItem="{Binding SelectedStickerPack}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             Visibility="{Binding IsEmojiTab, Converter={StaticResource InverseBoolToVisibility}}"
                                             AutomationProperties.Name="Наборы стикеров">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,6,0">
                                                    <Border Width="36"
                                                            Height="36"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource HubSurfaceBrush}"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding Title}">
                                                        <Grid>
                                                            <Image Source="{Binding Cover}"
                                                                   Stretch="Uniform"
                                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                                                            <local:EmojiGlyph HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              FontSize="18"
                                                                              Glyph="{Binding CoverEmoji}"
                                                                              Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <!-- Вкладка «Эмодзи»: категоризованные секции tg-stickers
                                             («Улыбки»/«Жесты и люди»/«Символы и объекты») + сетка вставки. -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding IsEmojiTab, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding EmojiSections}"
                                                          AutomationProperties.Name="Эмодзи по категориям">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat='Категория эмодзи: {0}'}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Margin="2,4,0,4"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                                       Text="{Binding Title}" />
                                                            <ItemsControl ItemsSource="{Binding Emojis}"
                                                                          AutomationProperties.Name="{Binding Title}">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Width="36"
                                                                                Height="36"
                                                                                Margin="0,0,2,2"
                                                                                Padding="0"
                                                                                FontSize="19"
                                                                                FontFamily="Segoe UI Emoji"
                                                                                Command="{Binding DataContext.InsertEmojiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                                                AutomationProperties.Name="{Binding StringFormat='Вставить эмодзи {0}'}">
                                                                            <local:EmojiGlyph Glyph="{Binding}" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <!-- Вкладка «Стикеры»: сетка активного пака (прежняя). -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding IsEmojiTab, Converter={StaticResource InverseBoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding SelectedStickerPack.Stickers}"
                                                          AutomationProperties.Name="Стикеры набора">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="64"
                                                                Height="64"
                                                                Margin="0,0,6,6"
                                                                Padding="4"
                                                                Command="{Binding SendCommand}"
                                                                AutomationProperties.Name="{Binding AutomationName}">
                                                            <Button.Style>
                                                                <Style TargetType="Button"
                                                                       BasedOn="{StaticResource ChatGhostButtonStyle}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsSendingSticker, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                     Value="True">
                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Grid>
                                                                <Image Source="{Binding Preview}"
                                                                       Stretch="Uniform"
                                                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                                                <local:EmojiGlyph HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  FontSize="28"
                                                                                  Glyph="{Binding Emoji}"
                                                                                  Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Загрузка стикеров…"
                                                   Visibility="{Binding IsLoadingStickers, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <Grid Grid.Row="4"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding IsEmojiTab, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding StickerImportSource, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Ссылка на набор стикеров" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource HubSecondaryButtonStyle}"
                                                Command="{Binding ImportStickerPackCommand}"
                                                Content="Импорт"
                                                IsEnabled="{Binding IsImportingStickerPack, Converter={StaticResource InverseBool}}"
                                                AutomationProperties.Name="Импортировать набор стикеров" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- FAB «вниз» — круглая кнопка у правого края ленты; видна,
                             пока пользователь прокрутил вверх (ChatScrollAssist).
                             Сверху-справа — красный бейдж «@»/счётчика как в Telegram. -->
                        <Grid Grid.Row="4"
                              Panel.ZIndex="1"
                              Margin="0,0,14,14"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom">
                        <Button Width="42"
                                Height="42"
                                Command="{Binding ScrollToEndCommand}"
                                ToolTip="К последним сообщениям"
                                AutomationProperties.Name="Прокрутить к последним сообщениям">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Surface"
                                            Background="{DynamicResource HubChatPanelBrush}"
                                            BorderBrush="{DynamicResource HubBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="21"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              Direction="270"
                                                              ShadowDepth="2"
                                                              Opacity="0.3" />
                                        </Border.Effect>
                                        <local:VectorIcon HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Size="20"
                                                          Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                          Data="{x:Static local:VectorIcons.ArrowDown}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubChatHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (local:ChatScrollAssist.IsAwayFromEnd), ElementName=MessagesList}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Бейдж непрочитанных/упоминаний над FAB (Telegram). -->
                        <Border MinWidth="19"
                                Height="19"
                                Padding="4,0"
                                Margin="0,-7,-7,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource HubErrorTextBrush}"
                                BorderBrush="{DynamicResource HubChatPanelBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9.5"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding ScrollFabBadgeText}" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasScrollFabBadge}" Value="True" />
                                                <Condition Binding="{Binding (local:ChatScrollAssist.IsAwayFromEnd), ElementName=MessagesList}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        </Grid>

                        <!-- «Печатает…» показан в шапке и строке списка (как в
                             Telegram Desktop) — отдельной строки над composer нет. -->

                        <!-- Плашка «Запланировано: N · ближайшее …» — открывает панель отложенных -->
                        <Button Grid.Row="6"
                                Margin="14,0,14,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ToggleScheduledPanelCommand}"
                                Content="{Binding ScheduledBarText}"
                                Visibility="{Binding HasScheduledBar, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Открыть запланированные сообщения">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource ChatGhostButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource HubChatAccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScheduledBarIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource HubDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Composer — единая полоса ввода и действий над обоями. -->
                        <Border Grid.Row="7"
                                Background="{DynamicResource HubChatPanelBrush}"
                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="6,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Контекст ответа/правки над полем ввода: акцентная полоса слева — как в Telegram. -->
                                <Border Grid.ColumnSpan="4"
                                        Margin="0,0,0,8"
                                        Padding="9,6"
                                        Background="{DynamicResource HubFlyoutSurfaceBrush}"
                                        BorderBrush="{DynamicResource HubChatLinkBrush}"
                                        BorderThickness="3,0,0,0"
                                        CornerRadius="0,10,10,0"
                                        Visibility="{Binding HasComposerContext, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubChatLinkBrush}"
                                                       Text="{Binding ComposerContextTitle}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                       Text="{Binding ComposerContextText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding CancelComposerContextCommand}"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                ToolTip="Отменить ответ или правку"
                                                AutomationProperties.Name="Отменить ответ или правку" />
                                    </Grid>
                                </Border>

                                <!-- Статус загрузки вложений (текстом, не только прогрессом) -->
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Margin="0,0,0,6"
                                           FontSize="11"
                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                           Text="{Binding UploadStatusText}"
                                           Visibility="{Binding HasUploadStatus, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Порядок Telegram: 📎 слева, поле ввода, 😊 справа от поля,
                                     круглая отправка. «Отправить позже» — в контекстном меню
                                     FAB и пунктом скрепки, как у Desktop-клиента. -->
                                <Menu Grid.Row="2"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Bottom"
                                      Background="Transparent"
                                      Visibility="{Binding VoiceBarVisible, Converter={StaticResource InverseBoolToVisibility}}">
                                    <MenuItem Style="{StaticResource ChatMenuRootUpStyle}"
                                              ToolTip="Прикрепить"
                                              IsEnabled="{Binding CanAttach}"
                                              AutomationProperties.Name="Прикрепить файлы к сообщению">
                                        <MenuItem.Header>
                                            <local:VectorIcon Size="22"
                                                              Data="{x:Static local:VectorIcons.Attach}" />
                                        </MenuItem.Header>
                                        <MenuItem.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource ChatIconMenuItemStyle}" />
                                        </MenuItem.Resources>
                                        <MenuItem Command="{Binding AttachCommand}"
                                                  CommandParameter="media"
                                                  Header="Фото или видео"
                                                  AutomationProperties.Name="Прикрепить фото или видео">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Photo}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding AttachCommand}"
                                                  CommandParameter="document"
                                                  Header="Документ"
                                                  AutomationProperties.Name="Прикрепить документ">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Document}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{Binding OpenTaskShareCommand}"
                                                  Header="Поделиться задачей"
                                                  AutomationProperties.Name="Поделиться задачей">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Task}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Visibility="{Binding CanScheduleMessage, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Command="{Binding OpenScheduleEditorCommand}"
                                                  Header="Отправить позже"
                                                  Visibility="{Binding CanScheduleMessage, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Запланировать сообщение">
                                            <MenuItem.Icon>
                                                <local:VectorIcon Size="16" Data="{x:Static local:VectorIcons.Clock}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>
                                </Menu>
                                <!-- UI-028: при записи/черновике место скрепки — корзина
                                     «Отменить голосовое сообщение» (без сети). -->
                                <Button Grid.Row="2"
                                        Margin="0,0,8,0"
                                        MinWidth="40"
                                        MinHeight="46"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Command="{Binding CancelVoiceRecordingCommand}"
                                        Visibility="{Binding VoiceBarVisible, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Отменить голосовое сообщение"
                                        AutomationProperties.Name="Отменить голосовое сообщение">
                                    <local:VectorIcon Size="22"
                                                      Data="{x:Static local:VectorIcons.Trash}" />
                                </Button>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         x:Name="ComposerInput"
                                         MinHeight="46"
                                         MaxHeight="124"
                                         VerticalAlignment="Bottom"
                                         Style="{StaticResource ChatComposerTextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="ComposerInput_PreviewKeyDown"
                                         TextChanged="ComposerInput_TextChanged"
                                         SelectionChanged="ComposerInput_SelectionChanged"
                                         Visibility="{Binding VoiceBarVisible, Converter={StaticResource InverseBoolToVisibility}}"
                                         AutomationProperties.Name="Текст сообщения" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                           Text="Сообщение…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=ComposerInput}" Value="" />
                                                        <Condition Binding="{Binding VoiceBarVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- UI-028: панель голосового вместо поля — красная точка и
                                     таймер при записи; ▶/⏸ и длительность у черновика. -->
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        MinHeight="46"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding VoiceBarVisible, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="8,0,10,0"
                                                 Fill="{DynamicResource HubErrorTextBrush}"
                                                 Visibility="{Binding IsVoiceRecording, Converter={StaticResource BoolToVisibility}}" />
                                        <Button MinWidth="36"
                                                MinHeight="36"
                                                Style="{StaticResource ChatGhostButtonStyle}"
                                                Command="{Binding ToggleVoicePreviewCommand}"
                                                Visibility="{Binding HasVoiceDraft, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Прослушать запись"
                                                AutomationProperties.Name="Прослушать голосовое сообщение">
                                            <local:VectorIcon Size="18"
                                                              Data="{x:Static local:VectorIcons.Play}">
                                                <local:VectorIcon.Style>
                                                    <Style TargetType="local:VectorIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVoicePreviewPlaying}" Value="True">
                                                                <Setter Property="Data" Value="{x:Static local:VectorIcons.Pause}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:VectorIcon.Style>
                                            </local:VectorIcon>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource HubTextBrush}"
                                                   Text="{Binding VoiceElapsedText}" />
                                    </StackPanel>
                                </Border>
                                <!-- 😊 — эмодзи/стикеры у правого края поля, как в Telegram. -->
                                <Button x:Name="StickerPanelButton"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        MinWidth="40"
                                        MinHeight="46"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        IsEnabled="{Binding HasConversation}"
                                        Click="StickerPanelButton_Click"
                                        MouseEnter="StickerPanelButton_MouseEnter"
                                        MouseLeave="StickerPanel_MouseLeave"
                                        Visibility="{Binding VoiceBarVisible, Converter={StaticResource InverseBoolToVisibility}}"
                                        ToolTip="Эмодзи и стикеры"
                                        AutomationProperties.Name="Открыть панель стикеров">
                                    <local:VectorIcon Size="22"
                                                      Data="{x:Static local:VectorIcons.Emoji}" />
                                </Button>
                                <!-- UI-028: скрытый плеер предпрослушивания черновика —
                                     без кадра, звуком управляет code-behind. -->
                                <MediaElement x:Name="VoicePreviewPlayer"
                                              Grid.Row="2"
                                              Grid.Column="3"
                                              Width="0"
                                              Height="0"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              MediaEnded="OnVoicePreviewMediaEnded"
                                              MediaFailed="OnVoicePreviewMediaFailed" />
                                <!-- Отправка — акцентный ➤, при правке ✓. -->
                                <Button Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ChatSendFabStyle}"
                                        Command="{Binding SendCommand}"
                                        Visibility="{Binding ShowSendFab, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Отправить сообщение">
                                    <!-- Parity web: правый клик по «Отправить» → «Отправить позже» -->
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Отправить позже"
                                                      Command="{Binding OpenScheduleEditorCommand}"
                                                      IsEnabled="{Binding CanScheduleMessage}"
                                                      AutomationProperties.Name="Отправить сообщение позже" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <!-- UI-028: 🎤 при пустом composer — запись только по
                                     явному нажатию; при записи — ✓ «Завершить»,
                                     у черновика — ➤ «Отправить голосовое». -->
                                <Button Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="0,0,0,3"
                                        MinWidth="40"
                                        MinHeight="40"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Foreground="{DynamicResource HubChatAccentBrush}"
                                        Command="{Binding StartVoiceRecordingCommand}"
                                        Visibility="{Binding ShowMicFab, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Записать голосовое сообщение"
                                        AutomationProperties.Name="Записать голосовое сообщение">
                                    <local:VectorIcon Size="21"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{x:Static local:VectorIcons.Mic}" />
                                </Button>
                                <Button Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="0,0,0,3"
                                        MinWidth="40"
                                        MinHeight="40"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Foreground="{DynamicResource HubChatAccentBrush}"
                                        Command="{Binding StopVoiceRecordingCommand}"
                                        Visibility="{Binding IsVoiceRecording, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Завершить запись"
                                        AutomationProperties.Name="Завершить запись голосового сообщения">
                                    <local:VectorIcon Size="21"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{x:Static local:VectorIcons.Check}" />
                                </Button>
                                <Button Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="0,0,0,3"
                                        MinWidth="40"
                                        MinHeight="40"
                                        Padding="0"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ChatGhostButtonStyle}"
                                        Foreground="{DynamicResource HubChatAccentBrush}"
                                        Command="{Binding SendVoiceMessageCommand}"
                                        Visibility="{Binding HasVoiceDraft, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Отправить голосовое сообщение"
                                        AutomationProperties.Name="Отправить голосовое сообщение">
                                    <local:VectorIcon Size="21"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="{x:Static local:VectorIcons.Send}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ══ Оверлей drag&drop файлов (tg-drop prompt) ══
                         Затемнение всей колонки чата + акцентная рамка по
                         периметру и подпись «Перетащите файлы, чтобы отправить
                         их в …». Только визуал: IsHitTestVisible=false, дроп
                         ловит ChatDropArea под ним. -->
                    <Border Panel.ZIndex="4"
                            Margin="10"
                            BorderBrush="{DynamicResource HubChatAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Background="#59000000"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsFileDropOverlayOpen, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Зона сброса файлов">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <local:VectorIcon HorizontalAlignment="Center"
                                              Size="44"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.Attach}" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F0FFFFFF"
                                       Text="{Binding FileDropTargetText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="420" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- Правая панель «Информация» — tdesktop profile: на широком окне —
                 колонка у правого края; на узком (UI-002) — оверлей поверх ленты,
                 чтобы не сжимать историю до обломка. Режимы — стилевым триггером:
                 локальные значения колонки не ставим, иначе триггер не сработает. -->
            <Border x:Name="PeerInfoPanel"
                    Width="380"
                    Background="{DynamicResource HubChatPanelBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPeerCardOpen, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactInfoOverlay}" Value="True">
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Panel.ZIndex" Value="3" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10"
                                                          Direction="270"
                                                          ShadowDepth="0"
                                                          Opacity="0.25"
                                                          RenderingBias="Quality" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Margin="10,6"
                          Height="36">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Информация" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ChatGhostButtonStyle}"
                                Command="{Binding ClosePeerCardCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                ToolTip="Закрыть панель информации"
                                AutomationProperties.Name="Закрыть панель информации" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="96"
                                    Height="96"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    CornerRadius="48"
                                    Background="{Binding SelectedConversation.AvatarBrush}">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="38"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               Text="{Binding SelectedConversation.AvatarInitials}" />
                                    <Border CornerRadius="48"
                                            Visibility="{Binding SelectedConversation.HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding SelectedConversation.AvatarImage}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedConversation.Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Emoji-status справа от имени (tg-profile). -->
                                <local:EmojiGlyph Margin="5,0,0,0"
                                                  VerticalAlignment="Center"
                                                  FontSize="15"
                                                  Glyph="{Binding SelectedConversation.StatusEmoji}"
                                                  Visibility="{Binding SelectedConversation.HasStatusEmoji, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubChatLinkBrush}"
                                       Text="{Binding SelectedConversation.PresenceText}"
                                       Visibility="{Binding SelectedConversation.PresenceText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubChatSecondaryBrush}"
                                       Text="{Binding SelectedConversation.KindText}"
                                       Visibility="{Binding SelectedConversation.KindText, Converter={StaticResource NonEmptyStringToVisibility}}" />

                            <!-- Ряд быстрых действий — иконки с подписями. -->
                            <StackPanel Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button MinWidth="64"
                                        Style="{StaticResource ChatRailTabStyle}"
                                        Command="{Binding SelectedConversation.ToggleMuteCommand}"
                                        AutomationProperties.Name="Уведомления диалога">
                                    <StackPanel>
                                        <local:VectorIcon HorizontalAlignment="Center"
                                                          Size="19"
                                                          Data="{x:Static local:VectorIcons.Bell}">
                                            <local:VectorIcon.Style>
                                                <Style TargetType="local:VectorIcon">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedConversation.IsMuted}" Value="True">
                                                            <Setter Property="Data" Value="{x:Static local:VectorIcons.BellOff}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </local:VectorIcon.Style>
                                        </local:VectorIcon>
                                        <TextBlock Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9.5"
                                                   Text="Уведомл." />
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="64"
                                        Style="{StaticResource ChatRailTabStyle}"
                                        Command="{Binding ToggleMembersPanelCommand}"
                                        Visibility="{Binding SelectedConversation.IsGroupLike, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Участники группы">
                                    <StackPanel>
                                        <local:VectorIcon HorizontalAlignment="Center"
                                                          Size="19"
                                                          Data="{x:Static local:VectorIcons.Group}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9.5"
                                                   Text="Участни." />
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="64"
                                        Style="{StaticResource ChatRailTabStyle}"
                                        Command="{Binding ToggleMediaPanelCommand}"
                                        AutomationProperties.Name="Медиагалерея диалога">
                                    <StackPanel>
                                        <local:VectorIcon HorizontalAlignment="Center"
                                                          Size="19"
                                                          Data="{x:Static local:VectorIcons.Photo}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9.5"
                                                   Text="Медиа" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Инфо-строки как в tg-profile: @username (direct)
                                 и описание (группа) с подписями-подзаголовками. -->
                            <StackPanel Margin="14,14,14,0"
                                        Visibility="{Binding SelectedConversation.PeerUsernameText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                <TextBlock FontSize="14"
                                           Text="{Binding SelectedConversation.PeerUsernameText}" />
                                <TextBlock Margin="0,1,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                           Text="Имя пользователя" />
                            </StackPanel>
                            <StackPanel Margin="14,14,14,0"
                                        Visibility="{Binding HasPeerDescription, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="14"
                                           Text="{Binding PeerDescriptionText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,1,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource HubChatSecondaryBrush}"
                                           Text="Описание" />
                            </StackPanel>

                            <!-- Участники группы: top-4 превью + «Показать всех»
                                 в панель «Участники» — как web-ChatContextPanel. -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding SelectedConversation.IsGroupLike, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="14,0">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding PeerMembersTitleText}" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource ChatGhostButtonStyle}"
                                            Command="{Binding ToggleMembersPanelCommand}"
                                            Content="Показать всех"
                                            FontSize="12"
                                            Foreground="{DynamicResource HubChatLinkBrush}"
                                            AutomationProperties.Name="Показать всех участников" />
                                </Grid>
                                <ItemsControl Margin="0,4,0,0"
                                              ItemsSource="{Binding PeerPanelMembers}"
                                              AutomationProperties.Name="Участники группы превью">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="36"
                                                  Margin="10,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32"
                                                        Height="32"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="16"
                                                        Background="{Binding AvatarBrush}">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   Text="{Binding AvatarInitials}" />
                                                        <Border CornerRadius="16"
                                                                Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding AvatarImage}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="13"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                               Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Subtitle, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Margin="0,12,0,4"
                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                    BorderThickness="0,1,0,0" />

                            <!-- Пункты действий диалога — иконки + текст, опасный красным. -->
                            <Button Padding="14,9"
                                    Style="{StaticResource ChatCardItemStyle}"
                                    Command="{Binding SelectedConversation.TogglePinCommand}"
                                    AutomationProperties.Name="Закрепить диалог">
                                <StackPanel Orientation="Horizontal">
                                    <local:VectorIcon Width="24"
                                                      Size="15"
                                                      Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                      Data="{x:Static local:VectorIcons.Pin}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding SelectedConversation.PinMenuText}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="14,9"
                                    Style="{StaticResource ChatCardItemStyle}"
                                    Command="{Binding SelectedConversation.ToggleArchiveCommand}"
                                    AutomationProperties.Name="Архивировать диалог">
                                <StackPanel Orientation="Horizontal">
                                    <local:VectorIcon Width="24"
                                                      Size="15"
                                                      Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                      Data="{Binding SelectedConversation.ArchiveMenuIcon, Converter={StaticResource EmojiToVector}}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding SelectedConversation.ArchiveMenuText}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="14,9"
                                    Style="{StaticResource ChatCardItemStyle}"
                                    Command="{Binding SelectedConversation.ExportHistoryCommand}"
                                    Visibility="{Binding SelectedConversation.CanExportHistory, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Экспорт истории">
                                <StackPanel Orientation="Horizontal">
                                    <local:VectorIcon Width="24"
                                                      Size="15"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource HubChatSecondaryBrush}"
                                                      Data="{x:Static local:VectorIcons.Exit}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Экспорт истории" />
                                </StackPanel>
                            </Button>
                            <Button Padding="14,9"
                                    Foreground="{DynamicResource HubErrorTextBrush}"
                                    Style="{StaticResource ChatCardItemStyle}"
                                    Command="{Binding SelectedConversation.LeaveGroupCommand}"
                                    Visibility="{Binding SelectedConversation.CanLeaveGroup, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Покинуть группу">
                                <StackPanel Orientation="Horizontal">
                                    <local:VectorIcon Width="24"
                                                      Size="15"
                                                      Data="{x:Static local:VectorIcons.Exit}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Покинуть группу" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Просмотрщик изображений (media viewer Telegram) ══
             Полноэкранный затемнённый оверлей поверх всего окна:
             картинка по центру (≤90%), имя файла + «N из M» сверху,
             стрелки ←→ по бокам, ✕ и ⬇ справа вверху. -->
        <Grid x:Name="MediaViewerOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Panel.ZIndex="10"
              Background="#B3000000"
              MouseLeftButtonDown="OnMediaViewerBackdropClick"
              Visibility="{Binding IsMediaViewerOpen, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.Name="Просмотр изображения">

            <!-- Верхняя панель: имя файла + счётчик/статус слева,
                 явные «Сохранить» и «Открыть в другом приложении» и ✕ справа. -->
            <Border Panel.ZIndex="3"
                    Padding="14,10"
                    VerticalAlignment="Top"
                    Background="#66000000">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F0FFFFFF"
                                   Text="{Binding MediaViewerTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   Text="{Binding MediaViewerCounterText}"
                                   Visibility="{Binding MediaViewerCounterText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   Text="{Binding MediaViewerStatusText}"
                                   Visibility="{Binding MediaViewerStatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,6,0"
                                Style="{StaticResource ChatGhostButtonStyle}"
                                Command="{Binding SaveMediaViewerCommand}"
                                Foreground="#F0FFFFFF"
                                ToolTip="Сохранить"
                                AutomationProperties.Name="Сохранить файл">
                            <local:VectorIcon Size="20"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.Download}" />
                        </Button>
                        <Button Margin="0,0,6,0"
                                Style="{StaticResource ChatGhostButtonStyle}"
                                Command="{Binding OpenMediaViewerExternalCommand}"
                                Foreground="#F0FFFFFF"
                                ToolTip="Открыть в другом приложении"
                                AutomationProperties.Name="Открыть в другом приложении">
                            <local:VectorIcon Size="20"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.OpenInNew}" />
                        </Button>
                        <Button Style="{StaticResource ChatGhostButtonStyle}"
                                Command="{Binding CloseMediaViewerCommand}"
                                Foreground="#F0FFFFFF"
                                ToolTip="Закрыть (Esc)"
                                AutomationProperties.Name="Закрыть просмотр">
                            <local:VectorIcon Size="20"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.Close}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ← → — боковые стрелки листания (только если картинок > 1). -->
            <Button Panel.ZIndex="3"
                    Width="44"
                    Height="44"
                    Margin="14,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding MediaViewerPrevCommand}"
                    Visibility="{Binding MediaViewerCanGoBack, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Предыдущее (←)"
                    AutomationProperties.Name="Предыдущее изображение">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowBg"
                                Background="#66000000"
                                CornerRadius="22">
                            <local:VectorIcon HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Size="24"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.ChevronLeft}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBg" Property="Background" Value="#99000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Panel.ZIndex="3"
                    Width="44"
                    Height="44"
                    Margin="0,0,14,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding MediaViewerNextCommand}"
                    Visibility="{Binding MediaViewerCanGoForward, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Следующее (→)"
                    AutomationProperties.Name="Следующее изображение">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowBg"
                                Background="#66000000"
                                CornerRadius="22">
                            <local:VectorIcon HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Size="24"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.ChevronRight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBg" Property="Background" Value="#99000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Центр: контент по виду элемента (UI-026). Картинка до 90% окна;
                 видео — MediaElement с собственным кадром; аудио — карточка;
                 неподдерживаемое — fallback с явным внешним запуском. Клик по
                 контенту оверлей не закрывает (фон ловит только себя). -->
            <Border Panel.ZIndex="2"
                    Margin="60,64"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Image MaxWidth="900"
                           Source="{Binding MediaViewerImage}"
                           Stretch="Uniform"
                           Visibility="{Binding MediaViewerIsImage, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="Полноразмерное изображение" />
                    <!-- Видео: MediaElement с ручным управлением; Source ставит
                         code-behind из MediaViewerMediaSource (UI-026). -->
                    <MediaElement x:Name="MediaViewerPlayer"
                                  MaxWidth="900"
                                  MaxHeight="520"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Stretch="Uniform"
                                  MediaOpened="OnMediaViewerMediaOpened"
                                  MediaEnded="OnMediaViewerMediaEnded"
                                  MediaFailed="OnMediaViewerMediaFailed"
                                  Visibility="{Binding MediaViewerIsVideo, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Второй элемент для аудио — тот же движок без кадра. -->
                    <MediaElement x:Name="MediaViewerAudioPlayer"
                                  Width="0"
                                  Height="0"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  MediaOpened="OnMediaViewerMediaOpened"
                                  MediaEnded="OnMediaViewerMediaEnded"
                                  MediaFailed="OnMediaViewerMediaFailed" />
                    <!-- Аудио: иконка + имя (кадра нет — только транспорт). -->
                    <Border MinWidth="300"
                            Padding="28,24"
                            Background="#33000000"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding MediaViewerIsAudio, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <local:VectorIcon HorizontalAlignment="Center"
                                              Size="48"
                                              Foreground="#F0FFFFFF"
                                              Data="{x:Static local:VectorIcons.Music}" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F0FFFFFF"
                                       Text="{Binding MediaViewerTitle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <!-- Fallback: формат без встроенного показа — только явный
                         внешний запуск по кнопке (UI-026). -->
                    <Border MinWidth="320"
                            Padding="28,24"
                            Background="#33000000"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding MediaViewerIsUnsupported, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <local:VectorIcon HorizontalAlignment="Center"
                                              Size="40"
                                              Foreground="#B3FFFFFF"
                                              Data="{x:Static local:VectorIcons.Document}" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="13"
                                       Foreground="#F0FFFFFF"
                                       Text="{Binding MediaViewerUnsupportedText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Margin="0,16,0,0"
                                    Padding="16,8"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ChatAccentPillButtonStyle}"
                                    Command="{Binding OpenMediaViewerExternalCommand}"
                                    Content="Открыть в другом приложении"
                                    AutomationProperties.Name="Открыть файл в другом приложении" />
                        </StackPanel>
                    </Border>
                    <ProgressBar Width="48"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsMediaViewerLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Транспорт воспроизведения (video/audio): play/pause, позиция,
                 время — как у tdesktop. Виден только для проигрываемого элемента. -->
            <Border x:Name="MediaViewerTransport"
                    Panel.ZIndex="3"
                    Margin="0,0,0,18"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#66000000"
                    CornerRadius="20"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MediaViewerPlayPause"
                            Style="{StaticResource ChatGhostButtonStyle}"
                            Click="OnMediaViewerPlayPauseClick"
                            AutomationProperties.Name="Воспроизвести или поставить на паузу">
                        <local:VectorIcon x:Name="MediaViewerPlayPauseIcon"
                                          Size="20"
                                          Foreground="#F0FFFFFF"
                                          Data="{x:Static local:VectorIcons.Pause}" />
                    </Button>
                    <Slider x:Name="MediaViewerPosition"
                            Grid.Column="1"
                            Margin="10,0"
                            MinWidth="160"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="OnMediaViewerSeekDown"
                            PreviewMouseLeftButtonUp="OnMediaViewerSeekUp"
                            AutomationProperties.Name="Позиция воспроизведения" />
                    <TextBlock x:Name="MediaViewerTimeText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#B3FFFFFF"
                               Text="0:00 / 0:00" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
