<UserControl x:Class="Hub.Desktop.Native.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
            <!-- Вкладки галереи — тот же чип-переключатель, что в «Отсутствиях». -->
            <Style x:Key="MediaTabRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}" />

            <!-- Пузырь сообщения без выделения/карточки. -->
            <Style x:Key="ChatMessageItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Баннер ошибки -->
        <Border Grid.Row="0"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RetryCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку диалогов" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: поиск + диалоги -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ConversationSearchInput"
                             Style="{StaticResource HubTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Поиск диалога" />
                    <TextBlock Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                               Text="Поиск диалога…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ToggleGlobalSearchCommand}"
                            Content="🔎"
                            ToolTip="Поиск по всем сообщениям"
                            AutomationProperties.Name="Поиск по всем сообщениям" />
                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ToggleNewConversationCommand}"
                            Content="＋"
                            ToolTip="Новый диалог"
                            AutomationProperties.Name="Новый диалог" />
                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding OpenNotesCommand}"
                            Content="🗒"
                            ToolTip="Заметки себе"
                            AutomationProperties.Name="Заметки себе" />
                    <Button Grid.Column="4"
                            Margin="8,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding RefreshConversationsCommand}"
                            Content="Обновить"
                            AutomationProperties.Name="Обновить список диалогов" />
                    <Button Grid.Row="1"
                            Grid.ColumnSpan="5"
                            Margin="0,6,0,0"
                            Command="{Binding ToggleArchivedViewCommand}"
                            Content="{Binding ArchiveToggleText}"
                            AutomationProperties.Name="Показать архивные диалоги">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchiveView}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource HubAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid IsEnabled="{Binding IsConversationListActive}">
                        <ListBox Style="{StaticResource HubListBoxStyle}"
                                 ItemsSource="{Binding Conversations}"
                                 SelectedItem="{Binding SelectedConversation}"
                                 AutomationProperties.Name="Список диалогов">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding TogglePinCommand}"
                                                      Header="{Binding PinMenuText}" />
                                            <MenuItem Command="{Binding ToggleMuteCommand}"
                                                      Header="{Binding MuteMenuText}" />
                                            <Separator />
                                            <MenuItem Command="{Binding ToggleArchiveCommand}"
                                                      Header="{Binding ArchiveMenuText}" />
                                            <MenuItem Command="{Binding ExportHistoryCommand}"
                                                      Header="Экспорт"
                                                      AutomationProperties.Name="Экспорт истории диалога"
                                                      Visibility="{Binding CanExportHistory, Converter={StaticResource BoolToVisibility}}" />
                                            <Separator Visibility="{Binding CanLeaveGroup, Converter={StaticResource BoolToVisibility}}" />
                                            <MenuItem Command="{Binding LeaveGroupCommand}"
                                                      Header="Покинуть группу"
                                                      AutomationProperties.Name="Покинуть группу"
                                                      Visibility="{Binding CanLeaveGroup, Converter={StaticResource BoolToVisibility}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Top">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="{DynamicResource HubSelectionBrush}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubTextBrush}"
                                                       Text="{Binding AvatarInitial}" />
                                        </Border>
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Fill="{DynamicResource HubSuccessBrush}"
                                                 AutomationProperties.Name="В сети"
                                                 Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="10,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,4,0"
                                                           FontSize="11"
                                                           Text="📌"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="4,0,0,0"
                                                           FontSize="11"
                                                           Text="🔇"
                                                           Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding TimeText}" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding Preview}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="34" />
                                            <Border Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    MinWidth="18"
                                                    Height="18"
                                                    Padding="5,0"
                                                    CornerRadius="9"
                                                    Background="{DynamicResource HubAccentBrush}"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubOnAccentBrush}"
                                                           Text="{Binding UnreadBadgeText}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding KindText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding KindText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="{Binding EmptyHint}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,16,0,0"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="Загрузка…"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Button Grid.Row="1"
                            Margin="0,8,0,0"
                            Style="{StaticResource HubSecondaryButtonStyle}"
                            Command="{Binding LoadMoreConversationsCommand}"
                            Content="{Binding ConversationsMoreText}"
                            IsEnabled="{Binding IsConversationListActive}"
                            Visibility="{Binding HasMoreConversations, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Показать следующую порцию диалогов" />

                    <!-- Панель «Новый диалог» поверх списка -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="1"
                            Padding="14"
                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsNewConversationOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding NewConversationTitleText}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding ToggleNewGroupModeCommand}"
                                        Content="{Binding NewConversationModeToggleText}"
                                        AutomationProperties.Name="Переключить режим: личный диалог или группа" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding ToggleNewConversationCommand}"
                                        Content="✕"
                                        AutomationProperties.Name="Закрыть создание диалога" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <TextBox x:Name="NewConversationSearchInput"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         Text="{Binding NewConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Поиск пользователя" />
                                <TextBlock Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="Имя или логин…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewConversationSearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Поля режима «Новая группа»: название + чипы выбранных -->
                            <StackPanel Grid.Row="2"
                                        Visibility="{Binding IsNewGroupMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,10,0,0">
                                    <TextBox x:Name="NewGroupTitleInput"
                                             Style="{StaticResource HubTextBoxStyle}"
                                             Text="{Binding NewGroupTitle, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Название группы" />
                                    <TextBlock Margin="13,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="Название группы…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NewGroupTitleInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ItemsControl Margin="0,8,0,0"
                                              ItemsSource="{Binding SelectedGroupMembers}"
                                              AutomationProperties.Name="Выбранные участники группы">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6"
                                                    Command="{Binding DataContext.PickUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Убрать {0} из группы'}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chip"
                                                                Padding="8,3"
                                                                Background="{DynamicResource HubSelectionBrush}"
                                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           Text="{Binding DisplayName}" />
                                                                <TextBlock Margin="6,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                           Text="✕" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ListBox Grid.Row="3"
                                     Margin="0,10,0,0"
                                     Style="{StaticResource HubListBoxStyle}"
                                     ItemsSource="{Binding FoundUsers}"
                                     AutomationProperties.Name="Найденные пользователи">
                                <!-- Действие на внутренней кнопке — контейнер
                                     нефокусируем, иначе мёртвая остановка Tab. -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource HubTaskCardStyle}">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.PickUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding DisplayName}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Surface"
                                                            Padding="8,6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubBorderDimBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource HubSelectionBrush}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding AvatarInitial}" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubAccentBrush}"
                                                           Text="✓"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Поиск людей…"
                                           Visibility="{Binding IsSearchingUsers, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Никого не найдено"
                                           Visibility="{Binding IsUserSearchEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Создание диалога…"
                                           Visibility="{Binding IsCreatingConversation, Converter={StaticResource BoolToVisibility}}" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource HubSecondaryButtonStyle}"
                                        Command="{Binding CreateGroupCommand}"
                                        Content="Создать группу"
                                        AutomationProperties.Name="Создать группу"
                                        Visibility="{Binding IsNewGroupMode, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Панель глобального поиска по сообщениям поверх списка -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="1"
                            Padding="14"
                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource HubBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsGlobalSearchOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Поиск по сообщениям" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding ToggleGlobalSearchCommand}"
                                        Content="✕"
                                        AutomationProperties.Name="Закрыть поиск по всем сообщениям" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <TextBox x:Name="GlobalSearchInput"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Поиск по всем сообщениям" />
                                <TextBlock Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="Текст сообщения…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Margin="0,8"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="{Binding GlobalSearchHint}"
                                       Visibility="{Binding GlobalSearchHint, Converter={StaticResource NonEmptyStringToVisibility}}" />

                            <ListBox Grid.Row="3"
                                     Style="{StaticResource HubListBoxStyle}"
                                     ItemsSource="{Binding GlobalSearchResults}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Результаты поиска по всем сообщениям">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource HubTaskCardStyle}">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.PickGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Preview}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Surface"
                                                            Padding="8,6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ConversationTitle, TargetNullValue='Диалог'}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding SenderName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding CreatedAt, StringFormat='dd.MM HH:mm'}" />
                                                </Grid>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="13"
                                                           Text="{Binding Preview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="34" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель диалогов и сообщений"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей" />

            <!-- Правая колонка: диалог -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasConversation, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Выберите диалог" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Сообщения появятся здесь." />
                    </StackPanel>

                    <Grid Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Шапка диалога + статус подключения -->
                        <Border Grid.Row="0"
                                Padding="18,12"
                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedConversation.Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Text="{Binding SelectedConversation.PresenceText}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="Статус собеседника"
                                               Visibility="{Binding SelectedConversation.PresenceText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedConversation.IsOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding SelectedConversation.KindText}"
                                               Visibility="{Binding SelectedConversation.KindText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding ToggleMediaPanelCommand}"
                                        Content="🖼"
                                        ToolTip="Медиа"
                                        AutomationProperties.Name="Медиагалерея диалога" />
                                <Button Grid.Column="2"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding ToggleMembersPanelCommand}"
                                        Content="👥"
                                        ToolTip="Участники"
                                        AutomationProperties.Name="Участники группы"
                                        Visibility="{Binding SelectedConversation.IsGroupLike, Converter={StaticResource BoolToVisibility}}" />
                                <Button Grid.Column="3"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding ToggleMessageSearchCommand}"
                                        Content="🔍"
                                        AutomationProperties.Name="Поиск по сообщениям" />
                                <Border Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HubStatusPillStyle}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource HubToneDotStyle}"
                                                 local:HubTone.Value="{Binding ConnectionTone}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding ConnectionStatusText}"
                                                   AutomationProperties.Name="Статус подключения чата" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Плашка закреплённого сообщения (клик → переход к якорю) -->
                        <Button Grid.Row="1"
                                Margin="14,6,14,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding JumpToPinnedCommand}"
                                Visibility="{Binding HasPinnedMessages, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Перейти к закреплённому сообщению">
                            <TextBlock MaxWidth="520"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="{Binding PinnedBarText}"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>

                        <!-- Подгрузка старых сообщений -->
                        <Button Grid.Row="2"
                                Margin="0,6"
                                HorizontalAlignment="Center"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding LoadOlderCommand}"
                                Content="Загрузить ранее"
                                Visibility="{Binding HasOlder, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Загрузить ранее" />

                        <!-- Лента сообщений -->
                        <Grid Grid.Row="3" Margin="14,0">
                            <ListBox x:Name="MessagesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,0,10,0"
                                     ItemsSource="{Binding Messages}"
                                     SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ChatMessageItemStyle}"
                                     IsTabStop="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Сообщения диалога">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border x:Name="Bubble"
                                                    MaxWidth="560"
                                                    Padding="10,7"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    SnapsToDevicePixels="True"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Ответить"
                                                                  Command="{Binding PlacementTarget.Tag.BeginReplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Изменить"
                                                                  Command="{Binding PlacementTarget.Tag.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <!-- Править можно только kind="text" — опросы скрываем. -->
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding PlacementTarget.DataContext.CanEditOrDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                                <Condition Binding="{Binding PlacementTarget.DataContext.HasPoll, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Header="Реагировать"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
                                                            <MenuItem Header="👍"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="👍" />
                                                            <MenuItem Header="❤️"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="❤️" />
                                                            <MenuItem Header="😂"
                                                                      Command="{Binding PlacementTarget.DataContext.ReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="😂" />
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Копировать текст"
                                                                  Command="{Binding PlacementTarget.Tag.CopyMessageTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Переслать"
                                                                  Command="{Binding PlacementTarget.Tag.BeginForwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanReply, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Завершить опрос"
                                                                  Command="{Binding PlacementTarget.DataContext.ClosePollCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanClosePoll, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Кто прочитал"
                                                                  Command="{Binding PlacementTarget.Tag.ShowMessageReadersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <!-- Только свои и прочитанные: StatusText = «✓✓». -->
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.StatusText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                     Value="✓✓">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <Separator Visibility="{Binding PlacementTarget.DataContext.CanEditOrDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                        <MenuItem Header="Удалить"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Visibility="{Binding PlacementTarget.DataContext.CanEditOrDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SenderName}"
                                                               Visibility="{Binding ShowSender, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubAccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubOnAccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="12"
                                                               FontStyle="Italic"
                                                               Text="{Binding ForwardText}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding ForwardText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubAccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubOnAccentSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Цитата-ответ: левая акцентная полоса отличает её от тела сообщения. -->
                                                    <Border Margin="0,4,0,0"
                                                            Padding="8,0,0,0"
                                                            BorderThickness="3,0,0,0"
                                                            Visibility="{Binding ReplyText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource HubOnAccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="12"
                                                                   FontStyle="Italic"
                                                                   Text="{Binding ReplyText}"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource HubOnAccentSecondaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="14"
                                                               Text="{Binding BodyText}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubOnAccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Превью первой ссылки в тексте (parity web ChatLinkPreview) -->
                                                    <ItemsControl Margin="0,6,0,0"
                                                                  ItemsSource="{Binding LinkPreviewItems}"
                                                                  Visibility="{Binding HasLinkPreviews, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Command="{Binding OpenCommand}"
                                                                        AutomationProperties.Name="{Binding HeaderText, StringFormat='Открыть ссылку {0}'}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Card"
                                                                                    Padding="10,7"
                                                                                    Background="{DynamicResource HubSurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource HubAccentBrush}"
                                                                                    BorderThickness="3,0,0,0"
                                                                                    CornerRadius="0,8,8,0">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Border Width="44"
                                                                                            Height="44"
                                                                                            Margin="0,0,10,0"
                                                                                            VerticalAlignment="Top"
                                                                                            CornerRadius="6"
                                                                                            ClipToBounds="True"
                                                                                            Background="{DynamicResource HubSelectionBrush}">
                                                                                        <Grid>
                                                                                            <TextBlock HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"
                                                                                                       FontSize="16"
                                                                                                       Text="🔗" />
                                                                                            <Image Stretch="UniformToFill"
                                                                                                   Source="{Binding ImageUrl}"
                                                                                                   Visibility="{Binding ImageUrl, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <StackPanel Grid.Column="1"
                                                                                                VerticalAlignment="Center">
                                                                                        <TextBlock FontSize="11"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource HubAccentBrush}"
                                                                                                   Text="{Binding HeaderText}"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="13"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource HubTextBrush}"
                                                                                                   Text="{Binding Title}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   TextWrapping="Wrap"
                                                                                                   MaxHeight="36"
                                                                                                   Visibility="{Binding Title, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                   Text="{Binding Description}"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   TextWrapping="Wrap"
                                                                                                   MaxHeight="32"
                                                                                                   Visibility="{Binding Description, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                   Text="Загрузка превью…"
                                                                                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                                    <Setter TargetName="Card" Property="BorderThickness" Value="3,0,0,2" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl Margin="0,4,0,0"
                                                                  ItemsSource="{Binding PollOptions}"
                                                                  Visibility="{Binding HasPoll, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Margin="0,2,0,0"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Command="{Binding VoteCommand}"
                                                                        AutomationProperties.Name="{Binding Text, StringFormat='Вариант опроса {0}'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Grid MinHeight="32">
                                                                                <ProgressBar Minimum="0"
                                                                                             Maximum="100"
                                                                                             Value="{Binding Percent, Mode=OneWay}"
                                                                                             Foreground="{DynamicResource HubSelectionBrush}"
                                                                                             Background="{DynamicResource HubSurfaceBrush}" />
                                                                                <Border x:Name="Surface"
                                                                                        Padding="8,0"
                                                                                        Background="Transparent"
                                                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="6">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock VerticalAlignment="Center"
                                                                                                   FontSize="13"
                                                                                                   Foreground="{DynamicResource HubTextBrush}"
                                                                                                   Text="{Binding Text}"
                                                                                                   TextTrimming="CharacterEllipsis">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Margin="8,0,0,0"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Orientation="Horizontal">
                                                                                            <TextBlock FontSize="12"
                                                                                                       Foreground="{DynamicResource HubAccentBrush}"
                                                                                                       Text="✓"
                                                                                                       Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}" />
                                                                                            <TextBlock Margin="4,0,0,0"
                                                                                                       FontSize="11"
                                                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                       Text="{Binding VotesText}"
                                                                                                       Visibility="{Binding VotesText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.8" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding PollSummaryText}"
                                                               Visibility="{Binding PollSummaryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <ItemsControl Margin="0,4,0,0"
                                                                  ItemsSource="{Binding AttachmentItems}"
                                                                  Visibility="{Binding HasAttachmentItems, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Margin="0,2,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Command="{Binding OpenCommand}"
                                                                        AutomationProperties.Name="{Binding FileName, StringFormat='Открыть вложение {0}'}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="ChipBg"
                                                                                    Padding="8,4"
                                                                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock VerticalAlignment="Center"
                                                                                               FontSize="12"
                                                                                               Text="{Binding Icon}" />
                                                                                    <TextBlock Margin="6,0,0,0"
                                                                                               MaxWidth="220"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="12"
                                                                                               Foreground="{DynamicResource HubTextBrush}"
                                                                                               Text="{Binding FileName}"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Margin="8,0,0,0"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                               Text="{Binding SizeText}"
                                                                                               Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                                    <Setter TargetName="ChipBg" Property="BorderThickness" Value="2" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,6,0,0"
                                                               FontSize="13"
                                                               Text="{Binding ReactionsText}"
                                                               Visibility="{Binding ReactionsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <StackPanel Margin="0,4,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource HubOnAccentSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Margin="0,0,4,0"
                                                                   FontSize="11"
                                                                   Text="{Binding EditedText}"
                                                                   Visibility="{Binding EditedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        <TextBlock Margin="0,0,4,0"
                                                                   FontSize="11"
                                                                   Text="{Binding StatusText}"
                                                                   Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="Статус доставки: ✓ отправлено, ✓✓ прочитано" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11"
                                                                   Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource HubAccentBrush}" />
                                                <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource HubAccentPressedBrush}" />
                                                <Setter TargetName="Bubble" Property="TextElement.Foreground" Value="{DynamicResource HubOnAccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsMessagesEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Сообщений пока нет. Напишите первым." />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Загрузка сообщений…"
                                       Visibility="{Binding IsLoadingMessages, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Поиск по сообщениям поверх ленты -->
                            <Border Panel.ZIndex="1"
                                    Padding="12"
                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsMessageSearchOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageSearchInput"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding MessageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Поиск по сообщениям диалога" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="Текст сообщения…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=MessageSearchInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding ToggleMessageSearchCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Закрыть поиск по сообщениям" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="{Binding MessageSearchHint}"
                                               Visibility="{Binding MessageSearchHint, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <ListBox Grid.Row="2"
                                             MaxHeight="320"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding SearchResults}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Результаты поиска по сообщениям">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.PickSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Surface"
                                                                    Padding="8,6"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding SenderName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="13"
                                                                   Text="{Binding BodyText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Пересылка: выбор целевого диалога поверх ленты -->
                            <Border Panel.ZIndex="1"
                                    MaxWidth="420"
                                    MaxHeight="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsForwardPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="Переслать сообщение" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding ForwardingMessage.ReplySummaryText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ForwardingMessage.ReplySummaryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding CloseForwardPanelCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Закрыть выбор диалога для пересылки" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <TextBox x:Name="ForwardFilterInput"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Фильтр диалогов для пересылки" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="Фильтр диалогов…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ForwardFilterInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Пересылаем…"
                                               Visibility="{Binding IsForwarding, Converter={StaticResource BoolToVisibility}}" />
                                    <ListBox Grid.Row="3"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding Conversations}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Диалоги для пересылки">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem"
                                                   BasedOn="{StaticResource HubTaskCardStyle}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.PickForwardTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Surface"
                                                                    Padding="8,6"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Background="{DynamicResource HubSelectionBrush}">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding AvatarInitial}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding Preview}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- «Кто прочитал»: мини-панель справа поверх ленты -->
                            <Border Panel.ZIndex="2"
                                    MaxWidth="320"
                                    MaxHeight="360"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="12"
                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsReadersPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ReadersTitleText}" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding CloseReadersPanelCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Закрыть список прочитавших" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingReaders, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Grid.Row="2"
                                                  Margin="0,8,0,0"
                                                  ItemsSource="{Binding MessageReaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="13"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding ReadAtText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- «Участники»: список и управление участниками поверх ленты -->
                            <Border Panel.ZIndex="1"
                                    MaxWidth="420"
                                    MaxHeight="460"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsMembersPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding MembersTitleText}" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding CloseMembersPanelCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Закрыть список участников" />
                                    </Grid>
                                    <Grid Grid.Row="1"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding CanManageGroupMembers, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox x:Name="MemberSearchInput"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Поиск участника для добавления" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="Добавить участника…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=MemberSearchInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="{Binding MemberSearchHint}"
                                               Visibility="{Binding MemberSearchHint, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <ListBox Grid.Row="3"
                                             Margin="0,6,0,0"
                                             MaxHeight="140"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding MemberCandidateResults}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Visibility="{Binding HasMemberCandidates, Converter={StaticResource BoolToVisibility}}"
                                             AutomationProperties.Name="Кандидаты в группу">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem"
                                                   BasedOn="{StaticResource HubTaskCardStyle}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.PickMemberCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Добавить {0} в группу'}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Surface"
                                                                    Padding="8,6"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Background="{DynamicResource HubSelectionBrush}">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding AvatarInitial}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding Subtitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="4" Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                                   Text="Загрузка…"
                                                   Visibility="{Binding IsLoadingMembers, Converter={StaticResource BoolToVisibility}}" />
                                        <ListBox Grid.Row="1"
                                                 Margin="0,4,0,0"
                                                 Style="{StaticResource HubListBoxStyle}"
                                                 ItemsSource="{Binding GroupMembers}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="Участники группы">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid VerticalAlignment="Top">
                                                            <Border Width="32"
                                                                    Height="32"
                                                                    CornerRadius="16"
                                                                    Background="{DynamicResource HubSelectionBrush}">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding AvatarInitial}" />
                                                            </Border>
                                                            <Ellipse Width="9"
                                                                     Height="9"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Fill="{DynamicResource HubSuccessBrush}"
                                                                     AutomationProperties.Name="В сети"
                                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Margin="6,0,0,0"
                                                                        Padding="5,1"
                                                                        CornerRadius="8"
                                                                        Background="{DynamicResource HubSelectionBrush}"
                                                                        Visibility="{Binding RoleText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                                                    <TextBlock FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource HubAccentBrush}"
                                                                               Text="{Binding RoleText}" />
                                                                </Border>
                                                                <TextBlock Margin="6,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource HubErrorTextBrush}"
                                                                           Text="{Binding RestrictedText}"
                                                                           Visibility="{Binding RestrictedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding Subtitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                            <Button Margin="0,0,6,0"
                                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                                    Command="{Binding TransferOwnershipCommand}"
                                                                    Content="Сделать владельцем"
                                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Сделать владельцем {0}'}"
                                                                    Visibility="{Binding CanTransferOwnership, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button VerticalAlignment="Center"
                                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                                    Command="{Binding RemoveCommand}"
                                                                    Content="✕"
                                                                    ToolTip="Исключить из группы"
                                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Исключить участника {0}'}"
                                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- «Медиа»: галерея вложений диалога поверх ленты -->
                            <Border Panel.ZIndex="1"
                                    MaxWidth="460"
                                    MaxHeight="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="12"
                                    Background="{DynamicResource HubSurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding IsMediaPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="Медиа" />
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding CloseMediaPanelCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Закрыть медиагалерею" />
                                    </Grid>
                                    <StackPanel Grid.Row="1"
                                                Margin="0,6,0,0"
                                                Orientation="Horizontal">
                                        <RadioButton GroupName="MediaGalleryTab"
                                                     Style="{StaticResource MediaTabRadioStyle}"
                                                     IsChecked="{Binding IsMediaTabSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMediaTabCommand}"
                                                     CommandParameter="media"
                                                     Content="Медиа"
                                                     AutomationProperties.Name="Вкладка галереи: медиа" />
                                        <RadioButton GroupName="MediaGalleryTab"
                                                     Style="{StaticResource MediaTabRadioStyle}"
                                                     IsChecked="{Binding IsFilesTabSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMediaTabCommand}"
                                                     CommandParameter="file"
                                                     Content="Файлы"
                                                     AutomationProperties.Name="Вкладка галереи: файлы" />
                                        <RadioButton GroupName="MediaGalleryTab"
                                                     Style="{StaticResource MediaTabRadioStyle}"
                                                     IsChecked="{Binding IsAudioTabSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMediaTabCommand}"
                                                     CommandParameter="audio"
                                                     Content="Аудио"
                                                     AutomationProperties.Name="Вкладка галереи: аудио" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Margin="0,6"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Загрузка…"
                                               Visibility="{Binding IsLoadingMedia, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Grid.Row="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding MediaItems}"
                                                          AutomationProperties.Name="Медиафайлы диалога">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,6,6"
                                                                Command="{Binding OpenCommand}"
                                                                ToolTip="{Binding FileName}"
                                                                AutomationProperties.Name="{Binding FileName, StringFormat='Открыть {0}'}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Tile"
                                                                            Width="132"
                                                                            Padding="8"
                                                                            Background="{DynamicResource HubSurfaceBrush}"
                                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Grid>
                                                                                <TextBlock HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           FontSize="24"
                                                                                           Text="{Binding Icon}" />
                                                                                <!-- Превью image-вложения поверх иконки. -->
                                                                                <Image Height="72"
                                                                                       Stretch="UniformToFill"
                                                                                       Source="{Binding Thumbnail}"
                                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                                            </Grid>
                                                                            <TextBlock Grid.Row="1"
                                                                                       Margin="0,6,0,0"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource HubTextBrush}"
                                                                                       Text="{Binding FileName}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       TextWrapping="Wrap"
                                                                                       MaxHeight="30" />
                                                                            <StackPanel Grid.Row="2"
                                                                                        Margin="0,2,0,0"
                                                                                        Orientation="Horizontal">
                                                                                <TextBlock FontSize="10"
                                                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                           Text="{Binding SizeText}"
                                                                                           Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                <TextBlock Margin="4,0,0,0"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                           Text="{Binding DurationText}"
                                                                                           Visibility="{Binding DurationText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource HubFocusBrush}" />
                                                                            <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   Text="{Binding MediaEmptyText}"
                                                   Visibility="{Binding MediaEmptyText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </Grid>
                                    <Button Grid.Row="4"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource HubGhostButtonStyle}"
                                            Command="{Binding LoadMoreMediaCommand}"
                                            Content="Показать ещё"
                                            Visibility="{Binding HasMoreMedia, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Показать ещё медиафайлы" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Индикатор «печатает…» над composer -->
                        <TextBlock Grid.Row="4"
                                   Margin="14,0,14,4"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="{Binding TypingText}"
                                   Visibility="{Binding HasTypingText, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="Индикатор набора текста" />

                        <!-- Composer -->
                        <Border Grid.Row="5"
                                Padding="14,10"
                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Контекст ответа/правки над полем ввода -->
                                <Border Grid.ColumnSpan="3"
                                        Margin="0,0,0,8"
                                        Padding="8,6"
                                        Background="{DynamicResource HubSurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HubAccentBrush}"
                                        BorderThickness="3,1,1,1"
                                        CornerRadius="6"
                                        Visibility="{Binding HasComposerContext, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubAccentBrush}"
                                                       Text="{Binding ComposerContextTitle}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding ComposerContextText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding CancelComposerContextCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Отменить ответ или правку" />
                                    </Grid>
                                </Border>

                                <!-- Статус загрузки вложений (текстом, не только прогрессом) -->
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="3"
                                           Margin="0,0,0,6"
                                           FontSize="11"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="{Binding UploadStatusText}"
                                           Visibility="{Binding HasUploadStatus, Converter={StaticResource BoolToVisibility}}" />

                                <Button Grid.Row="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding AttachCommand}"
                                        Content="📎"
                                        ToolTip="Прикрепить файлы"
                                        AutomationProperties.Name="Прикрепить файлы к сообщению" />

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         x:Name="ComposerInput"
                                         MinHeight="40"
                                         MaxHeight="120"
                                         VerticalAlignment="Bottom"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="ComposerInput_PreviewKeyDown"
                                         AutomationProperties.Name="Текст сообщения" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="Сообщение…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ComposerInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource HubPrimaryButtonStyle}"
                                        Command="{Binding SendCommand}"
                                        Content="{Binding SendButtonText}"
                                        AutomationProperties.Name="Отправить сообщение" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
