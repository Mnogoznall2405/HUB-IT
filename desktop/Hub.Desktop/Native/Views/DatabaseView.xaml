<UserControl x:Class="Hub.Desktop.Native.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,14,0,0" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource HubSectionTitleStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- Меню-фильтры: пункт = опция, команда — из Tag кнопки-хозяина. -->
            <Style x:Key="FilterMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}" />
                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, фильтры поля и типа, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Width="300"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск оборудования" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="{Binding SearchPlaceholderText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectFieldFilterCommand}"
                            Click="FieldFilterMenuButton_Click"
                            AutomationProperties.Name="Фильтр по полю поиска">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource FilterMenuItemStyle}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Поле: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedFieldFilterText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectTypeFilterCommand}"
                            Click="TypeFilterMenuButton_Click"
                            AutomationProperties.Name="Фильтр по типу оборудования">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource FilterMenuItemStyle}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Тип: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedTypeFilterText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Сбросить"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Сбросить фильтры базы" />
                    <ProgressBar Margin="8,0,0,0"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки оборудования" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить список оборудования" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка загрузки оборудования">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку оборудования" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Список оборудования | карточка -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Список -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource HubMutedTextStyle}"
                               FontSize="12"
                               Text="{Binding TotalText}"
                               Visibility="{Binding TotalText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                    <TextBlock DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               Style="{StaticResource HubMutedTextStyle}"
                               FontSize="12"
                               Text="{Binding LastUpdatedText}"
                               Visibility="{Binding LastUpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <ListBox Style="{StaticResource HubListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             AutomationProperties.Name="Список оборудования">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Title}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding TypeText}"
                                               Visibility="{Binding HasType, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding InvNoText, StringFormat=Инв. № {0}}"
                                                   Visibility="{Binding HasInvNo, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding SerialText, StringFormat=S/N {0}}"
                                                   Visibility="{Binding HasSerial, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding EmployeeText}"
                                               Visibility="{Binding HasEmployee, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding PlaceText}"
                                                   Visibility="{Binding HasPlace, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="7,2"
                                                CornerRadius="9"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое начальное состояние: поиска ещё не было -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowSearchPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Поиск по базе" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Введите инвентарный или серийный номер,&#x0a;фамилию сотрудника либо выберите тип." />
                    </StackPanel>

                    <!-- Пустая выдача после поиска -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Ничего не найдено" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="По текущим фильтрам оборудование не найдено." />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource HubSecondaryButtonStyle}"
                        Command="{Binding LoadMoreCommand}"
                        Content="{Binding MoreButtonText}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Показать ещё оборудование" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель списка и карточки оборудования" />

            <!-- Карточка оборудования -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Оборудование не выбрано" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Выберите позицию в списке слева." />
                    </StackPanel>

                    <ProgressBar Height="3"
                                 Margin="16"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки карточки оборудования" />

                    <TextBlock Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource HubErrorTextBrush}"
                               Text="{Binding DetailErrorText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Ошибка карточки оборудования" />

                    <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer Padding="22,18"
                                      VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="Карточка оборудования">
                            <StackPanel>
                                <!-- Шапка: модель + статус + тип/производитель (контекст Detail) -->
                                <StackPanel DataContext="{Binding Detail}">
                                    <TextBlock FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Модель оборудования" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Border Padding="8,3"
                                                CornerRadius="10"
                                                Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                        <Border Margin="8,0,0,0"
                                                Padding="8,3"
                                                CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource HubAccentBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasInvNo, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubAccentBrush}"
                                                       Text="{Binding InvNoText, StringFormat=Инв. № {0}}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding HeroMetaText}"
                                               Visibility="{Binding HasHeroMeta, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Передача: право database.write, как в веб-карточке -->
                                    <Button Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="14,6"
                                            Style="{StaticResource HubSecondaryButtonStyle}"
                                            Command="{Binding DataContext.OpenTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="⇄ Передать другому сотруднику"
                                            Visibility="{Binding DataContext.CanTransfer, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Передать оборудование другому сотруднику" />

                                    <!-- Учётные данные -->
                                    <Border Style="{StaticResource SectionPanelStyle}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                                       Text="Учёт" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="Тип" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding TypeText}" />
                                                <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Модель" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding ModelText}" />
                                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Производитель" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding VendorText}" />
                                                <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Инвентарный номер" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding InvNoText}" />
                                                <TextBlock Grid.Row="4" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Серийный номер" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding SerialText}" />
                                                <TextBlock Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Аппаратный серийный" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding HwSerialText}" />
                                                <TextBlock Grid.Row="6" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Парт. номер" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding PartNoText}" />
                                                <TextBlock Grid.Row="7" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Статус" />
                                                <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding StatusText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Сотрудник и расположение -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                                       Text="Сотрудник и расположение" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="Сотрудник" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding EmployeeText}" />
                                                <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Подразделение" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding EmployeeDeptText}" />
                                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Email" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding EmployeeEmailText}" />
                                                <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Филиал" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding BranchText}" />
                                                <TextBlock Grid.Row="4" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Локация" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding LocationText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Сеть и прочее -->
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                                       Text="Сеть и прочее" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="IP-адрес" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding IpText}" />
                                                <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="MAC-адрес" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding MacText}" />
                                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Сетевое имя" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding NetworkNameText}" />
                                                <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Домен" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding DomainText}" />
                                                <TextBlock Grid.Row="4" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Дата создания" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding DateCreateText}" />
                                                <TextBlock Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Изменено" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding DateModifiedText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Описание -->
                                    <Border Style="{StaticResource SectionPanelStyle}"
                                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                                       Text="Описание" />
                                            <TextBlock Style="{StaticResource MetaValueStyle}"
                                                       Text="{Binding DescriptionText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Фото: счётчик + превью (Bearer-контент через AuthImageLoader) -->
                                <Border Margin="0,14,0,0"
                                        Padding="14,10"
                                        CornerRadius="10"
                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding PhotoText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="📷" />
                                            <TextBlock Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       FontSize="12"
                                                       Text="{Binding PhotoText}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="Метка фото оборудования" />
                                        </StackPanel>
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding PhotoPreviews}"
                                                      Visibility="{Binding HasPhotoPreviews, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="Превью фото оборудования">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,6"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            AutomationProperties.Name="Открыть фото оборудования">
                                                        <Border CornerRadius="6"
                                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                BorderThickness="1">
                                                            <Image Width="120"
                                                                   Height="90"
                                                                   Stretch="UniformToFill"
                                                                   Source="{Binding Image}" />
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- История перемещений (CI_HISTORY) -->
                                <Border Margin="0,14,0,0"
                                        Padding="14,10"
                                        CornerRadius="10"
                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding HistoryText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="📜" />
                                            <TextBlock Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       FontSize="12"
                                                       Text="{Binding HistoryText}"
                                                       AutomationProperties.Name="Метка истории оборудования" />
                                        </StackPanel>
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding HistoryEntries}"
                                                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="История перемещений">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            Padding="10,8"
                                                            CornerRadius="6"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DateText}" />
                                                                <TextBlock Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Style="{StaticResource MetaLabelStyle}"
                                                                           FontSize="11"
                                                                           Text="{Binding HistIdText, StringFormat=\#{0}}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="12"
                                                                       Text="{Binding EmployeeText}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Style="{StaticResource MetaLabelStyle}">
                                                                <Run Text="{Binding BranchText, Mode=OneWay}" />
                                                                <Run Text=" / " />
                                                                <Run Text="{Binding LocationText, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Style="{StaticResource MetaLabelStyle}"
                                                                       Text="{Binding UserText, StringFormat=Пользователь: {0}}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding CommentText}"
                                                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Полноразмерный просмотр фото оборудования -->
        <Grid Background="#B3000000"
              Visibility="{Binding IsPhotoViewerOpen, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="900"
                    MaxHeight="700"
                    Padding="14"
                    CornerRadius="12"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Фото оборудования" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding ClosePhotoViewerCommand}"
                                Content="✕ Закрыть"
                                AutomationProperties.Name="Закрыть просмотр фото" />
                    </Grid>
                    <Image Grid.Row="1"
                           Margin="0,10,0,0"
                           Stretch="Uniform"
                           Source="{Binding PhotoViewerImage}"
                           AutomationProperties.Name="Фото оборудования" />
                </Grid>
            </Border>
        </Grid>

        <!-- Передача оборудования: модальный оверлей поверх всей страницы -->
        <Grid Grid.RowSpan="4"
              Panel.ZIndex="1"
              Background="#B3000000"
              PreviewKeyDown="TransferOverlay_PreviewKeyDown"
              Visibility="{Binding IsTransferOpen, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="560"
                    MaxHeight="660"
                    CornerRadius="12"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    DataContext="{Binding Transfer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Передача оборудования" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="{Binding InvNoText, StringFormat=Инв. № {0}}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Content="✕"
                                AutomationProperties.Name="Закрыть диалог передачи оборудования" />
                    </Grid>

                    <!-- Ошибка отправки/валидации: форма и поля сохраняются -->
                    <Border Grid.Row="1"
                            Margin="18,10,18,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   FontSize="12"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="18,8,18,0">
                        <ProgressBar Height="3"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource HubAccentBrush}"
                                     Background="{DynamicResource HubSurfaceRaisedBrush}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Индикатор передачи оборудования" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="{Binding StatusText}"
                                   Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="3"
                                  Margin="18,10,18,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Поля формы: скрываем после успешного результата -->
                            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
                                <!-- Сотрудник: /equipment/search/employee с debounce -->
                                <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Новый сотрудник *" />
                                <Grid>
                                    <TextBox x:Name="TransferEmployeeInput"
                                             Style="{StaticResource HubTextBoxStyle}"
                                             IsEnabled="{Binding AreInputsEnabled}"
                                             Text="{Binding EmployeeQuery, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Поиск сотрудника для передачи" />
                                    <TextBlock Margin="13,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               FontSize="13"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="ФИО или табельный номер…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TransferEmployeeInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Margin="0,6,0,0"
                                                 Width="90"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource HubAccentBrush}"
                                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                 Visibility="{Binding IsEmployeeSearchBusy, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Индикатор поиска сотрудника" />
                                </StackPanel>
                                <!-- Выбранный сотрудник: owner_no уходит в new_employee_no -->
                                <Border Margin="0,6,0,0"
                                        Padding="8,5"
                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource HubAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasSelectedEmployee, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedEmployee.Title}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding SelectedEmployee.MetaText}"
                                                       Visibility="{Binding SelectedEmployee.MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding ClearEmployeeCommand}"
                                                Content="✕"
                                                AutomationProperties.Name="Сбросить сотрудника передачи" />
                                    </Grid>
                                </Border>
                                <Popup IsOpen="{Binding IsEmployeePopupOpen, Mode=TwoWay}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=TransferEmployeeInput}"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border MinWidth="340"
                                            MaxWidth="480"
                                            Padding="4"
                                            Background="{DynamicResource HubSurfaceBrush}"
                                            BorderBrush="{DynamicResource HubBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ListBox Style="{StaticResource HubListBoxStyle}"
                                                 ItemsSource="{Binding EmployeeOptions}"
                                                 MaxHeight="240"
                                                 AutomationProperties.Name="Варианты сотрудника для передачи">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalContentAlignment="Stretch"
                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                            Command="{Binding DataContext.SelectEmployeeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='Выбрать сотрудника {0}'}">
                                                        <StackPanel>
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding MetaText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>

                                <!-- Филиал → локация (опционально, как в веб-форме) -->
                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource MetaLabelStyle}"
                                           Text="Филиал" />
                                <ComboBox ItemsSource="{Binding BranchOptions}"
                                          SelectedItem="{Binding SelectedBranch}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding AreInputsEnabled}"
                                          Background="{DynamicResource HubSurfaceAltBrush}"
                                          Foreground="{DynamicResource HubTextBrush}"
                                          AutomationProperties.Name="Филиал для передачи" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Локация" />
                                    <ProgressBar Grid.Column="1"
                                                 Width="60"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource HubAccentBrush}"
                                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                 Visibility="{Binding IsLocationsLoading, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Индикатор загрузки локаций" />
                                </Grid>
                                <ComboBox ItemsSource="{Binding LocationOptions}"
                                          SelectedItem="{Binding SelectedLocation}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding HasBranchSelection}"
                                          Background="{DynamicResource HubSurfaceAltBrush}"
                                          Foreground="{DynamicResource HubTextBrush}"
                                          AutomationProperties.Name="Локация для передачи" />

                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource MetaLabelStyle}"
                                           Text="Комментарий" />
                                <TextBox MinHeight="56"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         IsEnabled="{Binding AreInputsEnabled}"
                                         Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Комментарий к передаче" />
                            </StackPanel>

                            <!-- Результат: «Передано N позиций» + акты -->
                            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <Border Padding="12,10"
                                        CornerRadius="8"
                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource HubSuccessBrush}"
                                        BorderThickness="1">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HubSuccessBrush}"
                                               Text="{Binding ResultText}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Border>
                                <ItemsControl Margin="0,10,0,0"
                                              ItemsSource="{Binding Acts}"
                                              Visibility="{Binding HasActs, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Акты передачи оборудования">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,6"
                                                    HorizontalContentAlignment="Stretch"
                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                    Command="{Binding DataContext.DownloadActCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsNotDownloading}"
                                                    AutomationProperties.Name="{Binding FileName, StringFormat='Скачать акт {0}'}">
                                                <StackPanel>
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Действия формы -->
                    <StackPanel Grid.Row="4"
                                Margin="18,10,18,14"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                Command="{Binding SubmitCommand}"
                                Content="{Binding SubmitButtonText}"
                                Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}"
                                AutomationProperties.Name="Выполнить передачу оборудования" />
                        <Button Margin="10,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Content="Отмена"
                                AutomationProperties.Name="Отменить передачу оборудования" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
