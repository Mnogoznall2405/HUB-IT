<UserControl x:Class="Hub.Desktop.Native.Views.DlpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <Style x:Key="DlpSectionPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="DlpMetricPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="DlpMetaStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <!-- Подпись-метрика: заголовок над значением. -->
            <Style x:Key="DlpMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="DlpMetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!-- Строка «требует внимания» — клик открывает хост. -->
            <Style x:Key="DlpAttentionRowStyle" TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid AutomationProperties.Name="Страница DLP-мониторинга">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, филиал, только активные, обновить, графики -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="🛡 DLP" />
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="DlpSearchInput"
                                 Width="220"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск ПК по имени, пользователю или филиалу" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="ПК, пользователь, филиал…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DlpSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Margin="12,0,0,0"
                              MinWidth="170"
                              ItemsSource="{Binding BranchOptions}"
                              SelectedItem="{Binding SelectedBranch}"
                              AutomationProperties.Name="Фильтр по филиалу" />
                    <ToggleButton Margin="12,0,0,0"
                                  Style="{StaticResource HubChipToggleStyle}"
                                  IsChecked="{Binding ActiveOnly}"
                                  Content="Только активные"
                                  AutomationProperties.Name="Показать только активные сегодня ПК" />
                    <ProgressBar Margin="10,0,0,0"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки DLP" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ShowMonitoringCommand}"
                            Content="Мониторинг"
                            AutomationProperties.Name="Показать мониторинг DLP" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource HubSecondaryButtonStyle}"
                            Command="{Binding ShowSchedulesCommand}"
                            Content="Графики работ"
                            AutomationProperties.Name="Графики работы филиалов" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Обновить"
                            AutomationProperties.Name="Обновить DLP" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Баннер ошибки загрузки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка загрузки DLP">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку DLP" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку DLP" />
            </Grid>
        </Border>

        <!-- Контент: мониторинг | графики работ -->
        <Grid Grid.Row="2" Margin="20,6,20,12">

            <!-- ==================== Мониторинг ==================== -->
            <Grid Visibility="{Binding IsMonitoringView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Сводка за день: дата + KPI -->
                <Border Grid.Row="0" Style="{StaticResource DlpSectionPanelStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource DlpMetaStyle}"
                                   Text="Сводка за день:" />
                        <DatePicker Width="130"
                                    SelectedDate="{Binding OverviewDate, Mode=TwoWay}"
                                    AutomationProperties.Name="Дата сводки DLP" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DlpMetaStyle}"
                                   Text="{Binding SummaryText}"
                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource DlpSectionPanelStyle}">
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Активных ПК" />
                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding KpiActiveText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Ввод/пауза" />
                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding KpiActiveSecText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Отошли" />
                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding KpiAwaySecText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Развлечения" />
                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding KpiEntertainmentSecText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="USB" />
                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding KpiUsbText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Мессенджеры" />
                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding KpiMessengerText}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- Три колонки: внимание | ПК | деталь -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="210" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="330" MinWidth="270" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Требует внимания -->
                    <Border Grid.Column="0" Style="{StaticResource DlpSectionPanelStyle}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Обратить внимание" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AttentionGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding Title}"
                                                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource DlpAttentionRowStyle}"
                                                                    Command="{Binding DataContext.SelectHostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding ComputerName}"
                                                                    AutomationProperties.Name="{Binding Title}">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding Title}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                               Text="{Binding Subtitle}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="{DynamicResource HubWarningBrush}"
                                                                               Text="{Binding MetricText}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Список ПК -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource DlpMetaStyle}"
                                   Text="{Binding TotalText}" />
                        <ListBox Grid.Row="1"
                                 Style="{StaticResource HubListBoxStyle}"
                                 ItemsSource="{Binding Hosts}"
                                 SelectedItem="{Binding SelectedHost}"
                                 AutomationProperties.Name="Список ПК DLP">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Text="{Binding ComputerName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Text="{Binding UserText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding BranchText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding LastSeenText}" />
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding StatsText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Деталь хоста -->
                    <Border Grid.Column="4" Style="{StaticResource DlpSectionPanelStyle}" Margin="0,0,0,0">
                        <Grid>
                            <!-- Заглушка: хост не выбран -->
                            <TextBlock VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Выберите ПК слева — справа появится активность дня."
                                       Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Загрузка активности…"
                                       Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                       Text="{Binding DetailErrorText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Содержимое детали -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <!-- Шапка хоста -->
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas"
                                               Text="{Binding DetailTitle}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource DlpMetaStyle}"
                                               Text="{Binding DetailSubtitle}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DlpMetaStyle}" Text="День:" />
                                        <DatePicker Margin="8,0,0,0"
                                                    Width="130"
                                                    SelectedDate="{Binding DetailDate, Mode=TwoWay}"
                                                    AutomationProperties.Name="Дата активности хоста" />
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource DlpMetaStyle}"
                                                   Text="{Binding DetailShiftText}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource DlpMetaStyle}"
                                                   Text="{Binding DetailLunchText}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding DetailDayText}" />

                                    <!-- Сводка активности -->
                                    <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Ввод" />
                                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding DetActiveText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Пауза" />
                                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding DetPassiveText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Отошёл" />
                                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding DetAwayText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Блокировка" />
                                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding DetLockedText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Обед" />
                                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding DetBreakText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DlpMetricPanelStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DlpMetricLabelStyle}" Text="Вне смены" />
                                                <TextBlock Style="{StaticResource DlpMetricValueStyle}" Text="{Binding DetOffshiftText}" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubWarningBrush}"
                                               Text="{Binding DetActiveOffshiftText}"
                                               Visibility="{Binding DetActiveOffshiftText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding DetPctText}"
                                               Visibility="{Binding DetPctText, Converter={StaticResource NonEmptyStringToVisibility}}" />

                                    <!-- Дневная шкала: 288 ячеек по 5 минут -->
                                    <TextBlock Margin="0,10,0,4"
                                               Style="{StaticResource DlpMetricLabelStyle}"
                                               Text="Шкала дня (5 мин):" />
                                    <ItemsControl ItemsSource="{Binding Buckets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Width="10"
                                                           Height="14"
                                                           Margin="0,0,1,1"
                                                           Fill="{Binding Fill}"
                                                           ToolTip="{Binding TooltipText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" Fill="#2E7D32" />
                                        <TextBlock Margin="4,0,10,0" Style="{StaticResource DlpMetricLabelStyle}" Text="активен" />
                                        <Rectangle Width="10" Height="10" Fill="#90CAF9" />
                                        <TextBlock Margin="4,0,10,0" Style="{StaticResource DlpMetricLabelStyle}" Text="пауза" />
                                        <Rectangle Width="10" Height="10" Fill="#ED6C02" />
                                        <TextBlock Margin="4,0,10,0" Style="{StaticResource DlpMetricLabelStyle}" Text="отошёл/ввод вне смены" />
                                        <Rectangle Width="10" Height="10" Fill="#757575" />
                                        <TextBlock Margin="4,0,10,0" Style="{StaticResource DlpMetricLabelStyle}" Text="блокировка" />
                                        <Rectangle Width="10" Height="10" Fill="#0288D1" />
                                        <TextBlock Margin="4,0,10,0" Style="{StaticResource DlpMetricLabelStyle}" Text="обед" />
                                        <Rectangle Width="10" Height="10" Fill="#90A4AE" />
                                        <TextBlock Margin="4,0,10,0" Style="{StaticResource DlpMetricLabelStyle}" Text="вне смены" />
                                    </StackPanel>

                                    <!-- Лента серий -->
                                    <ListBox Margin="0,8,0,0"
                                             MaxHeight="150"
                                             Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding Runs}"
                                             AutomationProperties.Name="Лента серий активности">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="105"
                                                               FontSize="12"
                                                               FontFamily="Consolas"
                                                               Text="{Binding RangeText}" />
                                                    <TextBlock Width="110"
                                                               FontSize="12"
                                                               Text="{Binding StateText}" />
                                                    <TextBlock Width="80"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding DurationText}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding AppText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Топ приложений -->
                                    <WrapPanel Margin="0,8,0,0"
                                               Orientation="Horizontal"
                                               Visibility="{Binding HasTopApps, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding TopApps}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,6"
                                                            Padding="8,3"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1">
                                                        <TextBlock FontSize="11">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                 Text="{Binding DurationText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <!-- Вкладки проб -->
                                    <StackPanel Margin="0,10,0,6" Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                                      IsChecked="{Binding IsFilesTab, Mode=TwoWay}"
                                                      Content="Файлы"
                                                      AutomationProperties.Name="Вкладка файлов" />
                                        <ToggleButton Margin="6,0,0,0"
                                                      Style="{StaticResource HubChipToggleStyle}"
                                                      IsChecked="{Binding IsTelegramTab, Mode=TwoWay}"
                                                      Content="Telegram"
                                                      AutomationProperties.Name="Вкладка Telegram" />
                                        <ToggleButton Margin="6,0,0,0"
                                                      Style="{StaticResource HubChipToggleStyle}"
                                                      IsChecked="{Binding IsMaxTab, Mode=TwoWay}"
                                                      Content="MAX"
                                                      AutomationProperties.Name="Вкладка MAX" />
                                        <ToggleButton Margin="6,0,0,0"
                                                      Style="{StaticResource HubChipToggleStyle}"
                                                      IsChecked="{Binding IsBrowserTab, Mode=TwoWay}"
                                                      Content="Браузер"
                                                      AutomationProperties.Name="Вкладка браузера" />
                                        <ProgressBar Margin="12,0,0,0"
                                                     Width="70"
                                                     Height="3"
                                                     VerticalAlignment="Center"
                                                     IsIndeterminate="True"
                                                     Foreground="{DynamicResource HubAccentBrush}"
                                                     Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                     Visibility="{Binding IsProbeLoading, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="{Binding ProbeErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasProbeError, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource DlpMetaStyle}"
                                               Text="{Binding ProbeEmptyText}"
                                               Visibility="{Binding ProbeEmptyText, Converter={StaticResource NonEmptyStringToVisibility}}" />

                                    <!-- Файлы -->
                                    <StackPanel Visibility="{Binding IsFilesTab, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="0,0,0,4"
                                                   Style="{StaticResource DlpMetricLabelStyle}"
                                                   Text="{Binding NoiseHiddenText}"
                                                   Visibility="{Binding NoiseHiddenText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <ListBox MaxHeight="280"
                                                 Style="{StaticResource HubListBoxStyle}"
                                                 ItemsSource="{Binding FileEvents}"
                                                 AutomationProperties.Name="Файловые события хоста">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="40" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   Text="{Binding TimeText}" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding ChannelText}" />
                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="12"
                                                                   Text="{Binding FileName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FileName}" />
                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding SizeText}" />
                                                        <TextBlock Grid.Column="4"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding CountText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <!-- Telegram / MAX: диалоги -->
                                    <ItemsControl Visibility="{Binding IsTelegramTab, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding Chats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding ChatName}" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding UpdatedText}" />
                                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Messages}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                                        <TextBlock Width="60"
                                                                                   FontSize="11"
                                                                                   FontFamily="Consolas"
                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                   Text="{Binding TimeText}" />
                                                                        <TextBlock Width="110"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                   Text="{Binding SenderText}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock FontSize="12"
                                                                                   Text="{Binding Text}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding CountText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Visibility="{Binding IsMaxTab, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding Chats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding ChatName}" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding UpdatedText}" />
                                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Messages}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                                        <TextBlock Width="60"
                                                                                   FontSize="11"
                                                                                   FontFamily="Consolas"
                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                   Text="{Binding TimeText}" />
                                                                        <TextBlock Width="110"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                   Text="{Binding SenderText}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock FontSize="12"
                                                                                   Text="{Binding Text}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding CountText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Браузер -->
                                    <StackPanel Visibility="{Binding IsBrowserTab, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="0,0,0,4"
                                                   Style="{StaticResource DlpMetricLabelStyle}"
                                                   Text="{Binding BrowserTotalText}"
                                                   Visibility="{Binding BrowserTotalText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <ListBox MaxHeight="280"
                                                 Style="{StaticResource HubListBoxStyle}"
                                                 ItemsSource="{Binding BrowserVisits}"
                                                 AutomationProperties.Name="Визиты браузера хоста">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Width="90"
                                                                       FontSize="12"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding TimeText}" />
                                                            <TextBlock Width="110"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubWarningBrush}"
                                                                       Text="{Binding CategoryText}" />
                                                            <TextBlock FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding TitleText}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Margin="90,1,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding UrlText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="90,1,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding DwellText}" />
                                                        <TextBlock Margin="90,1,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding MetaText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== Графики работ ==================== -->
            <Grid Visibility="{Binding IsSchedulesView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DlpSectionPanelStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                   Text="Графики работы филиалов" />
                        <TextBlock Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DlpMetaStyle}"
                                   Text="Без графика пассивность остаётся «в работе»; с графиком обед и вне смены переклассифицируются."
                                   TextWrapping="Wrap" />
                        <ProgressBar Margin="12,0,0,0"
                                     Width="70"
                                     Height="3"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource HubAccentBrush}"
                                     Background="{DynamicResource HubSurfaceRaisedBrush}"
                                     Visibility="{Binding IsSchedulesLoading, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Уведомление: ошибка или успех сохранения/сброса -->
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="14,8"
                        CornerRadius="8"
                        BorderThickness="1"
                        Visibility="{Binding HasScheduleNotice, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Уведомление графиков DLP">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource HubSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource HubSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScheduleNoticeError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource HubErrorTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="12" Text="{Binding ScheduleNoticeText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScheduleNoticeError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Таблица филиалов -->
                <ListBox Grid.Row="2"
                         Margin="0,10,0,0"
                         Style="{StaticResource HubListBoxStyle}"
                         ItemsSource="{Binding Schedules}"
                         AutomationProperties.Name="Таблица графиков работы филиалов">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="{Binding BranchName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Text="{Binding WorkText}" />
                                <TextBlock Grid.Column="2"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Text="{Binding LunchText}" />
                                <TextBlock Grid.Column="3"
                                           FontSize="12"
                                           Text="{Binding OffsetText}" />
                                <TextBlock Grid.Column="4"
                                           FontSize="12"
                                           Text="{Binding DaysText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5"
                                           FontSize="11"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="{Binding UpdatedText}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="6"
                                        Margin="0,0,6,0"
                                        Padding="10,4"
                                        Command="{Binding DataContext.EditScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Изменить график филиала">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                                            <Setter Property="Content" Value="Изменить" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSchedule}" Value="False">
                                                    <Setter Property="Content" Value="Задать график" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="7"
                                        Padding="10,4"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding DeleteText}"
                                        Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Сбросить график филиала" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Редактор графика -->
                <Border Grid.Row="3"
                        Margin="0,10,0,0"
                        Style="{StaticResource DlpSectionPanelStyle}"
                        Visibility="{Binding IsEditingSchedule, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding EditingSchedule.Title}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DlpMetaStyle}" Text="Рабочее время:" />
                            <TextBox Margin="8,0,0,0"
                                     Width="60"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding EditingSchedule.WorkStartText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Начало рабочего дня" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource DlpMetaStyle}" Text="–" />
                            <TextBox Margin="6,0,0,0"
                                     Width="60"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding EditingSchedule.WorkEndText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Конец рабочего дня" />
                            <CheckBox Margin="18,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding EditingSchedule.LunchEnabled}"
                                      Content="Обед"
                                      AutomationProperties.Name="Обед в графике" />
                            <TextBox Margin="8,0,0,0"
                                     Width="60"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     IsEnabled="{Binding EditingSchedule.LunchEnabled}"
                                     Text="{Binding EditingSchedule.LunchStartText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Начало обеда" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource DlpMetaStyle}" Text="–" />
                            <TextBox Margin="6,0,0,0"
                                     Width="60"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     IsEnabled="{Binding EditingSchedule.LunchEnabled}"
                                     Text="{Binding EditingSchedule.LunchEndText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Конец обеда" />
                            <TextBlock Margin="18,0,0,0" Style="{StaticResource DlpMetaStyle}" Text="Смещение, мин:" />
                            <TextBox Margin="8,0,0,0"
                                     Width="60"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding EditingSchedule.OffsetText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Смещение часового пояса в минутах" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DlpMetaStyle}" Text="Дни:" />
                            <CheckBox Margin="10,0,0,0" IsChecked="{Binding EditingSchedule.Mon}" Content="Пн" />
                            <CheckBox Margin="6,0,0,0" IsChecked="{Binding EditingSchedule.Tue}" Content="Вт" />
                            <CheckBox Margin="6,0,0,0" IsChecked="{Binding EditingSchedule.Wed}" Content="Ср" />
                            <CheckBox Margin="6,0,0,0" IsChecked="{Binding EditingSchedule.Thu}" Content="Чт" />
                            <CheckBox Margin="6,0,0,0" IsChecked="{Binding EditingSchedule.Fri}" Content="Пт" />
                            <CheckBox Margin="6,0,0,0" IsChecked="{Binding EditingSchedule.Sat}" Content="Сб" />
                            <CheckBox Margin="6,0,0,0" IsChecked="{Binding EditingSchedule.Sun}" Content="Вс" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                    Command="{Binding SaveScheduleCommand}"
                                    Content="Сохранить"
                                    AutomationProperties.Name="Сохранить график филиала" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding CancelScheduleEditCommand}"
                                    Content="Отмена"
                                    AutomationProperties.Name="Отменить редактирование графика" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Пустое состояние -->
        <TextBlock Margin="20,0,0,12"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                   Text="Нет данных DLP — агенты ещё не прислали статистику."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
