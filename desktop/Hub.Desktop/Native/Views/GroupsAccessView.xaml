<UserControl x:Class="Hub.Desktop.Native.Views.GroupsAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <Style x:Key="ChipRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}">
                <!-- Ветки — читаемый hit-area даже до глобального чип-фикса. -->
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="12,5" />
            </Style>
            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="InfoChipStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Пилюля уровня доступа: тон по LevelTone (info/warning/error/member/muted). -->
            <Style x:Key="LevelPillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelTone}" Value="info">
                        <Setter Property="Foreground" Value="{DynamicResource HubAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelTone}" Value="warning">
                        <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelTone}" Value="error">
                        <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LevelPillBorderStyle" TargetType="Border" BasedOn="{StaticResource HubStatusPillStyle}">
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelTone}" Value="info">
                        <Setter Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelTone}" Value="warning">
                        <Setter Property="BorderBrush" Value="{DynamicResource HubWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelTone}" Value="error">
                        <Setter Property="BorderBrush" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Заголовок колонки-группы: метка папки + уровень (как веб-таблица). -->
            <DataTemplate x:Key="GroupHeaderTemplate">
                <StackPanel Margin="0,2" ToolTip="{Binding ToolTipText}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="150" />
                    <!-- Уровень группы: буква + подпись, чтобы строка W/R
                         читалась без легенды внизу. -->
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource HubTextSecondaryBrush}">
                        <Run FontWeight="SemiBold" Text="{Binding LevelMark, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding LevelLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="MatrixHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <!-- Полное имя группы — заголовок обрезан многоточием; DataContext — модель группы. -->
                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            </Style>
            <Style x:Key="MatrixCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск по учёткам/папкам, ветки, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center" Margin="0,0,8,6">
                        <TextBox x:Name="UserSearchInput"
                                 Width="230"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding UserQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск учётки по логину или ФИО" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Учётка или ФИО…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UserSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid VerticalAlignment="Center" Margin="0,0,8,6">
                        <TextBox x:Name="FolderSearchInput"
                                 Width="230"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding FolderQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск папки или группы" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Папка или группа…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FolderSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ItemsControl Margin="0,0,4,6" ItemsSource="{Binding BranchItems}"
                                  AutomationProperties.Name="Филиалы">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="GroupsAccessBranch"
                                             Style="{StaticResource ChipRadioStyle}"
                                             Margin="0,0,6,0"
                                             IsChecked="{Binding IsChecked}"
                                             Content="{Binding Label}"
                                             AutomationProperties.Name="{Binding AutomationName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="6,0,0,6"
                            VerticalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Сбросить"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Сбросить фильтры матрицы доступа" />
                    <ProgressBar Margin="8,0,0,6"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки матрицы доступа" />
                </WrapPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить матрицу доступа" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка загрузки матрицы доступа">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку матрицы" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Строка состояния снимка -->
        <WrapPanel Grid.Row="2" Margin="20,8,20,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetaLabelStyle}"
                       Text="{Binding SyncedAtText}"
                       Visibility="{Binding SyncedAtText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            <TextBlock Margin="12,0,0,0"
                       Style="{StaticResource MetaLabelStyle}"
                       Foreground="{DynamicResource HubWarningBrush}"
                       Text="{Binding StatusHintText}"
                       Visibility="{Binding StatusHintText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            <TextBlock Margin="12,0,0,0"
                       Style="{StaticResource MetaLabelStyle}"
                       Text="{Binding SummaryText}"
                       Visibility="{Binding SummaryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            <TextBlock Margin="12,0,0,0"
                       Style="{StaticResource MetaLabelStyle}"
                       Foreground="{DynamicResource HubWarningBrush}"
                       Text="{Binding TruncatedText}"
                       Visibility="{Binding TruncatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            <TextBlock Margin="12,0,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource MetaLabelStyle}"
                       Text="{Binding LastUpdatedText}"
                       Visibility="{Binding LastUpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
        </WrapPanel>

        <!-- Матрица | карточка группы -->
        <Grid Grid.Row="3" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Матрица доступа: колонки строятся в code-behind по MatrixGroups -->
            <Grid Grid.Column="0">
                <DataGrid x:Name="MatrixGrid"
                          ItemsSource="{Binding MatrixRows}"
                          AutoGenerateColumns="False"
                          FrozenColumnCount="1"
                          IsReadOnly="True"
                          SelectionUnit="Cell"
                          SelectionMode="Single"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HorizontalGridLinesBrush="{DynamicResource HubBorderDimBrush}"
                          VerticalGridLinesBrush="{DynamicResource HubBorderDimBrush}"
                          Background="{DynamicResource HubSurfaceAltBrush}"
                          BorderBrush="{DynamicResource HubBorderDimBrush}"
                          BorderThickness="1"
                          RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource MatrixHeaderStyle}"
                          CellStyle="{StaticResource MatrixCellStyle}"
                          CurrentCellChanged="MatrixGrid_CurrentCellChanged"
                          AutomationProperties.Name="Матрица доступа: учётки × папки"
                          Visibility="{Binding HasMatrix, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource HubMutedTextStyle}"
                           FontSize="14"
                           Text="Нет папок для отображения матрицы. Измените фильтр или обновите снимок."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="420"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="Пустая матрица доступа" />
                <TextBlock Margin="0,40,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Style="{StaticResource HubMutedTextStyle}"
                           FontSize="13"
                           Text="Нет учёток в выборке."
                           Visibility="{Binding IsUsersEmpty, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="Пустой список учёток" />
            </Grid>

            <!-- Карточка выбранной группы -->
            <Border Grid.Column="2"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="{DynamicResource HubSurfaceAltBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   FontSize="12"
                                   Text="ПАПКА / ГРУППА" />
                        <Button Grid.Column="1"
                                Margin="0,-6,-6,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseDetailCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                AutomationProperties.Name="Закрыть карточку группы"
                                Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource HubScrollViewerStyle}">
                        <StackPanel>
                            <!-- Заглушка -->
                            <StackPanel Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,24,0,0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           FontSize="13"
                                           Text="Выберите колонку-группу в матрице, чтобы посмотреть участников."
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           AutomationProperties.Name="Подсказка выбора группы" />
                            </StackPanel>

                            <ProgressBar Width="80"
                                         Height="3"
                                         HorizontalAlignment="Left"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource HubAccentBrush}"
                                         Background="{DynamicResource HubSurfaceRaisedBrush}"
                                         Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                         AutomationProperties.Name="Индикатор загрузки группы" />

                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                       FontSize="12"
                                       Text="{Binding DetailErrorText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.Name="Ошибка загрузки участников" />

                            <!-- Деталь -->
                            <StackPanel DataContext="{Binding Detail}"
                                        Visibility="{Binding DataContext.HasDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           FontSize="12"
                                           Text="{Binding DataContext.SelectionContextText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding DataContext.HasSelectionContext, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Margin="0,0,6,4"
                                            Style="{StaticResource LevelPillBorderStyle}">
                                        <TextBlock Style="{StaticResource LevelPillTextStyle}">
                                            <Run Text="{Binding LevelMark, Mode=OneWay}" />
                                            <Run Text="{Binding LevelLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Margin="0,0,6,4"
                                            Style="{StaticResource InfoChipStyle}"
                                            Visibility="{Binding BranchText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding BranchText}" />
                                    </Border>
                                    <Border Margin="0,0,6,4" Style="{StaticResource InfoChipStyle}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding MemberCountText}" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Путь" />
                                    <TextBlock Style="{StaticResource MetaValueStyle}"
                                               Text="{Binding PathText}"
                                               Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource MetaValueStyle}"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding Dn}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Описание" />
                                    <TextBlock Style="{StaticResource MetaValueStyle}"
                                               Text="{Binding DescriptionText}" />
                                </StackPanel>
                                <TextBlock Margin="0,14,0,6"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           FontSize="13"
                                           Text="{Binding MembersTitleText}" />
                                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                           FontSize="12"
                                           Text="Нет участников в снимке."
                                           Visibility="{Binding IsMembersEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Members}"
                                              AutomationProperties.Name="Участники группы">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8"
                                                        AutomationProperties.Name="{Binding AutomationName}">
                                                <TextBlock FontSize="13" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                                           FontSize="11"
                                                           Text="{Binding LoginText}"
                                                           Visibility="{Binding LoginText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Легенда уровней доступа -->
        <TextBlock Grid.Row="4"
                   Margin="20,0,20,10"
                   Style="{StaticResource HubMutedTextStyle}"
                   FontSize="11"
                   Text="R — Чтение  ·  W — Запись  ·  F — Полный  ·  + — Доступ  ·  · — Нет доступа. Выбор — клик по ячейке колонки-группы."
                   AutomationProperties.Name="Легенда уровней доступа" />
    </Grid>
</UserControl>
