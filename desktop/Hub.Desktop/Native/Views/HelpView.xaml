<UserControl x:Class="Hub.Desktop.Native.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск по базе знаний, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Width="340"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchInput_KeyDown"
                                 AutomationProperties.Name="Поиск по базе знаний" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Инструкция, VPN, почта, заявление…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Margin="10,0,0,0"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор поиска по базе знаний" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить базу знаний" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка базы знаний">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку базы знаний" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Дерево разделов/выдача поиска + карточка статьи -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Навигация: дерево раздел→статьи или результаты поиска -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,6"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource HubAccentBrush}"
                             Background="{DynamicResource HubSurfaceRaisedBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Индикатор загрузки базы знаний" />
                <Grid Grid.Row="1">
                    <!-- Дерево разделов со статьями -->
                    <TreeView x:Name="HelpTree"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="HelpTree_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Visibility="{Binding IsSearchActive, Converter={StaticResource InverseBoolToVisibility}}"
                              AutomationProperties.Name="Дерево разделов базы знаний">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding MetaText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="8,0,2,0"
                                            Padding="8,2"
                                            MinWidth="20"
                                            VerticalAlignment="Center"
                                            CornerRadius="10"
                                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                                            Visibility="{Binding BadgeText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding BadgeText}" />
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                                <!-- Собственный шаблон: системный шеврон-по-умолчанию
                                     почти невидим на тёмной теме — рисуем читаемый
                                     треугольник с разворотом при раскрытии. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <ToggleButton x:Name="Expander"
                                                              Width="18"
                                                              Height="18"
                                                              Margin="0,0,2,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              ClickMode="Press"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Cursor="Hand"
                                                              AutomationProperties.Name="Свернуть или развернуть раздел">
                                                    <Path x:Name="Chevron"
                                                          Width="8"
                                                          Height="8"
                                                          Data="M0,1 L6,4.5 L0,8 Z"
                                                          Fill="{DynamicResource HubTextSecondaryBrush}"
                                                          Stretch="Uniform">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" CenterX="4" CenterY="4.5" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </ToggleButton>
                                                <Border x:Name="ContentHost"
                                                        Grid.Column="1"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="Transparent"
                                                        CornerRadius="4">
                                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" CenterX="4" CenterY="4.5" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="Chevron" Property="Fill" Value="{DynamicResource HubAccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ContentHost" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- Результаты серверного поиска -->
                    <ListBox Style="{StaticResource HubListBoxStyle}"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchItem, Mode=TwoWay}"
                             Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Результаты поиска по базе знаний">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding SummaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding SummaryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding MetaText}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустая база -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="База знаний пока пуста" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Опубликованные инструкции и материалы появятся здесь." />
                    </StackPanel>

                    <!-- По запросу ничего не нашлось -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Ничего не нашлось — попробуйте другие слова." />
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель навигации и статьи"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей" />

            <!-- Карточка статьи -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ошибка детали -->
                    <Border Grid.Row="0"
                            Margin="18,14,18,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   Text="{Binding DetailErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Статья не выбрана -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Выберите статью" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Статья из раздела слева или выдачи поиска откроется здесь." />
                        </StackPanel>

                        <!-- Загрузка статьи -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowDetailLoading, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         IsIndeterminate="True" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Открываю статью…" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer Padding="22,18"
                                          VerticalScrollBarVisibility="Auto"
                                          DataContext="{Binding Detail}"
                                          AutomationProperties.Name="Карточка статьи базы знаний">
                                <StackPanel>
                                    <TextBlock FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Заголовок статьи" />

                                    <!-- Метаданные: тип, раздел, дата, владелец -->
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Border Padding="7,2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource HubStatusPillStyle}"
                                                BorderBrush="{DynamicResource HubAccentBrush}"
                                                Visibility="{Binding TypeText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubAccentBrush}"
                                                       Text="{Binding TypeText}" />
                                        </Border>
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding CategoryText}"
                                                   Visibility="{Binding CategoryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding UpdatedText, StringFormat='Обновлено {0}'}"
                                                   Visibility="{Binding UpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding OwnerText, StringFormat='Автор: {0}'}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding OwnerText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding TagsText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding TagsText, Converter={StaticResource NonEmptyStringToVisibility}}" />

                                    <local:MarkdownTextBlock Margin="0,14,0,0"
                                                             FontSize="14"
                                                             MarkdownText="{Binding BodyMarkdown}"
                                                             TextWrapping="Wrap"
                                                             Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}"
                                                             AutomationProperties.Name="Текст статьи" />
                                    <TextBlock Margin="0,14,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               Text="Текст статьи отсутствует."
                                               Visibility="{Binding HasBody, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статусная строка -->
        <Border Grid.Row="3" Padding="20,0,20,12">
            <Grid>
                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding ArticlesTotalText}"
                           AutomationProperties.Name="Счётчик статей базы знаний" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding LastUpdatedText}"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
