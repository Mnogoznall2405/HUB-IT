<UserControl x:Class="Hub.Desktop.Native.Views.ItObjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource HubSectionTitleStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,6" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SectionPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,14,0,0" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Пилюля статуса ПК в детали: тон по StatusTone (success/warning/error/muted). -->
            <Style x:Key="StatusPillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusTone}" Value="success">
                        <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="warning">
                        <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="error">
                        <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StatusPillBorderStyle" TargetType="Border" BasedOn="{StaticResource HubStatusPillStyle}">
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusTone}" Value="success">
                        <Setter Property="BorderBrush" Value="{DynamicResource HubSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="warning">
                        <Setter Property="BorderBrush" Value="{DynamicResource HubWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="error">
                        <Setter Property="BorderBrush" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Строка компьютера объекта: вся строка — ToggleButton раскрытия детали. -->
            <Style x:Key="ComputerRowToggleStyle" TargetType="ToggleButton">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource HubFocusStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HubSelectionBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HubAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, фильтры «Только мои»/«Удалённые», обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Width="340"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск ИТ-объекта по имени" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Имя объекта…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ToggleButton Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource HubChipToggleStyle}"
                                  IsChecked="{Binding OnlyMine}"
                                  Content="Только мои"
                                  Visibility="{Binding ShowManageFilters, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Показать только мои объекты" />
                    <ToggleButton VerticalAlignment="Center"
                                  Style="{StaticResource HubChipToggleStyle}"
                                  IsChecked="{Binding ShowHidden}"
                                  Content="Удалённые"
                                  Visibility="{Binding ShowManageFilters, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Показать удалённые объекты" />
                    <ProgressBar Margin="8,0,0,0"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки ИТ-объектов" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить список ИТ-объектов" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка загрузки ИТ-объектов">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку ИТ-объектов" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Список объектов | карточка -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Список объектов -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <ListBox Style="{StaticResource HubListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             AutomationProperties.Name="Список ИТ-объектов">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding OwnerAutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding OwnerText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOwnerMissing}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Border Margin="8,0,0,4"
                                                Padding="7,2"
                                                HorizontalAlignment="Right"
                                                CornerRadius="9"
                                                Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource HubErrorTextBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource HubErrorTextBrush}"
                                                       Text="Удалён" />
                                        </Border>
                                        <Border Margin="8,0,0,0"
                                                Padding="7,2"
                                                HorizontalAlignment="Right"
                                                CornerRadius="9"
                                                Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource HubBorderBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="Без привязки" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние списка -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Объектов нет" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="По текущим фильтрам доступные ИТ-объекты не найдены." />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource HubSecondaryButtonStyle}"
                        Command="{Binding LoadMoreCommand}"
                        Content="{Binding MoreButtonText}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Показать ещё ИТ-объекты" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель списка и карточки объекта" />

            <!-- Карточка объекта -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Объект не выбран" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Выберите объект в списке слева." />
                    </StackPanel>

                    <ProgressBar Height="3"
                                 Margin="16"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки карточки объекта" />

                    <TextBlock Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource HubErrorTextBrush}"
                               Text="{Binding DetailErrorText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Ошибка карточки объекта" />

                    <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer Padding="22,18"
                                      VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding Detail}"
                                      AutomationProperties.Name="Карточка ИТ-объекта">
                        <StackPanel>
                            <!-- Шапка: имя + бейджи -->
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Имя ИТ-объекта" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Border Margin="0,0,8,0"
                                        Padding="8,3"
                                        CornerRadius="10"
                                        Background="{DynamicResource HubSurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HubErrorTextBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               Text="Удалён" />
                                </Border>
                                <Border Padding="8,3"
                                        CornerRadius="10"
                                        Background="{DynamicResource HubSurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HubBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="Без привязки к ITINVENT" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="{Binding SourceDatabaseText}"
                                       Visibility="{Binding SourceDatabaseText, Converter={StaticResource NonEmptyStringToVisibility}}" />

                            <!-- Реквизиты: айтишник -->
                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Реквизиты" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Айтишник" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource MetaValueStyle}"
                                           Text="{Binding OwnerText}"
                                           AutomationProperties.Name="Айтишник объекта" />
                            </Grid>

                            <!-- Мой доступ -->
                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Мой доступ"
                                       Visibility="{Binding HasAccessChips, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding AccessChips}"
                                          Visibility="{Binding HasAccessChips, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="Доступы к разделам объекта">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipStyle}">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubTextBrush}"
                                                       Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Постоянная команда -->
                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Постоянная команда" />
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding TeamRoles}"
                                          AutomationProperties.Name="Постоянная команда объекта">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding RoleLabel}" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource MetaValueStyle}"
                                                               Text="{Binding PersonText}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Style="{StaticResource MetaLabelStyle}"
                                                               Text="{Binding AssignedText}"
                                                               Visibility="{Binding AssignedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           Style="{StaticResource MetaLabelStyle}"
                                                           Text="{Binding MetaText}"
                                                           Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Доступы (гранты) -->
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Доступы"
                                       Visibility="{Binding HasGrants, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding Grants}"
                                          Visibility="{Binding HasGrants, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="Выданные доступы к объекту">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetaValueStyle}"
                                                           Text="{Binding PersonText}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Style="{StaticResource MetaLabelStyle}"
                                                           Text="{Binding CreatedText, StringFormat='с {0}'}"
                                                           Visibility="{Binding CreatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding SectionLevelText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Компьютеры объекта -->
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasComputersSection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding ComputersTitleText}"
                                               AutomationProperties.Name="Компьютеры объекта" />
                                    <ProgressBar Margin="0,8,0,0"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource HubAccentBrush}"
                                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                 Visibility="{Binding IsComputersLoading, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Индикатор загрузки компьютеров" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               FontSize="12"
                                               Text="{Binding ComputersErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasComputersError, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="К этому объекту пока не привязан ни один компьютер с агентом."
                                               Visibility="{Binding IsComputersEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  ItemsSource="{Binding Computers}"
                                                  AutomationProperties.Name="Список компьютеров объекта">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,0">
                                                    <!-- Строка-переключатель: клик раскрывает деталь под строкой -->
                                                    <ToggleButton Style="{StaticResource ComputerRowToggleStyle}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Command="{Binding DataContext.SelectComputerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  AutomationProperties.Name="{Binding AutomationName}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Hostname}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1"
                                                                    Padding="8,2"
                                                                    Margin="8,0"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="9"
                                                                    BorderThickness="1"
                                                                    Style="{StaticResource HubStatusPillStyle}"
                                                                    local:HubTone.Value="{Binding StatusTone}">
                                                                <TextBlock FontSize="11"
                                                                           Style="{StaticResource HubToneTextStyle}"
                                                                           Text="{Binding StatusText}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <TextBlock FontSize="12"
                                                                           Foreground="{DynamicResource HubTextBrush}"
                                                                           Text="{Binding UserText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding UserText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                <TextBlock Margin="8,0,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                           Text="{Binding IpText}"
                                                                           Visibility="{Binding IpText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                <TextBlock Margin="8,0,0,0"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                           Text="{Binding InventoryText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding InventoryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </ToggleButton>

                                                    <!-- Деталь компьютера под выбранной строкой -->
                                                    <Border Margin="10,6,0,0"
                                                            Padding="12,10"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1"
                                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="Деталь компьютера объекта">
                                                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <ProgressBar Height="3"
                                                                         IsIndeterminate="True"
                                                                         Foreground="{DynamicResource HubAccentBrush}"
                                                                         Background="{DynamicResource HubSurfaceAltBrush}"
                                                                         Visibility="{Binding IsComputerDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                                                         AutomationProperties.Name="Индикатор загрузки детали компьютера" />
                                                            <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                                                       FontSize="12"
                                                                       Text="{Binding ComputerDetailErrorText}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasComputerDetailError, Converter={StaticResource BoolToVisibility}}"
                                                                       AutomationProperties.Name="Ошибка детали компьютера" />
                                                            <Border Visibility="{Binding HasComputerDetail, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel DataContext="{Binding ComputerDetail}">
                                                                    <!-- Шапка: имя + статус + IP/MAC -->
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding Title}"
                                                                                   TextWrapping="Wrap"
                                                                                   AutomationProperties.Name="Имя компьютера объекта" />
                                                                        <Border Margin="10,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Style="{StaticResource StatusPillBorderStyle}">
                                                                            <TextBlock Style="{StaticResource StatusPillTextStyle}"
                                                                                       Text="{Binding StatusText}" />
                                                                        </Border>
                                                                        <TextBlock Margin="10,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Style="{StaticResource MetaLabelStyle}"
                                                                                   Text="{Binding AgeText}" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               Style="{StaticResource MetaLabelStyle}"
                                                                               Text="{Binding HeroMetaText}"
                                                                               Visibility="{Binding HeroMetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource HubWarningBrush}"
                                                                               Text="{Binding AssignmentText}"
                                                                               Visibility="{Binding HasAssignmentText, Converter={StaticResource BoolToVisibility}}" />

                                                                    <!-- Пользователь и расположение -->
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               Style="{StaticResource SectionHeaderStyle}"
                                                                               Text="Пользователь и расположение" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="150" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="Сотрудник" />
                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding UserText}" />
                                                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Филиал" />
                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding BranchText}" />
                                                                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Расположение" />
                                                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding LocationText}" />
                                                                        <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="База" />
                                                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding DatabaseText}" />
                                                                        <TextBlock Grid.Row="4" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Инвентарный номер" />
                                                                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding InventoryText}" />
                                                                        <TextBlock Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Модель по учёту" />
                                                                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding InventoryModelText}" />
                                                                        <TextBlock Grid.Row="6" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Последний отчёт" />
                                                                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding LastSeenText}" />
                                                                    </Grid>

                                                                    <!-- Оборудование и агент -->
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               Style="{StaticResource SectionHeaderStyle}"
                                                                               Text="Оборудование и агент" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="150" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="Процессор" />
                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding CpuText}" />
                                                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Оперативная память" />
                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding RamText}" />
                                                                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Загрузка CPU" />
                                                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding CpuLoadText}" />
                                                                        <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Использование RAM" />
                                                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding RamUsedText}" />
                                                                        <TextBlock Grid.Row="4" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Время работы" />
                                                                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding UptimeText}" />
                                                                        <TextBlock Grid.Row="5" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Последняя перезагрузка" />
                                                                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding LastRebootText}" />
                                                                        <TextBlock Grid.Row="6" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Серийный номер" />
                                                                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding SystemSerialText}" />
                                                                    </Grid>

                                                                    <!-- Сеть -->
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               Style="{StaticResource SectionHeaderStyle}"
                                                                               Text="Сеть" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="150" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="Основной IP" />
                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding IpPrimaryText}" />
                                                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Все IP" />
                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding IpListText}" />
                                                                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="MAC" />
                                                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding MacAddress}" />
                                                                    </Grid>
                                                                    <ItemsControl Margin="0,8,0,0"
                                                                                  ItemsSource="{Binding NetworkDevices}"
                                                                                  Visibility="{Binding HasNetworkDevices, Converter={StaticResource BoolToVisibility}}"
                                                                                  AutomationProperties.Name="Сетевые устройства">
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Margin="0,0,0,6"
                                                                                        Padding="10,6"
                                                                                        CornerRadius="8"
                                                                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                        BorderThickness="1">
                                                                                    <StackPanel>
                                                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" />
                                                                                        <TextBlock FontSize="11"
                                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                   Text="{Binding MetaText}"
                                                                                                   Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}" />
                                                                                        <TextBlock FontSize="11"
                                                                                                   Foreground="{DynamicResource HubAccentBrush}"
                                                                                                   Text="{Binding Ipv4Text}"
                                                                                                   Visibility="{Binding HasIpv4, Converter={StaticResource BoolToVisibility}}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- Диски -->
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               Style="{StaticResource SectionHeaderStyle}"
                                                                               Text="Диски и тома"
                                                                               Visibility="{Binding HasDisks, Converter={StaticResource BoolToVisibility}}" />
                                                                    <ItemsControl ItemsSource="{Binding Disks}"
                                                                                  Visibility="{Binding HasDisks, Converter={StaticResource BoolToVisibility}}"
                                                                                  AutomationProperties.Name="Диски и тома">
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Margin="0,0,0,6"
                                                                                        Padding="10,6"
                                                                                        CornerRadius="8"
                                                                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                                                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                        BorderThickness="1">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <StackPanel>
                                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" />
                                                                                            <TextBlock FontSize="11"
                                                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                       Text="{Binding SubtitleText}"
                                                                                                       Visibility="{Binding SubtitleText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   VerticalAlignment="Top"
                                                                                                   FontSize="11"
                                                                                                   Text="{Binding HealthText}"
                                                                                                   Visibility="{Binding HasHealth, Converter={StaticResource BoolToVisibility}}">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaValueStyle}">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                                                            <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- Outlook и изменения -->
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               Style="{StaticResource SectionHeaderStyle}"
                                                                               Text="Outlook и изменения" />
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="150" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="Состояние Outlook" />
                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding OutlookStatusText}" />
                                                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Размер файлов Outlook" />
                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding OutlookSizeText}" />
                                                                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Архивов" />
                                                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding OutlookArchivesText}" />
                                                                        <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource MetaLabelStyle}" Text="Изменений за 30 дней" />
                                                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding ChangesCountText}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Инвентарь объекта -->
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasInventorySection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="Инвентарь"
                                               AutomationProperties.Name="Инвентарь объекта" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding InventoryCaptionText}"
                                               Visibility="{Binding InventoryCaptionText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <ProgressBar Margin="0,8,0,0"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource HubAccentBrush}"
                                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                 Visibility="{Binding IsInventoryLoading, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Индикатор загрузки инвентаря" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               FontSize="12"
                                               Text="{Binding InventoryErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasInventoryError, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="На этом объекте пока нет оборудования."
                                               Visibility="{Binding IsInventoryEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  ItemsSource="{Binding InventoryItems}"
                                                  AutomationProperties.Name="Оборудование объекта">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding MetaText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Top"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding StatusText}"
                                                               Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Мониторинг объекта -->
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasMonitoringSection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding MonitoringTitleText}"
                                               AutomationProperties.Name="Мониторинг объекта" />
                                    <ProgressBar Margin="0,8,0,0"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource HubAccentBrush}"
                                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                 Visibility="{Binding IsMonitoringLoading, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Индикатор загрузки мониторинга" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                               FontSize="12"
                                               Text="{Binding MonitoringErrorText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasMonitoringError, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="К объекту не привязано ни одного устройства мониторинга."
                                               Visibility="{Binding IsMonitoringEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  ItemsSource="{Binding MonitoringTargets}"
                                                  AutomationProperties.Name="Устройства мониторинга объекта">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,0">
                                                    <!-- Строка-переключатель: клик раскрывает спарклайн задержки под строкой -->
                                                    <ToggleButton Style="{StaticResource ComputerRowToggleStyle}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Command="{Binding DataContext.SelectMonitoringTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  AutomationProperties.Name="{Binding AutomationName}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="10,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding AddressText}"
                                                                       Visibility="{Binding AddressText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            <Border Grid.Column="2"
                                                                    Margin="10,0,0,0"
                                                                    Padding="8,2"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="9"
                                                                    BorderThickness="1"
                                                                    Style="{StaticResource HubStatusPillStyle}"
                                                                    local:HubTone.Value="{Binding StatusTone}">
                                                                <TextBlock FontSize="11"
                                                                           Style="{StaticResource HubToneTextStyle}"
                                                                           Text="{Binding StatusText}" />
                                                            </Border>
                                                        </Grid>
                                                    </ToggleButton>

                                                    <!-- Спарклайн задержки за 24 ч под выбранной строкой -->
                                                    <Border Margin="10,6,0,0"
                                                            Padding="12,10"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1"
                                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="График задержки устройства мониторинга">
                                                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <ProgressBar Height="3"
                                                                         IsIndeterminate="True"
                                                                         Foreground="{DynamicResource HubAccentBrush}"
                                                                         Background="{DynamicResource HubSurfaceAltBrush}"
                                                                         Visibility="{Binding IsMonitoringLatencyLoading, Converter={StaticResource BoolToVisibility}}"
                                                                         AutomationProperties.Name="Индикатор загрузки графика задержки" />
                                                            <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                                                       FontSize="12"
                                                                       Text="{Binding MonitoringLatencyErrorText}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasMonitoringLatencyError, Converter={StaticResource BoolToVisibility}}"
                                                                       AutomationProperties.Name="Ошибка графика задержки" />
                                                            <Border Visibility="{Binding HasMonitoringLatency, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel DataContext="{Binding MonitoringLatency}">
                                                                    <Border Width="200"
                                                                            Height="44"
                                                                            HorizontalAlignment="Left"
                                                                            CornerRadius="6"
                                                                            Background="{DynamicResource HubSurfaceAltBrush}"
                                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                            BorderThickness="1"
                                                                            ClipToBounds="True">
                                                                        <Viewbox Stretch="Fill">
                                                                            <ItemsControl Width="100"
                                                                                          Height="30"
                                                                                          ItemsSource="{Binding Segments}"
                                                                                          AutomationProperties.Name="Спарклайн задержки за 24 часа">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <Canvas Width="100" Height="30" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Polyline Points="{Binding}"
                                                                                                  Stroke="{DynamicResource HubAccentBrush}"
                                                                                                  StrokeThickness="1.5"
                                                                                                  StrokeLineJoin="Round" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Style="{StaticResource MetaLabelStyle}"
                                                                               Text="{Binding SummaryText}"
                                                                               AutomationProperties.Name="{Binding AutomationName}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Разделы без нативного просмотра: только отметки -->
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasPasswordsSection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="Пароли" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="Секреты объекта доступны в веб-версии портала" />
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding PasswordAuditLoaded, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding PasswordAuditText}"
                                                   AutomationProperties.Name="Журнал аудита паролей" />
                                        <ItemsControl Margin="0,4,0,0"
                                                      ItemsSource="{Binding PasswordAuditEntries}"
                                                      Visibility="{Binding HasPasswordAudit, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="Журнал раскрытий секретов объекта">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource MetaLabelStyle}"
                                                               Text="{Binding LineText}"
                                                               AutomationProperties.Name="{Binding AutomationName}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    Visibility="{Binding HasNetmapSection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="Карта сети" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="Редактирование схемы — в веб-версии портала"
                                                   Visibility="{Binding HasNetmapImage, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="Превью схемы не загружено — доступно в веб-версии портала"
                                                   Visibility="{Binding HasNetmapImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                    <Image Margin="0,10,0,0"
                                           MaxHeight="420"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"
                                           Source="{Binding NetmapImage}"
                                           Visibility="{Binding HasNetmapImage, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.Name="Превью карты сети" />
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding NetmapVersionsLoaded, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding NetmapVersionsText}"
                                                   AutomationProperties.Name="Версии карты сети" />
                                        <ItemsControl Margin="0,4,0,0"
                                                      ItemsSource="{Binding NetmapVersions}"
                                                      Visibility="{Binding HasNetmapVersions, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="Список версий карты сети">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource MetaLabelStyle}"
                                                               Text="{Binding LineText}"
                                                               AutomationProperties.Name="{Binding AutomationName}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статусная строка -->
        <Border Grid.Row="3" Padding="20,0,20,12">
            <Grid>
                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding TotalText}"
                           AutomationProperties.Name="Счётчик ИТ-объектов" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding LastUpdatedText}"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
