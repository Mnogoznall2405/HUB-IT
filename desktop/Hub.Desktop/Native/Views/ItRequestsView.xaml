<UserControl x:Class="Hub.Desktop.Native.Views.ItRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid AutomationProperties.Name="Страница заявок на МПЗ">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: вид списка, поиск, стадия, склад, просрочка, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                  Margin="0,0,0,6"
                                  IsChecked="{Binding IsViewActive, Mode=OneWay}"
                                  Command="{Binding SelectViewCommand}"
                                  CommandParameter="active"
                                  Content="Активные"
                                  AutomationProperties.Name="Активные заявки на МПЗ" />
                    <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                  Margin="0,0,0,6"
                                  IsChecked="{Binding IsViewHistory, Mode=OneWay}"
                                  Command="{Binding SelectViewCommand}"
                                  CommandParameter="history"
                                  Content="История"
                                  AutomationProperties.Name="История заявок на МПЗ" />
                    <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                  Margin="0,0,0,6"
                                  IsChecked="{Binding IsViewAll, Mode=OneWay}"
                                  Command="{Binding SelectViewCommand}"
                                  CommandParameter="all"
                                  Content="Все"
                                  AutomationProperties.Name="Все заявки на МПЗ" />
                    <Grid VerticalAlignment="Center" Margin="12,0,0,6">
                        <TextBox x:Name="SearchInput"
                                 Width="230"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск заявки на МПЗ" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Номер, позиция, склад…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Margin="0,0,8,6"
                              Width="190"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding StageOptions}"
                              DisplayMemberPath="Text"
                              SelectedValuePath="Ref"
                              SelectedValue="{Binding StageFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Фильтр заявок: стадия" />
                    <ComboBox Margin="0,0,8,6"
                              Width="230"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding WarehouseFacets}"
                              DisplayMemberPath="Text"
                              SelectedItem="{Binding WarehouseFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Фильтр заявок: склад" />
                    <CheckBox Margin="0,0,10,6"
                              VerticalAlignment="Center"
                              IsChecked="{Binding OverdueOnly, Mode=TwoWay}"
                              Content="Только просроченные"
                              AutomationProperties.Name="Фильтр заявок: только просроченные" />
                    <ProgressBar Margin="10,0,0,6"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки заявок на МПЗ" />
                </WrapPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить заявки на МПЗ" />
            </Grid>
        </Border>

        <!-- Баннер ошибки страницы -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding BannerErrorText, Converter={StaticResource NonEmptyStringToVisibility}}"
                AutomationProperties.Name="Ошибка страницы заявок на МПЗ">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку заявок" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                        AutomationProperties.Name="Скрыть ошибку заявок" />
            </Grid>
        </Border>

        <!-- Итоги, метка снапшота, предупреждения -->
        <StackPanel Grid.Row="2" Margin="20,8,20,0">
            <Border Padding="12,8"
                    CornerRadius="8"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubStatusInProgressBrush}"
                    BorderThickness="1"
                    Visibility="{Binding NoticeText, Converter={StaticResource NonEmptyStringToVisibility}}">
                <TextBlock Foreground="{DynamicResource HubStatusInProgressBrush}"
                           FontSize="12"
                           Text="{Binding NoticeText}"
                           TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,6,16,0"
                           FontSize="12"
                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                           Text="{Binding ResultText}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                           Text="{Binding AsOfText}" />
            </StackPanel>
        </StackPanel>

        <!-- Список заявок | карточка заявки -->
        <Grid Grid.Row="3" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox Style="{StaticResource HubListBoxStyle}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedRequest}"
                         Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="Список заявок на МПЗ">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border VerticalAlignment="Center"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            local:HubTone.Value="{Binding StateTone}">
                                        <TextBlock FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource HubToneTextStyle}"
                                                   Text="{Binding StateLabel}" />
                                    </Border>
                                    <Border Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            local:HubTone.Value="danger"
                                            Visibility="{Binding Overdue, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource HubToneTextStyle}"
                                                   Text="просрочена" />
                                    </Border>
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding Number}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="{Binding WarehouseName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="{Binding NomenclaturePreview}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding NomenclaturePreview, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding DateText, StringFormat=от {0}}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding RequiredDateText, StringFormat=к {0}}"
                                               Visibility="{Binding RequiredDateText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding ProgressLabel}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Заявок нет" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Измените фильтры или вид списка — заявки появятся после синхронизации с 1С." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ListErrorText, Converter={StaticResource NonEmptyStringToVisibility}}"
                            AutomationProperties.Name="Ошибка списка заявок">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource HubErrorTextBrush}"
                               Text="{Binding ListErrorText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding RetryListCommand}"
                            Content="Повторить"
                            AutomationProperties.Name="Повторить загрузку заявок" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель списка и карточки заявки" />

            <!-- Карточка заявки -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedRequest, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Заявка не выбрана" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Выберите заявку в списке слева." />
                    </StackPanel>

                    <ProgressBar Height="3"
                                 Margin="16"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки заявки" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding DetailErrorText, Converter={StaticResource NonEmptyStringToVisibility}}"
                                AutomationProperties.Name="Ошибка карточки заявки">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HubErrorTextBrush}"
                                   Text="{Binding DetailErrorText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding RetryDetailCommand}"
                                Content="Повторить"
                                AutomationProperties.Name="Повторить карточку заявки" />
                    </StackPanel>

                    <ScrollViewer Padding="22,18"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding Detail}">
                            <!-- Шапка: номер, состояние, метки -->
                            <StackPanel Orientation="Horizontal">
                                <Border VerticalAlignment="Top"
                                        Style="{StaticResource HubStatusPillStyle}"
                                        local:HubTone.Value="{Binding StateTone}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource HubToneTextStyle}"
                                               Text="{Binding StateLabel}" />
                                </Border>
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="{Binding Number, StringFormat=Заявка {0}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Border Margin="0,0,8,4"
                                        Style="{StaticResource HubStatusPillStyle}"
                                        local:HubTone.Value="danger"
                                        Visibility="{Binding Overdue, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource HubToneTextStyle}"
                                               Text="Просрочена" />
                                </Border>
                                <Border Margin="0,0,8,4"
                                        Style="{StaticResource HubStatusPillStyle}"
                                        local:HubTone.Value="warning"
                                        Visibility="{Binding AttentionRequired, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource HubToneTextStyle}"
                                               Text="Требует внимания" />
                                </Border>
                                <Border Margin="0,0,8,4"
                                        Style="{StaticResource HubStatusPillStyle}"
                                        local:HubTone.Value="info"
                                        Visibility="{Binding WarehouseName, Converter={StaticResource NonEmptyStringToVisibility}}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource HubToneTextStyle}"
                                               Text="{Binding WarehouseName}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="{Binding StateDescription}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding StateDescription, Converter={StaticResource NonEmptyStringToVisibility}}" />

                            <!-- Маршрут заявки -->
                            <TextBlock Margin="0,16,0,6"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Маршрут" />
                            <ItemsControl ItemsSource="{Binding Journey}"
                                          AutomationProperties.Name="Маршрут заявки">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label, StringFormat='Этап: {0}'}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,14,8" Width="150">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         VerticalAlignment="Center"
                                                         Style="{StaticResource HubToneDotStyle}"
                                                         local:HubTone.Value="{Binding Tone}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Label}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Margin="18,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding MetaText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Реквизиты -->
                            <TextBlock Margin="0,14,0,6"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Реквизиты" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Дата заявки" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding DateText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Требуется к" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding RequiredDateText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Фактическая поставка" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding DeliveryDateText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding DepartmentName, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Подразделение" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding DepartmentName}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding OrganizationName, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Организация" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding OrganizationName}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding InitiatorName, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Инициатор" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding InitiatorName}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding ResponsibleName, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Ответственный" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding ResponsibleName}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding ManagerNames, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Закупщик" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding ManagerNames}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding SupplierNames, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Поставщик" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding SupplierNames}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding GroupName, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Номенклатурная группа" />
                                        <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding GroupName}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding Comment, Converter={StaticResource NonEmptyStringToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Комментарий" />
                                <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding Comment}" />
                            </StackPanel>

                            <!-- Позиции -->
                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="{Binding ProgressLabel, StringFormat=Позиции — {0}, TargetNullValue=Позиции}" />
                            <ItemsControl ItemsSource="{Binding Positions}"
                                          AutomationProperties.Name="Позиции заявки">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="12,8"
                                                CornerRadius="8"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding Characteristic}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Characteristic, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding ProgressText}"
                                                               Visibility="{Binding ProgressText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HubErrorTextBrush}"
                                                               Text="{Binding ReasonText}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding ReasonText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding QtyText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="В заявке нет позиций.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPositions}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Документы -->
                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource HubSectionTitleStyle}"
                                       Text="Документы" />
                            <ItemsControl ItemsSource="{Binding Documents}"
                                          AutomationProperties.Name="Документы заявки">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="12,8"
                                                CornerRadius="8"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding Number}"
                                                               Visibility="{Binding Number, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding DateText}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding MetaText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding NomenclatureText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding NomenclatureText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="По заявке пока нет связанных документов.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDocuments}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Пагинация -->
        <StackPanel Grid.Row="4" Margin="20,0,20,10" Orientation="Horizontal">
            <Button Style="{StaticResource HubSecondaryButtonStyle}"
                    Command="{Binding LoadMoreCommand}"
                    Content="Показать ещё"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Показать ещё заявки" />
            <ProgressBar Margin="12,0,0,0"
                         Width="80"
                         Height="3"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource HubAccentBrush}"
                         Background="{DynamicResource HubSurfaceRaisedBrush}"
                         Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
