<UserControl x:Class="Hub.Desktop.Native.Views.MailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />
            <local:MailGroupHeaderConverter x:Key="MailGroupHeader" />

            <Style x:Key="ChipRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}" />
            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Командная панель Outlook: Создание | Сообщения | поиск + обновление.
             Фильтры «Все/Непрочитанные» перенесены к заголовку списка (UX-фике).
             На узких окнах поиск+скоуп+обновление переносятся на вторую строку
             (MailToolbarGrid_SizeChanged) — вместо наложения на Auto-кнопки. -->
        <Border Grid.Row="0"
                Padding="20,7,20,6"
                BorderBrush="{DynamicResource HubBorderDimBrush}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="MailToolbarGrid"
                  SizeChanged="MailToolbarGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ToolbarSecondRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ToolbarCreateGroup" Orientation="Horizontal">
                    <Button MinHeight="30"
                            Padding="12,3"
                            Style="{StaticResource HubPrimaryButtonStyle}"
                            Command="{Binding NewMessageCommand}"
                            Content="Новое письмо"
                            AutomationProperties.Name="Новое письмо" />
                    <Button Margin="6,0,0,0"
                            MinHeight="30"
                            Padding="10,3"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding OpenItRequestCommand}"
                            Content="IT-заявка"
                            Visibility="{Binding ShowSetupHint, Converter={StaticResource InverseBoolToVisibility}}"
                            AutomationProperties.Name="Открыть форму заявки в IT" />
                </StackPanel>

                <StackPanel x:Name="ToolbarMessageGroup"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Orientation="Horizontal">
                    <Border Width="1" Background="{DynamicResource HubBorderDimBrush}" Margin="0,3" />
                    <Button Margin="8,0,0,0"
                            MinHeight="30"
                            Padding="10,3"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding ReplyCommand}"
                            Content="Ответить"
                            AutomationProperties.Name="Ответить на письмо" />
                    <Button Margin="4,0,0,0"
                            MinHeight="30"
                            Padding="10,3"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding DeleteCommand}"
                            Foreground="{DynamicResource HubErrorTextBrush}"
                            Content="Удалить"
                            AutomationProperties.Name="Удалить письмо в папку «Удалённые»" />
                    <Button Margin="4,0,0,0"
                            MinHeight="30"
                            Padding="10,3"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding}"
                            Click="HeaderMoreMenuButton_Click"
                            IsEnabled="{Binding HasDetail}"
                            AutomationProperties.Name="Другие действия с письмом">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ещё" />
                            <local:VectorIcon Margin="5,1,0,0"
                                              VerticalAlignment="Center"
                                              Size="9"
                                              Data="{x:Static local:VectorIcons.ChevronDown}"
                                              Foreground="{DynamicResource HubTextSecondaryBrush}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ответить всем"
                                          Command="{Binding PlacementTarget.Tag.ReplyAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Ответить всем адресатам письма" />
                                <MenuItem Header="Переслать"
                                          Command="{Binding PlacementTarget.Tag.ForwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Переслать письмо" />
                                <MenuItem Header="Переместить в…"
                                          ItemsSource="{Binding PlacementTarget.Tag.MoveTargets, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Переместить письмо в папку">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <Setter Property="Command" Value="{Binding PlacementTarget.Tag.MoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding Id}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{Binding PlacementTarget.Tag.Detail.ToggleReadButtonText, RelativeSource={RelativeSource AncestorType=ContextMenu}, TargetNullValue=Прочитано}"
                                          Command="{Binding PlacementTarget.Tag.ToggleReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Переключить отметку о прочтении письма" />
                                <MenuItem Header="{Binding PlacementTarget.Tag.Detail.ImportanceToggleText, RelativeSource={RelativeSource AncestorType=ContextMenu}, TargetNullValue=Важное}"
                                          Command="{Binding PlacementTarget.Tag.ToggleImportanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Переключить важность письма" />
                                <MenuItem Header="{Binding PlacementTarget.Tag.Detail.HeadersToggleText, RelativeSource={RelativeSource AncestorType=ContextMenu}, TargetNullValue=Показать заголовки}"
                                          Command="{Binding PlacementTarget.Tag.ToggleDetailHeadersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Показать или скрыть полные заголовки письма" />
                                <MenuItem Header="Скачать исходник (.eml)"
                                          Command="{Binding PlacementTarget.Tag.DownloadMessageSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          AutomationProperties.Name="Скачать исходник письма в формате EML" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- Фильтры убраны из глобальной панели: «Все/Непрочитанные»
                     теперь в заголовке списка рядом с папкой (UX-фике).
                     «Все папки» — область поиска, остаётся рядом с поиском. -->

                <!-- Поиск — единый компонент: иконка внутри поля, скоуп
                     «Все папки» и «Обновить» примыкают справа; поле центрируется
                     в *-колонке как в Outlook Web. -->
                <Grid x:Name="ToolbarSearchBox"
                      Grid.Column="2"
                      MinWidth="220"
                      MaxWidth="300"
                      HorizontalAlignment="Center">
                    <TextBox x:Name="SearchInput"
                             HorizontalAlignment="Stretch"
                             Padding="30,9,12,9"
                             Style="{StaticResource HubTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchInput_KeyDown"
                             ToolTip="Поиск по письмам (Ctrl+F — фокус, Enter — найти, Esc — сбросить)"
                             AutomationProperties.Name="Поиск по письмам" />
                    <local:VectorIcon Margin="11,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Size="14"
                                      Foreground="{DynamicResource HubTextSecondaryBrush}"
                                      Data="{x:Static local:VectorIcons.Search}" />
                    <TextBlock Margin="30,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                               Text="Поиск письма…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <!-- «Все папки» — область поиска (не фильтр прочитанности):
                     чип-тогл рядом с поисковой строкой. -->
                <ToggleButton x:Name="ToolbarScopeChip"
                              Grid.Column="3"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource HubChipToggleStyle}"
                              IsChecked="{Binding SearchAllFolders, Mode=TwoWay}"
                              Command="{Binding RefreshCommand}"
                              Content="Все папки"
                              ToolTip="Искать во всех папках, а не только в выбранной. Область применяется вместе с поисковым запросом."
                              AutomationProperties.Name="Искать во всех папках" />
                <Button x:Name="ToolbarRefreshButton"
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        MinHeight="30"
                        MinWidth="30"
                        Padding="6,3"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Refresh}"
                        ToolTip="Обновить папки и письма"
                        AutomationProperties.Name="Обновить папки и письма" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку почты" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                        ToolTip="Скрыть ошибку"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Папки | Список писем | Чтение -->
        <Grid Grid.Row="2" Margin="20,10,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MailRailColumn" Width="200" MinWidth="180" />
                <ColumnDefinition x:Name="FolderSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="MailListColumn" Width="340" MinWidth="280" />
                <ColumnDefinition x:Name="ListSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="MailReadingColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Рейка папок -->
            <Grid x:Name="MailRailContent"
                  Grid.Column="0"
                  AutomationProperties.Name="Панель папок почты">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               FontSize="12"
                               Text="{Binding MailboxLabel}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding MailboxLabel}"
                               Visibility="{Binding MailboxLabel, Converter={StaticResource NonEmptyStringToVisibility}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Padding="8,2"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding NewFolderCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                Content="Папка"
                                AutomationProperties.Name="Создать папку" />
                        <Button Margin="4,0,0,0"
                                MinHeight="22"
                                Padding="6,1"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Click="CollapseMailRailButton_Click"
                                ToolTip="Свернуть панель папок"
                                AutomationProperties.Name="Свернуть панель папок">
                            <local:VectorIcon Size="10"
                                              Data="{x:Static local:VectorIcons.ChevronLeft}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Inline-редактор имени папки -->
                <Border Grid.Row="1"
                        Margin="0,0,0,6"
                        Padding="10"
                        CornerRadius="8"
                        Background="{DynamicResource HubSurfaceAltBrush}"
                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsFolderEditorOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   FontSize="12"
                                   Text="{Binding FolderEditorTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="FolderEditorNameInput"
                                 Margin="0,6,0,0"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding FolderEditorName, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="FolderEditorName_KeyDown"
                                 AutomationProperties.Name="Имя папки" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource HubErrorTextBrush}"
                                   Text="{Binding FolderEditorErrorText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFolderEditorError, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource HubSecondaryButtonStyle}"
                                    Command="{Binding ConfirmFolderEditorCommand}"
                                    Content="{Binding FolderEditorConfirmText}"
                                    AutomationProperties.Name="Подтвердить имя папки" />
                            <Button Margin="8,0,0,0"
                                    Padding="10,4"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding CancelFolderEditorCommand}"
                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                    ToolTip="Отменить"
                                    AutomationProperties.Name="Отменить редактирование папки" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ListBox x:Name="MailFolderList"
                         Grid.Row="2"
                         Style="{StaticResource HubListBoxStyle}"
                         ItemContainerStyle="{StaticResource MailFolderItemStyle}"
                         ItemsSource="{Binding Folders}"
                         SelectedItem="{Binding SelectedFolder}"
                         SelectionChanged="MailFolderList_SelectionChanged"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         AllowDrop="True"
                         DragOver="FolderList_DragOver"
                         DragLeave="FolderList_DragLeave"
                         Drop="FolderList_Drop"
                         AutomationProperties.Name="Список папок почты">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding FavoriteText}"
                                                  Command="{Binding PlacementTarget.Tag.ToggleFolderFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding AreActionsEnabled}"
                                                  AutomationProperties.Name="Переключить избранное папки" />
                                        <MenuItem Header="Создать вложенную папку"
                                                  Command="{Binding PlacementTarget.Tag.NewSubfolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding AreActionsEnabled}"
                                                  Visibility="{Binding CanCreateChildren, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Создать вложенную папку" />
                                        <MenuItem Header="Переименовать"
                                                  Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding AreActionsEnabled}"
                                                  Visibility="{Binding ShowRename, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Переименовать папку" />
                                        <MenuItem Header="{Binding DeleteText}"
                                                  Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding AreActionsEnabled}"
                                                  Foreground="{DynamicResource HubErrorTextBrush}"
                                                  Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Удалить папку" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Подсветка drag-over: после ColumnDefinitions (MC3088). -->
                                <Border Background="{DynamicResource HubSelectionBrush}"
                                        BorderBrush="{DynamicResource HubAccentBrush}"
                                        BorderThickness="1"
                                        Grid.ColumnSpan="7"
                                        Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Отступ иерархии -->
                                <Border Width="{Binding IndentWidth}" />
                                <!-- Chevron раскрытия детей -->
                                <Button Grid.Column="1"
                                        Width="16" Height="16"
                                        MinWidth="0" MinHeight="16"
                                        Padding="0"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding DataContext.ToggleFolderExpandedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding ExpanderAccessibleName}">
                                    <local:VectorIcon Size="9"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource HubTextSecondaryBrush}">
                                        <local:VectorIcon.Style>
                                            <Style TargetType="local:VectorIcon">
                                                <Setter Property="Data" Value="{x:Static local:VectorIcons.ChevronRight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Data" Value="{x:Static local:VectorIcons.ChevronDown}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </local:VectorIcon.Style>
                                    </local:VectorIcon>
                                </Button>
                                <local:VectorIcon Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Size="14"
                                                  Foreground="{DynamicResource HubTextBrush}"
                                                  Data="{Binding IconData}" />
                                <local:VectorIcon Grid.Column="3"
                                                  Margin="4,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Size="11"
                                                  Foreground="{DynamicResource HubWarningBrush}"
                                                  Data="{x:Static local:VectorIcons.Star}"
                                                  ToolTip="Папка в избранном"
                                                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="4"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource HubTextBrush}"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Label}" />
                                <!-- Счётчик всех писем -->
                                <Border Grid.Column="5"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        MinWidth="20" Height="18" Padding="6,0"
                                        CornerRadius="9"
                                        Background="{DynamicResource HubScrollThumbBrush}"
                                        Visibility="{Binding TotalText, Converter={StaticResource NonEmptyStringToVisibility}}"
                                        AutomationProperties.Name="{Binding TotalText, StringFormat='Всего писем в папке: {0}'}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{DynamicResource HubTextBrush}"
                                               Text="{Binding TotalText}" />
                                </Border>
                                <!-- Бейдж непрочитанных: пара accent/on-accent —
                                     как бейджи непрочитанных в меню шелла
                                     (HubWindow); локальный White убран (этап 34). -->
                                <Border Grid.Column="6"
                                        Margin="4,0,0,0"
                                        MinWidth="20" Height="18" Padding="6,0"
                                        CornerRadius="9"
                                        Background="{DynamicResource HubAccentBrush}"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="{Binding UnreadBadgeText, StringFormat='Непрочитанных писем: {0}'}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HubOnAccentBrush}"
                                               Text="{Binding UnreadBadgeText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <!-- Полоса «развернуть папки» — сосед MailRailContent, а не его ребёнок:
                 свёртка прячет контейнер целиком, не затирая биндинги видимости
                 детей (Visibility=… локально убивал биндинг IsFolderEditorOpen). -->
            <Button x:Name="MailRailExpandButton"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    MinHeight="22"
                    Padding="0,1"
                    Visibility="Collapsed"
                    Style="{StaticResource HubGhostButtonStyle}"
                    Click="ExpandMailRailButton_Click"
                    ToolTip="Развернуть панель папок"
                    AutomationProperties.Name="Развернуть панель папок">
                <local:VectorIcon Size="10"
                                  Data="{x:Static local:VectorIcons.ChevronRight}" />
            </Button>

            <GridSplitter x:Name="FolderSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Focusable="True"
                          FocusVisualStyle="{StaticResource HubFocusStyle}"
                          DragCompleted="FolderSplitter_DragCompleted"
                          MouseDoubleClick="FolderSplitter_MouseDoubleClick"
                          AutomationProperties.Name="Разделитель папок и списка писем"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей, двойной клик возвращает стандартную" />

            <!-- Список писем -->
            <Grid x:Name="MailListPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                              Height="3"
                              Margin="0,0,0,6"
                              IsIndeterminate="True"
                              Foreground="{DynamicResource HubAccentBrush}"
                              Background="{DynamicResource HubSurfaceRaisedBrush}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="Индикатор загрузки писем" />
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок списка: строка 1 — папка + счётчик;
                         строка 2 — SegmentedControl + «Выбрать все».
                         Папка получает всю ширину строки 1 — не обрезается. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding ListHeaderTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ListHeaderTitle}"
                                       AutomationProperties.Name="{Binding ListHeaderAutomationName}" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="{Binding ListHeaderCountText}"
                                       Visibility="{Binding ListHeaderCountText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                        </Grid>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="{Binding SearchStatusText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SearchStatusText, Converter={StaticResource NonEmptyStringToVisibility}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <!-- Строка 2: фильтры + массовое выделение -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- SegmentedControl: «Все» / «Непрочитанные» -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource HubSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="MailFilterSegment"
                                                 Style="{StaticResource HubFilterSegmentStyle}"
                                                 IsChecked="{Binding IsFilterAll, Mode=TwoWay}"
                                                 Command="{Binding SelectFilterCommand}"
                                                 CommandParameter="all"
                                                 Content="Все"
                                                 ToolTip="Показать все письма папки"
                                                 AutomationProperties.Name="Фильтр: все письма" />
                                    <RadioButton GroupName="MailFilterSegment"
                                                 Style="{StaticResource HubFilterSegmentStyle}"
                                                 IsChecked="{Binding IsFilterUnread, Mode=TwoWay}"
                                                 Command="{Binding SelectFilterCommand}"
                                                 CommandParameter="unread"
                                                 Content="Непрочитанные"
                                                 ToolTip="Только непрочитанные письма"
                                                 AutomationProperties.Name="Фильтр: непрочитанные письма" />
                                </StackPanel>
                            </Border>
                            <!-- Массовое выделение — отдельный контрол (не фильтр):
                                 трёхсостояний чекбокс «все загруженные». Выбор всех
                                 писем папки API не поддерживает — подпись честно
                                 говорит про загруженную порцию. -->
                            <CheckBox Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      Style="{StaticResource HubCheckBoxStyle}"
                                      IsChecked="{Binding IsAllLoadedChecked, Mode=TwoWay}"
                                      Content="Выбрать все"
                                      ToolTip="Выбрать все загруженные письма"
                                      AutomationProperties.Name="Выбрать все загруженные письма" />
                        </Grid>
                    </StackPanel>

                    <!-- Панель массовых действий -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,6"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel HorizontalAlignment="Right">
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="{Binding SelectionText}" />
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubAccentBrush}"
                                       Text="{Binding BulkBusyText}"
                                       Visibility="{Binding IsBulkBusy, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding BulkMarkReadCommand}"
                                    Content="Пометить прочитанными"
                                    Padding="10,4"
                                    AutomationProperties.Name="Пометить выбранные прочитанными" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding BulkMarkUnreadCommand}"
                                    Content="Пометить непрочитанными"
                                    Padding="10,4"
                                    AutomationProperties.Name="Пометить выбранные непрочитанными" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Padding="10,4"
                                    Tag="{Binding BulkMoveCommand}"
                                    Click="BulkMoveMenuButton_Click"
                                    AutomationProperties.Name="Переместить выбранные письма в папку">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Переместить" />
                                    <local:VectorIcon Margin="5,1,0,0"
                                                      VerticalAlignment="Center"
                                                      Size="9"
                                                      Data="{x:Static local:VectorIcons.ChevronDown}"
                                                      Foreground="{DynamicResource HubTextSecondaryBrush}" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Label}" />
                                                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Id}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding BulkArchiveCommand}"
                                    Content="В архив"
                                    Padding="10,4"
                                    AutomationProperties.Name="Переместить выбранные письма в архив" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding BulkDeleteCommand}"
                                    Content="Удалить"
                                    Padding="10,4"
                                    Visibility="{Binding ShowBulkSoftDelete, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Удалить выбранные письма в «Удалённые»" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding BulkDeletePermanentCommand}"
                                    Content="Удалить навсегда"
                                    Padding="10,4"
                                    Foreground="{DynamicResource HubErrorTextBrush}"
                                    Visibility="{Binding IsTrashFolder, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Удалить выбранные письма безвозвратно" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding ClearSelectionCommand}"
                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                    Padding="10,4"
                                    ToolTip="Снять выбор"
                                    AutomationProperties.Name="Снять выбор писем" />
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox Style="{StaticResource HubListBoxStyle}"
                                 ItemContainerStyle="{StaticResource MailMessageItemStyle}"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 PreviewMouseLeftButtonDown="MessageList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="MessageList_PreviewMouseMove"
                                 KeyDown="MessageList_KeyDown"
                                 Loaded="MessageList_Loaded"
                                 AutomationProperties.Name="Список писем">
                            <!-- Группировка по датам (Outlook) -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,8,0,3"
                                                       Padding="0,0,0,2"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding Name, Converter={StaticResource MailGroupHeader}}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Margin" Value="0,2,0,0" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Converter={StaticResource MailGroupHeader}}" />
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          ContextMenuOpening="RowContextMenu_Opening"
                                          ContextMenuClosing="RowContextMenu_Closing">
                                        <!-- Контекстное меню строки -->
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding ToggleReadItemText}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleItemReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.Name="Переключить отметку о прочтении письма" />
                                                <MenuItem Header="В архив"
                                                          Command="{Binding PlacementTarget.Tag.ArchiveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.Name="Переместить письмо в архив" />
                                                <MenuItem Header="Переместить в…"
                                                          ItemsSource="{Binding PlacementTarget.Tag.MoveTargets, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          AutomationProperties.Name="Переместить письмо в папку">
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Label}" />
                                                            <Setter Property="Command" Value="{Binding PlacementTarget.Tag.MoveItemFromKebabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding Id}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                                <MenuItem Header="Восстановить"
                                                          Command="{Binding PlacementTarget.Tag.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"
                                                          Visibility="{Binding PlacementTarget.Tag.IsTrashFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                                          AutomationProperties.Name="Восстановить письмо из удалённых" />
                                                <Separator />
                                                <MenuItem Header="{Binding PlacementTarget.Tag.ItemDeleteMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.Name="Удалить письмо" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Чекбокс массового выбора -->
                                        <CheckBox VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding CheckBoxAccessibleName}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource HubCheckBoxStyle}">
                                                    <Setter Property="Opacity" Value="0.8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <!-- Read-status: зелёная точка -->
                                        <Ellipse Grid.Column="1"
                                                 Width="10" Height="10"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource HubUnreadDotBrush}"
                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Непрочитанное письмо" />
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="14"
                                                           Foreground="{DynamicResource HubTextBrush}"
                                                           Text="{Binding SenderText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           MaxHeight="18"
                                                           ToolTip="{Binding SenderText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding DateText}" />
                                            </Grid>
                                            <!-- Тема — вся ширина строки (действия не отнимают её). -->
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource HubTextBrush}"
                                                       Text="{Binding Subject}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       MaxHeight="18"
                                                       ToolTip="{Binding Subject}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Превью + icon-info: скрепка/звезда/kebab
                                                 прижаты к правому краю строки превью. -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding Preview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           MaxHeight="16"
                                                           ToolTip="{Binding Preview}"
                                                           Visibility="{Binding Preview, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <local:VectorIcon VerticalAlignment="Center"
                                                                      Size="13"
                                                                      Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                      Data="{x:Static local:VectorIcons.Attach}"
                                                                      ToolTip="{Binding AttachmentsText}"
                                                               AutomationProperties.Name="{Binding AttachmentsText, StringFormat='Вложения: {0}'}"
                                                               Visibility="{Binding AttachmentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    <Button Margin="4,0,0,0"
                                                            MinWidth="22" MinHeight="20" Padding="4,0"
                                                            Command="{Binding DataContext.ToggleItemImportanceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Переключить важность"
                                                            AutomationProperties.Name="{Binding StarAccessibleName}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                                                                <Setter Property="Foreground" Value="{DynamicResource HubTextSecondaryBrush}" />
                                                                <Setter Property="Opacity" Value="0.8" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <local:VectorIcon Size="13" VerticalAlignment="Center">
                                                            <local:VectorIcon.Style>
                                                                <Style TargetType="local:VectorIcon">
                                                                    <Setter Property="Data" Value="{x:Static local:VectorIcons.StarOutline}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                                            <Setter Property="Data" Value="{x:Static local:VectorIcons.Star}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </local:VectorIcon.Style>
                                                        </local:VectorIcon>
                                                    </Button>
                                                    <Button Margin="4,0,0,0"
                                                            MinWidth="22" MinHeight="20" Padding="4,0"
                                                            Click="RowMoreMenuButton_Click"
                                                            ToolTip="Меню письма"
                                                            AutomationProperties.Name="{Binding MenuAccessibleName}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                                                                <Setter Property="Opacity" Value="0.8" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <local:VectorIcon Size="11"
                                                                          Data="{x:Static local:VectorIcons.MoreHoriz}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Пустое состояние списка -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.6"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <local:VectorIcon HorizontalAlignment="Center"
                                              Size="30"
                                              Foreground="{DynamicResource HubTextSecondaryBrush}"
                                              Data="{x:Static local:VectorIcons.Mail}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Писем нет" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="В этой папке пока пусто."
                                       Visibility="{Binding HasActiveListFilters, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="По фильтру или поиску писем не найдено."
                                       Visibility="{Binding HasActiveListFilters, Converter={StaticResource BoolToVisibility}}" />
                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    MinHeight="26" Padding="12,2"
                                    Style="{StaticResource HubSecondaryButtonStyle}"
                                    Command="{Binding ResetListFiltersCommand}"
                                    Content="Сбросить фильтры"
                                    Visibility="{Binding HasActiveListFilters, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Сбросить поиск и фильтры" />
                        </StackPanel>
                    </Grid>
                    <!-- «Показать ещё»: тонкая ссылка-кнопка вместо крупного блока (P2);
                         infinite scroll подгружает автоматически, кнопка — fallback. -->
                    <Button Grid.Row="3"
                            Margin="0,6,0,0"
                            MinHeight="26"
                            Padding="12,2"
                            HorizontalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding LoadMoreCommand}"
                            Content="{Binding MoreButtonText}"
                            ToolTip="{Binding LoadMoreToolTip}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Показать следующую порцию писем" />
                </Grid>
            </Grid>

            <GridSplitter x:Name="ListSplitter"
                          Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Focusable="True"
                          FocusVisualStyle="{StaticResource HubFocusStyle}"
                          DragCompleted="ListSplitter_DragCompleted"
                          MouseDoubleClick="ListSplitter_MouseDoubleClick"
                          AutomationProperties.Name="Разделитель списка и чтения письма"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей, двойной клик возвращает стандартную" />

            <!-- Чтение письма -->
            <Border x:Name="ReadingPaneBorder"
                    Grid.Column="4"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ошибка детали -->
                    <Border Grid.Row="0"
                            Margin="18,14,18,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   Text="{Binding DetailErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Пустая деталь: привет-панель -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    Opacity="0.85"
                                    Visibility="{Binding ShowDetailEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="64" Height="64"
                                    HorizontalAlignment="Center"
                                    CornerRadius="32"
                                    Background="{DynamicResource HubStatusMutedSoftBrush}"
                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                    BorderThickness="1">
                                <local:VectorIcon HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Size="26"
                                                  Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                  Data="{x:Static local:VectorIcons.Mail}" />
                            </Border>
                            <TextBlock Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Выберите письмо" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       TextAlignment="Center"
                                       Text="Письмо из списка откроется здесь для чтения." />
                            <!-- Подробная справка — по запросу, не на пустом экране. -->
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    MinHeight="24"
                                    Padding="10,2"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Click="HeaderMoreMenuButton_Click"
                                    AutomationProperties.Name="Подсказки по работе со списком писем">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Подсказки и клавиши" />
                                    <local:VectorIcon Margin="5,1,0,0"
                                                      VerticalAlignment="Center"
                                                      Size="9"
                                                      Data="{x:Static local:VectorIcons.ChevronDown}"
                                                      Foreground="{DynamicResource HubTextSecondaryBrush}" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Клик по строке — открыть письмо" IsEnabled="False" />
                                        <MenuItem Header="Правый клик или меню строки — прочитано, архив, перемещение" IsEnabled="False" />
                                        <MenuItem Header="Звезда в строке — важное письмо, Del — удалить выбранное" IsEnabled="False" />
                                        <Separator />
                                        <MenuItem Header="Ctrl+F — фокус в поиск, Enter — найти" IsEnabled="False" />
                                        <MenuItem Header="Esc в поиске — сбросить фильтры" IsEnabled="False" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <!-- Загрузка детали -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowDetailLoading, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Width="18" Height="18"
                                         HorizontalAlignment="Center"
                                         IsIndeterminate="True" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Загружаю письмо…" />
                        </StackPanel>

                        <!-- Деталь: шапка (тема/от/действия/вложения) + тело -->
                        <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <!-- Шапка: собственный ограниченный скроллер -->
                                <RowDefinition Height="Auto" MaxHeight="340" />
                                <!-- Тело: фиксированная область — HWND WebView2
                                     ограничен границами этой строки (ScrollViewer
                                     не клипает HwndHost — первопричина белого
                                     прямоугольника до низа окна). -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="DetailScrollViewer"
                                          Grid.Row="0"
                                          Padding="18,12,18,4"
                                          VerticalScrollBarVisibility="Auto"
                                          DataContext="{Binding Detail}"
                                          AutomationProperties.Name="Сведения о письме">
                                <StackPanel MaxWidth="1100"
                                            HorizontalAlignment="Stretch">
                                    <!-- Тема + пилюли + «Назад» (компакт) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Компактный режим: вернуться к списку -->
                                        <Button x:Name="CompactBackButton"
                                                MinHeight="24"
                                                Padding="8,2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Top"
                                                Visibility="Collapsed"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Click="CompactBackButton_Click"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Back}"
                                                Content="К списку"
                                                AutomationProperties.Name="Вернуться к списку писем" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Text="{Binding Subject}"
                                                   TextWrapping="Wrap" />
                                        <!-- Пилюли «Важно»/«Черновик» — в своей колонке 2,
                                             иначе ложились поверх начала темы (та же колонка 1). -->
                                        <StackPanel Grid.Column="2"
                                                    Margin="12,4,0,0"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                            <Border Style="{StaticResource HubStatusPillStyle}"
                                                    local:HubTone.Value="warning"
                                                    Visibility="{Binding IsImportant, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Style="{StaticResource HubToneTextStyle}"
                                                           Text="{Binding ImportanceText}" />
                                            </Border>
                                            <Border Margin="6,0,0,0"
                                                    Style="{StaticResource HubStatusPillStyle}"
                                                    local:HubTone.Value="info"
                                                    Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Style="{StaticResource HubToneTextStyle}"
                                                           Text="Черновик" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Действия: при узкой панели чтения переносятся на вторую
                                         строку вместо обрезания левых кнопок. -->
                                    <WrapPanel Margin="0,10,0,0"
                                               HorizontalAlignment="Right"
                                               Orientation="Horizontal">
                                        <Button MinHeight="24" Padding="10,2"
                                                Style="{StaticResource HubSecondaryButtonStyle}"
                                                Command="{Binding DataContext.ReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="Ответить"
                                                AutomationProperties.Name="Ответить на письмо" />
                                        <Button Margin="6,0,0,0"
                                                MinHeight="24" Padding="10,2"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding DataContext.ReplyAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="Ответить всем"
                                                AutomationProperties.Name="Ответить всем адресатам письма" />
                                        <Button Margin="6,0,0,0"
                                                MinHeight="24" Padding="10,2"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="Переслать"
                                                AutomationProperties.Name="Переслать письмо" />
                                        <!-- Восстановить (только в «Удалённых») -->
                                        <Button Margin="6,0,0,0"
                                                MinHeight="24" Padding="10,2"
                                                Style="{StaticResource HubSecondaryButtonStyle}"
                                                Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Восстановить"
                                                Visibility="{Binding DataContext.IsTrashFolder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="Восстановить письмо из удалённых" />
                                        <!-- Ещё ▾ -->
                                        <Button Margin="6,0,0,0"
                                                MinHeight="24" Padding="10,2"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Click="HeaderMoreMenuButton_Click"
                                                AutomationProperties.Name="Другие действия с письмом">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="Ещё" />
                                                <local:VectorIcon Margin="5,1,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Size="9"
                                                                  Data="{x:Static local:VectorIcons.ChevronDown}"
                                                                  Foreground="{DynamicResource HubTextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Переместить в…"
                                                              ItemsSource="{Binding PlacementTarget.Tag.MoveTargets, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              AutomationProperties.Name="Переместить письмо в папку">
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding Label}" />
                                                                <Setter Property="Command" Value="{Binding PlacementTarget.Tag.MoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <Setter Property="CommandParameter" Value="{Binding Id}" />
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding ImportanceToggleText}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleImportanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              AutomationProperties.Name="Переключить важность письма" />
                                                    <MenuItem Header="{Binding ToggleReadButtonText}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              AutomationProperties.Name="Переключить отметку о прочтении письма" />
                                                    <MenuItem Header="{Binding PlacementTarget.Tag.Detail.HeadersToggleText, RelativeSource={RelativeSource AncestorType=ContextMenu}, TargetNullValue=Показать заголовки}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleDetailHeadersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              AutomationProperties.Name="Показать или скрыть полные заголовки письма" />
                                                    <MenuItem Header="Скачать исходник (.eml)"
                                                              Command="{Binding PlacementTarget.Tag.DownloadMessageSourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              AutomationProperties.Name="Скачать исходник письма в формате EML" />
                                                    <Separator />
                                                    <MenuItem Header="Редактировать черновик"
                                                              Command="{Binding PlacementTarget.Tag.EditDraftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.Detail.IsDraft, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                                              AutomationProperties.Name="Открыть черновик в композере" />
                                                    <MenuItem Header="Удалить черновик"
                                                              Command="{Binding PlacementTarget.Tag.DeleteDraftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.Detail.IsDraft, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                                              AutomationProperties.Name="Удалить черновик безвозвратно" />
                                                    <Separator />
                                                    <MenuItem Header="Удалить"
                                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Foreground="{DynamicResource HubErrorTextBrush}"
                                                              AutomationProperties.Name="Удалить письмо в папку «Удалённые»" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>

                                    <!-- Шапка отправителя (Gmail/Яндекс); дата уходит под имя на узкой панели -->
                                    <Grid Margin="0,14,0,0"
                                          SizeChanged="DetailSenderGrid_SizeChanged">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26"
                                                VerticalAlignment="Center"
                                                CornerRadius="13"
                                                Background="{DynamicResource HubScrollThumbBrush}"
                                                AutomationProperties.Name="{Binding SenderText, StringFormat='Отправитель: {0}'}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding AvatarInitials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <!-- Имя отправителя: своя строка, не сливается с адресом. -->
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubTextBrush}"
                                                       Text="{Binding SenderText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SenderText}" />
                                            <!-- Адрес: отдельная строка под именем (P1). -->
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding SenderEmail}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SenderEmail}"
                                                       Visibility="{Binding SenderEmail, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <Button x:Name="DetailToExpandButton"
                                                    Margin="0,2,0,0"
                                                    Padding="0"
                                                    MinHeight="0"
                                                    HorizontalContentAlignment="Left"
                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                    Cursor="Hand"
                                                    Click="DetailToExpand_Click"
                                                    ToolTip="Показать или свернуть полный список получателей"
                                                    AutomationProperties.Name="Развернуть список получателей письма">
                                                <TextBlock x:Name="DetailToTextBlock"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ToText}">
                                                    <Run Text="Кому: " />
                                                    <Run Text="{Binding ToText, Mode=OneWay}" />
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="DetailDateText"
                                                   Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding DateText}" />
                                    </Grid>
                                    <TextBlock Margin="36,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CcText}"
                                               Visibility="{Binding CcText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <Run Text="Копия: " />
                                        <Run Text="{Binding CcText, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- Полные заголовки -->
                                    <Border Margin="0,12,0,0"
                                            Padding="12,10"
                                            CornerRadius="6"
                                            Background="{DynamicResource HubSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding AreHeadersVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MetaLabelStyle}"
                                                       Text="Полные заголовки" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding HeadersSourceName}"
                                                       Visibility="{Binding HeadersSourceName, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HubTextBrush}"
                                                       Text="{Binding HeadersText}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HeadersText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Style="{StaticResource MetaLabelStyle}"
                                                       Text="Загружаем заголовки…"
                                                       Visibility="{Binding IsHeadersLoading, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Вложения -->
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding HasVisibleAttachments, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Вложения" />
                                        <ItemsControl Margin="0,4,0,0"
                                                      AutomationProperties.Name="Вложения письма"
                                                      ItemsSource="{Binding Attachments}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Вложение {0}'}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,4"
                                                            Padding="8,3"
                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat='Скачать вложение {0}'}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <local:VectorIcon Margin="0,0,4,0"
                                                                              VerticalAlignment="Center"
                                                                              Size="13"
                                                                              Data="{x:Static local:VectorIcons.Attach}" />
                                                            <TextBlock FontSize="12" Text="{Binding DownloadText}" />
                                                            <TextBlock Margin="6,0,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding SizeText}"
                                                                       Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- AI-действия -->
                                    <StackPanel Margin="0,16,0,0"
                                                Visibility="{Binding DataContext.ShowAiActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                        <WrapPanel>
                                            <Button Padding="10,4"
                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                    Command="{Binding DataContext.SummarizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Edit}"
                                                    Content="Кратко"
                                                    AutomationProperties.Name="Сделать пересказ письма" />
                                            <Button Margin="8,0,0,0"
                                                    Padding="10,4"
                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                    Command="{Binding DataContext.SmartRepliesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    local:NavGlyph.Icon="{x:Static local:VectorIcons.Chat}"
                                                    Content="Быстрые ответы"
                                                    AutomationProperties.Name="Предложить варианты ответа" />
                                        </WrapPanel>
                                        <!-- AI согласие -->
                                        <Border Margin="0,8,0,0"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubAccentBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding DataContext.AiConsentOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="ИИ для писем" />
                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding DataContext.MailAiDisclosureText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                    <Button Style="{StaticResource HubSecondaryButtonStyle}"
                                                            Command="{Binding DataContext.AcceptAiConsentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Content="Разрешить ИИ"
                                                            AutomationProperties.Name="Разрешить ИИ для писем" />
                                                    <Button Margin="8,0,0,0"
                                                            Padding="10,4"
                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                            Command="{Binding DataContext.DismissAiConsentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Content="Отмена"
                                                            AutomationProperties.Name="Не включать ИИ" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <!-- Пересказ -->
                                        <Border Margin="0,8,0,0"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                Visibility="{Binding DataContext.ShowSummaryPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                                           FontSize="11"
                                                           Text="Пересказ" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="13"
                                                           Text="{Binding DataContext.SummaryPanelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubErrorTextBrush}"
                                                   Text="{Binding DataContext.AiErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding DataContext.HasAiError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- Чипы быстрых ответов -->
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               FontSize="12"
                                               Text="{Binding DataContext.SmartRepliesHintText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Visibility="{Binding DataContext.IsSmartRepliesLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Margin="0,12,0,0"
                                                  AutomationProperties.Name="Подсказки ответа"
                                                  ItemsSource="{Binding DataContext.SmartReplies, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding StringFormat='Подсказка ответа: {0}'}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,5"
                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                        Command="{Binding DataContext.ApplySmartReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Вставить подсказку в ответ">
                                                    <TextBlock MaxWidth="360"
                                                               FontSize="12"
                                                               Text="{Binding}"
                                                               TextWrapping="Wrap" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Тело письма: фиксированная область Grid — HWND
                                 ограничен этой областью; скролл внутри браузера.
                                 P0: plain-text показывается только когда НЕТ html —
                                 иначе WebView2 с белым фоном перекрывает текст. -->
                            <Grid Grid.Row="1"
                                  Margin="0,4,0,0"
                                  DataContext="{Binding Detail}">
                                <!-- Видимостью управляет code-behind: текст показывается
                                     когда нет html ИЛИ когда WebView2-ридер недоступен. -->
                                <ScrollViewer x:Name="PlainBodyViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="Collapsed"
                                              AutomationProperties.Name="Текст письма">
                                    <TextBlock Padding="18,8,18,16"
                                               FontSize="13"
                                               MaxWidth="1100"
                                               Text="{Binding Body}"
                                               TextWrapping="Wrap"
                                               TextOptions.TextFormattingMode="Ideal" />
                                </ScrollViewer>
                                <TextBlock Padding="18,8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HubMutedTextStyle}"
                                           Text="Текст письма отсутствует."
                                           Visibility="{Binding HasAnyBody, Converter={StaticResource InverseBoolToVisibility}}" />
                                <!-- HTML: WebView2 лениво в code-behind -->
                                <Grid x:Name="MailBodyHost" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Композер: перекрывает панель чтения -->
            <Border Grid.Column="4"
                    Panel.ZIndex="1"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsComposeOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid x:Name="ComposerGrid"
                      DataContext="{Binding Composer}"
                      DataContextChanged="ComposerGrid_DataContextChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть композер" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="20,10,20,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   FontSize="12"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  Margin="20,12,20,4"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Поля нового письма">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Кому" />
                            <TextBox x:Name="ToInput"
                                     Tag="to"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="RecipientTextBox_TextChanged"
                                     GotFocus="RecipientTextBox_GotFocus"
                                     KeyDown="RecipientTextBox_KeyDown"
                                     AutomationProperties.Name="Получатели письма (Кому)" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Копия" />
                            <TextBox x:Name="CcInput"
                                     Tag="cc"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="RecipientTextBox_TextChanged"
                                     GotFocus="RecipientTextBox_GotFocus"
                                     KeyDown="RecipientTextBox_KeyDown"
                                     AutomationProperties.Name="Получатели копии (Копия)" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Скрытая копия" />
                            <TextBox x:Name="BccInput"
                                     Tag="bcc"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="RecipientTextBox_TextChanged"
                                     GotFocus="RecipientTextBox_GotFocus"
                                     KeyDown="RecipientTextBox_KeyDown"
                                     AutomationProperties.Name="Получатели скрытой копии (СК)" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Тема" />
                            <TextBox Style="{StaticResource HubTextBoxStyle}"
                                     Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Тема письма" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Текст письма" />
                            <TextBox MinHeight="180"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Текст нового письма" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Foreground="{DynamicResource HubSuccessBrush}"
                                       Text="{Binding RetainedAttachmentsText}"
                                       Visibility="{Binding HasRetainedAttachments, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl Margin="0,6,0,0"
                                          AutomationProperties.Name="Вложения письма"
                                          ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Вложение {0}'}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,4"
                                                Padding="8,3"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <local:VectorIcon Margin="0,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  Size="13"
                                                                  Data="{x:Static local:VectorIcons.Attach}" />
                                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                                <TextBlock Margin="6,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding SizeText}"
                                                           Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                <Button Margin="8,0,0,0"
                                                        Padding="2,0"
                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                        ToolTip="{Binding Name, StringFormat='Убрать вложение {0}'}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Убрать вложение {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Действия композера -->
                    <Border Grid.Row="3"
                            Padding="20,12,20,16"
                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                        Command="{Binding SendCommand}"
                                        Content="{Binding SendButtonText}"
                                        AutomationProperties.Name="Отправить письмо" />
                                <Button Margin="10,0,0,0"
                                        Style="{StaticResource HubSecondaryButtonStyle}"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="{Binding SaveDraftButtonText}"
                                        AutomationProperties.Name="Сохранить письмо в черновики" />
                                <Button Margin="10,0,0,0"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding DeleteDraftCommand}"
                                        Content="Удалить черновик"
                                        Foreground="{DynamicResource HubErrorTextBrush}"
                                        Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Удалить черновик безвозвратно" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding AttachCommand}"
                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Attach}"
                                        ToolTip="Прикрепить файл"
                                        AutomationProperties.Name="Прикрепить файл к письму" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Автоподсказка контактов -->
                    <Popup x:Name="ContactPopup"
                           Grid.RowSpan="4"
                           IsOpen="{Binding IsContactPopupOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ToInput}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border MinWidth="280"
                                MaxWidth="420"
                                Padding="4"
                                Background="{DynamicResource HubSurfaceBrush}"
                                BorderBrush="{DynamicResource HubBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ListBox Style="{StaticResource HubListBoxStyle}"
                                     ItemsSource="{Binding ContactSuggestions}"
                                     MaxHeight="240"
                                     AutomationProperties.Name="Подсказки контактов">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding DataContext.ApplyContactSuggestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding DisplayText, StringFormat='Подставить контакт {0}'}">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding Email}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Ящик не настроен -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Panel.ZIndex="1"
                    Background="{DynamicResource HubBackgroundBrush}"
                    Visibility="{Binding ShowSetupHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="Почта пока недоступна" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="{Binding SetupHintText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource HubSecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Проверить снова"
                            AutomationProperties.Name="Проверить доступность почты снова" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Статус-бар -->
        <Border Grid.Row="3"
                Padding="20,8"
                Background="{DynamicResource HubSurfaceAltBrush}"
                BorderBrush="{DynamicResource HubBorderDimBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource HubTextSecondaryBrush}">
                        <Run Text="Непрочитанных в ящике:" />
                        <Run Text="{Binding UnreadText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="14,0,0,0"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                               Text="{Binding LastUpdatedText}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding HasStatusInfo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               MaxWidth="520"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusInfoText}"
                               Foreground="{DynamicResource HubSuccessBrush}"
                               Text="{Binding StatusInfoText}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Margin="8,0,0,0"
                            Padding="4,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding DismissStatusCommand}"
                            local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                            ToolTip="Скрыть сообщение"
                            AutomationProperties.Name="Скрыть статусное сообщение" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Заявка в IT -->
        <Grid Grid.RowSpan="4"
              Panel.ZIndex="2"
              Background="#B3000000"
              PreviewKeyDown="ItRequestOverlay_PreviewKeyDown"
              Visibility="{Binding IsItRequestOpen, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="560"
                    MaxHeight="720"
                    Margin="24"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    DataContext="{Binding ItRequest}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть форму заявки в IT" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="18,10,18,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   FontSize="12"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 Margin="18,8,18,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор отправки заявки" />

                    <ScrollViewer Grid.Row="3"
                                  Margin="18,10,18,0"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Поля заявки">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Шаблон" />
                            <ComboBox ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="DisplayTitle"
                                      Background="{DynamicResource HubSurfaceAltBrush}"
                                      Foreground="{DynamicResource HubTextBrush}"
                                      AutomationProperties.Name="Шаблон заявки в IT" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Нет доступных шаблонов заявок."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasTemplates, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl Margin="0,4,0,0"
                                          AutomationProperties.Name="Поля заявки"
                                          ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label, StringFormat='Поле заявки: {0}'}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource MetaLabelStyle}"
                                                       Text="{Binding LabelText}"
                                                       Visibility="{Binding IsCheckbox, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBox Style="{StaticResource HubTextBoxStyle}"
                                                     Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVisibility}}"
                                                     AutomationProperties.Name="{Binding Label}" />
                                            <TextBox MinHeight="64"
                                                     MaxHeight="140"
                                                     Style="{StaticResource HubTextBoxStyle}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top"
                                                     Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsTextarea, Converter={StaticResource BoolToVisibility}}"
                                                     AutomationProperties.Name="{Binding Label}" />
                                            <ComboBox ItemsSource="{Binding OptionValues}"
                                                      SelectedItem="{Binding SelectedOption}"
                                                      Background="{DynamicResource HubSurfaceAltBrush}"
                                                      Foreground="{DynamicResource HubTextBrush}"
                                                      Visibility="{Binding IsSelect, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="{Binding Label}" />
                                            <ItemsControl ItemsSource="{Binding OptionItems}"
                                                          AutomationProperties.Name="Варианты поля"
                                                          Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Text, StringFormat='Вариант: {0}'}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="0,2,0,0"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding Text}"
                                                                  AutomationProperties.Name="{Binding Text}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DatePicker SelectedDate="{Binding DateValue}"
                                                        Background="{DynamicResource HubSurfaceAltBrush}"
                                                        Foreground="{DynamicResource HubTextBrush}"
                                                        Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding Label}" />
                                            <CheckBox Margin="0,2,0,0"
                                                      IsChecked="{Binding BoolValue}"
                                                      Content="{Binding LabelText}"
                                                      Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="{Binding LabelText}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding HelpText}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasHelpText, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Margin="0,10,0,0"
                                          AutomationProperties.Name="Вложения заявки"
                                          ItemsSource="{Binding Attachments}"
                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Вложение {0}'}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,4"
                                                Padding="8,3"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <local:VectorIcon Margin="0,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  Size="13"
                                                                  Data="{x:Static local:VectorIcons.Attach}" />
                                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                                <TextBlock Margin="6,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding SizeText}"
                                                           Visibility="{Binding SizeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                <Button Margin="8,0,0,0"
                                                        Padding="2,0"
                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                        ToolTip="{Binding Name, StringFormat='Убрать вложение {0}'}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Убрать вложение {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="4" Margin="18,12,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource HubSecondaryButtonStyle}"
                                Command="{Binding AttachCommand}"
                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Attach}"
                                ToolTip="Прикрепить файл"
                                AutomationProperties.Name="Прикрепить файл к заявке" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Content="Отмена"
                                AutomationProperties.Name="Отменить заявку" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Style="{StaticResource HubPrimaryButtonStyle}"
                                Command="{Binding SendCommand}"
                                Content="{Binding SendButtonText}"
                                AutomationProperties.Name="Отправить заявку в IT" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
