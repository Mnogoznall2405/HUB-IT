<UserControl x:Class="Hub.Desktop.Native.Views.MyFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             x:Name="Root"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <!-- Строка локации в левой рейке: выбранная подсвечена как элемент списка. -->
            <Style x:Key="LocationItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource HubTaskCardStyle}" />

            <!-- Крошка пути — призрачная кнопка без рамки. -->
            <Style x:Key="CrumbButtonStyle" TargetType="Button" BasedOn="{StaticResource HubGhostButtonStyle}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Кнопка строки («Открыть»/«Скачать»): компактная вторичная. -->
            <Style x:Key="RowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HubSecondaryButtonStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Content" Value="Скачать" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter Property="Content" Value="Открыть" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                        <Setter Property="Content" Value="…" />
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Меню срока хранения: пункт = опция, команда — из Tag кнопки-хозяина. -->
            <Style x:Key="RetentionMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}" />
                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая рейка: личный диск и общие папки -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource HubBorderDimBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="20,18,16,10"
                           Style="{StaticResource HubSectionTitleStyle}"
                           Text="Мои файлы" />
                <ListBox Grid.Row="1"
                         Margin="10,0,10,10"
                         Style="{StaticResource HubListBoxStyle}"
                         ItemContainerStyle="{StaticResource LocationItemStyle}"
                         ItemsSource="{Binding Locations}"
                         SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                         AutomationProperties.Name="Диски и общие папки">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        VerticalAlignment="Top"
                                        CornerRadius="8"
                                        Background="{DynamicResource HubSelectionBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Text="{Binding IconGlyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding MetaText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Правая панель: тулбар + содержимое текущего места -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Тулбар: назад, путь, срок хранения, действия -->
            <Border Grid.Row="0" Padding="20,16,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource HubSecondaryButtonStyle}"
                                MinHeight="36"
                                Padding="12,4"
                                Command="{Binding GoUpCommand}"
                                Content="‹"
                                AutomationProperties.Name="На уровень выше" />
                        <ItemsControl Margin="8,0,0,0"
                                      ItemsSource="{Binding Breadcrumbs}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="›"
                                                   Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource CrumbButtonStyle}"
                                                Command="{Binding DataContext.GoToCrumbCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource HubGhostButtonStyle}"
                                Tag="{Binding SelectRetentionCommand}"
                                Click="RetentionMenuButton_Click"
                                Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Срок хранения загружаемых файлов">
                            <Button.ContextMenu>
                                <ContextMenu ItemContainerStyle="{StaticResource RetentionMenuItemStyle}" />
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="Хранить: " />
                                <TextBlock FontSize="12" Text="{Binding RetentionLabel}" />
                                <TextBlock Margin="4,0,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="▾" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource HubSecondaryButtonStyle}"
                                MinHeight="36"
                                Command="{Binding UploadCommand}"
                                Content="Загрузить"
                                Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Загрузить файлы" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding BeginNewFolderCommand}"
                                Content="Новая папка"
                                Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Создать папку" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding BeginRenameCommand}"
                                CommandParameter="{Binding SelectedItem}"
                                Content="Переименовать"
                                Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Переименовать выбранное" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding BeginShareCommand}"
                                CommandParameter="{Binding SelectedItem}"
                                Content="Поделиться"
                                AutomationProperties.Name="Поделиться выбранным" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding DeleteEntryCommand}"
                                CommandParameter="{Binding SelectedItem}"
                                Content="Удалить"
                                Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Удалить выбранное" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="Обновить"
                                AutomationProperties.Name="Обновить список файлов" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,8,0,0"
                               Style="{StaticResource HubSectionTitleStyle}"
                               Text="{Binding HeaderText}" />
                </Grid>
            </Border>

            <!-- Встроенный редактор имени: новая папка / переименование -->
            <Border Grid.Row="1"
                    Margin="20,10,20,0"
                    Padding="14,10"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsNameEditorOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Text="{Binding NameEditorTitle}" />
                    <TextBox x:Name="NameEditorInput"
                             Grid.Column="1"
                             Margin="14,0,0,0"
                             Style="{StaticResource HubTextBoxStyle}"
                             Text="{Binding NameEditorText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="NameEditorInput_KeyDown"
                             AutomationProperties.Name="Имя папки или файла" />
                    <Button Grid.Column="2"
                            Margin="10,0,8,0"
                            Style="{StaticResource HubPrimaryButtonStyle}"
                            Command="{Binding ConfirmNameEditorCommand}"
                            Content="{Binding NameEditorConfirmText}"
                            AutomationProperties.Name="Подтвердить имя" />
                    <Button Grid.Column="3"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding CancelNameEditorCommand}"
                            Content="Отмена"
                            AutomationProperties.Name="Отмена редактирования имени" />
                </Grid>
            </Border>

            <!-- Баннер ошибки -->
            <Border Grid.Row="2"
                    Margin="20,10,20,0"
                    Padding="14,10"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubErrorTextBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource HubErrorTextBrush}"
                               Text="{Binding BannerErrorText}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <Button Grid.Column="1"
                            Margin="12,0,8,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Повторить"
                            AutomationProperties.Name="Повторить загрузку файлов" />
                    <Button Grid.Column="2"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding DismissBannerCommand}"
                            Content="✕"
                            AutomationProperties.Name="Скрыть ошибку" />
                </Grid>
            </Border>

            <!-- Загрузка списка -->
            <Border Grid.Row="3"
                    Margin="20,10,20,0"
                    Padding="14,10"
                    Background="{DynamicResource HubSurfaceBrush}"
                    CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="18"
                                 Height="18"
                                 IsIndeterminate="True"
                                 Margin="0,0,12,0" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="Загружаю файлы…" />
                </StackPanel>
            </Border>

            <!-- Прогресс чанковой загрузки -->
            <Border Grid.Row="4"
                    Margin="20,10,20,0"
                    Padding="14,10"
                    Background="{DynamicResource HubSurfaceBrush}"
                    CornerRadius="8"
                    Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="18"
                                 Height="18"
                                 IsIndeterminate="True"
                                 Margin="0,0,12,0" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="{Binding UploadStatusText}" />
                </StackPanel>
            </Border>

            <!-- Содержимое текущего места -->
            <Grid Grid.Row="5" Margin="20,12,20,10">
                <ListBox Style="{StaticResource HubListBoxStyle}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         AutomationProperties.Name="Содержимое папки">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Поделиться"
                                                  Command="{Binding PlacementTarget.Tag.BeginShareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        CornerRadius="8"
                                        Background="{DynamicResource HubSelectionBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Text="{Binding IconGlyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0"
                                                   FontSize="12"
                                                   Text="🔗"
                                                   Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.Name="Есть публичная ссылка" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding SizeText}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding ModifiedText}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubWarningBrush}"
                                                   Text="{Binding StatusText}"
                                                   Visibility="{Binding StatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Command="{Binding DataContext.OpenEntryCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Открыть или скачать" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Пустое состояние -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{Binding EmptyTitleText}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="{Binding EmptyHintText}" />
                </StackPanel>

                <!-- Панель публичной ссылки: поверх списка, как поиск в чате -->
                <Border Panel.ZIndex="1"
                        VerticalAlignment="Top"
                        Padding="14,10"
                        Background="{DynamicResource HubSurfaceBrush}"
                        BorderBrush="{DynamicResource HubAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsSharePanelOpen, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Панель публичной ссылки">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="Публичная ссылка" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="{Binding ShareTargetText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseSharePanelCommand}"
                                Content="✕"
                                AutomationProperties.Name="Закрыть панель ссылки" />

                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                     Height="3"
                                     Margin="0,8,0,0"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource HubAccentBrush}"
                                     Background="{DynamicResource HubSurfaceRaisedBrush}"
                                     Visibility="{Binding IsShareBusy, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Индикатор запроса ссылки" />

                        <!-- URL активной ссылки + копирование -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2"
                              Margin="0,8,0,0"
                              Visibility="{Binding HasShareLinks, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource HubTextBoxStyle}"
                                     IsReadOnly="True"
                                     Text="{Binding ShareUrl, Mode=OneWay}"
                                     AutomationProperties.Name="Публичная ссылка для копирования" />
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource HubPrimaryButtonStyle}"
                                    Command="{Binding CopyShareLinkCommand}"
                                    Content="{Binding ShareCopyText}"
                                    AutomationProperties.Name="Копировать ссылку" />
                        </Grid>

                        <!-- Активные ссылки: статус и срок + отзыв (контракт — одна на объект) -->
                        <ItemsControl Grid.Row="3" Grid.ColumnSpan="2"
                                      Margin="0,8,0,0"
                                      ItemsSource="{Binding ShareLinks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding StatusText}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding ExpiresText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding DataContext.RevokeShareCommand, ElementName=Root}"
                                                Content="Отозвать"
                                                AutomationProperties.Name="Отозвать ссылку" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Пустое состояние и действия панели -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Открывается без входа. Активной ссылки нет — создайте новую."
                                       Visibility="{Binding HasShareLinks, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HubSecondaryButtonStyle}"
                                    Command="{Binding CreateShareCommand}"
                                    Content="Создать ссылку"
                                    Visibility="{Binding HasShareLinks, Converter={StaticResource InverseBoolToVisibility}}"
                                    AutomationProperties.Name="Создать ссылку" />
                            <Button VerticalAlignment="Center"
                                    Style="{StaticResource HubGhostButtonStyle}"
                                    Command="{Binding RotateShareCommand}"
                                    Content="Перевыпустить ссылку"
                                    Visibility="{Binding HasShareLinks, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Перевыпустить ссылку" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
