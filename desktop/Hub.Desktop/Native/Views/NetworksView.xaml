<UserControl x:Class="Hub.Desktop.Native.Views.NetworksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,6" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SectionPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,14,0,0" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="DeviceHeaderCellStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск по филиалам, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Width="340"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск филиала по имени или коду" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Филиал или код…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Margin="10,0,0,0"
                                 Width="80"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки филиалов" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить список филиалов" />
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка загрузки сетей">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку филиалов" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Список филиалов | карточка -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Список филиалов -->
            <Grid Grid.Column="0">
                <ListBox Style="{StaticResource HubListBoxStyle}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedBranch}"
                         AutomationProperties.Name="Список филиалов сети">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="{Binding CodeText}"
                                           Visibility="{Binding CodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Border Margin="0,0,6,4"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource HubSurfaceRaisedBrush}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding DevicesChipText}" />
                                    </Border>
                                    <Border Margin="0,0,6,4"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource HubSurfaceRaisedBrush}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding PortsChipText}" />
                                    </Border>
                                    <Border Margin="0,0,6,4"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource HubSurfaceRaisedBrush}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding SocketsChipText}" />
                                    </Border>
                                    <Border Margin="0,0,6,4"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource HubSurfaceRaisedBrush}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding MapsChipText}" />
                                    </Border>
                                    <Border Margin="0,0,0,4"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource HubSurfaceRaisedBrush}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding PointsChipText}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource HubAccentBrush}"
                                           Text="{Binding SiteCodeText}"
                                           Visibility="{Binding SiteCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Пустое состояние списка -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Филиалов нет" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource HubMutedTextStyle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="По текущему поиску филиалы сети не найдены." />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель списка и карточки филиала" />

            <!-- Карточка филиала -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Филиал не выбран" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Выберите филиал в списке слева." />
                    </StackPanel>

                    <ProgressBar Height="3"
                                 Margin="16"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки карточки филиала" />

                    <TextBlock Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource HubErrorTextBrush}"
                               Text="{Binding DetailErrorText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="Ошибка карточки филиала" />

                    <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer Padding="22,18"
                                      VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding Detail}"
                                      AutomationProperties.Name="Карточка филиала">
                            <StackPanel>
                                <!-- Шапка: имя + код + чипы метрик -->
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Имя филиала" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding BranchCodeText}"
                                               Visibility="{Binding BranchCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="10,0,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding CityCodeText}"
                                               Visibility="{Binding CityCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="10,0,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding SiteCodeText}"
                                               Visibility="{Binding SiteCodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Margin="10,0,0,0"
                                               Style="{StaticResource MetaLabelStyle}"
                                               Text="{Binding DbIdText}"
                                               Visibility="{Binding DbIdText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0"
                                           AutomationProperties.Name="Метрики филиала">
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock FontSize="12" Text="{Binding DevicesChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock FontSize="12" Text="{Binding PortsChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock FontSize="12" Text="{Binding OccupiedChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock FontSize="12" Text="{Binding SocketsChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock FontSize="12" Text="{Binding MapsChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock FontSize="12" Text="{Binding PointsChipText}" />
                                    </Border>
                                </WrapPanel>

                                <!-- Площадки -->
                                <TextBlock Margin="0,16,0,0"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           Text="Площадки"
                                           Visibility="{Binding HasSites, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl Margin="0,8,0,0"
                                              ItemsSource="{Binding Sites}"
                                              Visibility="{Binding HasSites, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Площадки филиала">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4"
                                                       Style="{StaticResource MetaValueStyle}"
                                                       FontSize="12"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Оборудование -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DevicesTitleText}"
                                                   AutomationProperties.Name="Оборудование филиала" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="У филиала нет оборудования."
                                                   Visibility="{Binding IsDevicesEmpty, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Шапка таблицы -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDevicesEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource DeviceHeaderCellStyle}" Text="УСТРОЙСТВО" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource DeviceHeaderCellStyle}" Text="ТИП" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource DeviceHeaderCellStyle}" Text="МОДЕЛЬ" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource DeviceHeaderCellStyle}" Text="ПЛОЩАДКА" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource DeviceHeaderCellStyle}" Text="MGMT IP" />
                                            <TextBlock Grid.Column="5" Style="{StaticResource DeviceHeaderCellStyle}" Text="ПОРТЫ" />
                                        </Grid>
                                        <ItemsControl Margin="0,2,0,0"
                                                      ItemsSource="{Binding Devices}"
                                                      AutomationProperties.Name="Таблица оборудования филиала">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6,0,0"
                                                          AutomationProperties.Name="{Binding DeviceCodeText, StringFormat='Устройство {0}'}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.6*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DeviceCodeText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding DeviceTypeText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                            <TextBlock FontSize="12"
                                                                       Text="{Binding ModelText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding ModelText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding NotesText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding NotesText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding SiteText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding MgmtIpText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="5"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding PortsText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Файлы-схемы -->
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding MapsTitleText}"
                                                   AutomationProperties.Name="Схемы сети филиала" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource MetaLabelStyle}"
                                                   Text="У филиала нет загруженных схем."
                                                   Visibility="{Binding IsMapsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl Margin="0,4,0,0"
                                                      ItemsSource="{Binding Maps}"
                                                      AutomationProperties.Name="Файлы-схемы филиала">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,8"
                                                            Padding="8,6"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <Button HorizontalContentAlignment="Left"
                                                                    Padding="0"
                                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                                    Command="{Binding DataContext.OpenMapFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding IsDownloadEnabled}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Открыть файл схемы {0}'}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock FontSize="12" Text="🗺 " />
                                                                    <TextBlock FontSize="12" Text="{Binding DisplayText}" />
                                                                </StackPanel>
                                                            </Button>
                                                            <TextBlock Margin="0,2,0,4"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding SubtitleText}"
                                                                       Visibility="{Binding SubtitleText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            <Button HorizontalAlignment="Left"
                                                                    Padding="10,2"
                                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                                    Command="{Binding DataContext.ExportMapPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding IsDownloadEnabled}"
                                                                    Content="PDF с точками"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Экспорт схемы {0} в PDF'}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статусная строка -->
        <Border Grid.Row="3" Padding="20,0,20,12">
            <Grid>
                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding TotalText}"
                           AutomationProperties.Name="Счётчик филиалов" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource HubMutedTextStyle}"
                           Text="{Binding LastUpdatedText}"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
