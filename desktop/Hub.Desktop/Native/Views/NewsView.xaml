<UserControl x:Class="Hub.Desktop.Native.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <Style x:Key="ChipRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchInput"
                             MaxWidth="460"
                             HorizontalAlignment="Left"
                             MinWidth="240"
                             Style="{StaticResource HubTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchInput_KeyDown"
                             AutomationProperties.Name="Поиск по новостям" />
                    <TextBlock Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                               Text="Поиск новости…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"
                        AutomationProperties.Name="Обновить список новостей" />
            </Grid>
        </Border>

        <!-- Фильтры-чипы -->
        <StackPanel Grid.Row="1"
                    Margin="20,12,20,0"
                    Orientation="Horizontal">
            <RadioButton GroupName="NewsFilter"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsFilterAll, Mode=TwoWay}"
                         Command="{Binding SelectFilterCommand}"
                         CommandParameter="all"
                         Content="Все"
                         AutomationProperties.Name="Фильтр: все новости" />
            <RadioButton GroupName="NewsFilter"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsFilterUnread, Mode=TwoWay}"
                         Command="{Binding SelectFilterCommand}"
                         CommandParameter="unread"
                         Content="Непрочитанные"
                         AutomationProperties.Name="Фильтр: непрочитанные новости" />
            <RadioButton GroupName="NewsFilter"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsFilterBookmarks, Mode=TwoWay}"
                         Command="{Binding SelectFilterCommand}"
                         CommandParameter="bookmarks"
                         Content="Закладки"
                         local:NavGlyph.Icon="{x:Static local:VectorIcons.Bookmark}"
                         AutomationProperties.Name="Фильтр: закладки" />
        </StackPanel>

        <!-- Порядок списка: серверная сортировка (sort_by/sort_dir) -->
        <StackPanel Grid.Row="2"
                    Margin="20,8,20,0"
                    Orientation="Horizontal">
            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource HubMutedTextStyle}"
                       FontSize="12"
                       Text="Порядок:" />
            <RadioButton GroupName="NewsSort"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsSortNewest, Mode=TwoWay}"
                         Command="{Binding SelectSortCommand}"
                         CommandParameter="published_desc"
                         Content="Сначала новые"
                         AutomationProperties.Name="Сортировка новостей: сначала новые" />
            <RadioButton GroupName="NewsSort"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsSortOldest, Mode=TwoWay}"
                         Command="{Binding SelectSortCommand}"
                         CommandParameter="published_asc"
                         Content="Сначала старые"
                         AutomationProperties.Name="Сортировка новостей: сначала старые" />
            <RadioButton GroupName="NewsSort"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsSortUpdated, Mode=TwoWay}"
                         Command="{Binding SelectSortCommand}"
                         CommandParameter="updated_desc"
                         Content="Недавно обновлённые"
                         AutomationProperties.Name="Сортировка новостей: недавно обновлённые" />
            <RadioButton GroupName="NewsSort"
                         Style="{StaticResource ChipRadioStyle}"
                         IsChecked="{Binding IsSortPriority, Mode=TwoWay}"
                         Command="{Binding SelectSortCommand}"
                         CommandParameter="priority_desc"
                         Content="По важности"
                         AutomationProperties.Name="Сортировка новостей: по важности" />
        </StackPanel>

        <!-- Баннер ошибки -->
        <Border Grid.Row="3"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку новостей" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Список + детали -->
        <Grid Grid.Row="4" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,6"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource HubAccentBrush}"
                             Background="{DynamicResource HubSurfaceRaisedBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Индикатор загрузки новостей" />
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <ListBox Style="{StaticResource HubListBoxStyle}"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}"
                                 AutomationProperties.Name="Список новостей">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <!-- Точка непрочитанной: цвет + текст «Новая» рядом -->
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Margin="0,0,6,0"
                                                     Fill="{DynamicResource HubAccentBrush}"
                                                     Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Margin="0,0,6,0"
                                                       FontSize="12"
                                                       Text="{Binding PinnedMarker}"
                                                       Visibility="{Binding PinnedMarker, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   FontSize="14"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="40">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="2"
                                                    Margin="10,1,0,0"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                            <Border Margin="0,0,6,0"
                                                    Style="{StaticResource HubStatusPillStyle}"
                                                    BorderBrush="{DynamicResource HubAccentBrush}"
                                                    Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubAccentBrush}"
                                                           Text="Новая" />
                                            </Border>
                                            <Border Style="{StaticResource HubStatusPillStyle}"
                                                    BorderBrush="{DynamicResource HubWarningBrush}"
                                                    Visibility="{Binding IsHighPriority, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HubWarningBrush}"
                                                           Text="{Binding PriorityText}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               FontSize="12"
                                               Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="34" />
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding DateText}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding CategoryText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding CategoryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding UpdatedBadgeText}"
                                                       Visibility="{Binding UpdatedBadgeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubWarningBrush}"
                                                       Text="{Binding AckPendingText}"
                                                       Visibility="{Binding AckPendingText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding AttachmentsText}"
                                                       Visibility="{Binding AttachmentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding CommentsText}"
                                                       Visibility="{Binding CommentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Новостей нет" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Под текущий фильтр ничего не подходит. Измените фильтр или поиск." />
                    </StackPanel>
                    </Grid>
                    <Button Grid.Row="1"
                            Margin="0,8,0,0"
                            Style="{StaticResource HubSecondaryButtonStyle}"
                            Command="{Binding LoadMoreCommand}"
                            Content="{Binding MoreButtonText}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Показать следующую порцию новостей" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.Name="Разделитель списка и деталей"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей" />

            <!-- Детали новости -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ошибка детали/действия -->
                    <Border Grid.Row="0"
                            Margin="18,14,18,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   Text="{Binding DetailErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Пустая деталь -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowDetailEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Выберите новость" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Карточка слева откроет полный текст объявления." />
                        </StackPanel>

                        <!-- Загрузка детали -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowDetailLoading, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         IsIndeterminate="True" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Загружаю объявление…" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Padding="22,18"
                                          VerticalScrollBarVisibility="Auto"
                                          DataContext="{Binding Detail}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                        <Border Grid.Column="1"
                                                Margin="14,2,0,0"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HubStatusPillStyle}"
                                                BorderBrush="{DynamicResource HubWarningBrush}"
                                                Visibility="{Binding IsHighPriority, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubWarningBrush}"
                                                       Text="{Binding PriorityText}" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetaLabelStyle}" Text="Автор" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding AuthorText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Опубликовано" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding DateText}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Обновлено"
                                                   Visibility="{Binding UpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding UpdatedText}"
                                                   Visibility="{Binding UpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Категория"
                                                   Visibility="{Binding CategoryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding CategoryText}"
                                                   Visibility="{Binding CategoryText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Вложения"
                                                   Visibility="{Binding AttachmentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding AttachmentsText}"
                                                   Visibility="{Binding AttachmentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Комментарии"
                                                   Visibility="{Binding CommentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding CommentsText}"
                                                   Visibility="{Binding CommentsText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </Grid>

                                    <TextBlock Margin="0,18,0,6"
                                               Style="{StaticResource HubSectionTitleStyle}"
                                               FontSize="14"
                                               Text="Текст объявления" />
                                    <local:MarkdownTextBlock MarkdownText="{Binding Body}"
                                                             TextWrapping="Wrap"
                                                             Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                               Text="Текст объявления отсутствует."
                                               Visibility="{Binding HasBody, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <!-- Реакции: чипы со счётами (своя подсвечена) + «+»-меню -->
                                    <WrapPanel Margin="0,16,0,0"
                                               Visibility="{Binding ReactionsEnabled, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding ReactionChips}"
                                                      AutomationProperties.Name="Реакции на новость">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding TooltipText}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                                                  Margin="0,0,8,8"
                                                                  IsChecked="{Binding IsMine, Mode=OneWay}"
                                                                  Command="{Binding DataContext.ToggleReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  Content="{Binding DisplayText}"
                                                                  ToolTip="{Binding TooltipText}"
                                                                  AutomationProperties.Name="{Binding TooltipText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource HubGhostButtonStyle}"
                                                Margin="0,0,8,8"
                                                MinHeight="28"
                                                Padding="10,4"
                                                Click="ReactionMenu_Click"
                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                                ToolTip="Добавить реакцию"
                                                AutomationProperties.Name="Добавить реакцию">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="👍 Нравится" Command="{Binding DataContext.PickReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="like" />
                                                    <MenuItem Header="❤️ Любовь" Command="{Binding DataContext.PickReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="love" />
                                                    <MenuItem Header="😂 Смех" Command="{Binding DataContext.PickReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="laugh" />
                                                    <MenuItem Header="😮 Удивление" Command="{Binding DataContext.PickReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="wow" />
                                                    <MenuItem Header="😢 Грусть" Command="{Binding DataContext.PickReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="sad" />
                                                    <MenuItem Header="😡 Возмущение" Command="{Binding DataContext.PickReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="angry" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>

                                    <!-- Действия: лайк / комментарии / закладка -->
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                                      IsChecked="{Binding IsLiked, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Content="{Binding LikeText}"
                                                      ToolTip="{Binding LikeTooltip}"
                                                      Visibility="{Binding ReactionsEnabled, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="Нравится" />
                                        <StackPanel Margin="4,0,12,0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <local:VectorIcon Size="13"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                              Data="{x:Static local:VectorIcons.Chat}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding CommentsTotal}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CommentsTotal}" Value="0">
                                                                <Setter Property="Text" Value="" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ToggleButton Style="{StaticResource HubChipToggleStyle}"
                                                      IsChecked="{Binding IsBookmarked, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Content="{Binding BookmarkText}"
                                                      ToolTip="{Binding BookmarkTooltip}"
                                                      AutomationProperties.Name="Закладка" />
                                    </StackPanel>

                                    <!-- Опрос -->
                                    <Border Margin="0,16,0,0"
                                            Padding="14,12"
                                            Background="{DynamicResource HubSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Visibility="{Binding HasPoll, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                                       FontSize="14"
                                                       Text="{Binding PollQuestion}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Style="{StaticResource HubMutedTextStyle}"
                                                       FontSize="12"
                                                       Text="{Binding PollMetaText}"
                                                       Visibility="{Binding PollMetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            <ItemsControl Margin="0,10,0,0"
                                                          ItemsSource="{Binding PollOptions}"
                                                          AutomationProperties.Name="Варианты опроса">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Text, StringFormat='Вариант опроса: {0}'}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6"
                                                                Padding="10,8"
                                                                Background="{DynamicResource HubSurfaceBrush}"
                                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox VerticalAlignment="Center"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}"
                                                                              AutomationProperties.Name="{Binding Text}" />
                                                                    <Button Style="{StaticResource HubGhostButtonStyle}"
                                                                            Padding="8,2"
                                                                            Command="{Binding DataContext.VotePollOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="{Binding Text}"
                                                                            Visibility="{Binding ShowVoteButton, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Margin="8,0,8,0"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding Text}"
                                                                               TextWrapping="Wrap"
                                                                               Visibility="{Binding ShowVoteButton, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                    <TextBlock Grid.Column="2"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                               Text="{Binding VotesCount, StringFormat='{}{0} гол.'}"
                                                                               Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}" />
                                                                </Grid>
                                                                <Grid Margin="0,6,0,0"
                                                                      Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ProgressBar Height="6"
                                                                                 Minimum="0"
                                                                                 Maximum="100"
                                                                                 Value="{Binding Percent, Mode=OneWay}"
                                                                                 Foreground="{DynamicResource HubAccentBrush}"
                                                                                 Background="{DynamicResource HubSurfaceRaisedBrush}" />
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="8,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Horizontal">
                                                                        <local:VectorIcon Size="12"
                                                                                          VerticalAlignment="Center"
                                                                                          Foreground="{DynamicResource HubAccentBrush}"
                                                                                          Data="{x:Static local:VectorIcons.Check}"
                                                                                          Visibility="{Binding IsViewerVote, Converter={StaticResource BoolToVisibility}}" />
                                                                        <TextBlock Margin="4,0,0,0"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                   Text="{Binding PercentText}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding PollVotersText}" />
                                                    <TextBlock Margin="10,0,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding PollClosesText}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                    <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                                            Command="{Binding DataContext.SubmitPollVoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Content="{Binding PollSubmitText}"
                                                            Visibility="{Binding ShowPollSubmit, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="Голосовать в опросе" />
                                                    <Button Margin="8,0,0,0"
                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                            Command="{Binding DataContext.CancelPollVoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Content="Отменить голос"
                                                            Visibility="{Binding ShowPollCancelVote, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="Отменить голос" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Вложения -->
                                    <StackPanel x:Name="AttachmentsSectionPanel"
                                                Margin="0,16,0,0"
                                                Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                                   FontSize="14"
                                                   Text="Вложения" />
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding Attachments}"
                                                      AutomationProperties.Name="Вложения новости">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,8,8"
                                                            MinHeight="28"
                                                            Padding="10,4"
                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding DisplayText}"
                                                            ToolTip="{Binding Name}"
                                                            AutomationProperties.Name="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Комментарии -->
                                    <StackPanel x:Name="CommentsSectionPanel"
                                                Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                                   FontSize="14"
                                                   Text="{Binding CommentsHeaderText}" />
                                        <Border Margin="0,8,0,0"
                                                Padding="12,8"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubErrorTextBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding CommentsErrorText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                            <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                                       Text="{Binding CommentsErrorText}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <ProgressBar Margin="0,8,0,0"
                                                     Height="3"
                                                     IsIndeterminate="True"
                                                     Foreground="{DynamicResource HubAccentBrush}"
                                                     Background="{DynamicResource HubSurfaceRaisedBrush}"
                                                     Visibility="{Binding ShowCommentsLoading, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding Comments}"
                                                      AutomationProperties.Name="Комментарии">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AuthorText, StringFormat='Комментарий: {0}'}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,8,0,0"
                                                            Padding="10,8"
                                                            Background="{DynamicResource HubSurfaceBrush}"
                                                            BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock FontWeight="SemiBold"
                                                                               Text="{Binding AuthorText}" />
                                                                    <TextBlock Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                               Text="{Binding DateText}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1"
                                                                            Orientation="Horizontal"
                                                                            Visibility="{Binding ShowActions, Converter={StaticResource BoolToVisibility}}">
                                                                    <Button Margin="0,0,6,0"
                                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                                            Padding="8,2"
                                                                            Command="{Binding DataContext.BeginCommentEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="Изменить"
                                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"
                                                                            AutomationProperties.Name="Изменить комментарий" />
                                                                    <Button Style="{StaticResource HubGhostButtonStyle}"
                                                                            Padding="8,2"
                                                                            Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="Удалить"
                                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                                            AutomationProperties.Name="Удалить комментарий" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock FontSize="12"
                                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                       Text="{Binding ReplyToText}"
                                                                       Visibility="{Binding ReplyToText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Text="{Binding DisplayBody}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <StackPanel Margin="0,4,0,0"
                                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBox MinHeight="56"
                                                                         AcceptsReturn="True"
                                                                         Style="{StaticResource HubTextBoxStyle}"
                                                                         Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextWrapping="Wrap" />
                                                                <StackPanel Margin="0,6,0,0"
                                                                            Orientation="Horizontal">
                                                                    <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                                                            Command="{Binding DataContext.SaveCommentEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="Сохранить"
                                                                            AutomationProperties.Name="Сохранить правку комментария" />
                                                                    <Button Margin="8,0,0,0"
                                                                            Style="{StaticResource HubGhostButtonStyle}"
                                                                            Command="{Binding DataContext.CancelCommentEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="Отмена"
                                                                            AutomationProperties.Name="Отменить правку" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <ItemsControl Margin="0,6,0,0"
                                                                          ItemsSource="{Binding Attachments}"
                                                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}"
                                                                          AutomationProperties.Name="Вложения комментария">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Margin="0,0,6,6"
                                                                                MinHeight="24"
                                                                                Padding="8,2"
                                                                                Style="{StaticResource HubGhostButtonStyle}"
                                                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="{Binding DisplayText}"
                                                                                ToolTip="{Binding Name}"
                                                                                AutomationProperties.Name="{Binding Name}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <WrapPanel Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowReactions, Converter={StaticResource BoolToVisibility}}">
                                                                <ItemsControl ItemsSource="{Binding ReactionChips}"
                                                                              AutomationProperties.Name="Реакции на комментарий">
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="AutomationProperties.Name" Value="{Binding TooltipText}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ToggleButton Margin="0,0,6,4"
                                                                                          MinHeight="22"
                                                                                          Padding="7,1"
                                                                                          Style="{StaticResource HubChipToggleStyle}"
                                                                                          IsChecked="{Binding IsMine, Mode=OneWay}"
                                                                                          Command="{Binding DataContext.ToggleCommentReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                          CommandParameter="{Binding}"
                                                                                          Content="{Binding DisplayText}"
                                                                                          ToolTip="{Binding TooltipText}"
                                                                                          AutomationProperties.Name="{Binding TooltipText}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Margin="0,0,6,4"
                                                                        MinHeight="22"
                                                                        Padding="7,1"
                                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                                        Click="ReactionMenu_Click"
                                                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                                                        ToolTip="Добавить реакцию"
                                                                        AutomationProperties.Name="Добавить реакцию">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="👍 Нравится" Command="{Binding PickReactionCommand}" CommandParameter="like" />
                                                                            <MenuItem Header="❤️ Любовь" Command="{Binding PickReactionCommand}" CommandParameter="love" />
                                                                            <MenuItem Header="😂 Смех" Command="{Binding PickReactionCommand}" CommandParameter="laugh" />
                                                                            <MenuItem Header="😮 Удивление" Command="{Binding PickReactionCommand}" CommandParameter="wow" />
                                                                            <MenuItem Header="😢 Грусть" Command="{Binding PickReactionCommand}" CommandParameter="sad" />
                                                                            <MenuItem Header="😡 Возмущение" Command="{Binding PickReactionCommand}" CommandParameter="angry" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <Button Margin="0,0,6,4"
                                                                        MinHeight="22"
                                                                        Padding="7,1"
                                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                                        Command="{Binding DataContext.ReplyCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Ответить"
                                                                        Visibility="{Binding CanReply, Converter={StaticResource BoolToVisibility}}"
                                                                        AutomationProperties.Name="Ответить на комментарий" />
                                                            </WrapPanel>
                                                            <StackPanel>
                                                                <Button Margin="0,2,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                                        Padding="8,2"
                                                                        Command="{Binding DataContext.ToggleRepliesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{Binding RepliesButtonText}"
                                                                        Visibility="{Binding HasReplies, Converter={StaticResource BoolToVisibility}}"
                                                                        AutomationProperties.Name="Развернуть ответы" />
                                                                <ProgressBar Margin="0,4,0,0"
                                                                             Height="3"
                                                                             IsIndeterminate="True"
                                                                             Foreground="{DynamicResource HubAccentBrush}"
                                                                             Visibility="{Binding IsRepliesLoading, Converter={StaticResource BoolToVisibility}}" />
                                                                <ItemsControl Margin="16,4,0,0"
                                                                              ItemsSource="{Binding Replies}"
                                                                              Visibility="{Binding RepliesExpanded, Converter={StaticResource BoolToVisibility}}"
                                                                              AutomationProperties.Name="Ответы на комментарий">
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="AutomationProperties.Name" Value="{Binding AuthorText, StringFormat='Ответ: {0}'}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,0,0,6"
                                                                                    Padding="8,6"
                                                                                    Background="{DynamicResource HubSurfaceAltBrush}"
                                                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="8">
                                                                                <StackPanel>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock FontWeight="SemiBold"
                                                                                                   Text="{Binding AuthorText}" />
                                                                                        <TextBlock Margin="8,0,0,0"
                                                                                                   VerticalAlignment="Center"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                                   Text="{Binding DateText}" />
                                                                                    </StackPanel>
                                                                                    <TextBlock FontSize="12"
                                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                                               Text="{Binding ReplyToText}"
                                                                                               Visibility="{Binding ReplyToText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                                                    <TextBlock Margin="0,2,0,0"
                                                                                               Text="{Binding DisplayBody}"
                                                                                               TextWrapping="Wrap" />
                                                                                    <WrapPanel Margin="0,4,0,0">
                                                                                        <ItemsControl ItemsSource="{Binding ReactionChips}"
                                                                                                      AutomationProperties.Name="Реакции на ответ">
                                                                                            <ItemsControl.ItemContainerStyle>
                                                                                                <Style TargetType="ContentPresenter">
                                                                                                    <Setter Property="AutomationProperties.Name" Value="{Binding TooltipText}" />
                                                                                                </Style>
                                                                                            </ItemsControl.ItemContainerStyle>
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <WrapPanel />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <ToggleButton Margin="0,0,6,4"
                                                                                                                  MinHeight="20"
                                                                                                                  Padding="6,1"
                                                                                                                  Style="{StaticResource HubChipToggleStyle}"
                                                                                                                  IsChecked="{Binding IsMine, Mode=OneWay}"
                                                                                                                  Command="{Binding DataContext.ToggleCommentReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                                  CommandParameter="{Binding}"
                                                                                                                  Content="{Binding DisplayText}"
                                                                                                                  ToolTip="{Binding TooltipText}"
                                                                                                                  AutomationProperties.Name="{Binding TooltipText}" />
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                        <Button Margin="0,0,6,4"
                                                                                                MinHeight="20"
                                                                                                Padding="6,1"
                                                                                                Style="{StaticResource HubGhostButtonStyle}"
                                                                                                Click="ReactionMenu_Click"
                                                                                                local:NavGlyph.Icon="{x:Static local:VectorIcons.Plus}"
                                                                                                ToolTip="Добавить реакцию"
                                                                                                AutomationProperties.Name="Добавить реакцию">
                                                                                            <Button.ContextMenu>
                                                                                                <ContextMenu>
                                                                                                    <MenuItem Header="👍" Command="{Binding PickReactionCommand}" CommandParameter="like" />
                                                                                                    <MenuItem Header="❤️" Command="{Binding PickReactionCommand}" CommandParameter="love" />
                                                                                                    <MenuItem Header="😂" Command="{Binding PickReactionCommand}" CommandParameter="laugh" />
                                                                                                    <MenuItem Header="😮" Command="{Binding PickReactionCommand}" CommandParameter="wow" />
                                                                                                    <MenuItem Header="😢" Command="{Binding PickReactionCommand}" CommandParameter="sad" />
                                                                                                    <MenuItem Header="😡" Command="{Binding PickReactionCommand}" CommandParameter="angry" />
                                                                                                </ContextMenu>
                                                                                            </Button.ContextMenu>
                                                                                        </Button>
                                                                                        <Button Margin="0,0,6,4"
                                                                                                MinHeight="20"
                                                                                                Padding="6,1"
                                                                                                Style="{StaticResource HubGhostButtonStyle}"
                                                                                                Command="{Binding DataContext.ReplyCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="Ответить"
                                                                                                Visibility="{Binding CanReply, Converter={StaticResource BoolToVisibility}}" />
                                                                                        <Button Margin="0,0,6,4"
                                                                                                MinHeight="20"
                                                                                                Padding="6,1"
                                                                                                Style="{StaticResource HubGhostButtonStyle}"
                                                                                                Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="Удалить"
                                                                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                                                                    </WrapPanel>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource HubGhostButtonStyle}"
                                                Command="{Binding DataContext.LoadMoreCommentsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="Показать ещё комментарии"
                                                Visibility="{Binding HasMoreComments, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="Показать ещё комментарии" />
                                        <Border Margin="0,8,0,0"
                                                Padding="8,4"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding ReplyToText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding ReplyToText}"
                                                           TextWrapping="Wrap" />
                                                <Button Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                        Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        local:NavGlyph.Icon="{x:Static local:VectorIcons.Close}"
                                                        AutomationProperties.Name="Отменить ответ" />
                                            </Grid>
                                        </Border>
                                        <Grid Margin="0,8,0,0"
                                              Visibility="{Binding ShowComposer, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox MinHeight="40"
                                                     AcceptsReturn="True"
                                                     Style="{StaticResource HubTextBoxStyle}"
                                                     Text="{Binding CommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     AutomationProperties.Name="Текст комментария" />
                                            <Button Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource HubPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.SendCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Content="Отправить"
                                                    AutomationProperties.Name="Отправить комментарий" />
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource HubMutedTextStyle}"
                                                   FontSize="12"
                                                   Text="{Binding CommentsDisabledText}"
                                                   Visibility="{Binding CommentsDisabledText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Подтверждение прочтения -->
                            <Border Grid.Row="1"
                                    Padding="22,14"
                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                    BorderThickness="0,1,0,0"
                                    DataContext="{Binding Detail}"
                                    Visibility="{Binding RequiresAck, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HubWarningBrush}"
                                                   Text="Требует подтверждения прочтения"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsAckPending, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ShowAckDone, Converter={StaticResource BoolToVisibility}}">
                                            <local:VectorIcon Size="13"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,5,0"
                                                              Foreground="{DynamicResource HubSuccessBrush}"
                                                              Data="{x:Static local:VectorIcons.Check}" />
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HubSuccessBrush}"
                                                       Text="Подтверждено" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Style="{StaticResource HubPrimaryButtonStyle}"
                                            Command="{Binding DataContext.AckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding CanAck}"
                                            Content="{Binding AckButtonText}"
                                            Visibility="{Binding IsAckPending, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Подтвердить прочтение новости" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус-бар -->
        <Border Grid.Row="5"
                Padding="20,8"
                Background="{DynamicResource HubSurfaceAltBrush}"
                BorderBrush="{DynamicResource HubBorderDimBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource HubTextSecondaryBrush}">
                    <Run Text="Всего:" />
                    <Run Text="{Binding TotalText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="14,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource HubTextSecondaryBrush}">
                    <Run Text="Непрочитанных:" />
                    <Run Text="{Binding UnreadText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="14,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource HubTextSecondaryBrush}">
                    <Run Text="Требуют подтверждения:" />
                    <Run Text="{Binding AckPendingText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="14,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                           Text="{Binding LastUpdatedText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
