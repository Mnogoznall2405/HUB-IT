<UserControl x:Class="Hub.Desktop.Native.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Тонкая мягкая строка-разделитель между полями карточки. -->
            <Style x:Key="RowSeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,10" />
                <Setter Property="Background" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Деструктивное действие: мягкая danger-заливка вместо
                 нейтральной secondary-кнопки (та же логика, что у tone-пилюль). -->
            <Style x:Key="DangerSoftButtonStyle" TargetType="Button" BasedOn="{StaticResource HubSecondaryButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource HubStatusOverdueSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubStatusOverdueBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource HubScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24"
                    MaxWidth="640">

            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="Профиль" />

            <!-- Карточка пользователя: hero-«верхний свет», как у KPI-карточек главной -->
            <Border Margin="0,20,0,0"
                    Padding="20,16"
                    Background="{DynamicResource HubCardGradientBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Карточка текущего пользователя">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="28"
                            Background="{DynamicResource HubSelectionBrush}"
                            BorderBrush="{DynamicResource HubAccentBrush}"
                            BorderThickness="1">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HubAccentBrush}"
                                   Text="{Binding Initials}" />
                    </Border>
                    <StackPanel Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}"
                                   AutomationProperties.Name="Отображаемое имя пользователя" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="{Binding UserName}"
                                   AutomationProperties.Name="Логин пользователя" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Сессия -->
            <TextBlock Margin="0,20,0,0"
                       Style="{StaticResource HubSectionTitleStyle}"
                       Text="Сессия" />
            <Border Margin="0,10,0,0"
                    Padding="16,14"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   Text="Сессия действует до" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SessionExpiresText}"
                                   AutomationProperties.Name="Срок действия сессии" />
                    </Grid>
                    <Border Style="{StaticResource RowSeparatorStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   Text="Устройство" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DeviceIdText}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Идентификатор устройства" />
                    </Grid>
                    <Border Style="{StaticResource RowSeparatorStyle}" />
                    <Button Margin="0,2,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DangerSoftButtonStyle}"
                            Command="{Binding SignOutCommand}"
                            Content="Выйти из учётной записи"
                            AutomationProperties.Name="Выйти из учётной записи HUB" />
                </StackPanel>
            </Border>

            <!-- О приложении -->
            <TextBlock Margin="0,20,0,0"
                       Style="{StaticResource HubSectionTitleStyle}"
                       Text="О приложении" />
            <Border Margin="0,10,0,0"
                    Padding="16,14"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Сведения о приложении">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   Text="Приложение" />
                        <TextBlock Grid.Column="1"
                                   Text="HUB Desktop" />
                    </Grid>
                    <Border Style="{StaticResource RowSeparatorStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   Text="Версия" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AppVersionText}"
                                   AutomationProperties.Name="Версия приложения" />
                    </Grid>
                    <Border Style="{StaticResource RowSeparatorStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                   Text="Сервер" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ServerText}"
                                   AutomationProperties.Name="Адрес сервера HUB" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
