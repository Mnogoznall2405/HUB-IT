<UserControl x:Class="Hub.Desktop.Native.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="HeaderCellStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="MetricPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="ChipRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}" />
            <Style x:Key="ChipStyle" TargetType="Border" BasedOn="{StaticResource HubStatusPillStyle}">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="BorderBrush" Value="{DynamicResource HubBorderDimBrush}" />
                <Setter Property="Background" Value="{DynamicResource HubSurfaceBrush}" />
            </Style>

            <!-- Меню-фильтр периода: пункт = опция, команда — из Tag кнопки-хозяина. -->
            <Style x:Key="FilterMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}" />
                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>

            <!-- Тон значения метрики: success|warning|error → кисти темы. -->
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="success">
                        <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                        <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="error">
                        <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Тон числа «Осталось» в таблице чистки ПК. -->
            <Style x:Key="RemainingTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RemainingTone}" Value="error">
                        <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RemainingTone}" Value="success">
                        <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Тон «Покрытие» — getCoverageColor веба. -->
            <Style x:Key="CoverageTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CoverageTone}" Value="success">
                        <Setter Property="Foreground" Value="{DynamicResource HubSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CoverageTone}" Value="warning">
                        <Setter Property="Foreground" Value="{DynamicResource HubWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CoverageTone}" Value="error">
                        <Setter Property="Foreground" Value="{DynamicResource HubErrorTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid AutomationProperties.Name="Страница статистики">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: заголовок, вкладки, период, фильтр, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Статистика"
                                   AutomationProperties.Name="Заголовок страницы статистики" />
                        <ProgressBar Margin="10,0,0,0"
                                     Width="80"
                                     Height="3"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource HubAccentBrush}"
                                     Background="{DynamicResource HubSurfaceRaisedBrush}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Индикатор загрузки статистики" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Обновить"
                            AutomationProperties.Name="Обновить статистику" />
                </Grid>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <RadioButton GroupName="StatsTab"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsPcTab, Mode=TwoWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="pc"
                                 Content="Чистка ПК"
                                 AutomationProperties.Name="Раздел статистики: чистка ПК" />
                    <RadioButton GroupName="StatsTab"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsMfuTab, Mode=TwoWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="mfu"
                                 Content="МФУ"
                                 Visibility="{Binding ShowMfuTab, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Раздел статистики: МФУ" />
                    <RadioButton GroupName="StatsTab"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsBatteryTab, Mode=TwoWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="battery"
                                 Content="Батареи"
                                 AutomationProperties.Name="Раздел статистики: батареи" />
                    <RadioButton GroupName="StatsTab"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsPcComponentsTab, Mode=TwoWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="pc_components"
                                 Content="Комплектующие ПК"
                                 AutomationProperties.Name="Раздел статистики: комплектующие ПК" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button VerticalAlignment="Center"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectPeriodCommand}"
                            Click="PeriodMenuButton_Click"
                            AutomationProperties.Name="Выбор периода статистики">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource FilterMenuItemStyle}"
                                         ItemsSource="{Binding PeriodOptions}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Период: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedPeriodText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Width="260"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Фильтр статистики по филиалу или локации" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="{Binding FilterPlaceholderText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetaLabelStyle}"
                               FontWeight="SemiBold"
                               Text="{Binding TitleText}" />
                    <TextBlock Margin="10,0,0,0"
                               Style="{StaticResource MetaLabelStyle}"
                               Text="{Binding PeriodRangeText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Баннер ошибки загрузки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.Name="Ошибка загрузки статистики">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку статистики" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку статистики" />
            </Grid>
        </Border>

        <!-- Контент раздела: карточки, распределения, таблицы -->
        <ScrollViewer Grid.Row="2"
                      Margin="20,10,20,10"
                      Style="{StaticResource HubScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Числовые карточки (MetricCard-ряд веба) -->
                <ItemsControl ItemsSource="{Binding MetricCards}"
                              AutomationProperties.Name="Сводные показатели статистики">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricPanelStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                               Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding ValueText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Распределения (DistributionChips веба) -->
                <ItemsControl ItemsSource="{Binding Slices}"
                              AutomationProperties.Name="Распределения статистики">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionPanelStyle}"
                                    MinWidth="220"
                                    Margin="0,12,10,0">
                                <StackPanel>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Chips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <TextBlock FontSize="12" Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Раздел «Чистка ПК»: таблица по филиалам -->
                <Border Style="{StaticResource SectionPanelStyle}"
                        Visibility="{Binding ShowPcTable, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Таблица чистки ПК по филиалам">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="160" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource HeaderCellStyle}" Text="ФИЛИАЛ" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" Text="ПК ВСЕГО" />
                            <TextBlock Grid.Column="2" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" Text="ПОЧИЩЕНО" />
                            <TextBlock Grid.Column="3" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" Text="ОСТАЛОСЬ" />
                            <TextBlock Grid.Column="4" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" Text="ЧИСТОК ЗА ПЕРИОД" />
                            <TextBlock Grid.Column="5" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" Text="ПОКРЫТИЕ" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="Нет данных по выбранному фильтру"
                                   AutomationProperties.Name="Пустая таблица чистки ПК">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaLabelStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPcBranches}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Margin="0,2,0,0"
                                      ItemsSource="{Binding PcBranches}"
                                      AutomationProperties.Name="Строки статистики чистки ПК">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0"
                                          AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="160" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Branch}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12.5"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding TotalPcText}" />
                                        <TextBlock Grid.Column="2"
                                                   FontSize="12.5"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CleanedPcText}" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource RemainingTextStyle}"
                                                   Text="{Binding RemainingPcText}" />
                                        <TextBlock Grid.Column="4"
                                                   FontSize="12.5"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CleaningsPeriodText}" />
                                        <TextBlock Grid.Column="5"
                                                   Style="{StaticResource CoverageTextStyle}"
                                                   Text="{Binding CoverageText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Разделы МФУ/батареи/комплектующие: локации + последние записи -->
                <StackPanel Visibility="{Binding ShowOperationsTables, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource SectionPanelStyle}"
                            AutomationProperties.Name="Таблица статистики по локациям">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding LocationsTitleText}"
                                       AutomationProperties.Name="Заголовок таблицы локаций" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="2*" MinWidth="160" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource HeaderCellStyle}" Text="ФИЛИАЛ" />
                                <TextBlock Grid.Column="1" Style="{StaticResource HeaderCellStyle}" Text="ЛОКАЦИЯ" />
                                <TextBlock Grid.Column="2" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right" Text="{Binding LocationOpsHeaderText}" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource HeaderCellStyle}" Text="ТОП ПОЗИЦИЙ" />
                                <TextBlock Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource HeaderCellStyle}" Text="ПОСЛЕДНЯЯ ЗАМЕНА" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Нет данных по выбранному фильтру"
                                       AutomationProperties.Name="Пустая таблица локаций">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetaLabelStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLocations}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl Margin="0,2,0,0"
                                          ItemsSource="{Binding Locations}"
                                          AutomationProperties.Name="Строки статистики по локациям">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0"
                                              AutomationProperties.Name="{Binding AutomationName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="2*" MinWidth="160" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Branch}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12.5"
                                                       Text="{Binding Location}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       FontSize="12.5"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding OperationsText}" />
                                            <TextBlock Grid.Column="3"
                                                       Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding TopItemsText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       Margin="8,0,0,0"
                                                       FontSize="12"
                                                       Text="{Binding LastReplacementText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionPanelStyle}"
                            AutomationProperties.Name="Таблица последних записей статистики">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding RecentTitleText}"
                                       AutomationProperties.Name="Заголовок таблицы последних записей" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" MinWidth="100" />
                                    <ColumnDefinition Width="*" MinWidth="100" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource HeaderCellStyle}" Text="ДАТА" />
                                <TextBlock Grid.Column="1" Style="{StaticResource HeaderCellStyle}" Text="ФИЛИАЛ" />
                                <TextBlock Grid.Column="2" Style="{StaticResource HeaderCellStyle}" Text="ЛОКАЦИЯ" />
                                <TextBlock Grid.Column="3" Style="{StaticResource HeaderCellStyle}" Text="{Binding RecentModelHeaderText}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource HeaderCellStyle}" Text="{Binding RecentKindHeaderText}" />
                                <TextBlock Grid.Column="5" Style="{StaticResource HeaderCellStyle}" Text="ПОЗИЦИЯ" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="За выбранный период записей нет"
                                       AutomationProperties.Name="Пустая таблица последних записей">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetaLabelStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl Margin="0,2,0,0"
                                          ItemsSource="{Binding RecentItems}"
                                          AutomationProperties.Name="Строки последних записей статистики">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0"
                                              AutomationProperties.Name="{Binding AutomationName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" MinWidth="100" />
                                                <ColumnDefinition Width="*" MinWidth="100" />
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12"
                                                       Text="{Binding DateText}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Branch}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       FontSize="12.5"
                                                       Text="{Binding Location}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3"
                                                       FontSize="12.5"
                                                       Text="{Binding ModelText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                       Text="{Binding KindText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5"
                                                       FontSize="12.5"
                                                       Text="{Binding ItemText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
