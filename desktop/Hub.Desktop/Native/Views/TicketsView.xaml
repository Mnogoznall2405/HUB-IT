<UserControl x:Class="Hub.Desktop.Native.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hub.Desktop.Native.Views"
             Foreground="{DynamicResource HubTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/HubTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <!-- Чипы переключателя режима (Список/Канбан/Дашборд) — как в других нативных страницах. -->
            <Style x:Key="ChipRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HubChipToggleStyle}" />

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HubMutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource HubTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Меню-фильтры: пункт = опция, команда — из Tag кнопки-хозяина. -->
            <Style x:Key="FilterMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}" />
                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
            <Style x:Key="ObjectFilterMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Setter Property="Command" Value="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск, фильтры, обновить -->
        <Border Grid.Row="0" Padding="20,16,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center"
                          Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBox x:Name="SearchInput"
                                 Width="220"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchInput_KeyDown"
                                 AutomationProperties.Name="Поиск по заявкам на билеты" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                   Text="Поиск заявки…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Margin="10,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectStatusFilterCommand}"
                            Click="StatusFilterMenuButton_Click"
                            Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Фильтр заявок по статусу">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource FilterMenuItemStyle}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Статус: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedStatusFilterText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Tag="{Binding SelectObjectFilterCommand}"
                            Click="ObjectFilterMenuButton_Click"
                            Visibility="{Binding IsDashboardMode, Converter={StaticResource InverseBoolToVisibility}}"
                            AutomationProperties.Name="Фильтр заявок по объекту">
                        <Button.ContextMenu>
                            <ContextMenu ItemContainerStyle="{StaticResource ObjectFilterMenuItemStyle}" />
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="Объект: " />
                            <TextBlock FontSize="12" Text="{Binding SelectedObjectFilterText}" />
                            <TextBlock Margin="4,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource HubTextSecondaryBrush}"
                                       Text="▾" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Режим просмотра: Список | Канбан | Дашборд -->
                    <RadioButton GroupName="TicketsViewMode"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsListMode, Mode=TwoWay}"
                                 Command="{Binding SelectViewModeCommand}"
                                 CommandParameter="list"
                                 Content="Список"
                                 AutomationProperties.Name="Режим: список заявок" />
                    <RadioButton GroupName="TicketsViewMode"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsKanbanMode, Mode=TwoWay}"
                                 Command="{Binding SelectViewModeCommand}"
                                 CommandParameter="kanban"
                                 Content="Канбан"
                                 AutomationProperties.Name="Режим: канбан-доска заявок" />
                    <RadioButton GroupName="TicketsViewMode"
                                 Style="{StaticResource ChipRadioStyle}"
                                 IsChecked="{Binding IsDashboardMode, Mode=TwoWay}"
                                 Command="{Binding SelectViewModeCommand}"
                                 CommandParameter="dashboard"
                                 Content="Дашборд"
                                 AutomationProperties.Name="Режим: сводка по заявкам" />
                    <Button Margin="10,0,0,0"
                            Style="{StaticResource HubPrimaryButtonStyle}"
                            Command="{Binding NewTicketCommand}"
                            Content="＋ Новая заявка"
                            AutomationProperties.Name="Создать новую заявку на билеты" />
                    <Button Margin="10,0,0,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Обновить"
                            AutomationProperties.Name="Обновить список заявок на билеты" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Баннер ошибки -->
        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="14,10"
                Background="{DynamicResource HubSurfaceBrush}"
                BorderBrush="{DynamicResource HubErrorTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasBannerError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HubErrorTextBrush}"
                           Text="{Binding BannerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Повторить"
                        AutomationProperties.Name="Повторить загрузку заявок на билеты" />
                <Button Grid.Column="2"
                        Style="{StaticResource HubGhostButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Content="✕"
                        AutomationProperties.Name="Скрыть ошибку" />
            </Grid>
        </Border>

        <!-- Список + карточка; режимы Канбан/Дашборд занимают всю область,
             карточка в канбане открывается поверх правой колонки -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Режим «Канбан»: доска колонок во всю ширину (лежит под карточкой-оверлеем) -->
            <Grid Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Visibility="{Binding IsKanbanMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,6"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource HubAccentBrush}"
                             Background="{DynamicResource HubSurfaceRaisedBrush}"
                             Visibility="{Binding IsKanbanLoading, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Индикатор загрузки канбан-доски заявок" />
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Канбан-доска заявок на билеты">
                    <ItemsControl ItemsSource="{Binding KanbanColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="264"
                                        Margin="0,0,10,0"
                                        Padding="8"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource HubSurfaceBrush}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}" />
                                            <Border Grid.Column="1"
                                                    Padding="8,2"
                                                    Style="{StaticResource HubStatusPillStyle}"
                                                    BorderBrush="{DynamicResource HubBorderBrush}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding CountText}" />
                                            </Border>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Cards}"
                                                          AutomationProperties.Name="{Binding Title, StringFormat='Колонка канбана: {0}'}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,0,8"
                                                                Padding="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                Style="{StaticResource HubGhostButtonStyle}"
                                                                Command="{Binding DataContext.SelectKanbanCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding Title, StringFormat='Открыть заявку {0}'}">
                                                            <Border Padding="10,8"
                                                                    Background="{DynamicResource HubSurfaceAltBrush}"
                                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding Title}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                               Text="{Binding ObjectText}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <WrapPanel Margin="0,6,0,0">
                                                                        <Border Margin="0,0,6,4"
                                                                                Style="{StaticResource HubStatusPillStyle}"
                                                                                local:HubTone.Value="{Binding StatusTone}">
                                                                            <TextBlock FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       Style="{StaticResource HubToneTextStyle}"
                                                                                       Text="{Binding StatusText}" />
                                                                        </Border>
                                                                        <Border Margin="0,0,0,4"
                                                                                Style="{StaticResource HubStatusPillStyle}"
                                                                                local:HubTone.Value="danger"
                                                                                Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       Style="{StaticResource HubToneTextStyle}"
                                                                                       Text="Срочно" />
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                               Text="{Binding RouteText}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                               Text="{Binding AssigneeText}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Режим «Дашборд»: метрики, разрез по объектам и топ-списки -->
            <ScrollViewer Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDashboardMode, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="Сводка по заявкам на билеты">
                <StackPanel Margin="0,4,0,0">
                    <ProgressBar Height="3"
                                 Margin="0,0,0,6"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsDashboardLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки сводки заявок" />
                    <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                               FontSize="15"
                               Text="Сводка" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource HubMutedTextStyle}"
                               FontSize="12"
                               Text="Данные обновляются при открытии раздела" />
                    <ItemsControl Margin="0,6,0,0"
                                  ItemsSource="{Binding DashboardMetrics}"
                                  AutomationProperties.Name="Метрики сводки заявок">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,8,4"
                                        Padding="12,8"
                                        Background="{DynamicResource HubSurfaceBrush}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding Label}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Value}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource HubSectionTitleStyle}"
                               FontSize="14"
                               Text="Объекты" />
                    <ItemsControl ItemsSource="{Binding DashboardObjects}"
                                  AutomationProperties.Name="Заявки по объектам">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6,10,0"
                                        Padding="12,10"
                                        Background="{DynamicResource HubSurfaceBrush}"
                                        BorderBrush="{DynamicResource HubBorderDimBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding CodeText}"
                                                           Visibility="{Binding CodeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="8,2"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource HubStatusPillStyle}"
                                                    BorderBrush="{DynamicResource HubBorderBrush}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding ActiveText}" />
                                            </Border>
                                        </Grid>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Margin="0,0,6,4"
                                                    Style="{StaticResource HubStatusPillStyle}"
                                                    BorderBrush="{DynamicResource HubBorderBrush}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding NewText}" />
                                            </Border>
                                            <Border Margin="0,0,6,4"
                                                    Style="{StaticResource HubStatusPillStyle}"
                                                    BorderBrush="{DynamicResource HubBorderBrush}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding InProgressText}" />
                                            </Border>
                                            <Border Margin="0,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource HubStatusPillStyle}">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource HubBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource HubWarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                           Text="{Binding ProblematicText}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Text="{Binding TicketSumText}" />
                                        <TextBlock FontSize="12"
                                                   Text="{Binding LossSumText}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding NearestDepartureText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource HubMutedTextStyle}"
                               Text="Нет активных объектов."
                               Visibility="{Binding HasDashboardObjects, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                       FontSize="14"
                                       Text="Топ проблем" />
                            <ItemsControl Margin="0,4,0,0"
                                          ItemsSource="{Binding DashboardTopProblems}"
                                          AutomationProperties.Name="Топ объектов по проблемным заявкам">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="12"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Padding="8,2"
                                                        Style="{StaticResource HubStatusPillStyle}"
                                                        BorderBrush="{DynamicResource HubWarningBrush}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource HubWarningBrush}"
                                                               Text="{Binding ValueText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Проблемных объектов нет."
                                       Visibility="{Binding HasDashboardTopProblems, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource HubSectionTitleStyle}"
                                       FontSize="14"
                                       Text="Нагрузка" />
                            <ItemsControl Margin="0,4,0,0"
                                          ItemsSource="{Binding DashboardTopAssignees}"
                                          AutomationProperties.Name="Нагрузка исполнителей по заявкам">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="12"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Padding="8,2"
                                                        Style="{StaticResource HubStatusPillStyle}"
                                                        BorderBrush="{DynamicResource HubBorderBrush}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                               Text="{Binding ValueText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource HubMutedTextStyle}"
                                       Text="Активных заявок у исполнителей нет."
                                       Visibility="{Binding HasDashboardTopAssignees, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="0"
                  Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,6"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource HubAccentBrush}"
                             Background="{DynamicResource HubSurfaceRaisedBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Индикатор загрузки заявок на билеты" />
                <Grid Grid.Row="1">
                    <ListBox Style="{StaticResource HubListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             AutomationProperties.Name="Список заявок на билеты">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="40" />
                                        <Border Grid.Column="1"
                                                Margin="10,1,0,0"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HubStatusPillStyle}"
                                                local:HubTone.Value="{Binding StatusTone}">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource HubToneTextStyle}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource HubMutedTextStyle}"
                                               FontSize="12"
                                               Text="{Binding RequestNumberText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding RouteText, Mode=OneWay}" />
                                            <Run Text="{Binding MetaText, Mode=OneWay, StringFormat=' · {0}'}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource HubToneTextStyle}"
                                                   local:HubTone.Value="danger"
                                                   Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="● " /><Run Text="Срочно" />
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Заявок нет" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Под текущий фильтр ничего не подходит. Измените статус, объект или поиск." />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="2"
                        Margin="0,8,0,0"
                        Style="{StaticResource HubSecondaryButtonStyle}"
                        Command="{Binding LoadMoreCommand}"
                        Content="{Binding MoreButtonText}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Показать следующую страницу заявок" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="Разделитель списка и карточки заявки"
                          AutomationProperties.HelpText="Стрелки влево и вправо изменяют ширину панелей" />

            <!-- Скрим канбан-оверлея: затемняет доску под карточкой,
                 клик по затемнённому фону закрывает карточку (как ✕). -->
            <Button Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Focusable="False"
                    Cursor="Arrow"
                    Command="{Binding CloseDetailCommand}"
                    Visibility="{Binding IsKanbanDetailOpen, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Закрыть карточку заявки">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#80000000" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Карточка заявки: в списке — всегда, в канбане — поверх доски при выборе -->
            <Border Grid.Column="2"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding ShowSidePanel, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Выберите заявку" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HubMutedTextStyle}"
                                   Text="Карточка слева откроет реквизиты, файлы, статусы и комментарии." />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource HubErrorTextBrush}"
                                   Text="{Binding DetailErrorText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>

                    <ProgressBar Width="160"
                                 Height="4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор загрузки карточки заявки" />

                    <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Padding="22,18"
                                      VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding Detail}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <Border Grid.Column="1"
                                            Margin="14,2,0,0"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            local:HubTone.Value="{Binding StatusTone}">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource HubToneTextStyle}"
                                                   Text="{Binding StatusText}" />
                                    </Border>
                                    <!-- В канбане карточка — оверлей поверх доски: нужен явный способ закрыть -->
                                    <Button Grid.Column="2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource HubGhostButtonStyle}"
                                            Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="✕"
                                            Visibility="{Binding DataContext.IsKanbanMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Закрыть карточку заявки" />
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Margin="0,0,8,6"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            BorderBrush="{DynamicResource HubBorderBrush}"
                                            Visibility="{Binding EmployeeText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding EmployeeText}" />
                                    </Border>
                                    <Border Margin="0,0,8,6"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            BorderBrush="{DynamicResource HubBorderBrush}"
                                            Visibility="{Binding ObjectText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding ObjectText}" />
                                    </Border>
                                    <Border Margin="0,0,8,6"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            BorderBrush="{DynamicResource HubWarningBrush}"
                                            Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HubWarningBrush}"
                                                   Text="Срочная" />
                                    </Border>
                                    <Border Margin="0,0,8,6"
                                            Style="{StaticResource HubStatusPillStyle}"
                                            BorderBrush="{DynamicResource HubWarningBrush}"
                                            Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubWarningBrush}"
                                                   Text="Требует проверки" />
                                    </Border>
                                </WrapPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetaLabelStyle}" Text="Сотрудник"
                                               Visibility="{Binding EmployeeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding EmployeeText}"
                                               Visibility="{Binding EmployeeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Объект"
                                               Visibility="{Binding ObjectText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding ObjectText}"
                                               Visibility="{Binding ObjectText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Прибытие / город"
                                               Visibility="{Binding RouteText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding RouteText}"
                                               Visibility="{Binding RouteText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Дата подачи"
                                               Visibility="{Binding SubmittedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding SubmittedText}"
                                               Visibility="{Binding SubmittedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Дата выезда"
                                               Visibility="{Binding DepartureText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding DepartureText}"
                                               Visibility="{Binding DepartureText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Исполнитель"
                                               Visibility="{Binding AssigneeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding AssigneeText}"
                                               Visibility="{Binding AssigneeText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Стоимость"
                                               Visibility="{Binding CostText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding CostText}"
                                               Visibility="{Binding CostText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Возврат"
                                               Visibility="{Binding RefundText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding RefundText}"
                                               Visibility="{Binding RefundText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Создана"
                                               Visibility="{Binding CreatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding CreatedText}"
                                               Visibility="{Binding CreatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource MetaLabelStyle}" Text="Обновлена"
                                               Visibility="{Binding UpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource MetaValueStyle}" Text="{Binding UpdatedText}"
                                               Visibility="{Binding UpdatedText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                </Grid>

                                <TextBlock Margin="0,18,0,6"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           FontSize="14"
                                           Text="Примечание"
                                           Visibility="{Binding NoteText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                           Text="{Binding NoteText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding NoteText, Converter={StaticResource NonEmptyStringToVisibility}}" />

                                <TextBlock Margin="0,18,0,6"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           FontSize="14"
                                           Text="Файлы"
                                           Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6"
                                                    Padding="8,3"
                                                    Style="{StaticResource HubGhostButtonStyle}"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsDownloadEnabled}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Скачать файл {0}'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="12" Text="📄 " />
                                                    <TextBlock FontSize="12" Text="{Binding DisplayText}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Смена статуса: допустимые переходы из клиентской карты -->
                                <TextBlock Margin="0,18,0,6"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           FontSize="14"
                                           Text="Сменить статус"
                                           Visibility="{Binding HasStatusActions, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Visibility="{Binding HasStatusActions, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="0,0,0,8">
                                        <TextBox x:Name="StatusCommentInput"
                                                 MinHeight="36"
                                                 MaxHeight="72"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding StatusComment, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Комментарий к смене статуса билета" />
                                        <TextBlock Margin="13,8,0,0"
                                                   VerticalAlignment="Top"
                                                   IsHitTestVisible="False"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="Комментарий к смене статуса (необязательно)…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=StatusCommentInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding StatusActions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,6"
                                                        Padding="10,4"
                                                        Style="{StaticResource HubSecondaryButtonStyle}"
                                                        Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.Detail.CanChangeStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Content="{Binding Label}"
                                                        AutomationProperties.Name="{Binding Label, StringFormat='Сменить статус заявки на: {0}'}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Лента комментариев -->
                                <TextBlock Margin="0,18,0,6"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           FontSize="14"
                                           Text="Комментарии" />
                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10,8"
                                                    Background="{DynamicResource HubSurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                                               FontSize="11"
                                                               Text="{Binding MetaText}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="13"
                                                               Text="{Binding Text}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                           Text="Комментариев пока нет."
                                           Visibility="{Binding HasComments, Converter={StaticResource InverseBoolToVisibility}}" />

                                <!-- Лента истории изменений: новые записи первыми -->
                                <TextBlock Margin="0,18,0,6"
                                           Style="{StaticResource HubSectionTitleStyle}"
                                           FontSize="14"
                                           Text="История" />
                                <ItemsControl ItemsSource="{Binding HistoryEntries}"
                                              AutomationProperties.Name="Лента истории изменений заявки">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10,8"
                                                    Background="{DynamicResource HubSurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                                               FontSize="11"
                                                               Text="{Binding MetaText}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="13"
                                                               Text="{Binding ChangeText}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource HubMutedTextStyle}"
                                                               FontSize="12"
                                                               Text="{Binding CommentText}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding CommentText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource HubMutedTextStyle}"
                                           Text="Изменений пока нет."
                                           Visibility="{Binding ShowHistoryEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource HubErrorTextBrush}"
                                           Text="Историю загрузить не удалось."
                                           Visibility="{Binding HistoryFailed, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource HubSecondaryButtonStyle}"
                                        Command="{Binding DataContext.LoadMoreHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        IsEnabled="{Binding CanLoadMoreHistory}"
                                        Content="{Binding HistoryMoreText}"
                                        Visibility="{Binding HasMoreHistory, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Показать ещё записей истории заявки" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Нижняя панель: ошибка карточки + ввод комментария -->
                        <Border Grid.Row="1"
                                Padding="22,14"
                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                BorderThickness="0,1,0,0"
                                DataContext="{Binding Detail}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8"
                                           Foreground="{DynamicResource HubErrorTextBrush}"
                                           Text="{Binding DataContext.DetailErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding DataContext.HasDetailError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="CommentInput"
                                                 MinHeight="40"
                                                 MaxHeight="96"
                                                 Style="{StaticResource HubTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="CommentInput_KeyDown"
                                                 AutomationProperties.Name="Новый комментарий к заявке" />
                                        <TextBlock Margin="13,10,0,0"
                                                   VerticalAlignment="Top"
                                                   IsHitTestVisible="False"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="Комментарий…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=CommentInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource HubPrimaryButtonStyle}"
                                            Command="{Binding DataContext.SendCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="Отправить"
                                            AutomationProperties.Name="Отправить комментарий к заявке" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Форма создания заявки: поверх карточки, как композер у почты -->
            <Border Grid.Column="2"
                    Panel.ZIndex="1"
                    Background="{DynamicResource HubSurfaceBrush}"
                    BorderBrush="{DynamicResource HubBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsCreateOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding Create}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Новая заявка" />
                        <Button Grid.Column="1"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Content="✕"
                                AutomationProperties.Name="Закрыть форму создания заявки" />
                    </Grid>

                    <!-- Ошибка создания/валидации: поля не стираются -->
                    <Border Grid.Row="1"
                            Margin="18,10,18,0"
                            Padding="12,8"
                            Background="{DynamicResource HubSurfaceAltBrush}"
                            BorderBrush="{DynamicResource HubErrorTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{DynamicResource HubErrorTextBrush}"
                                   FontSize="12"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 Margin="18,8,18,0"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource HubAccentBrush}"
                                 Background="{DynamicResource HubSurfaceRaisedBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Индикатор создания заявки" />

                    <ScrollViewer Grid.Row="3"
                                  Margin="18,10,18,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Сотрудник: серверный поиск справочник билетов + ЗУП -->
                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Сотрудник *" />
                            <Grid>
                                <TextBox x:Name="CreateEmployeeInput"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         Text="{Binding EmployeeQuery, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Поиск сотрудника для заявки" />
                                <TextBlock Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="13"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="ФИО из ЗУП или справочника билетов…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CreateEmployeeInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Margin="0,6,0,0"
                                             Width="90"
                                             Height="3"
                                             IsIndeterminate="True"
                                             Foreground="{DynamicResource HubAccentBrush}"
                                             Background="{DynamicResource HubSurfaceRaisedBrush}"
                                             Visibility="{Binding IsEmployeeSearchBusy, Converter={StaticResource BoolToVisibility}}"
                                             AutomationProperties.Name="Индикатор поиска сотрудника" />
                            </StackPanel>
                            <!-- Выбранный сотрудник: local готов, ЗУП импортируется при создании -->
                            <Border Margin="0,6,0,0"
                                    Padding="8,5"
                                    Background="{DynamicResource HubSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource HubAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasSelectedEmployee, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedEmployee.Title}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                   Text="{Binding SelectedEmployee.MetaText}"
                                                   Visibility="{Binding SelectedEmployee.MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource HubGhostButtonStyle}"
                                            Command="{Binding ClearEmployeeCommand}"
                                            Content="✕"
                                            AutomationProperties.Name="Сбросить выбранного сотрудника" />
                                </Grid>
                            </Border>
                            <Popup IsOpen="{Binding IsEmployeePopupOpen, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=CreateEmployeeInput}"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border MinWidth="340"
                                        MaxWidth="480"
                                        Padding="4"
                                        Background="{DynamicResource HubSurfaceBrush}"
                                        BorderBrush="{DynamicResource HubBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ListBox Style="{StaticResource HubListBoxStyle}"
                                             ItemsSource="{Binding EmployeeOptions}"
                                             MaxHeight="240"
                                             AutomationProperties.Name="Варианты сотрудника для заявки">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch"
                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                        Command="{Binding DataContext.SelectEmployeeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Выбрать сотрудника {0}'}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource HubTextSecondaryBrush}"
                                                                   Text="{Binding MetaText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding MetaText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>

                            <!-- Объект выезда -->
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Объект *" />
                            <ComboBox ItemsSource="{Binding Objects}"
                                      SelectedItem="{Binding SelectedObject}"
                                      DisplayMemberPath="DisplayName"
                                      Background="{DynamicResource HubSurfaceAltBrush}"
                                      Foreground="{DynamicResource HubTextBrush}"
                                      AutomationProperties.Name="Объект выезда для заявки" />

                            <!-- Даты выезда/возвращения -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Дата выезда" />
                                    <DatePicker SelectedDate="{Binding DepartureDate, Mode=TwoWay}"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                Foreground="{DynamicResource HubTextBrush}"
                                                AutomationProperties.Name="Дата выезда для заявки" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource MetaLabelStyle}" Text="Дата возвращения" />
                                    <DatePicker SelectedDate="{Binding ArrivalDate, Mode=TwoWay}"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                Foreground="{DynamicResource HubTextBrush}"
                                                AutomationProperties.Name="Дата возвращения для заявки" />
                                </StackPanel>
                            </Grid>

                            <!-- Маршрут -->
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Маршрут / город вылета" />
                            <Grid>
                                <TextBox x:Name="CreateRouteInput"
                                         Style="{StaticResource HubTextBoxStyle}"
                                         MaxLength="500"
                                         Text="{Binding RouteText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Маршрут заявки" />
                                <TextBlock Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="13"
                                           Foreground="{DynamicResource HubTextSecondaryBrush}"
                                           Text="Например: Сургут">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CreateRouteInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <CheckBox Margin="0,12,0,0"
                                      VerticalContentAlignment="Center"
                                      Foreground="{DynamicResource HubTextBrush}"
                                      IsChecked="{Binding IsUrgent, Mode=TwoWay}"
                                      Content="Срочная заявка"
                                      AutomationProperties.Name="Отметка срочной заявки" />

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Text="Комментарий" />
                            <TextBox MinHeight="64"
                                     Style="{StaticResource HubTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Комментарий к заявке" />

                            <!-- Файлы: загружаются на сервер после создания заявки -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource MetaLabelStyle}"
                                           Text="Файлы" />
                                <Button Grid.Column="1"
                                        Padding="8,2"
                                        Style="{StaticResource HubGhostButtonStyle}"
                                        Command="{Binding AttachCommand}"
                                        Content="📎 Прикрепить"
                                        AutomationProperties.Name="Прикрепить файл к заявке" />
                            </Grid>
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Files}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,4"
                                                Padding="8,3"
                                                Background="{DynamicResource HubSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource HubBorderDimBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" Text="📎 " />
                                                <TextBlock FontSize="12" Text="{Binding DisplayText}" />
                                                <Button Margin="8,0,0,0"
                                                        Padding="2,0"
                                                        Style="{StaticResource HubGhostButtonStyle}"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Убрать файл {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Действия формы -->
                    <StackPanel Grid.Row="4"
                                Margin="18,10,18,14"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource HubPrimaryButtonStyle}"
                                Command="{Binding CreateCommand}"
                                Content="{Binding CreateButtonText}"
                                AutomationProperties.Name="Создать заявку на билеты" />
                        <Button Margin="10,0,0,0"
                                Style="{StaticResource HubGhostButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Content="Отмена"
                                AutomationProperties.Name="Отменить создание заявки" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус-бар -->
        <Border Grid.Row="3"
                Padding="20,8"
                Background="{DynamicResource HubSurfaceAltBrush}"
                BorderBrush="{DynamicResource HubBorderDimBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource HubTextSecondaryBrush}">
                        <Run Text="Заявок:" />
                        <Run Text="{Binding TotalText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="14,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource HubTextSecondaryBrush}"
                               Text="{Binding LastUpdatedText}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding HasStatusInfo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource HubSuccessBrush}"
                               Text="{Binding StatusInfoText}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Margin="8,0,0,0"
                            Padding="4,0"
                            Style="{StaticResource HubGhostButtonStyle}"
                            Command="{Binding DismissStatusCommand}"
                            Content="✕"
                            AutomationProperties.Name="Скрыть статусное сообщение" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
