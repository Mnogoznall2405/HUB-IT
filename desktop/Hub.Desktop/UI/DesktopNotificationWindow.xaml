<Window x:Class="Hub.Desktop.UI.DesktopNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUB Desktop notification"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="NotificationSurfaceBrush" Color="#171B22" />
        <SolidColorBrush x:Key="NotificationBorderBrush" Color="#303640" />
        <SolidColorBrush x:Key="NotificationTitleBrush" Color="#F3F2F1" />
        <SolidColorBrush x:Key="NotificationBodyBrush" Color="#C8C6C4" />
        <SolidColorBrush x:Key="NotificationMutedBrush" Color="#A19F9D" />
        <SolidColorBrush x:Key="NotificationHoverBrush" Color="#252A31" />

        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NotificationMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource NotificationHoverBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource NotificationTitleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="NotificationSurface"
            Margin="10"
            Padding="16,14"
            Background="{DynamicResource NotificationSurfaceBrush}"
            BorderBrush="{DynamicResource NotificationBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Cursor="Hand"
            MouseLeftButtonUp="NotificationSurface_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              Direction="270"
                              Opacity="0.32"
                              ShadowDepth="5"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>

            <Border Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="#0F6CBD"
                    CornerRadius="8">
                <Image Width="20"
                       Height="20"
                       Source="/Assets/hub-icon.png"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                <TextBlock Text="HUB Desktop"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="{DynamicResource NotificationMutedBrush}" />
                <TextBlock x:Name="NotificationTitle"
                           Margin="0,3,0,0"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource NotificationTitleBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NotificationBody"
                           Margin="0,5,0,0"
                           MaxHeight="44"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource NotificationBodyBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource NotificationCloseButtonStyle}"
                    Click="DismissButton_Click"
                    ToolTip="Закрыть уведомление"
                    AutomationProperties.Name="Закрыть уведомление">
                <Path Width="10"
                      Height="10"
                      Data="M 1,1 L 9,9 M 9,1 L 1,9"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4"
                      Stretch="None" />
            </Button>
        </Grid>
    </Border>
</Window>
