<Window x:Class="Hub.Desktop.UI.DesktopNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUB Desktop notification"
        Width="324"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="NotificationSurfaceBrush" Color="#171B22" />
        <SolidColorBrush x:Key="NotificationBorderBrush" Color="#303640" />
        <SolidColorBrush x:Key="NotificationTitleBrush" Color="#F3F2F1" />
        <SolidColorBrush x:Key="NotificationBodyBrush" Color="#C8C6C4" />
        <SolidColorBrush x:Key="NotificationMutedBrush" Color="#A19F9D" />
        <SolidColorBrush x:Key="NotificationHoverBrush" Color="#252A31" />
        <SolidColorBrush x:Key="NotificationAccentBrush" Color="#4CC2FF" />
        <SolidColorBrush x:Key="NotificationActionHoverBrush" Color="#1C3444" />

        <Style x:Key="NotificationActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotificationAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource NotificationAccentBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource NotificationActionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NotificationMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource NotificationHoverBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource NotificationTitleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="NotificationSurface"
            Margin="8"
            Padding="12,10"
            Background="{DynamicResource NotificationSurfaceBrush}"
            BorderBrush="{DynamicResource NotificationBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Cursor="Hand"
            AutomationProperties.LiveSetting="Polite"
            MouseEnter="NotificationSurface_MouseEnter"
            MouseLeave="NotificationSurface_MouseLeave"
            MouseRightButtonUp="NotificationSurface_MouseRightButtonUp"
            MouseLeftButtonUp="NotificationSurface_MouseLeftButtonUp">
        <Border.RenderTransform>
            <TranslateTransform x:Name="NotificationSurfaceTranslate" X="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.3"
                              ShadowDepth="4"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>

            <Border Width="28"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="#0F6CBD"
                    CornerRadius="7">
                <Image Width="17"
                       Height="17"
                       Source="/Assets/hub-icon.png"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="9,0,8,0">
                <TextBlock Text="HUB"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Foreground="{DynamicResource NotificationMutedBrush}" />
                <TextBlock x:Name="NotificationTitle"
                           Margin="0,2,0,0"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource NotificationTitleBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NotificationBody"
                           Margin="0,3,0,0"
                           MaxHeight="36"
                           FontFamily="Segoe UI"
                           FontSize="12.5"
                           LineHeight="17"
                           Foreground="{DynamicResource NotificationBodyBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
                <Button x:Name="PrimaryActionButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource NotificationActionButtonStyle}"
                        Click="PrimaryActionButton_Click" />
            </StackPanel>

            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource NotificationCloseButtonStyle}"
                    Click="DismissButton_Click"
                    ToolTip="Закрыть уведомление"
                    AutomationProperties.Name="Закрыть уведомление">
                <Path Width="9"
                      Height="9"
                      Data="M 1,1 L 8,8 M 8,1 L 1,8"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.3"
                      Stretch="None" />
            </Button>
        </Grid>
    </Border>
</Window>
