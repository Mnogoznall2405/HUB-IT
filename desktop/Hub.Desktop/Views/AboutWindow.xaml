<Window x:Class="Hub.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="О программе и обновления — HUB Desktop"
        Icon="../Assets/hub-icon.ico"
        Width="660"
        Height="700"
        MinWidth="540"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F1115"
        Foreground="#F3F2F1"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="О программе и обновления HUB Desktop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A9B1BB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#0369A1" />
        <SolidColorBrush x:Key="FocusBrush" Color="#7DD3FC" />

        <Style x:Key="KeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2"
                                BorderBrush="{StaticResource FocusBrush}"
                                BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{StaticResource AccentPressedBrush}" />
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="RuntimeLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,16,11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RuntimeValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F2F1" />
            <Setter Property="Margin" Value="0,0,0,11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TitleCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3F2F1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#A4262C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#11151B"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Width="20"
                               Height="20"
                               Margin="0,0,9,0"
                               Source="../Assets/hub-icon.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="Логотип HUB" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="HUB Desktop" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource TitleCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="✕"
                            AutomationProperties.Name="Закрыть окно" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="28,24,28,28"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                    <TextBlock FontSize="25"
                               FontWeight="SemiBold"
                               Text="О программе и обновления" />
                    <TextBlock Margin="0,6,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Состояние локального клиента HUB и безопасных обновлений."
                               TextWrapping="Wrap" />

                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,15"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Среда выполнения" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource RuntimeLabelStyle}" Text="Версия HUB Desktop" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="{Binding InstalledVersion}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource RuntimeLabelStyle}" Text="WebView2 Runtime" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="{Binding WebView2Version}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource RuntimeLabelStyle}" Text="Windows App SDK" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="{Binding WindowsAppSdkStatus}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource RuntimeLabelStyle}" Text="Уведомления" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="{Binding NotificationMode}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource RuntimeLabelStyle}" Text="Автозапуск" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="{Binding AutostartStatus}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Обновления" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,10,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding UpdateStatus}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding UpdateStatus}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="Последняя успешная проверка: " />
                                <Run Text="{Binding LastSuccessfulCheck, Mode=OneWay}" />
                            </TextBlock>
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="CheckForUpdatesButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding CanCheckForUpdates, Mode=OneWay}"
                                        Click="CheckForUpdatesButton_Click"
                                        Content="{Binding CheckActionText, Mode=OneWay}"
                                        AutomationProperties.Name="Проверить обновления HUB Desktop"
                                        AutomationProperties.HelpText="Проверить stable-канал и показать результат в этом окне" />
                                <Button x:Name="InstallUpdateButton"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="InstallUpdateButton_Click"
                                        Content="Перезапустить и обновить"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Перезапустить HUB Desktop и установить обновление"
                                        AutomationProperties.HelpText="HUB закроется только после выбора этой команды" />
                                <Button x:Name="DeferUpdateButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="DeferUpdateButton_Click"
                                        Content="Позже"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Отложить обновление HUB Desktop" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Что нового" />
                            <TextBlock x:Name="EmptyReleaseNotesText"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Для установленной версии примечаний пока нет. Проверьте обновления, чтобы загрузить их."
                                       TextWrapping="Wrap" />
                            <ItemsControl x:Name="ReleaseNotesList"
                                          Margin="0,8,0,0"
                                          ItemsSource="{Binding ReleaseNotes}"
                                          AutomationProperties.Name="Примечания к обновлению">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                            <Run Text="•  " />
                                            <Run Text="{Binding Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            AutomationProperties.Name="Сочетания клавиш HUB Desktop">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Сочетания клавиш" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource RuntimeValueStyle}" FontWeight="SemiBold" Text="Ctrl+K" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="Быстрый переход" />
                                <TextBlock Grid.Row="1" Style="{StaticResource RuntimeValueStyle}" FontWeight="SemiBold" Text="Ctrl+P" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="Печать текущей страницы" />
                                <TextBlock Grid.Row="2" Style="{StaticResource RuntimeValueStyle}" FontWeight="SemiBold" Text="Ctrl+F5" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="Обновить портал без кэша" />
                                <TextBlock Grid.Row="3" Style="{StaticResource RuntimeValueStyle}" FontWeight="SemiBold" Text="Ctrl+Shift+H" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="Показать или скрыть HUB, если включено в настройках" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Style="{StaticResource RuntimeValueStyle}" FontWeight="SemiBold" Text="Esc" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource RuntimeValueStyle}" Text="Закрыть вспомогательное окно" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="CloseWindowButton"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"
                            Content="Закрыть"
                            AutomationProperties.Name="Закрыть окно о программе и обновления" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
