<Window x:Class="Hub.Desktop.Views.DesktopSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Настройки — HUB Desktop"
        Icon="../Assets/hub-icon.ico"
        Width="620"
        Height="650"
        MinWidth="520"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F1115"
        Foreground="#F3F2F1"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Настройки HUB Desktop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B6BEC8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="FocusBrush" Color="#7DD3FC" />

        <Style x:Key="KeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2" BorderBrush="{StaticResource FocusBrush}" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="#F3F2F1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Setter Property="Foreground" Value="#F3F2F1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="TitleCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3F2F1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#11151B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Width="20" Height="20" Margin="0,0,9,0" Source="../Assets/hub-icon.png" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="HUB Desktop" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource TitleCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CancelButton_Click"
                            Content="✕"
                            AutomationProperties.Name="Закрыть настройки без сохранения" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="26,22,26,10" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="25" FontWeight="SemiBold" Text="Настройки Desktop" />
                    <TextBlock Margin="0,6,0,20" Foreground="{StaticResource MutedTextBrush}" Text="Поведение оболочки Windows. Настройки портала и учётной записи остаются внутри HUB." TextWrapping="Wrap" />

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="При входе в Windows" />
                            <RadioButton x:Name="LaunchHiddenRadio" GroupName="LaunchVisibility" Content="Запускать скрытым в области уведомлений" AutomationProperties.Name="При входе в Windows запускать HUB скрытым" />
                            <RadioButton x:Name="LaunchOpenRadio" GroupName="LaunchVisibility" Content="Открывать главное окно" AutomationProperties.Name="При входе в Windows открывать главное окно HUB" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Стартовая страница" />
                            <RadioButton x:Name="StartHomeRadio" GroupName="StartupPage" Content="Главная" />
                            <RadioButton x:Name="StartLastRadio" GroupName="StartupPage" Content="Последняя безопасная страница" />
                            <TextBlock Margin="22,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Страницы входа, общие ссылки и адреса с токенами не сохраняются." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Окно и клавиатура" />
                            <CheckBox x:Name="AskOnCloseCheck" Content="Один раз спросить перед первым сворачиванием по кнопке X" />
                            <CheckBox x:Name="GlobalHotkeyCheck" Content="Ctrl+Shift+H — показать или скрыть HUB" AutomationProperties.HelpText="Глобальная комбинация включается только если не занята другой программой" />
                            <TextBlock Margin="22,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Если комбинация занята другой программой, настройка не сохранится." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ValidationText"
                               Margin="0,0,0,8"
                               Foreground="#FF99A4"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="26,14" Background="#11151B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Content="Отмена" />
                    <Button x:Name="SaveButton" Style="{StaticResource ActionButtonStyle}" Click="SaveButton_Click" Content="Сохранить" AutomationProperties.Name="Сохранить настройки HUB Desktop" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
