<Window x:Class="Hub.Desktop.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Диагностика — HUB Desktop"
        Icon="../Assets/hub-icon.ico"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F1115"
        Foreground="#F3F2F1"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Диагностика HUB Desktop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A9B1BB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="FocusBrush" Color="#7DD3FC" />

        <Style x:Key="KeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2"
                                BorderBrush="{StaticResource FocusBrush}"
                                BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="TitleCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3F2F1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#A4262C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#11151B"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Width="20"
                               Height="20"
                               Margin="0,0,9,0"
                               Source="../Assets/hub-icon.png"
                               AutomationProperties.Name="Логотип HUB" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="HUB Desktop" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource TitleCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="✕"
                            AutomationProperties.Name="Закрыть окно" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="28,24,28,28"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="25"
                               FontWeight="SemiBold"
                               Text="Диагностика" />
                    <TextBlock Margin="0,6,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Локальные сведения о клиенте. Содержимое портала и профиль входа не читаются."
                               TextWrapping="Wrap" />

                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ItemsControl ItemsSource="{Binding Items}"
                                      AutomationProperties.Name="Сведения диагностики">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,16,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding Label}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border x:Name="RenderingWarningPanel"
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#362A16"
                            BorderBrush="#8A6D1D"
                            BorderThickness="1"
                            CornerRadius="7"
                            AutomationProperties.LiveSetting="Polite">
                        <TextBlock Text="{Binding RenderingWarning}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding RenderingWarning}" />
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Архив для поддержки" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="В архив попадут только очищенные логи, diagnostics.json и локальные self-checks. Cookies, токены, профиль WebView2, письма, сообщения и документы не включаются."
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="ExportButton"
                                        Margin="0,0,10,8"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="ExportButton_Click"
                                        Content="Создать архив для поддержки"
                                        AutomationProperties.Name="Создать очищенный архив для поддержки" />
                                <Button x:Name="OpenLogsButton"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OpenLogsButton_Click"
                                        Content="Открыть папку логов"
                                        AutomationProperties.Name="Открыть локальную папку логов HUB Desktop" />
                            </WrapPanel>
                            <TextBlock x:Name="ExportStatusText"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <Button Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"
                            Content="Закрыть"
                            AutomationProperties.Name="Закрыть окно диагностики" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
