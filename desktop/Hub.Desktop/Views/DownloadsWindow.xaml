<Window x:Class="Hub.Desktop.Views.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Загрузки — HUB Desktop"
        Icon="../Assets/hub-icon.ico"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Загрузки HUB Desktop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1115" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#11151B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F2F1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A9B1BB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="FocusBrush" Color="#7DD3FC" />

        <Style x:Key="KeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2"
                                BorderBrush="{DynamicResource FocusBrush}"
                                BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#A4262C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Width="20"
                               Height="20"
                               Margin="0,0,9,0"
                               Source="../Assets/hub-icon.png"
                               Stretch="Uniform"
                               AutomationProperties.Name="Логотип HUB" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Загрузки" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource TitleCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="✕"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть окно загрузок" />
                </Grid>
            </Border>

            <Border x:Name="ActionMessagePanel"
                    Grid.Row="1"
                    Margin="18,16,18,0"
                    Padding="12,9"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <TextBlock x:Name="ActionMessageText"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="18,12,18,0"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="Открыть папку загрузок"
                        Click="OpenDownloadsFolderButton_Click"
                        AutomationProperties.Name="Открыть папку загрузок Windows" />
                <Button Style="{StaticResource ActionButtonStyle}"
                        Content="Очистить завершённые"
                        Click="ClearFinishedButton_Click"
                        AutomationProperties.Name="Очистить завершённые загрузки из списка без удаления файлов" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="18">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="430"
                           Text="Загрузки этой сессии появятся здесь. История не сохраняется после выхода из HUB Desktop."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Список загрузок">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}" />
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                            <ProgressBar Height="6"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent}"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         AutomationProperties.Name="{Binding StatusText}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <DockPanel Margin="0,7,0,0" LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Margin="12,0,0,0"
                                                           Text="{Binding SourceWindowLabel}"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"
                                                    Margin="0,12,0,0"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Content="Отменить"
                                                    Tag="{Binding Id}"
                                                    Click="CancelButton_Click"
                                                    AutomationProperties.Name="{Binding FileName, StringFormat=Отменить загрузку {0}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Margin="0,0,8,0"
                                                    Content="Открыть"
                                                    Tag="{Binding Id}"
                                                    Click="OpenButton_Click"
                                                    AutomationProperties.Name="{Binding FileName, StringFormat=Открыть {0}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanOpen}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Показать в папке"
                                                    Tag="{Binding Id}"
                                                    Click="RevealButton_Click"
                                                    AutomationProperties.Name="{Binding FileName, StringFormat=Показать {0} в папке}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanReveal}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
