<Window x:Class="Hub.Desktop.Views.MailComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUB Desktop — новое письмо"
        Width="1200"
        Height="850"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/hub-icon.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid x:Name="BrowserHost" Background="#F8FAFC">
        <TextBlock x:Name="LoadingText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="15"
                   Foreground="#64748B"
                   Text="Открываем редактор письма…" />
    </Grid>
</Window>
