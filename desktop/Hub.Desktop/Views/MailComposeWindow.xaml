<Window x:Class="Hub.Desktop.Views.MailComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUB Desktop — новое письмо"
        Width="1200"
        Height="850"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/hub-icon.ico"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid x:Name="BrowserHost" Background="#F8FAFC">
        <Border x:Name="LoadingPanel"
                Panel.ZIndex="1"
                Background="#F8FAFC">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           Foreground="#475569"
                           Text="Открываем редактор письма…"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RetryButton"
                        Margin="0,18,0,0"
                        MinWidth="120"
                        MinHeight="40"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Content="Повторить"
                        Visibility="Collapsed"
                        Click="RetryButton_Click"
                        AutomationProperties.Name="Повторно открыть редактор письма" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
