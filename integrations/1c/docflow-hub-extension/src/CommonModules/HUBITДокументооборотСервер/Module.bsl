Функция ЗаписатьСогласование(Задача, РезультатСогласования) Экспорт

	Если ТипЗнч(Задача) = Тип("ЗадачаОбъект.ЗадачаИсполнителя") Тогда
		СсылкаЗадачи = Задача.Ссылка;
	ИначеЕсли ТипЗнч(Задача) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		СсылкаЗадачи = Задача;
	Иначе
		ВызватьИсключение "Передан неверный тип задания";
	КонецЕсли;

	Если РезультатСогласования <> Перечисления.РезультатыСогласования.Согласовано Тогда
		ВызватьИсключение "Результат согласования не разрешён";
	КонецЕсли;

	ЗадачаОбъект = СсылкаЗадачи.ПолучитьОбъект();
	Если ЗадачаОбъект.Выполнена Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ЗадачаОбъект.БизнесПроцесс) <> Тип("БизнесПроцессСсылка.Согласование") Тогда
		ВызватьИсключение "Задание не относится к процессу согласования";
	КонецЕсли;

	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если ЗадачаОбъект.Исполнитель <> ТекущийПользователь Тогда
		ВызватьИсключение "Задание не назначено текущему пользователю";
	КонецЕсли;

	Если РаботаСБизнесПроцессамиВызовСервера.ЕстьАктивныеПодзадачи(СсылкаЗадачи) Тогда
		ВызватьИсключение "У задания есть активные подзадачи";
	КонецЕсли;

	СсылкаПроцесса = ЗадачаОбъект.БизнесПроцесс;
	НачатьТранзакцию();
	ПривилегированныйРежим = Ложь;

	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("БизнесПроцесс.Согласование");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Ссылка", СсылкаПроцесса);
		Блокировка.Заблокировать();

		ЗадачаОбъект = СсылкаЗадачи.ПолучитьОбъект();
		Если ЗадачаОбъект.Выполнена Тогда
			ОтменитьТранзакцию();
			Возврат Истина;
		КонецЕсли;

		Если ЗадачаОбъект.Исполнитель <> ТекущийПользователь
			Или ЗадачаОбъект.БизнесПроцесс <> СсылкаПроцесса Тогда
			ВызватьИсключение "Состояние задания изменилось";
		КонецЕсли;

		УстановитьПривилегированныйРежим(Истина);
		ПривилегированныйРежим = Истина;

		ПроцессОбъект = СсылкаПроцесса.ПолучитьОбъект();
		ПроцессОбъект.ДополнительныеСвойства.Вставить("ТекущаяЗадача", СсылкаЗадачи);
		ПроцессОбъект.ДополнительныеСвойства.Вставить("РезультатСогласования", РезультатСогласования);
		РаботаСБизнесПроцессами.ЗаписатьПроцесс(ПроцессОбъект, "ЗаписьСОбработкойВыполненияЗадачи");

		УстановитьПривилегированныйРежим(Ложь);
		ПривилегированныйРежим = Ложь;
		ЗафиксироватьТранзакцию();

	Исключение
		Если ПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗадачаОбъект = СсылкаЗадачи.ПолучитьОбъект();
	Если Не ЗадачаОбъект.Выполнена Тогда
		ВызватьИсключение "1С не подтвердила выполнение задания";
	КонецЕсли;

	Возврат Истина;

КонецФункции
