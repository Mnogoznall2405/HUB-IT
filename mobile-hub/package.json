{
  "name": "mobile-hub",
  "version": "1.1.17",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "start:clear": "expo start -c",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --coverage=false",
    "assets:icons": "python scripts/generate-assets.py",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk:local": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Local -Variant preview",
    "build:apk:local:compat": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Local -Variant preview -AllowDebugSigning",
    "build:apk:local:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Local -Variant debug",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1 -Eas",
    "benchmark:apk": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-apk.ps1",
    "smoke:device": "powershell -ExecutionPolicy Bypass -File scripts/device-smoke.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "^1.8.0",
    "@react-navigation/native": "^7.0.14",
    "axios": "^1.19.0",
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.13",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.14",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.13",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-paper": "^5.13.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ]
  }
}
