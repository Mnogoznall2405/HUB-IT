ARG OPENCODE_IMAGE=ghcr.io/anomalyco/opencode@sha256:d99f6cb95094eb9934ead4b600242e950ae6681d20c5a5f131a1c0a62208517f
# CPython 3.12 toolchain (apk on current Alpine no longer ships 3.12).
ARG CPYTHON_IMAGE=docker.io/library/python@sha256:aed27d7387bcf51a8f43b4a5b998857591c7933caa405920267ad42fb609a6d5
FROM ${CPYTHON_IMAGE} AS cpython

FROM ${OPENCODE_IMAGE}

ARG OPENCODE_VERSION=1.18.18

USER root

# Keep the reviewed OpenCode base immutable; bring CPython 3.12 from a pinned
# official image because Alpine apk now resolves python3 to 3.14.
COPY --from=cpython /usr/local /usr/local
ENV PATH="/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN set -eu; \
    if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bash git ripgrep ca-certificates; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends bash git ripgrep ca-certificates; \
      rm -rf /var/lib/apt/lists/*; \
    else \
      echo 'Unsupported reviewed base image' >&2; exit 1; \
    fi; \
    opencode --version | grep -F "${OPENCODE_VERSION}" >/dev/null; \
    python3 -c 'import sys; assert sys.version_info[:2] == (3, 12), sys.version'; \
    python3 -m pip --version >/dev/null

COPY requirements.lock /tmp/requirements.lock
RUN python3 -m pip install --no-cache-dir --disable-pip-version-check --break-system-packages -r /tmp/requirements.lock; \
    rm -f /tmp/requirements.lock /usr/local/bin/pip /usr/local/bin/pip3 /usr/bin/pip /usr/bin/pip3 \
      /usr/local/bin/easy_install /usr/bin/easy_install; \
    find /usr /usr/local -type d \( \
      -path '*/python3.12/ensurepip' -o \
      -path '*/python3.12/site-packages/pip' -o \
      -path '*/python3.12/site-packages/pip-*.dist-info' -o \
      -path '*/python3.12/site-packages/setuptools' -o \
      -path '*/python3.12/site-packages/setuptools-*.dist-info' -o \
      -path '*/python3.12/site-packages/wheel' -o \
      -path '*/python3.12/site-packages/wheel-*.dist-info' \
    \) -prune -exec rm -rf '{}' '+' 2>/dev/null || true; \
    python3 -c 'import importlib.util; assert importlib.util.find_spec("pip") is None; assert importlib.util.find_spec("setuptools") is None; assert importlib.util.find_spec("wheel") is None'; \
    if python3 -m pip --version >/dev/null 2>&1; then echo 'pip runtime remains available' >&2; exit 1; fi

COPY opencode.json /etc/opencode/opencode.json
RUN chmod 0444 /etc/opencode/opencode.json; \
    if command -v addgroup >/dev/null 2>&1 && command -v adduser >/dev/null 2>&1; then \
      addgroup -g 10001 -S sandbox 2>/dev/null || true; \
      adduser -u 10001 -S -D -H -G sandbox sandbox 2>/dev/null || true; \
    elif command -v groupadd >/dev/null 2>&1; then \
      groupadd --gid 10001 sandbox 2>/dev/null || true; \
      useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sandbox 2>/dev/null || true; \
    fi; \
    test "$(id -u sandbox)" = '10001'

USER 10001:10001
WORKDIR /workspace
ENV HOME=/tmp/home \
    TMPDIR=/tmp \
    OPENCODE_CONFIG=/etc/opencode/opencode.json

ENTRYPOINT ["opencode"]
CMD ["serve", "--hostname", "0.0.0.0", "--port", "4096"]
