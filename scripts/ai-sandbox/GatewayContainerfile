ARG GATEWAY_BASE_IMAGE=ghcr.io/anomalyco/opencode@sha256:d99f6cb95094eb9934ead4b600242e950ae6681d20c5a5f131a1c0a62208517f
FROM ${GATEWAY_BASE_IMAGE}

USER root

# Reuse the already-reviewed immutable linux/amd64 base, but install only the
# exact Python runtime needed by the trusted HUB gateway. OpenCode itself is
# never invoked by this image.
RUN set -eu; \
    if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache python3 py3-pip ca-certificates; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-pip ca-certificates; \
      rm -rf /var/lib/apt/lists/*; \
    else \
      echo 'Unsupported reviewed gateway base image' >&2; exit 1; \
    fi; \
    python3 -c 'import sys; assert sys.version_info[:2] == (3, 12), sys.version'

COPY scripts/ai-sandbox/gateway-requirements.lock /tmp/gateway-requirements.lock
RUN python3 -m pip install --no-cache-dir --disable-pip-version-check --break-system-packages \
      -r /tmp/gateway-requirements.lock; \
    rm -f /tmp/gateway-requirements.lock /usr/local/bin/pip /usr/local/bin/pip3 \
      /usr/bin/pip /usr/bin/pip3 /usr/local/bin/easy_install /usr/bin/easy_install; \
    find /usr /usr/local -type d \( \
      -path '*/python3.12/ensurepip' -o \
      -path '*/python3.12/site-packages/pip' -o \
      -path '*/python3.12/site-packages/pip-*.dist-info' -o \
      -path '*/python3.12/site-packages/setuptools' -o \
      -path '*/python3.12/site-packages/setuptools-*.dist-info' -o \
      -path '*/python3.12/site-packages/wheel' -o \
      -path '*/python3.12/site-packages/wheel-*.dist-info' \
    \) -prune -exec rm -rf '{}' '+' 2>/dev/null || true

# Security boundary: never copy a backend/shared directory wholesale. The
# build context may be dirty and may contain .env.*, uploads, databases or
# logs; even deleting them later would leave secrets in an image layer.
COPY WEB-itinvent/backend/__init__.py /opt/hub/WEB-itinvent/backend/__init__.py
COPY WEB-itinvent/backend/ai_sandbox_gateway_main.py /opt/hub/WEB-itinvent/backend/ai_sandbox_gateway_main.py
COPY WEB-itinvent/backend/config.py /opt/hub/WEB-itinvent/backend/config.py
COPY WEB-itinvent/backend/appdb/__init__.py /opt/hub/WEB-itinvent/backend/appdb/__init__.py
COPY WEB-itinvent/backend/appdb/db.py /opt/hub/WEB-itinvent/backend/appdb/db.py
COPY WEB-itinvent/backend/appdb/models.py /opt/hub/WEB-itinvent/backend/appdb/models.py
COPY WEB-itinvent/backend/services/__init__.py /opt/hub/WEB-itinvent/backend/services/__init__.py
COPY WEB-itinvent/backend/services/sql_observability.py /opt/hub/WEB-itinvent/backend/services/sql_observability.py
COPY WEB-itinvent/backend/ai_sandbox/__init__.py /opt/hub/WEB-itinvent/backend/ai_sandbox/__init__.py
COPY WEB-itinvent/backend/ai_sandbox/config.py /opt/hub/WEB-itinvent/backend/ai_sandbox/config.py
COPY WEB-itinvent/backend/ai_sandbox/contracts.py /opt/hub/WEB-itinvent/backend/ai_sandbox/contracts.py
COPY WEB-itinvent/backend/ai_sandbox/policy.py /opt/hub/WEB-itinvent/backend/ai_sandbox/policy.py
COPY WEB-itinvent/backend/ai_sandbox/models.py /opt/hub/WEB-itinvent/backend/ai_sandbox/models.py
COPY WEB-itinvent/backend/ai_sandbox/gateway.py /opt/hub/WEB-itinvent/backend/ai_sandbox/gateway.py
COPY shared/__init__.py /opt/hub/shared/__init__.py
COPY shared/llm/__init__.py /opt/hub/shared/llm/__init__.py
COPY shared/llm/client.py /opt/hub/shared/llm/client.py
COPY shared/llm/env.py /opt/hub/shared/llm/env.py
COPY shared/llm/errors.py /opt/hub/shared/llm/errors.py
COPY shared/llm/models.py /opt/hub/shared/llm/models.py
COPY shared/llm/openai_gateway.py /opt/hub/shared/llm/openai_gateway.py

RUN find /opt/hub -type d -name __pycache__ -prune -exec rm -rf '{}' '+'; \
    find /opt/hub -type f \( -name '.env*' -o -name '*.pyc' -o -name '*.pyo' \) -delete; \
    test -z "$(find /opt/hub -type f \( -name '.env*' -o -name '*.db' -o -name '*.sqlite*' \) -print -quit)"; \
    python3 -c 'import sys; sys.path[:0] = ["/opt/hub/WEB-itinvent", "/opt/hub"]; import backend.ai_sandbox_gateway_main'

USER 10001:10001
WORKDIR /opt/hub/WEB-itinvent
ENV PYTHONPATH=/opt/hub/WEB-itinvent:/opt/hub \
    HOME=/tmp/home \
    TMPDIR=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["python3", "-m", "uvicorn"]
CMD ["backend.ai_sandbox_gateway_main:app", "--host", "0.0.0.0", "--port", "8080", "--no-server-header"]
