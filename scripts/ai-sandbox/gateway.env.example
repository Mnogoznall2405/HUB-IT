# Dedicated Linux gateway only. Never pass this env file to OpenCode.
# Service owner hub-ai-sandbox; directory 0700, file 0600.
APP_DATABASE_URL=postgresql+psycopg://<gateway-user>:<password>@<db-host>/<db-name>
APP_ENV=production
# Independent random service key; never copy the portal signing key here.
JWT_SECRET_KEY=<independent-random-service-key>
AUTH_COOKIE_SECURE=true
AI_SANDBOX_ENABLED=1
AI_SANDBOX_LLM_MODEL=<approved-model>
AI_SANDBOX_LLM_MAX_OUTPUT_TOKENS=4000
ROUTERAI_API_KEY=<provider-key>
# Historical shared-client variable names; dedicated gateway uses OpenCode Go.
# Approved Go model: deepseek-v4.1-flash (without provider prefix).
ROUTERAI_BASE_URL=https://opencode.ai/zen/go/v1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
