[Unit]
Description=HUB OpenCode isolated execution worker
Wants=network-online.target hub-ai-gateway.service
Requires=user@10001.service
After=network-online.target user@10001.service hub-ai-gateway.service
Conflicts=hub-ai-cleanup.service
RequiresMountsFor=/var/lib/hub-ai-sandbox/workspaces

[Service]
Type=simple
User=hub-ai-sandbox
Group=hub-ai-sandbox
WorkingDirectory=/opt/hub-ai/current/WEB-itinvent
Environment=XDG_RUNTIME_DIR=/run/user/10001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/10001/bus
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CONTAINERS_CONF=/etc/hub-ai-sandbox/containers-service.conf
Environment=PYTHONPATH=/opt/hub-ai/current/WEB-itinvent:/opt/hub-ai/current
EnvironmentFile=/etc/hub-ai-sandbox/worker.env
ExecStartPre=/usr/bin/mountpoint -q /var/lib/hub-ai-sandbox/workspaces
ExecStart=/opt/hub-ai/venv/bin/python -m backend.ai_sandbox_worker_main --worker-id=tmn-srv-ai-01-sandbox-1
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
Delegate=yes
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
