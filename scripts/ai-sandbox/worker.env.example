APP_ENV=production
JWT_SECRET_KEY=<independent-random-service-key>
AUTH_COOKIE_SECURE=true
APP_DATABASE_URL=postgresql+psycopg://<worker-user>:<password>@<db-host>/<db-name>
AI_SANDBOX_ENABLED=0
AI_SANDBOX_IMAGE=<registry>/<image>@sha256:<manifest-digest>
AI_SANDBOX_OPENCODE_VERSION=1.18.18
AI_SANDBOX_CONTENT_TRANSFER_READY=1
AI_SANDBOX_CONTENT_TRANSFER_URL=https://hub-ai-control:8443/api/v1/chat/internal/ai/sandbox
AI_SANDBOX_CONTENT_TRANSFER_ALLOWED_HOST=hub-ai-control
AI_SANDBOX_TRANSFER_SERVICE_TOKEN=<same-strong-token-as-HUB>
AI_SANDBOX_LLM_GATEWAY_URL=http://hub-ai-llm-gateway:8080/v1
AI_SANDBOX_WORKSPACE_ROOT=/var/lib/hub-ai-sandbox/workspaces
AI_SANDBOX_RUNTIME_SECRET_ROOT=/run/user/10001/hub-ai-sandbox
AI_SANDBOX_QUOTA_HELPER=/usr/local/libexec/hub-ai-sandbox-quota
AI_SANDBOX_SECCOMP_PROFILE=/etc/hub-ai-sandbox/seccomp-opencode.json
AI_SANDBOX_RETENTION_ENABLED=1
SSL_CERT_FILE=/etc/hub-ai-sandbox/control-ca.pem
