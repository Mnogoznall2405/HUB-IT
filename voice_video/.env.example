# API ключи VoiceVideo
# HuggingFace токен — нужен для pyannote (диаризация/эмбеддинги спикеров).
# Модели gated: примите условия на https://hf.co/pyannote/speaker-diarization-3.1
# и https://hf.co/pyannote/embedding (или wespeaker-voxceleb-resnet34-LM)
HF_TOKEN=

# OpenRouter ключ — AI-анализ встреч (https://openrouter.ai/keys)
OPENROUTER_KEY=

# Устройство: true = CUDA GPU, false = CPU
USE_CUDA=true

# Модели (опционально)
# OPENAI_MODEL — основная LLM (анализ, резюме, задачи). По умолчанию openai/gpt-6-luna-pro
# OPENAI_MODEL=openai/gpt-6-luna-pro
# SEGMENTATION_MODEL — LLM для разметки тем. По умолчанию = OPENAI_MODEL (luna)
# SEGMENTATION_MODEL=openai/gpt-6-luna-pro
# TOPIC_ANALYSIS_MODEL — быстрая LLM для по-темного анализа (1 вызов на тему).
# По умолчанию xiaomi/mimo-v2.6-pro-ultraspeed (~14с/тему, валидный JSON).
# TOPIC_ANALYSIS_MODEL=xiaomi/mimo-v2.6-pro-ultraspeed
# Альтернатива: OPENAI_MODEL=xiaomi/mimo-v2.6-pro
# DEFAULT_WHISPER_MODEL=large-v3
# STT_ENGINE — движок транскрипции: whisper (локально, GPU) | gemini | grok | mai
# STT_ENGINE=whisper
# SEPARATOR_ENGINE — сепаратор вокала: kim (быстрый, дефолт) | melband | viperx | demucs | none
# SEPARATOR_ENGINE=kim

# Диаризация (тонкая настройка pyannote community-1, опционально)
# DIARIZATION_NUM_SPEAKERS — точное число спикеров, если известно (0 = авто)
# DIARIZATION_NUM_SPEAKERS=0
# DIARIZATION_CLUSTERING_THRESHOLD — порог слияния кластеров (ниже = больше спикеров; дефолт модели)
# DIARIZATION_CLUSTERING_THRESHOLD=0.7
# DIARIZATION_MIN_DURATION_OFF — мин. пауза для разделения реплик, сек (ниже = ловит короткие перебивки)
# DIARIZATION_MIN_DURATION_OFF=0.0
# DIARIZATION_AUDIO — звук для диаризации: processed (после сепаратора, по умолчанию) или raw
# (сырой). Выбирать по сравнению DER на вкладке «Разметка» в /voice; на текст не влияет.
# DIARIZATION_AUDIO=processed
# DIARIZATION_OVERLAP_ASSIGN — спикер слова по наибольшему пересечению с репликой
# (детерминированно при одновременной речи). 0 — прежний индекс «100 мс -> спикер».
# DIARIZATION_OVERLAP_ASSIGN=0
# SPEAKER_EMBEDDINGS_IMPROVED — узнавание по голосу: до 15 самых длинных реплик,
# центральные ≤8 с, нормированные векторы. 0 — прежние 5 первых реплик.
# SPEAKER_EMBEDDINGS_IMPROVED=0
# DIARIZATION_EXCLUSIVE — «эксклюзивная» разметка community-1 (pyannote.audio >= 4): один
# говорящий в момент времени, точнее привязка слов. Проверить вариантом на вкладке «Разметка».
# DIARIZATION_EXCLUSIVE=0
# DIARIZATION_CHUNK_SECONDS — чанковая диаризация длинных записей: окна этой длины (с) с
# перекрытием DIARIZATION_CHUNK_OVERLAP_SECONDS, голоса сшиваются без потолка на число
# спикеров. 0 — выключено. Включается для записей длиннее DIARIZATION_CHUNK_THRESHOLD_SECONDS.
# Нужен pyannote.audio >= 4. Пороги сшивки: DIARIZATION_STITCH_SIMILARITY/_MARGIN/_MIN_SPEECH.
# DIARIZATION_CHUNK_SECONDS=0
# DIARIZATION_CHUNK_THRESHOLD_SECONDS=1800
# DIARIZATION_CHUNK_OVERLAP_SECONDS=30
# Jev как контролёр протокола: направление темы (стройка/финансы/снабжение…) и «сторож» поручений
# (сомнительные получают «⚠ проверить: причина» в реестре). Сбой Jev протокол не ломает.
# AUDIO_LOUDNORM — нормализация громкости по стандарту вещания (−16 LUFS) вместо пиковой. На тихих записях облачный
# STT теряет слова; тест на ВКС: сырой звук 13.1% расхождения со вторым распознавателем, с Kim 8.1%, с loudnorm 6.7%.
# С AUDIO_LOUDNORM=1 сепаратор вокала не нужен: SEPARATOR_ENGINE=none (экономит ~25 мин на записи в 2.5 часа).
# AUDIO_LOUDNORM=0
# DEAD_AIR_SECONDS — участки записи без звука дольше N секунд (по умолчанию 600) не нормализуются: пустой рабочий стол
# часами (запись 22.07: 18 ч, звук в ~40 мин). Тишина возвращается на место, длина и тайм-коды не меняются. 0 — выкл.
# DEAD_AIR_SECONDS=600
# VIDEO_HINTS — подсказки «кто говорит» по видео ВКС (TrueConf: рамка говорящего + подпись плитки, локальный OCR,
# кадры никуда не уходят): имена для безымянных голосов, состав комнат, расхождения «аккаунт ≠ голос» -> <base>_video_hints.json.
# Только подсказки, в протокол имена сами не попадают.
# VIDEO_HINTS=0
# FACE_HINTS — опознание лиц в подсвеченной плитке (YuNet+SFace, локально на CPU; нужен VIDEO_HINTS=1). БИОМЕТРИЯ: включать
# только после согласования с ИБ и юристами. Эталоны набираются сами по согласию голоса и плитки, хранятся только векторы
# (FACE_ROSTER_PATH, по умолчанию data/face_roster.json), фото не сохраняются. В сводке: faces.tiles, faces.face_voice_conflicts.
# FACE_HINTS=0
# SPEAKER_REIDENTIFY — пореплечная проверка голосов по эталонам: реплика ≥3 с, явно (расстояние ≤0.30, запас 0.10) похожая на другой эталон,
# получает его имя; уверенные голоса не трогаются. Тест на ВКС 03.10: неверных секунд 380 -> 241 (−37 %), верные не портятся.
# SPEAKER_REIDENTIFY=0
# JEV_DOMAIN_TAGS=1
# JEV_PROTOCOL_GUARD=1
# JEV_GUARD_SUPPORT_MIN=0.4
# JEV_GUARD_OWNER_MIN=0.5
# Словарь компании (вкладка «Словарь»): GLOSSARY_PROMPT — релевантные термины в промпты анализа и подсказка
# для STT; GLOSSARY_CORRECT — замена подтверждённых ошибочных написаний; GLOSSARY_EXTRACT — после анализа
# предлагать кандидатов в словарь. GLOSSARY_PATH — выгрузка подтверждённых (пишет voice_server).
# GLOSSARY_PROMPT=1
# GLOSSARY_CORRECT=1
# GLOSSARY_EXTRACT=1
# GLOSSARY_PATH=data/company_glossary.json
# SPEAKER_RECURRING — помечать неизвестные голоса, встречавшиеся в других записях
# (voice_video/data/recurring_voices.json); SPEAKER_RECURRING_SIMILARITY — порог похожести.
# SPEAKER_RECURRING=0
# SPEAKER_RECURRING_SIMILARITY=0.6
# Пороги узнавания по эталонам (косинусное расстояние, меньше = строже).
# Подобрать: вкладка «Разметка» → «Подбор порога узнавания».
# SPEAKER_ID_STRICT=0.25
# SPEAKER_ID_MODERATE=0.35
# SPEAKER_ID_LOOSE=0.45
